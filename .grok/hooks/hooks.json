{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/.grok/hooks/bin/session-start.ps1\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mt5__|mcp__|use_tool|mcp_call_tool|EnterWorktree|git_worktree|worktree|Worktree|Bash|run_terminal_command|exec|spawn_subagent|Task|Write|Edit|MultiEdit|search_replace|write|edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/.grok/hooks/bin/pretool.ps1\"",
            "timeout": 8
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mt5__|mcp__|use_tool|mcp_call_tool|Bash|run_terminal_command|exec",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/.grok/hooks/bin/posttool.ps1\"",
            "timeout": 8
          }
        ]
      }
    ]
  }
}
