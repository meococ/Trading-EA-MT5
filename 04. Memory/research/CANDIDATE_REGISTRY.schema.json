{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alphafactory.CANDIDATE_REGISTRY.schema.json",
  "title": "AlphaFactory append-only hypothesis state row",
  "$defs": {
    "sha256": {
      "type": ["string", "null"],
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "path": {
      "type": ["string", "null"],
      "minLength": 1
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "record_type": { "const": "hypothesis_state" },
    "schema_version": { "const": "alphafactory_candidate_registry.v1" },
    "hypothesis_id": { "type": "string", "pattern": "^HYP-[A-Z0-9_-]{3,120}$" },
    "ea_name": { "type": "string", "pattern": "^EA_[A-Za-z0-9_.-]{1,120}$" },
    "state": {
      "enum": [
        "idea", "probe", "screened", "challenger", "confirmed",
        "portfolio-sleeve", "parked", "killed"
      ]
    },
    "parent_candidate": { "type": ["string", "null"] },
    "feature_family": { "type": "string", "minLength": 1 },
    "lane": { "type": "string", "minLength": 1 },
    "symbol": { "type": "string", "minLength": 1 },
    "timeframe": { "type": "string", "pattern": "^(M[1-9][0-9]*|H[1-9][0-9]*|D1|W1|MN1)$" },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string", "pattern": "^[0-9]{4}[.][0-9]{2}[.][0-9]{2}$" },
        "to": { "type": "string", "pattern": "^[0-9]{4}[.][0-9]{2}[.][0-9]{2}$" }
      },
      "required": ["from", "to"]
    },
    "model": { "type": ["integer", "null"], "enum": [null, 0, 1, 2, 4] },
    "source_provenance": { "type": "string", "minLength": 1 },
    "source_path": { "$ref": "#/$defs/path" },
    "source_hash": { "$ref": "#/$defs/sha256" },
    "prereg_path": { "$ref": "#/$defs/path" },
    "prereg_sha256": { "$ref": "#/$defs/sha256" },
    "exact_overrides": { "type": "string" },
    "acceptance_contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_profit_factor": { "type": "number", "minimum": 1.3 },
        "min_trades_per_week": { "type": "number", "minimum": 2.0 },
        "max_trades_per_week": { "type": "number", "minimum": 2.0, "maximum": 5.0 },
        "max_drawdown_pct": { "type": "number", "exclusiveMinimum": 0, "maximum": 8.0 },
        "min_cost_pf_x1_5": { "type": "number", "minimum": 1.25 },
        "min_cost_pf_x2": { "type": "number", "minimum": 1.0 },
        "max_monte_carlo_p95_dd_pct": { "type": "number", "exclusiveMinimum": 0, "maximum": 8.0 }
      },
      "required": [
        "min_profit_factor", "min_trades_per_week", "max_trades_per_week",
        "max_drawdown_pct", "min_cost_pf_x1_5", "min_cost_pf_x2",
        "max_monte_carlo_p95_dd_pct"
      ]
    },
    "verdict": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "updated_at_utc": { "type": "string", "format": "date-time" },
    "run_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "metrics": { "type": "object" },
    "validation": {
      "type": "object",
      "properties": {
        "source_run_bindings": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "active_contract_bundle_path",
            "active_contract_bundle_sha256",
            "authority_amendment_path",
            "authority_amendment_sha256",
            "economic_access_authorized",
            "economics_authorized",
            "evidence_root",
            "final_output_root",
            "holdout_authorized",
            "implementation_review_receipt_path",
            "implementation_review_receipt_sha256",
            "implementation_task_path",
            "implementation_task_sha256",
            "model0_authorized",
            "network_allowed",
            "production_source_projection_authorized",
            "projection_attempt_id",
            "projector_test_path",
            "projector_test_sha256",
            "projector_tool_path",
            "projector_tool_sha256",
            "public_manifest_path",
            "public_manifest_sha256",
            "public_receipt_path",
            "public_receipt_sha256",
            "registry_mutation_allowed",
            "research_holdout_authorized",
            "research_validation_authorized",
            "schema_version",
            "selection_manifest_path",
            "selection_manifest_sha256",
            "source_projection_attempt_limit",
            "source_run_authorized",
            "source_run_packet_review_required",
            "stage_root",
            "subprocess_allowed",
            "supervisor_review_base_sha256",
            "supervisor_test_path",
            "supervisor_test_sha256",
            "supervisor_tool_path",
            "trading_mutation",
            "validation_authorized",
            "validator_test_path",
            "validator_test_sha256",
            "validator_tool_path",
            "validator_tool_sha256"
          ],
          "properties": {
            "active_contract_bundle_path": {"const": "03. EA Developer/EA_TrendStackContinuation/research/HYP-TRENDSTACK-EURUSD-H1-007_ACTIVE_SOURCE_CONTRACT_BUNDLE_V2.json"},
            "active_contract_bundle_sha256": {"const": "1080BBF2D88A4FB68A293DE35C6E955A7CE2282EB0F4D44ACA26D533E11BCD2C"},
            "authority_amendment_path": {"const": "03. EA Developer/EA_TrendStackContinuation/research/HYP-TRENDSTACK-EURUSD-H1-007_SOURCE_RUN_AUTHORITY_AMENDMENT_V2.json"},
            "authority_amendment_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
            "economic_access_authorized": {"const": false},
            "economics_authorized": {"const": false},
            "evidence_root": {"const": "03. EA Developer/EA_TrendStackContinuation/research/evidence/HYP-TRENDSTACK-EURUSD-H1-007_SOURCE_PROJECTION_ATTEMPTS/HYP007-SOURCE-PROJECTION-7C4A91E6D2B80F35"},
            "final_output_root": {"const": "02. AlphaFactory/data/fivepercent/EURUSD/trendstack_007_design_h1_1200"},
            "holdout_authorized": {"const": false},
            "implementation_review_receipt_path": {"enum": ["03. EA Developer/EA_TrendStackContinuation/research/HYP-TRENDSTACK-EURUSD-H1-007_SOURCE_IMPLEMENTATION_REVIEW_RECEIPT_V5.json", "03. EA Developer/EA_TrendStackContinuation/research/HYP-TRENDSTACK-EURUSD-H1-007_SOURCE_IMPLEMENTATION_REVIEW_RECEIPT_V6.json"]},
            "implementation_review_receipt_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
            "implementation_task_path": {"enum": ["03. EA Developer/EA_TrendStackContinuation/research/HYP-TRENDSTACK-EURUSD-H1-007_SOURCE_IMPLEMENTATION_TASK_PACKET_V5.json", "03. EA Developer/EA_TrendStackContinuation/research/HYP-TRENDSTACK-EURUSD-H1-007_SOURCE_IMPLEMENTATION_TASK_PACKET_V6.json"]},
            "implementation_task_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
            "model0_authorized": {"const": false},
            "network_allowed": {"const": false},
            "production_source_projection_authorized": {"const": true},
            "projection_attempt_id": {"const": "HYP007-SOURCE-PROJECTION-7C4A91E6D2B80F35"},
            "projector_test_path": {"const": "03. EA Developer/EA_TrendStackContinuation/research/tests/test_project_trendstack_007_design_source.py"},
            "projector_test_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
            "projector_tool_path": {"const": "03. EA Developer/EA_TrendStackContinuation/research/project_trendstack_007_design_source.py"},
            "projector_tool_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
            "public_manifest_path": {"const": "02. AlphaFactory/data/fivepercent/EURUSD/h1_splitvault_002/public/design_manifest.jsonl"},
            "public_manifest_sha256": {"const": "DA513911B01B1C4232611225C77A4F22E9E3C89E719EE530923BD574D06451E5"},
            "public_receipt_path": {"const": "02. AlphaFactory/data/fivepercent/EURUSD/h1_splitvault_002/public/design_receipt.json"},
            "public_receipt_sha256": {"const": "623328512F0CB77B52B155F6CD314EA2B47DAC40636A7714BD38167BEA807B13"},
            "registry_mutation_allowed": {"const": false},
            "research_holdout_authorized": {"const": false},
            "research_validation_authorized": {"const": false},
            "schema_version": {"const": "trendstack_007_source_run_bindings.v2"},
            "selection_manifest_path": {"const": "03. EA Developer/EA_TrendStackContinuation/research/HYP-TRENDSTACK-EURUSD-H1-006_DESIGN_DATE_SELECTION.jsonl"},
            "selection_manifest_sha256": {"const": "D99C21ED2611A70D9F225170997EAADDD6567827B69759A1DFA9EA7F73C7A135"},
            "source_projection_attempt_limit": {"const": 1},
            "source_run_authorized": {"const": true},
            "source_run_packet_review_required": {"const": true},
            "stage_root": {"const": "02. AlphaFactory/data/fivepercent/EURUSD/.trendstack_007_design_h1_1200.attempt-HYP007-SOURCE-PROJECTION-7C4A91E6D2B80F35"},
            "subprocess_allowed": {"const": false},
            "supervisor_review_base_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
            "supervisor_test_path": {"const": "03. EA Developer/EA_TrendStackContinuation/research/tests/test_supervise_trendstack_007_source_projection.py"},
            "supervisor_test_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
            "supervisor_tool_path": {"const": "03. EA Developer/EA_TrendStackContinuation/research/supervise_trendstack_007_source_projection.py"},
            "trading_mutation": {"const": false},
            "validation_authorized": {"const": false},
            "validator_test_path": {"const": "03. EA Developer/EA_TrendStackContinuation/research/tests/test_validate_trendstack_007_design_source.py"},
            "validator_test_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
            "validator_tool_path": {"const": "03. EA Developer/EA_TrendStackContinuation/research/validate_trendstack_007_design_source.py"},
            "validator_tool_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
          }
        }
      }
    }
  },
  "required": [
    "record_type", "schema_version", "hypothesis_id", "ea_name", "state",
    "parent_candidate", "feature_family", "lane", "symbol", "timeframe", "window",
    "model", "source_provenance", "source_path", "source_hash", "prereg_path",
    "prereg_sha256", "exact_overrides", "acceptance_contract", "verdict", "reason", "updated_at_utc",
    "run_ids", "metrics", "validation"
  ]
}
