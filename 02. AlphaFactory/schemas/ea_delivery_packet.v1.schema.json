{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alphafactory.ea_delivery_packet.v1",
  "title": "AlphaFactory EA development delivery packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at_utc",
    "hypothesis_id",
    "ea_name",
    "delivery_class",
    "completion_claim",
    "verdict",
    "bindings",
    "logic_contract",
    "engineering_contract",
    "run_contract",
    "analysis_contract",
    "chart_contract",
    "anti_overfit_contract",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "alphafactory_ea_delivery_packet.v1"},
    "created_at_utc": {"type": "string", "minLength": 1},
    "hypothesis_id": {"type": "string", "minLength": 1},
    "ea_name": {"type": "string", "pattern": "^EA_[A-Za-z0-9_.-]+$"},
    "delivery_class": {"enum": ["economic_run", "zero_trade_terminal"]},
    "completion_claim": {"const": true},
    "verdict": {"enum": ["SCREENED", "CHALLENGER", "CONFIRMED", "PARKED", "KILLED", "INVALID"]},
    "bindings": {
      "type": "array",
      "minItems": 15,
      "items": {"$ref": "#/$defs/binding"}
    },
    "logic_contract": {"type": "object"},
    "engineering_contract": {"type": "object"},
    "run_contract": {"type": "object"},
    "analysis_contract": {"type": "object"},
    "chart_contract": {"type": "object"},
    "anti_overfit_contract": {"type": "object"},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "bytes", "sha256"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"}
      }
    }
  }
}
