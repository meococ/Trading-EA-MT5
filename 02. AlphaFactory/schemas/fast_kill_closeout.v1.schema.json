{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alphafactory.fast_kill_closeout.v1",
  "title": "AlphaFactory lean fast-kill closeout",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at_utc",
    "hypothesis_id",
    "ea_name",
    "evidence_class",
    "verdict",
    "kill_code",
    "cell_closeout_claim",
    "bindings",
    "frozen_kill_gate",
    "metrics",
    "anti_overfit_contract",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "alphafactory_fast_kill_closeout.v1"},
    "created_at_utc": {"type": "string", "minLength": 1},
    "hypothesis_id": {"type": "string", "minLength": 1},
    "ea_name": {"type": "string", "pattern": "^EA_[A-Za-z0-9_.-]+$"},
    "evidence_class": {"enum": ["offline_probe", "model0"]},
    "verdict": {"enum": ["KILLED", "PARKED", "INVALID"]},
    "kill_code": {
      "enum": [
        "data_invalid",
        "engineering_invalid",
        "cadence_fail",
        "gross_edge_fail",
        "cost_dominated",
        "matched_control_fail",
        "instability_fail",
        "risk_fail"
      ]
    },
    "cell_closeout_claim": {"const": true},
    "bindings": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/binding"}
    },
    "frozen_kill_gate": {"type": "object"},
    "metrics": {"type": "object"},
    "anti_overfit_contract": {"type": "object"},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "bytes", "sha256"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
      }
    }
  }
}
