{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alphafactory_optimization_receipt.v1",
  "title": "AlphaFactory frozen MT5 optimization receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "frozen_pre_outcome",
    "selection_rule_frozen",
    "expected_total_trials",
    "report_format",
    "sharpe_column",
    "sr_semantics",
    "source_path",
    "source_sha256",
    "config_path",
    "config_sha256",
    "hypothesis_id",
    "run_id",
    "selection_metric",
    "selection_direction",
    "selection_tie_breaker",
    "parameter_axes",
    "cumulative_trials_before",
    "report_path",
    "report_sha256",
    "selected_pass_id",
    "selected_returns_path",
    "selected_returns_sha256",
    "selected_returns_column",
    "selected_returns_row_count"
  ],
  "properties": {
    "schema_version": { "const": "alphafactory_optimization_receipt.v1" },
    "frozen_pre_outcome": { "const": true },
    "selection_rule_frozen": { "const": true },
    "expected_total_trials": { "type": "integer", "minimum": 1 },
    "report_format": { "enum": ["spreadsheetml", "delimited"] },
    "sharpe_column": { "type": "string", "minLength": 1 },
    "sr_semantics": { "const": "per_trade_net_r" },
    "source_path": { "type": "string", "minLength": 1 },
    "source_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "config_path": { "type": "string", "minLength": 1 },
    "config_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "hypothesis_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "selection_metric": { "type": "string", "minLength": 1 },
    "selection_direction": { "enum": ["max", "min"] },
    "selection_tie_breaker": { "const": "lowest_pass_id" },
    "parameter_axes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "cumulative_trials_before": { "type": "integer", "minimum": 0 },
    "report_path": { "type": "string", "minLength": 1 },
    "report_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "selected_pass_id": { "type": "string", "pattern": "^[0-9]+$" },
    "selected_returns_path": { "type": "string", "minLength": 1 },
    "selected_returns_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "selected_returns_column": { "type": "string", "minLength": 1 },
    "selected_returns_row_count": { "type": "integer", "minimum": 3 }
  }
}
