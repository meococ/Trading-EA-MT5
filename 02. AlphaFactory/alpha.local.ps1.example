# Machine-local MT5 paths for AlphaFactory.
# Copy this file to alpha.local.ps1 and edit for THIS machine.
# alpha.local.ps1 is gitignored — never commit real machine paths.
#
#   Copy-Item "alpha.local.ps1.example" "alpha.local.ps1"
#   # or:
#   .\tools\init_machine_paths.ps1
#
# AlphaFactory compile/backtest must use ONE portable isolate.
# Never pin Owner GUI:
#   C:\Program Files\MetaTrader 5
#   %APPDATA%\MetaQuotes\Terminal\<32-hex>
# Leftover tree runtime\mt5-portable is unused. Do not compile/backtest against
# it. Default `alpha.ps1 clean` will not delete it; Owner reclaim only.
# Launch factory terminal64 only with /portable. Double-click creates an AppData
# clone and mixes profiles.

# Factory isolate (InstallRoot = DataRoot). Prefer mqdemo for tester; keep
# fivepercent as a separate unused tree unless Owner retargets it.
$MT5InstallRoot = "D:\Meta 5\Trading-EA-MT5\02. AlphaFactory\runtime\mt5-portable-mqdemo"
$MT5DataRoot = $MT5InstallRoot
$MT5PortableMode = $true
$MT5CommonFilesRoot = Join-Path $MT5DataRoot "Common\Files"
$MT5AllowCommonFiles = $true
$MT5TesterRoot = Join-Path $MT5DataRoot "Tester"
$MT5RequiredStorageDrive = "D:"

# Alternate unused live-data tree (do not run tester against it while mqdemo is pinned):
#   $MT5InstallRoot = "D:\Meta 5\Trading-EA-MT5\02. AlphaFactory\runtime\mt5-portable-fivepercent"
#
# Owner Program Files GUI stays outside the factory. Do not uncomment this as a
# factory target:
#   $MT5InstallRoot = "C:\Program Files\MetaTrader 5"
#   $MT5DataRoot = "C:\Users\YOUR_USER\AppData\Roaming\MetaQuotes\Terminal\YOUR_32_HEX_TERMINAL_ID"
#   $MT5PortableMode = $false
#   $MT5CommonFilesRoot = Join-Path (Split-Path -Parent $MT5DataRoot) "Common\Files"
