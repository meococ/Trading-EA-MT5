{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "EA_SonicR.CANDIDATE_REGISTRY.schema.json",
  "title": "EA_SonicR candidate registry row",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "artifact_ref": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["path", "sha256"],
      "additionalProperties": false
    },
    "matched_control_evidence": {
      "type": "object",
      "properties": {
        "control_run_id": { "type": "string", "minLength": 1 },
        "challenger_run_id": { "type": "string", "minLength": 1 },
        "control_overrides": { "type": "string", "minLength": 1 },
        "challenger_overrides": { "type": "string", "minLength": 1 },
        "control_manifest": { "$ref": "#/$defs/artifact_ref" },
        "challenger_manifest": { "$ref": "#/$defs/artifact_ref" },
        "control_report": { "$ref": "#/$defs/artifact_ref" },
        "challenger_report": { "$ref": "#/$defs/artifact_ref" },
        "comparison": { "$ref": "#/$defs/artifact_ref" }
      },
      "required": [
        "control_run_id",
        "challenger_run_id",
        "control_overrides",
        "challenger_overrides",
        "control_manifest",
        "challenger_manifest",
        "control_report",
        "challenger_report",
        "comparison"
      ],
      "additionalProperties": false
    },
    "stability_evidence": {
      "type": "object",
      "properties": {
        "artifact": { "$ref": "#/$defs/artifact_ref" },
        "window": { "type": "string", "minLength": 1 },
        "months": { "const": 84 },
        "positive_months": { "type": "integer", "minimum": 42, "maximum": 84 },
        "positive_month_ratio": { "type": "number", "minimum": 0.5, "maximum": 1 },
        "max_month_positive_profit_share": { "type": "number", "minimum": 0, "maximum": 0.2 },
        "half_years": { "const": 14 },
        "positive_half_years": { "type": "integer", "minimum": 9, "maximum": 14 },
        "positive_half_year_ratio": { "type": "number", "minimum": 0.6428571428571429, "maximum": 1 },
        "max_half_year_positive_profit_share": { "type": "number", "minimum": 0, "maximum": 0.35 },
        "years": { "const": 7 },
        "positive_years": { "type": "integer", "minimum": 4, "maximum": 7 },
        "positive_year_ratio": { "type": "number", "minimum": 0.5714285714285714, "maximum": 1 },
        "max_year_positive_profit_share": { "type": "number", "minimum": 0, "maximum": 0.4 }
      },
      "required": [
        "artifact",
        "window",
        "months",
        "positive_months",
        "positive_month_ratio",
        "max_month_positive_profit_share",
        "half_years",
        "positive_half_years",
        "positive_half_year_ratio",
        "max_half_year_positive_profit_share",
        "years",
        "positive_years",
        "positive_year_ratio",
        "max_year_positive_profit_share"
      ],
      "additionalProperties": false
    },
    "control_evidence": {
      "type": "object",
      "properties": {
        "control_id": { "type": "string", "minLength": 1 },
        "cost_pf_x1_delta": { "type": "number", "minimum": 0.15 },
        "mean_net_r_per_trade_x1_delta": { "type": "number", "minimum": 0.05 },
        "passed": { "const": true }
      },
      "required": [
        "control_id",
        "cost_pf_x1_delta",
        "mean_net_r_per_trade_x1_delta",
        "passed"
      ],
      "additionalProperties": false
    },
    "split_evidence": {
      "type": "object",
      "properties": {
        "window": { "type": "string", "minLength": 1 },
        "report": { "$ref": "#/$defs/artifact_ref" },
        "cost_manifest": { "$ref": "#/$defs/artifact_ref" },
        "outcome_artifact": { "$ref": "#/$defs/artifact_ref" },
        "trades": { "type": "integer", "minimum": 1 },
        "elapsed_days": { "type": "number", "exclusiveMinimum": 0 },
        "elapsed_calendar_weeks": { "type": "number", "exclusiveMinimum": 0 },
        "trades_per_elapsed_week": { "type": "number", "minimum": 2, "maximum": 5 },
        "cost_pf_x1": { "type": "number", "exclusiveMinimum": 1.3 },
        "cost_pf_x1_5": { "type": "number", "minimum": 1.25 },
        "cost_pf_x2": { "type": "number", "minimum": 1.0 },
        "net_r_x1_5": { "type": "number", "exclusiveMinimum": 0 },
        "mean_net_r_per_trade_x1": { "type": "number" },
        "positive_years": { "type": "integer", "minimum": 1 },
        "total_years": { "type": "integer", "minimum": 1 },
        "max_component_share_x1_5": { "type": "number", "minimum": 0, "maximum": 0.6 },
        "min_component_share_x1_5": { "type": "number", "minimum": 0.15, "maximum": 1 },
        "controls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/control_evidence" }
        }
      },
      "required": [
        "window",
        "report",
        "cost_manifest",
        "outcome_artifact",
        "trades",
        "elapsed_days",
        "elapsed_calendar_weeks",
        "trades_per_elapsed_week",
        "cost_pf_x1",
        "cost_pf_x1_5",
        "cost_pf_x2",
        "net_r_x1_5",
        "mean_net_r_per_trade_x1",
        "positive_years",
        "total_years",
        "max_component_share_x1_5",
        "min_component_share_x1_5",
        "controls"
      ],
      "additionalProperties": false
    },
    "promotion_evidence": {
      "type": "object",
      "properties": {
        "train": { "$ref": "#/$defs/split_evidence" },
        "holdout": { "$ref": "#/$defs/split_evidence" },
        "stability": { "$ref": "#/$defs/stability_evidence" },
        "validation_artifacts": {
          "type": "object",
          "properties": {
            "validate_full": { "$ref": "#/$defs/artifact_ref" },
            "walk_forward": { "$ref": "#/$defs/artifact_ref" },
            "pbo_cscv": { "$ref": "#/$defs/artifact_ref" },
            "reality_check_spa": { "$ref": "#/$defs/artifact_ref" },
            "monte_carlo": { "$ref": "#/$defs/artifact_ref" },
            "robustness_suite": { "$ref": "#/$defs/artifact_ref" },
            "equity_audit": { "$ref": "#/$defs/artifact_ref" },
            "cost_stress": { "$ref": "#/$defs/artifact_ref" },
            "execution_audit": { "$ref": "#/$defs/artifact_ref" },
            "nonrepaint_audit": { "$ref": "#/$defs/artifact_ref" },
            "casebook": { "$ref": "#/$defs/artifact_ref" }
          },
          "required": [
            "validate_full",
            "walk_forward",
            "pbo_cscv",
            "reality_check_spa",
            "monte_carlo",
            "robustness_suite",
            "equity_audit",
            "cost_stress",
            "execution_audit",
            "nonrepaint_audit",
            "casebook"
          ],
          "additionalProperties": false
        }
      },
      "required": ["train", "holdout", "stability", "validation_artifacts"],
      "additionalProperties": false
    },
    "portfolio_evidence": {
      "type": "object",
      "properties": {
        "component_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "component_run_ids": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "component_runs": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "correlation_exposure": { "$ref": "#/$defs/artifact_ref" },
        "overlap_audit": { "$ref": "#/$defs/artifact_ref" },
        "portfolio_drawdown": { "$ref": "#/$defs/artifact_ref" },
        "combined_cost_stress": { "$ref": "#/$defs/artifact_ref" },
        "max_pairwise_abs_correlation": { "type": "number", "minimum": 0, "maximum": 1 },
        "max_overlap_share": { "type": "number", "minimum": 0, "maximum": 1 },
        "portfolio_p95_dd_pct": { "type": "number", "minimum": 0 },
        "risk_budget_dd_pct": { "type": "number", "exclusiveMinimum": 0 },
        "combined_cost_pf_x1_5": { "type": "number", "minimum": 1.25 },
        "combined_cost_pf_x2": { "type": "number", "minimum": 1.0 }
      },
      "required": [
        "component_ids",
        "component_run_ids",
        "component_runs",
        "correlation_exposure",
        "overlap_audit",
        "portfolio_drawdown",
        "combined_cost_stress",
        "max_pairwise_abs_correlation",
        "max_overlap_share",
        "portfolio_p95_dd_pct",
        "risk_budget_dd_pct",
        "combined_cost_pf_x1_5",
        "combined_cost_pf_x2"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "record_type",
    "schema_version"
  ],
  "oneOf": [
    {
      "properties": {
        "record_type": { "const": "registry_meta" },
        "schema_version": { "const": 1 },
        "created_at": { "type": "string" },
        "scope": { "type": "string" },
        "rule": { "type": "string" }
      },
      "required": ["record_type", "schema_version", "created_at", "scope", "rule"],
      "additionalProperties": false
    },
    {
      "properties": {
        "record_type": { "const": "candidate" },
        "schema_version": { "const": 1 },
        "hypothesis_id": { "type": "string", "minLength": 1 },
        "state": {
          "enum": [
            "idea",
            "probe",
            "screened",
            "challenger",
            "confirmed",
            "portfolio-sleeve",
            "parked",
            "killed"
          ]
        },
        "parent_candidate": { "type": ["string", "null"] },
        "feature_family": { "type": "string" },
        "lane": { "type": "string" },
        "setup_type": { "type": "string" },
        "symbol": { "type": "string" },
        "timeframe": { "type": "string" },
        "window": { "type": "string" },
        "model": { "type": ["string", "integer"] },
        "source_provenance": { "type": "string" },
        "prereg_path": { "type": "string" },
        "readout_path": { "type": ["string", "null"] },
        "readout_hash": {
          "anyOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "exact_overrides": { "type": ["string", "null"] },
        "variant_tag": { "type": ["string", "null"] },
        "source_path": { "type": "string" },
        "source_hash": { "type": ["string", "null"] },
        "compiled_artifact_path": { "type": ["string", "null"] },
        "compiled_artifact_hash": { "type": ["string", "null"] },
        "matched_control_run_id": { "type": ["string", "null"] },
        "matched_control_evidence": {
          "anyOf": [
            { "$ref": "#/$defs/matched_control_evidence" },
            { "type": "null" }
          ]
        },
        "nonrepaint_audit": {
          "anyOf": [
            { "$ref": "#/$defs/artifact_ref" },
            { "type": "null" }
          ]
        },
        "preflight_evidence": {
          "anyOf": [
            { "$ref": "#/$defs/artifact_ref" },
            { "type": "null" }
          ]
        },
        "run_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "metrics": {
          "type": "object",
          "properties": {
            "trades": { "type": ["number", "null"] },
            "trades_per_year": { "type": ["number", "null"] },
            "elapsed_days": { "type": ["number", "null"], "exclusiveMinimum": 0 },
            "elapsed_calendar_weeks": { "type": ["number", "null"], "exclusiveMinimum": 0 },
            "trades_per_elapsed_week": { "type": ["number", "null"], "minimum": 0 },
            "pf": { "type": ["number", "null"] },
            "net": { "type": ["number", "null"] },
            "max_dd_pct": { "type": ["number", "null"] },
            "cost_pf_x1": { "type": ["number", "null"] },
            "cost_pf_x1_5": { "type": ["number", "null"] },
            "cost_pf_x2": { "type": ["number", "null"] },
            "net_r_x1_5": { "type": ["number", "null"] },
            "positive_months": { "type": ["string", "null"] },
            "positive_half_years": { "type": ["string", "null"] },
            "positive_years": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        },
        "validation": {
          "type": "object",
          "properties": {
            "validate_full": { "type": ["string", "null"] },
            "wfa": { "type": ["string", "null"] },
            "pbo_cscv": { "type": ["string", "null"] },
            "reality_check_spa": { "type": ["string", "null"] },
            "monte_carlo": { "type": ["string", "null"] },
            "robustness_suite": { "type": ["string", "null"] },
            "equity_audit": { "type": ["string", "null"] },
            "cost_stress": { "type": ["string", "null"] },
            "execution_audit": { "type": ["string", "null"] },
            "sidecar_completeness": { "type": ["string", "null"] },
            "casebook_status": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        },
        "promotion_evidence": {
          "anyOf": [
            { "$ref": "#/$defs/promotion_evidence" },
            { "type": "null" }
          ]
        },
        "portfolio_evidence": {
          "anyOf": [
            { "$ref": "#/$defs/portfolio_evidence" },
            { "type": "null" }
          ]
        },
        "verdict": {
          "enum": [
            "pending",
            "continue",
            "park",
            "kill",
            "confirm",
            "portfolio-candidate"
          ]
        },
        "reason": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": [
        "record_type",
        "schema_version",
        "hypothesis_id",
        "state",
        "feature_family",
        "lane",
        "setup_type",
        "symbol",
        "timeframe",
        "window",
        "model",
        "source_provenance",
        "prereg_path",
        "source_path",
        "run_ids",
        "metrics",
        "validation",
        "verdict",
        "reason",
        "updated_at"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": { "const": "challenger" }
            },
            "required": ["state"]
          },
          "then": {
            "required": [
              "readout_path",
              "readout_hash",
              "source_hash",
              "compiled_artifact_path",
              "compiled_artifact_hash",
              "matched_control_run_id",
              "matched_control_evidence",
              "nonrepaint_audit",
              "preflight_evidence"
            ],
            "properties": {
              "model": { "const": 0 },
              "readout_path": { "type": "string", "minLength": 1 },
              "readout_hash": { "$ref": "#/$defs/sha256" },
              "source_hash": { "$ref": "#/$defs/sha256" },
              "compiled_artifact_path": { "type": "string", "minLength": 1 },
              "compiled_artifact_hash": { "$ref": "#/$defs/sha256" },
              "matched_control_run_id": { "type": "string", "minLength": 1 },
              "matched_control_evidence": { "$ref": "#/$defs/matched_control_evidence" },
              "nonrepaint_audit": { "$ref": "#/$defs/artifact_ref" },
              "preflight_evidence": { "$ref": "#/$defs/artifact_ref" },
              "run_ids": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "metrics": {
                "required": [
                  "trades",
                  "elapsed_days",
                  "elapsed_calendar_weeks",
                  "trades_per_elapsed_week",
                  "cost_pf_x1",
                  "cost_pf_x1_5",
                  "cost_pf_x2",
                  "net_r_x1_5"
                ],
                "properties": {
                  "trades": { "type": "integer", "minimum": 1 },
                  "elapsed_days": { "type": "number", "exclusiveMinimum": 0 },
                  "elapsed_calendar_weeks": { "type": "number", "exclusiveMinimum": 0 },
                  "trades_per_elapsed_week": { "type": "number", "minimum": 0 },
                  "cost_pf_x1": { "type": "number", "minimum": 0 },
                  "cost_pf_x1_5": { "type": "number", "minimum": 0 },
                  "cost_pf_x2": { "type": "number", "minimum": 0 },
                  "net_r_x1_5": { "type": "number" }
                }
              },
              "validation": {
                "required": [
                  "validate_full",
                  "cost_stress",
                  "execution_audit",
                  "sidecar_completeness"
                ],
                "properties": {
                  "validate_full": { "const": "PASS" },
                  "cost_stress": { "const": "PASS" },
                  "execution_audit": { "const": "PASS" },
                  "sidecar_completeness": { "const": "PASS" }
                }
              },
              "verdict": { "const": "continue" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": { "enum": ["confirmed", "portfolio-sleeve"] }
            },
            "required": ["state"]
          },
          "then": {
            "required": [
              "readout_path",
              "readout_hash",
              "source_hash",
              "compiled_artifact_path",
              "compiled_artifact_hash",
              "matched_control_run_id",
              "matched_control_evidence",
              "nonrepaint_audit",
              "preflight_evidence",
              "promotion_evidence"
            ],
            "properties": {
              "model": { "const": 0 },
              "readout_path": { "type": "string", "minLength": 1 },
              "readout_hash": { "$ref": "#/$defs/sha256" },
              "source_hash": { "$ref": "#/$defs/sha256" },
              "compiled_artifact_path": { "type": "string", "minLength": 1 },
              "compiled_artifact_hash": { "$ref": "#/$defs/sha256" },
              "matched_control_run_id": { "type": "string", "minLength": 1 },
              "matched_control_evidence": { "$ref": "#/$defs/matched_control_evidence" },
              "nonrepaint_audit": { "$ref": "#/$defs/artifact_ref" },
              "preflight_evidence": { "$ref": "#/$defs/artifact_ref" },
              "run_ids": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "promotion_evidence": { "$ref": "#/$defs/promotion_evidence" },
              "metrics": {
                "required": [
                  "trades",
                  "elapsed_days",
                  "elapsed_calendar_weeks",
                  "trades_per_elapsed_week",
                  "cost_pf_x1",
                  "cost_pf_x1_5",
                  "cost_pf_x2",
                  "net_r_x1_5"
                ],
                "properties": {
                  "trades": { "type": "integer", "minimum": 1 },
                  "elapsed_days": { "type": "number", "exclusiveMinimum": 0 },
                  "elapsed_calendar_weeks": { "type": "number", "exclusiveMinimum": 0 },
                  "trades_per_elapsed_week": { "type": "number", "minimum": 2, "maximum": 5 },
                  "cost_pf_x1": { "type": "number", "exclusiveMinimum": 1.3 },
                  "cost_pf_x1_5": { "type": "number", "minimum": 1.25 },
                  "cost_pf_x2": { "type": "number", "minimum": 1.0 },
                  "net_r_x1_5": { "type": "number", "exclusiveMinimum": 0 }
                }
              },
              "validation": {
                "required": [
                  "validate_full",
                  "wfa",
                  "pbo_cscv",
                  "reality_check_spa",
                  "monte_carlo",
                  "robustness_suite",
                  "equity_audit",
                  "cost_stress",
                  "execution_audit",
                  "sidecar_completeness",
                  "casebook_status"
                ],
                "properties": {
                  "validate_full": { "const": "PASS" },
                  "wfa": { "const": "PASS" },
                  "pbo_cscv": { "const": "PASS" },
                  "reality_check_spa": { "const": "PASS" },
                  "monte_carlo": { "const": "PASS" },
                  "robustness_suite": { "const": "PASS" },
                  "equity_audit": { "const": "PASS" },
                  "cost_stress": { "const": "PASS" },
                  "execution_audit": { "const": "PASS" },
                  "sidecar_completeness": { "const": "PASS" },
                  "casebook_status": { "const": "PASS" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "state": { "const": "confirmed" } },
            "required": ["state"]
          },
          "then": { "properties": { "verdict": { "const": "confirm" } } }
        },
        {
          "if": {
            "properties": { "state": { "const": "portfolio-sleeve" } },
            "required": ["state"]
          },
          "then": {
            "required": ["portfolio_evidence"],
            "properties": {
              "verdict": { "const": "portfolio-candidate" },
              "portfolio_evidence": { "$ref": "#/$defs/portfolio_evidence" }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    {
      "title": "Legacy candidate result row (non-promotable)",
      "properties": {
        "record_type": { "const": "candidate_result" },
        "schema_version": { "const": 1 },
        "hypothesis_id": { "type": "string", "minLength": 1 },
        "state": {
          "enum": ["screened_m5", "screened_m15", "screened_h1", "probe", "parked"]
        },
        "parent_candidate": { "type": ["string", "null"] },
        "feature_family": { "type": "string" },
        "lane": { "type": "string" },
        "setup_type": { "type": "string" },
        "symbol": { "type": "string" },
        "timeframe": { "type": "string" },
        "window": { "type": "string" },
        "model": { "type": ["string", "integer"] },
        "source_provenance": { "type": "string" },
        "prereg_path": { "type": "string" },
        "readout_path": { "type": ["string", "null"] },
        "report_path": { "type": "string" },
        "exact_overrides": { "type": ["string", "null"] },
        "variant_tag": { "type": ["string", "null"] },
        "source_path": { "type": "string" },
        "source_hash": { "type": ["string", "null"] },
        "include_hashes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "compiled_artifact_hash": { "type": ["string", "null"] },
        "matched_control_run_id": { "type": ["string", "null"] },
        "run_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "metrics": { "type": "object", "additionalProperties": true },
        "validation": { "type": "object", "additionalProperties": true },
        "verdict": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "updated_at": { "type": "string" }
      },
      "required": [
        "record_type",
        "schema_version",
        "hypothesis_id",
        "state",
        "lane",
        "symbol",
        "timeframe",
        "window",
        "model",
        "source_path",
        "source_hash",
        "compiled_artifact_hash",
        "run_ids",
        "readout_path",
        "metrics",
        "validation",
