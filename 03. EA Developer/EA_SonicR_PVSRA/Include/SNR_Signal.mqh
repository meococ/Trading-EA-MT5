#ifndef SNR_SIGNAL_MQH
#define SNR_SIGNAL_MQH

#include "SNR_Types.mqh"
#include "SNR_Dragon.mqh"
#include "SNR_Trend.mqh"
#include "SNR_ClassicWave.mqh"
#include "SNR_PVSRA.mqh"
#include "SNR_SRLevels.mqh"
#include "SNR_Session.mqh"
#include "SNR_News.mqh"

bool SnrBuildClassicSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                           const SnrHandles &handles,const SnrClassicCfg &cfg,
                           const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 || cfg.lookback<32)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates rates[];
   double d_high[],d_mid[],d_low[],trend[],atr[];
   if(!SnrCopyClosedRates(symbol,tf,cfg.lookback,rates) ||
      !SnrCopyClosedBuffer(handles.dragon_high,cfg.lookback,d_high) ||
      !SnrCopyClosedBuffer(handles.dragon_mid,cfg.lookback,d_mid) ||
      !SnrCopyClosedBuffer(handles.dragon_low,cfg.lookback,d_low) ||
      !SnrCopyClosedBuffer(handles.trend,cfg.lookback,trend) ||
      !SnrCopyClosedBuffer(handles.atr,cfg.lookback,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(rates[0].time<=0 || rates[0].time>=availability_time ||
      !SnrFinite(rates[0].close) || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=rates[0].time;
   out.signal_high=rates[0].high;
   out.signal_low=rates[0].low;
   out.signal_close=rates[0].close;
   out.atr=atr[0];

   if(!SnrDragonReadClosed(d_high,d_mid,d_low,atr,cfg.dragon_slope_bars,
                           cfg.dragon_min_slope_atr,out.dragon))
     {
      out.data_fail=true;
      out.reject_reason="DRAGON_READ";
      return(false);
     }
   if(!SnrTrendReadClosed(trend,rates[0].close,cfg.trend_slope_bars,out.trend))
     {
      out.data_fail=true;
      out.reject_reason="TREND_READ";
      return(false);
     }
   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=rates[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   const int direction=out.trend.side;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="TREND";
      return(true);
     }
   const bool dragon_ok=((direction>0 && d_mid[0]>=d_mid[cfg.dragon_slope_bars]) ||
                         (direction<0 && d_mid[0]<=d_mid[cfg.dragon_slope_bars]));
   if(!dragon_ok)
     {
      out.reject_reason="DRAGON";
      return(true);
     }
   out.direction=direction;

   if(!SnrClassicWaveReadClosed(rates,d_high,d_low,direction,cfg,out.wave))
     {
      out.data_fail=true;
      out.reject_reason="WAVE_READ";
      return(false);
     }
   if(!out.wave.valid || !out.wave.break_or_reject)
     {
      out.reject_reason="WAVE";
      return(true);
     }

   SnrPvsraReadClosed(rates,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);

   if(!SnrSrReadClosed(rates[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildBandSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                        const SnrHandles &handles,const SnrClassicCfg &cfg,
                        const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 || cfg.lookback<32)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates rates[];
   double d_high[],d_mid[],d_low[],trend[],atr[];
   if(!SnrCopyClosedRates(symbol,tf,cfg.lookback,rates) ||
      !SnrCopyClosedBuffer(handles.dragon_high,cfg.lookback,d_high) ||
      !SnrCopyClosedBuffer(handles.dragon_mid,cfg.lookback,d_mid) ||
      !SnrCopyClosedBuffer(handles.dragon_low,cfg.lookback,d_low) ||
      !SnrCopyClosedBuffer(handles.trend,cfg.lookback,trend) ||
      !SnrCopyClosedBuffer(handles.atr,cfg.lookback,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(rates)<8 || rates[0].time<=0 || rates[0].time>=availability_time ||
      !SnrFinite(rates[0].close) || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=rates[0].time;
   out.signal_high=rates[0].high;
   out.signal_low=rates[0].low;
   out.signal_close=rates[0].close;
   out.atr=atr[0];

   if(!SnrDragonReadClosed(d_high,d_mid,d_low,atr,cfg.dragon_slope_bars,
                           cfg.dragon_min_slope_atr,out.dragon))
     {
      out.data_fail=true;
      out.reject_reason="DRAGON_READ";
      return(false);
     }
   if(!SnrTrendReadClosed(trend,rates[0].close,cfg.trend_slope_bars,out.trend))
     {
      out.data_fail=true;
      out.reject_reason="TREND_READ";
      return(false);
     }
   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=rates[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   const int direction=out.trend.side;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="TREND";
      return(true);
     }
   const bool dragon_ok=((direction>0 && d_mid[0]>=d_mid[cfg.dragon_slope_bars]) ||
                         (direction<0 && d_mid[0]<=d_mid[cfg.dragon_slope_bars]));
   if(!dragon_ok)
     {
      out.reject_reason="DRAGON";
      return(true);
     }
   out.direction=direction;

   const bool now_out=(direction>0
                       ? (rates[0].close>d_high[0] && rates[0].close>rates[0].open)
                       : (rates[0].close<d_low[0] && rates[0].close<rates[0].open));
   const bool was_in=(direction>0 ? rates[1].close<=d_high[1]
                                  : rates[1].close>=d_low[1]);
   if(!now_out || !was_in)
     {
      out.reject_reason="BAND";
      return(true);
     }

   double structure=rates[0].low;
   if(direction<0)
      structure=rates[0].high;
   const int scan=MathMin(8,ArraySize(rates)-1);
   for(int i=1;i<=scan;i++)
     {
      if(direction>0 && rates[i].low<structure)
         structure=rates[i].low;
      if(direction<0 && rates[i].high>structure)
         structure=rates[i].high;
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=structure;
   out.wave.impulse_extreme=(direction>0 ? rates[0].high : rates[0].low);
   out.wave.pullback_price=structure;

   SnrPvsraReadClosed(rates,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(rates[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrShouldRideExit(const string symbol,const ENUM_TIMEFRAMES tf,
                       const SnrHandles &handles,const int direction,
                       const datetime availability_time,bool &data_fail)
  {
   data_fail=false;
   if(direction==SNR_DIR_NONE || availability_time<=0 || !SnrHandlesReady(handles))
      return(false);
   MqlRates rates[];
   double d_high[],d_low[];
   if(!SnrCopyClosedRates(symbol,tf,8,rates) ||
      !SnrCopyClosedBuffer(handles.dragon_high,8,d_high) ||
      !SnrCopyClosedBuffer(handles.dragon_low,8,d_low))
     {
      data_fail=true;
      return(false);
     }
   if(rates[0].time<=0 || rates[0].time>=availability_time ||
      !SnrFinite(rates[0].close) || !SnrFinite(d_high[0]) || !SnrFinite(d_low[0]))
     {
      data_fail=true;
      return(false);
     }
   if(direction>0)
      return(rates[0].close<d_low[0]);
   return(rates[0].close>d_high[0]);
  }

bool SnrBuildPullSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                        const SnrHandles &handles,const SnrClassicCfg &cfg,
                        const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 || cfg.lookback<32)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates rates[];
   double d_high[],d_mid[],d_low[],trend[],atr[];
   if(!SnrCopyClosedRates(symbol,tf,cfg.lookback,rates) ||
      !SnrCopyClosedBuffer(handles.dragon_high,cfg.lookback,d_high) ||
      !SnrCopyClosedBuffer(handles.dragon_mid,cfg.lookback,d_mid) ||
      !SnrCopyClosedBuffer(handles.dragon_low,cfg.lookback,d_low) ||
      !SnrCopyClosedBuffer(handles.trend,cfg.lookback,trend) ||
      !SnrCopyClosedBuffer(handles.atr,cfg.lookback,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(rates)<4 || rates[0].time<=0 || rates[0].time>=availability_time ||
      !SnrFinite(rates[0].close) || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=rates[0].time;
   out.signal_high=rates[0].high;
   out.signal_low=rates[0].low;
   out.signal_close=rates[0].close;
   out.atr=atr[0];

   if(!SnrDragonReadClosed(d_high,d_mid,d_low,atr,cfg.dragon_slope_bars,
                           cfg.dragon_min_slope_atr,out.dragon))
     {
      out.data_fail=true;
      out.reject_reason="DRAGON_READ";
      return(false);
     }
   if(!SnrTrendReadClosed(trend,rates[0].close,cfg.trend_slope_bars,out.trend))
     {
      out.data_fail=true;
      out.reject_reason="TREND_READ";
      return(false);
     }
   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=rates[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   const int direction=out.trend.side;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="TREND";
      return(true);
     }
   const bool dragon_ok=((direction>0 && d_mid[0]>=d_mid[cfg.dragon_slope_bars]) ||
                         (direction<0 && d_mid[0]<=d_mid[cfg.dragon_slope_bars]));
   if(!dragon_ok)
     {
      out.reject_reason="DRAGON";
      return(true);
     }
   out.direction=direction;

   const double touch=MathMax(cfg.dragon_touch_atr,0.05)*atr[0];
   const bool tag_prior=(direction>0
                         ? (rates[1].low<=d_mid[0]+touch && rates[2].low>d_mid[0]+touch)
                         : (rates[1].high>=d_mid[0]-touch && rates[2].high<d_mid[0]-touch));
   const bool reclaim_now=(direction>0
                           ? (rates[0].close>d_mid[0] && rates[0].close>rates[0].open)
                           : (rates[0].close<d_mid[0] && rates[0].close<rates[0].open));
   const bool not_break=(direction>0 ? rates[0].close<=d_high[0]
                                    : rates[0].close>=d_low[0]);
   if(!tag_prior || !reclaim_now || !not_break)
     {
      out.reject_reason="PULL";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=true;
   out.wave.break_or_reject=true;
   out.wave.first_break=false;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? MathMin(rates[0].low,rates[1].low)
                                        : MathMax(rates[0].high,rates[1].high));
   out.wave.pullback_price=out.wave.structure_swing;
   out.wave.impulse_extreme=(direction>0 ? rates[0].high : rates[0].low);

   SnrPvsraReadClosed(rates,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(rates[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildRunBarSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 || cfg.lookback<32)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates rates[];
   double d_high[],d_mid[],d_low[],trend[],atr[];
   if(!SnrCopyClosedRates(symbol,tf,cfg.lookback,rates) ||
      !SnrCopyClosedBuffer(handles.dragon_high,cfg.lookback,d_high) ||
      !SnrCopyClosedBuffer(handles.dragon_mid,cfg.lookback,d_mid) ||
      !SnrCopyClosedBuffer(handles.dragon_low,cfg.lookback,d_low) ||
      !SnrCopyClosedBuffer(handles.trend,cfg.lookback,trend) ||
      !SnrCopyClosedBuffer(handles.atr,cfg.lookback,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(rates)<4 || rates[0].time<=0 || rates[0].time>=availability_time ||
      !SnrFinite(rates[0].close) || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=rates[0].time;
   out.signal_high=rates[0].high;
   out.signal_low=rates[0].low;
   out.signal_close=rates[0].close;
   out.atr=atr[0];

   if(!SnrDragonReadClosed(d_high,d_mid,d_low,atr,cfg.dragon_slope_bars,
                           cfg.dragon_min_slope_atr,out.dragon))
     {
      out.data_fail=true;
      out.reject_reason="DRAGON_READ";
      return(false);
     }
   if(!SnrTrendReadClosed(trend,rates[0].close,cfg.trend_slope_bars,out.trend))
     {
      out.data_fail=true;
      out.reject_reason="TREND_READ";
      return(false);
     }
   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=rates[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   const int direction=out.trend.side;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="TREND";
      return(true);
     }
   const bool dragon_ok=((direction>0 && d_mid[0]>=d_mid[cfg.dragon_slope_bars]) ||
                         (direction<0 && d_mid[0]<=d_mid[cfg.dragon_slope_bars]));
   if(!dragon_ok)
     {
      out.reject_reason="DRAGON";
      return(true);
     }
   out.direction=direction;

   if(ArraySize(d_high)<3 || ArraySize(d_mid)<3 || ArraySize(d_low)<3 ||
      !SnrFinite(d_high[1]) || !SnrFinite(d_mid[1]) || !SnrFinite(d_low[1]) ||
      !SnrFinite(atr[1]) || atr[1]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="RUNBAR_KISS_READ";
      return(false);
     }
   const double touch=MathMax(cfg.dragon_touch_atr,0.05)*atr[1];
   const double body=MathAbs(rates[0].close-rates[0].open);
   const bool impulse=(body>=0.30*atr[0]);
   const bool run_now=(direction>0
                       ? (rates[0].close>d_high[0] && rates[0].close>rates[0].open)
                       : (rates[0].close<d_low[0] && rates[0].close<rates[0].open));
   const bool kissed=(direction>0
                      ? (rates[1].high>=d_high[1]-touch &&
                         rates[1].low>=d_mid[1]-touch &&
                         rates[1].close<=d_high[1] &&
                         rates[1].close>=d_mid[1])
                      : (rates[1].low<=d_low[1]+touch &&
                         rates[1].high<=d_mid[1]+touch &&
                         rates[1].close>=d_low[1] &&
                         rates[1].close<=d_mid[1]));
   if(!impulse || !run_now || !kissed)
     {
      out.reject_reason="RUNBAR";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=true;
   out.wave.break_or_reject=true;
   out.wave.first_break=false;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=d_mid[0];
   out.wave.pullback_price=d_mid[0];
   out.wave.impulse_extreme=(direction>0 ? rates[0].high : rates[0].low);

   SnrPvsraReadClosed(rates,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(rates[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildM1BreakSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                           const SnrHandles &handles,const SnrClassicCfg &cfg,
                           const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 || cfg.lookback<32)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates m1[];
   MqlRates m15[];
   double d_high[],d_mid[],d_low[],trend[],atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,m1) ||
      !SnrCopyClosedRates(symbol,PERIOD_M15,32,m15) ||
      !SnrCopyClosedBuffer(handles.dragon_high,32,d_high) ||
      !SnrCopyClosedBuffer(handles.dragon_mid,32,d_mid) ||
      !SnrCopyClosedBuffer(handles.dragon_low,32,d_low) ||
      !SnrCopyClosedBuffer(handles.trend,32,trend) ||
      !SnrCopyClosedBuffer(handles.atr,32,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(m1)<3 || ArraySize(m15)<4 || m1[0].time<=0 ||
      m1[0].time>=availability_time || m15[0].time<=0 ||
      m15[0].time>=availability_time || !SnrFinite(m1[0].close) ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=m1[0].time;
   out.signal_high=m1[0].high;
   out.signal_low=m1[0].low;
   out.signal_close=m1[0].close;
   out.atr=atr[0];

   if(!SnrDragonReadClosed(d_high,d_mid,d_low,atr,cfg.dragon_slope_bars,
                           cfg.dragon_min_slope_atr,out.dragon))
     {
      out.data_fail=true;
      out.reject_reason="DRAGON_READ";
      return(false);
     }
   if(!SnrTrendReadClosed(trend,m15[0].close,cfg.trend_slope_bars,out.trend))
     {
      out.data_fail=true;
      out.reject_reason="TREND_READ";
      return(false);
     }
   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=m1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   const int direction=out.trend.side;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="TREND";
      return(true);
     }
   const bool dragon_ok=((direction>0 && d_mid[0]>=d_mid[cfg.dragon_slope_bars]) ||
                         (direction<0 && d_mid[0]<=d_mid[cfg.dragon_slope_bars]));
   if(!dragon_ok)
     {
      out.reject_reason="DRAGON";
      return(true);
     }
   out.direction=direction;

   const bool cross=(direction>0
                     ? (m1[0].close>d_high[0] && m1[1].close<=d_high[0] && m1[0].close>m1[0].open)
                     : (m1[0].close<d_low[0] && m1[1].close>=d_low[0] && m1[0].close<m1[0].open));
   if(!cross)
     {
      out.reject_reason="M1CROSS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=true;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=d_mid[0];
   out.wave.pullback_price=d_mid[0];
   out.wave.impulse_extreme=(direction>0 ? m1[0].high : m1[0].low);

   SnrPvsraReadClosed(m15,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(m1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildM5CrossSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                           const SnrHandles &handles,const SnrClassicCfg &cfg,
                           const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 || cfg.lookback<32)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates m5[];
   MqlRates m15[];
   double d_high[],d_mid[],d_low[],trend[],atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,m5) ||
      !SnrCopyClosedRates(symbol,PERIOD_M15,32,m15) ||
      !SnrCopyClosedBuffer(handles.dragon_high,32,d_high) ||
      !SnrCopyClosedBuffer(handles.dragon_mid,32,d_mid) ||
      !SnrCopyClosedBuffer(handles.dragon_low,32,d_low) ||
      !SnrCopyClosedBuffer(handles.trend,32,trend) ||
      !SnrCopyClosedBuffer(handles.atr,32,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(m5)<3 || ArraySize(m15)<4 || m5[0].time<=0 ||
      m5[0].time>=availability_time || m15[0].time<=0 ||
      m15[0].time>=availability_time || !SnrFinite(m5[0].close) ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=m5[0].time;
   out.signal_high=m5[0].high;
   out.signal_low=m5[0].low;
   out.signal_close=m5[0].close;
   out.atr=atr[0];

   if(!SnrDragonReadClosed(d_high,d_mid,d_low,atr,cfg.dragon_slope_bars,
                           cfg.dragon_min_slope_atr,out.dragon))
     {
      out.data_fail=true;
      out.reject_reason="DRAGON_READ";
      return(false);
     }
   if(!SnrTrendReadClosed(trend,m15[0].close,cfg.trend_slope_bars,out.trend))
     {
      out.data_fail=true;
      out.reject_reason="TREND_READ";
      return(false);
     }
   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=m5[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   const int direction=out.trend.side;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="TREND";
      return(true);
     }
   const bool dragon_ok=((direction>0 && d_mid[0]>=d_mid[cfg.dragon_slope_bars]) ||
                         (direction<0 && d_mid[0]<=d_mid[cfg.dragon_slope_bars]));
   if(!dragon_ok)
     {
      out.reject_reason="DRAGON";
      return(true);
     }
   out.direction=direction;

   const double body=MathAbs(m5[0].close-m5[0].open);
   const bool impulse=(body>=0.25*atr[0]);
   const bool cross=(direction>0
                     ? (m5[0].close>d_high[0] && m5[1].close<=d_high[0] && m5[0].close>m5[0].open)
                     : (m5[0].close<d_low[0] && m5[1].close>=d_low[0] && m5[0].close<m5[0].open));
   if(!impulse || !cross)
     {
      out.reject_reason="M5CROSS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=true;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=d_mid[0];
   out.wave.pullback_price=d_mid[0];
   out.wave.impulse_extreme=(direction>0 ? m5[0].high : m5[0].low);

   SnrPvsraReadClosed(m15,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(m5[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildM5FadeSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 || cfg.lookback<32)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates m5[];
   MqlRates m15[];
   double d_high[],d_mid[],d_low[],trend[],atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,m5) ||
      !SnrCopyClosedRates(symbol,PERIOD_M15,32,m15) ||
      !SnrCopyClosedBuffer(handles.dragon_high,32,d_high) ||
      !SnrCopyClosedBuffer(handles.dragon_mid,32,d_mid) ||
      !SnrCopyClosedBuffer(handles.dragon_low,32,d_low) ||
      !SnrCopyClosedBuffer(handles.trend,32,trend) ||
      !SnrCopyClosedBuffer(handles.atr,32,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(m5)<3 || ArraySize(m15)<4 || m5[0].time<=0 ||
      m5[0].time>=availability_time || m15[0].time<=0 ||
      m15[0].time>=availability_time || !SnrFinite(m5[0].close) ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=m5[0].time;
   out.signal_high=m5[0].high;
   out.signal_low=m5[0].low;
   out.signal_close=m5[0].close;
   out.atr=atr[0];

   if(!SnrDragonReadClosed(d_high,d_mid,d_low,atr,cfg.dragon_slope_bars,
                           cfg.dragon_min_slope_atr,out.dragon))
     {
      out.data_fail=true;
      out.reject_reason="DRAGON_READ";
      return(false);
     }
   if(!SnrTrendReadClosed(trend,m15[0].close,cfg.trend_slope_bars,out.trend))
     {
      out.data_fail=true;
      out.reject_reason="TREND_READ";
      return(false);
     }
   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=m5[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   const int direction=out.trend.side;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="TREND";
      return(true);
     }
   const bool dragon_ok=((direction>0 && d_mid[0]>=d_mid[cfg.dragon_slope_bars]) ||
                         (direction<0 && d_mid[0]<=d_mid[cfg.dragon_slope_bars]));
   if(!dragon_ok)
     {
      out.reject_reason="DRAGON";
      return(true);
     }
   out.direction=direction;

   const bool fade=(direction>0
                    ? (m5[0].low<=d_low[0] &&
                       (d_low[0]-m5[0].low)>=0.25*atr[0] &&
                       m5[0].close>d_low[0] &&
                       m5[0].close<d_high[0] &&
                       m5[0].close>m5[0].open)
                    : (m5[0].high>=d_high[0] &&
                       (m5[0].high-d_high[0])>=0.25*atr[0] &&
                       m5[0].close<d_high[0] &&
                       m5[0].close>d_low[0] &&
                       m5[0].close<m5[0].open));
   if(!fade)
     {
      out.reject_reason="M5FADE";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=true;
   out.wave.break_or_reject=true;
   out.wave.first_break=false;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? m5[0].low : m5[0].high);
   out.wave.pullback_price=d_mid[0];
   out.wave.impulse_extreme=(direction>0 ? m5[0].low : m5[0].high);

   SnrPvsraReadClosed(m15,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(m5[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildM15H4MidSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                            const SnrHandles &handles,const SnrClassicCfg &cfg,
                            const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 || cfg.lookback<32)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates m15[];
   MqlRates h4[];
   double d_high[],d_mid[],d_low[],trend[],atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,m15) ||
      !SnrCopyClosedRates(symbol,PERIOD_H4,16,h4) ||
      !SnrCopyClosedBuffer(handles.dragon_high,16,d_high) ||
      !SnrCopyClosedBuffer(handles.dragon_mid,16,d_mid) ||
      !SnrCopyClosedBuffer(handles.dragon_low,16,d_low) ||
      !SnrCopyClosedBuffer(handles.trend,16,trend) ||
      !SnrCopyClosedBuffer(handles.atr,16,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(m15)<3 || ArraySize(h4)<4 || m15[0].time<=0 ||
      m15[0].time>=availability_time || h4[0].time<=0 ||
      h4[0].time>=availability_time || !SnrFinite(m15[0].close) ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=m15[0].time;
   out.signal_high=m15[0].high;
   out.signal_low=m15[0].low;
   out.signal_close=m15[0].close;
   out.atr=atr[0];

   if(!SnrDragonReadClosed(d_high,d_mid,d_low,atr,cfg.dragon_slope_bars,
                           cfg.dragon_min_slope_atr,out.dragon))
     {
      out.data_fail=true;
      out.reject_reason="DRAGON_READ";
      return(false);
     }
   if(!SnrTrendReadClosed(trend,h4[0].close,cfg.trend_slope_bars,out.trend))
     {
      out.data_fail=true;
      out.reject_reason="TREND_READ";
      return(false);
     }
   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=m15[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   const int direction=out.trend.side;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="TREND";
      return(true);
     }
   const bool dragon_ok=((direction>0 && d_mid[0]>=d_mid[cfg.dragon_slope_bars]) ||
                         (direction<0 && d_mid[0]<=d_mid[cfg.dragon_slope_bars]));
   if(!dragon_ok)
     {
      out.reject_reason="DRAGON";
      return(true);
     }
   out.direction=direction;

   const double h4_body=MathAbs(h4[0].close-h4[0].open);
   const bool impulse=(h4_body>=0.20*atr[0] &&
                       (direction>0 ? h4[0].close>h4[0].open : h4[0].close<h4[0].open));
   const bool tag=(direction>0
                   ? (m15[0].low<=d_mid[0] && m15[0].close>=d_mid[0] &&
                      m15[0].close>m15[0].open &&
                      (m15[0].close-d_mid[0])<=0.35*atr[0])
                   : (m15[0].high>=d_mid[0] && m15[0].close<=d_mid[0] &&
                      m15[0].close<m15[0].open &&
                      (d_mid[0]-m15[0].close)<=0.35*atr[0]));
   if(!impulse || !tag)
     {
      out.reject_reason="H4MID";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=true;
   out.wave.break_or_reject=false;
   out.wave.first_break=false;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? d_low[0] : d_high[0]);
   out.wave.pullback_price=d_mid[0];
   out.wave.impulse_extreme=(direction>0 ? h4[0].high : h4[0].low);

   SnrPvsraReadClosed(h4,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(m15[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildM15ClimaxSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                             const SnrHandles &handles,const SnrClassicCfg &cfg,
                             const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 ||
      handles.h1_trend==INVALID_HANDLE || handles.h1_atr==INVALID_HANDLE)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates m15[];
   MqlRates h4[];
   double m15_atr[];
   double h4_trend[];
   if(!SnrCopyClosedRates(symbol,tf,16,m15) ||
      !SnrCopyClosedRates(symbol,PERIOD_H4,16,h4) ||
      !SnrCopyClosedBuffer(handles.atr,16,m15_atr) ||
      !SnrCopyClosedBuffer(handles.h1_trend,16,h4_trend))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(m15)<12 || ArraySize(h4)<4 || m15[0].time<=0 ||
      m15[0].time>=availability_time || h4[0].time<=0 ||
      h4[0].time>=availability_time || !SnrFinite(m15[0].close) ||
      !SnrFinite(m15_atr[0]) || m15_atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=m15[0].time;
   out.signal_high=m15[0].high;
   out.signal_low=m15[0].low;
   out.signal_close=m15[0].close;
   out.atr=m15_atr[0];

   if(!SnrTrendReadClosed(h4_trend,h4[0].close,cfg.trend_slope_bars,out.trend))
     {
      out.data_fail=true;
      out.reject_reason="TREND_READ";
      return(false);
     }
   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=m15[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   MqlDateTime london_clock;
   SnrGmtToLondon(signal_gmt,london_clock);
   if((cfg.use_ny_session && london_clock.hour>=cfg.ny_end_hour-1) ||
      (london_clock.day_of_week==5 && london_clock.hour>=cfg.friday_flatten_hour-1))
     {
      out.reject_reason="SESSION_TAIL";
      return(true);
     }

   const int direction=out.trend.side;
   if(direction==SNR_DIR_NONE || !SnrTrendAligned(out.trend,direction))
     {
      out.reject_reason="TREND";
      return(true);
     }
   out.direction=direction;

   double vol_avg=0.0;
   if(!SnrVolumeAveragePrior(m15,cfg.vol_avg_bars,vol_avg))
     {
      out.data_fail=true;
      out.reject_reason="VOL_AVG";
      return(false);
     }
   const int vol_class=SnrClassifyVolume((double)m15[0].tick_volume,vol_avg,
                                         cfg.vol_rising_mult,cfg.vol_climax_mult);
   const double body=MathAbs(m15[0].close-m15[0].open);
   const bool impulse=(body>=0.25*m15_atr[0]);
   const bool with_trend_color=(direction>0 ? m15[0].close>m15[0].open
                                            : m15[0].close<m15[0].open);
   if(vol_class!=SNR_PVSRA_CLIMAX || !impulse || !with_trend_color)
     {
      out.reject_reason="CLIMAX";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=false;
   out.wave.first_break=false;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? m15[0].low : m15[0].high);
   out.wave.pullback_price=m15[0].close;
   out.wave.impulse_extreme=(direction>0 ? m15[0].high : m15[0].low);

   SnrPvsraReadClosed(m15,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(m15[0].close,direction,m15_atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildM15H4RejoinSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                               const SnrHandles &handles,const SnrClassicCfg &cfg,
                               const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 ||
      handles.h1_trend==INVALID_HANDLE || handles.h1_atr==INVALID_HANDLE)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates m15[];
   MqlRates h4[];
   double m15_atr[];
   double h4_trend[];
   if(!SnrCopyClosedRates(symbol,tf,8,m15) ||
      !SnrCopyClosedRates(symbol,PERIOD_H4,16,h4) ||
      !SnrCopyClosedBuffer(handles.atr,8,m15_atr) ||
      !SnrCopyClosedBuffer(handles.h1_trend,16,h4_trend))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(m15)<3 || ArraySize(h4)<4 || m15[0].time<=0 ||
      m15[0].time>=availability_time || h4[0].time<=0 ||
      h4[0].time>=availability_time || !SnrFinite(m15[0].close) ||
      !SnrFinite(m15[1].close) || !SnrFinite(m15_atr[0]) || m15_atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=m15[0].time;
   out.signal_high=m15[0].high;
   out.signal_low=m15[0].low;
   out.signal_close=m15[0].close;
   out.atr=m15_atr[0];

   if(!SnrTrendReadClosed(h4_trend,h4[0].close,cfg.trend_slope_bars,out.trend))
     {
      out.data_fail=true;
      out.reject_reason="TREND_READ";
      return(false);
     }
   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=m15[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   MqlDateTime london_clock;
   SnrGmtToLondon(signal_gmt,london_clock);
   if((cfg.use_ny_session && london_clock.hour>=cfg.ny_end_hour-1) ||
      (london_clock.day_of_week==5 && london_clock.hour>=cfg.friday_flatten_hour-1))
     {
      out.reject_reason="SESSION_TAIL";
      return(true);
     }

   const int direction=out.trend.side;
   if(direction==SNR_DIR_NONE || !SnrTrendAligned(out.trend,direction))
     {
      out.reject_reason="TREND";
      return(true);
     }
   out.direction=direction;

   const double h4_ema=out.trend.ema;
   const bool was_wrong=(direction>0 ? m15[1].close<h4_ema : m15[1].close>h4_ema);
   const bool now_right=(direction>0 ? m15[0].close>h4_ema : m15[0].close<h4_ema);
   const bool with_trend_color=(direction>0 ? m15[0].close>m15[0].open
                                            : m15[0].close<m15[0].open);
   const double beyond=MathAbs(m15[0].close-h4_ema);
   if(!was_wrong || !now_right || !with_trend_color || beyond<0.10*m15_atr[0])
     {
      out.reject_reason="H4REJOIN";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=false;
   out.wave.first_break=false;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? MathMin(m15[0].low,m15[1].low)
                                         : MathMax(m15[0].high,m15[1].high));
   out.wave.pullback_price=h4_ema;
   out.wave.impulse_extreme=(direction>0 ? m15[0].high : m15[0].low);

   SnrPvsraReadClosed(m15,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(m15[0].close,direction,m15_atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildM15InsideBrkSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                                const SnrHandles &handles,const SnrClassicCfg &cfg,
                                const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 ||
      handles.h1_trend==INVALID_HANDLE || handles.h1_atr==INVALID_HANDLE)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates m15[];
   MqlRates h4[];
   double m15_atr[];
   double h4_trend[];
   if(!SnrCopyClosedRates(symbol,tf,8,m15) ||
      !SnrCopyClosedRates(symbol,PERIOD_H4,16,h4) ||
      !SnrCopyClosedBuffer(handles.atr,8,m15_atr) ||
      !SnrCopyClosedBuffer(handles.h1_trend,16,h4_trend))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(m15)<3 || ArraySize(h4)<4 || m15[0].time<=0 ||
      m15[0].time>=availability_time || h4[0].time<=0 ||
      h4[0].time>=availability_time || !SnrFinite(m15[0].close) ||
      !SnrFinite(m15[1].high) || !SnrFinite(m15[2].high) ||
      !SnrFinite(m15_atr[0]) || m15_atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=m15[0].time;
   out.signal_high=m15[0].high;
   out.signal_low=m15[0].low;
   out.signal_close=m15[0].close;
   out.atr=m15_atr[0];

   if(!SnrTrendReadClosed(h4_trend,h4[0].close,cfg.trend_slope_bars,out.trend))
     {
      out.data_fail=true;
      out.reject_reason="TREND_READ";
      return(false);
     }
   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=m15[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   MqlDateTime london_clock;
   SnrGmtToLondon(signal_gmt,london_clock);
   if((cfg.use_ny_session && london_clock.hour>=cfg.ny_end_hour-1) ||
      (london_clock.day_of_week==5 && london_clock.hour>=cfg.friday_flatten_hour-1))
     {
      out.reject_reason="SESSION_TAIL";
      return(true);
     }

   const int direction=out.trend.side;
   if(direction==SNR_DIR_NONE || !SnrTrendAligned(out.trend,direction))
     {
      out.reject_reason="TREND";
      return(true);
     }
   out.direction=direction;

   const bool inside_bar=(m15[1].high<m15[2].high && m15[1].low>m15[2].low);
   const bool with_trend_color=(direction>0 ? m15[0].close>m15[0].open
                                            : m15[0].close<m15[0].open);
   const bool broke=(direction>0 ? m15[0].close>m15[2].high
                                 : m15[0].close<m15[2].low);
   if(!inside_bar || !broke || !with_trend_color)
     {
      out.reject_reason="INSIDEBRK";
      return(true);
     }

   const double cluster_low=MathMin(m15[0].low,MathMin(m15[1].low,m15[2].low));
   const double cluster_high=MathMax(m15[0].high,MathMax(m15[1].high,m15[2].high));
   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=false;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? cluster_low : cluster_high);
   out.wave.pullback_price=(direction>0 ? m15[2].high : m15[2].low);
   out.wave.impulse_extreme=(direction>0 ? m15[0].high : m15[0].low);

   SnrPvsraReadClosed(m15,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(m15[0].close,direction,m15_atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

