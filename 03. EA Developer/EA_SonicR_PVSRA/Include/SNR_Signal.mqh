      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="AAL_RANGE";
      return(true);
     }

   MqlDateTime sig_ldn;
   SnrGmtToLondon(signal_gmt,sig_ldn);
   const int sig_key=sig_ldn.year*10000+sig_ldn.mon*100+sig_ldn.day;
   double t_open=0.0;
   double t_close=0.0;
   int t_n=0;
   double p_open=0.0;
   double p_close=0.0;
   int p_n=0;
   const int nh=ArraySize(h1);
   for(int i=nh-1;i>=1;i--)
     {
      if(h1[i].time<=0 || !SnrFinite(h1[i].open) || !SnrFinite(h1[i].close))
         continue;
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime ldn;
      SnrGmtToLondon(bar_gmt,ldn);
      const int key=ldn.year*10000+ldn.mon*100+ldn.day;
      if(key!=sig_key)
         continue;
      if(ldn.hour>=0 && ldn.hour<=3)
        {
         if(t_n==0)
            t_open=h1[i].open;
         t_close=h1[i].close;
         t_n++;
        }
      else if(ldn.hour>=4 && ldn.hour<=7)
        {
         if(p_n==0)
            p_open=h1[i].open;
         p_close=h1[i].close;
         p_n++;
        }
     }
   if(t_n<3 || p_n<3)
     {
      out.reject_reason="AAL_BARS";
      return(true);
     }

   const double t_net=t_close-t_open;
   const double p_net=p_close-p_open;
   if(!SnrFinite(t_net) || !SnrFinite(p_net) || t_net==0.0 || p_net==0.0 ||
      (t_net>0.0 && p_net<0.0) || (t_net<0.0 && p_net>0.0) ||
      MathAbs(t_net)<0.30*atr[0] || MathAbs(p_net)<0.30*atr[0])
     {
      out.reject_reason="AAL_ALIGN";
      return(true);
     }

   const int bias=(t_net>0.0 ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="AAL_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="AAL_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=t_net/atr[0];
   out.trend.slope=p_net/atr[0];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1D1erSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,48,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,8,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<16 || ArraySize(d1)<2 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(d1[0].close) || !SnrFinite(d1[0].open) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="D1ER_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="D1ER_RANGE";
      return(true);
     }
   if(d1[0].close==d1[0].open)
     {
      out.reject_reason="D1ER_D1COLOR";
      return(true);
     }

   const datetime d1_end=d1[0].time+86400;
   double path=0.0;
   int n_h=0;
   const int nh=ArraySize(h1);
   for(int i=1;i<nh;i++)
     {
      if(h1[i].time<=0 || h1[i].time<d1[0].time || h1[i].time>=d1_end ||
         !SnrFinite(h1[i].high) || !SnrFinite(h1[i].low) ||
         h1[i].high<=h1[i].low)
         continue;
      path+=(h1[i].high-h1[i].low);
      n_h++;
     }
   const double body=MathAbs(d1[0].close-d1[0].open);
   if(n_h<12 || !SnrFinite(path) || path<=0.0 || !SnrFinite(body) ||
      body<path*0.60)
     {
      out.reject_reason="D1ER_ER";
      return(true);
     }

   const int bias=(d1[0].close>d1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="D1ER_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="D1ER_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=body/path;
   out.trend.slope=(double)n_h;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1IwqSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,120,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,16,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<16 || ArraySize(d1)<15 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="IWQ_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="IWQ_RANGE";
      return(true);
     }

   datetime monday_cursor=signal_gmt;
   MqlDateTime this_mon;
   SnrGmtToLondon(monday_cursor,this_mon);
   int hops=0;
   while(this_mon.day_of_week!=1 && hops<8)
     {
      monday_cursor-=86400;
      SnrGmtToLondon(monday_cursor,this_mon);
      hops++;
     }
   if(this_mon.day_of_week!=1)
     {
      out.reject_reason="IWQ_MON";
      return(true);
     }
   const int mon_key=this_mon.year*10000+this_mon.mon*100+this_mon.day;
   MqlDateTime sig_ldn;
   SnrGmtToLondon(signal_gmt,sig_ldn);
   const int sig_key=sig_ldn.year*10000+sig_ldn.mon*100+sig_ldn.day;

   double wh=-1.0e100;
   double wl=1.0e100;
   int n_w=0;
   const int nh=ArraySize(h1);
   for(int i=0;i<nh;i++)
     {
      if(h1[i].time<=0 || !SnrFinite(h1[i].high) || !SnrFinite(h1[i].low) ||
         h1[i].high<=h1[i].low)
         continue;
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime ldn;
      SnrGmtToLondon(bar_gmt,ldn);
      const int key=ldn.year*10000+ldn.mon*100+ldn.day;
      if(key<mon_key || key>sig_key)
         continue;
      if(h1[i].high>wh)
         wh=h1[i].high;
      if(h1[i].low<wl)
         wl=h1[i].low;
      n_w++;
     }
   const double wr=wh-wl;
   if(n_w<6 || !SnrFinite(wr) || wr<=0.0)
     {
      out.reject_reason="IWQ_BOX";
      return(true);
     }

   double adr_sum=0.0;
   for(int i=1;i<=14;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) || d1[i].high<=d1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="IWQ_ADR";
         return(false);
        }
      adr_sum+=(d1[i].high-d1[i].low);
     }
   const double adr=adr_sum/14.0;
   if(!SnrFinite(adr) || adr<=0.0 || wr<0.80*adr)
     {
      out.reject_reason="IWQ_SIZE";
      return(true);
     }

   const double q=(h1[0].close-wl)/wr;
   int bias=SNR_DIR_NONE;
   if(q>=0.75)
      bias=SNR_DIR_LONG;
   else if(q<=0.25)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="IWQ_Q";
      return(true);
     }

   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="IWQ_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="IWQ_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=q;
   out.trend.slope=wr/adr;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1H4pbSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates h4[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_H4,8,h4) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(h4)<7 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h4[0].time<=0 || h4[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h4[0].close) || !SnrFinite(h4[0].open) ||
      !SnrFinite(h4[0].high) || !SnrFinite(h4[0].low) ||
      h1[0].high<=h1[0].low || h4[0].high<=h4[0].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="H4PB_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="H4PB_RANGE";
      return(true);
     }

   const double h4_range=h4[0].high-h4[0].low;
   const double h4_body=MathAbs(h4[0].close-h4[0].open);
   if(!SnrFinite(h4_range) || h4_range<=0.0 ||
      !SnrFinite(h4_body) || h4_body<0.70*h4_range)
     {
      out.reject_reason="H4PB_BODY";
      return(true);
     }

   double tr_sum=0.0;
   for(int i=1;i<=6;i++)
     {
      if(!SnrFinite(h4[i].high) || !SnrFinite(h4[i].low) || h4[i].high<=h4[i].low)
        {
         out.data_fail=true;
         out.reject_reason="H4PB_PRIOR";
         return(false);
        }
      tr_sum+=(h4[i].high-h4[i].low);
     }
   const double tr_mean=tr_sum/6.0;
   if(!SnrFinite(tr_mean) || tr_mean<=0.0 || h4_range<0.70*tr_mean)
     {
      out.reject_reason="H4PB_SIZE";
      return(true);
     }

   const int bias=(h4[0].close>h4[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int h1_dir=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(h1_dir==bias)
     {
      out.reject_reason="H4PB_DIP";
      return(true);
     }

   const int direction=bias;
   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="H4PB_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=h4_body/h4_range;
   out.trend.slope=h4_range/tr_mean;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1D1krSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,16,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(d1)<15 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 || d1[0].high<=d1[0].low ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(d1[0].close) || !SnrFinite(d1[0].high) ||
      !SnrFinite(d1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="D1KR_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="D1KR_RANGE";
      return(true);
     }

   double adr_sum=0.0;
   for(int i=1;i<=14;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) || d1[i].high<=d1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="D1KR_ADR";
         return(false);
        }
      adr_sum+=(d1[i].high-d1[i].low);
     }
   const double adr=adr_sum/14.0;
   const double y_range=d1[0].high-d1[0].low;
   if(!SnrFinite(adr) || adr<=0.0 || !SnrFinite(y_range) || y_range<0.50*adr)
     {
      out.reject_reason="D1KR_SIZE";
      return(true);
     }

   double prior_low=1.0e100;
   double prior_high=-1.0e100;
   for(int i=1;i<=9;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) || d1[i].high<=d1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="D1KR_LOOK";
         return(false);
        }
      if(d1[i].low<prior_low)
         prior_low=d1[i].low;
      if(d1[i].high>prior_high)
         prior_high=d1[i].high;
     }

   const double q=(d1[0].close-d1[0].low)/y_range;
   int bias=SNR_DIR_NONE;
   if(d1[0].low<=prior_low && q>=0.50)
      bias=SNR_DIR_LONG;
   else if(d1[0].high>=prior_high && q<=0.50)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="D1KR_REV";
      return(true);
     }

   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="D1KR_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="D1KR_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=q;
   out.trend.slope=y_range/adr;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1J4mSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates h4[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_H4,8,h4) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(h4)<7 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h4[0].time<=0 || h4[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h4[0].close) || !SnrFinite(h4[0].open) ||
      !SnrFinite(h4[0].high) || !SnrFinite(h4[0].low) ||
      h1[0].high<=h1[0].low || h4[0].high<=h4[0].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="J4M_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="J4M_RANGE";
      return(true);
     }

   const double h4_range=h4[0].high-h4[0].low;
   const double h4_body=MathAbs(h4[0].close-h4[0].open);
   if(!SnrFinite(h4_range) || h4_range<=0.0 ||
      !SnrFinite(h4_body) || h4_body<0.70*h4_range)
     {
      out.reject_reason="J4M_BODY";
      return(true);
     }

   double tr_sum=0.0;
   for(int i=1;i<=6;i++)
     {
      if(!SnrFinite(h4[i].high) || !SnrFinite(h4[i].low) || h4[i].high<=h4[i].low)
        {
         out.data_fail=true;
         out.reject_reason="J4M_PRIOR";
         return(false);
        }
      tr_sum+=(h4[i].high-h4[i].low);
     }
   const double tr_mean=tr_sum/6.0;
   if(!SnrFinite(tr_mean) || tr_mean<=0.0 || h4_range<0.70*tr_mean)
     {
      out.reject_reason="J4M_SIZE";
      return(true);
     }

   const int bias=(h4[0].close>h4[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="J4M_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="J4M_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=h4_body/h4_range;
   out.trend.slope=h4_range/tr_mean;
   out.trend.side=direction;

   if(SnrNewsUsdJpyHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

