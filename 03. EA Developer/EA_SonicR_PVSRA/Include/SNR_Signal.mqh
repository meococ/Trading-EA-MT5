   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="H4RA_RANGE";
      return(true);
     }

   const double h4_rng=h4[0].high-h4[0].low;
   if(!SnrFinite(h4_rng) || h4_rng<2.00*atr[0] || h4[0].close==h4[0].open)
     {
      out.reject_reason="H4RA_SIZE";
      return(true);
     }

   const int bias=(h4[0].close>h4[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
