     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=15)
     {
      out.reject_reason="FIXP_HOUR";
      return(true);
     }

   const double range=h1[0].high-h1[0].low;
   if(!SnrFinite(range) || range<atr[0])
     {
      out.reject_reason="FIXP_RANGE";
      return(true);
     }
   const double upper=h1[0].high-h1[0].close;
   const double lower=h1[0].close-h1[0].low;
   int direction=SNR_DIR_NONE;
   if(upper>=0.40*range && h1[0].close<h1[0].open)
      direction=SNR_DIR_SHORT;
   else if(lower>=0.40*range && h1[0].close>h1[0].open)
      direction=SNR_DIR_LONG;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="FIXP_WICK";
      return(true);
     }

   double box_h=h1[0].high;
   double box_l=h1[0].low;
   for(int i=1;i<=2;i++)
     {
      if(!SnrFinite(h1[i].high) || !SnrFinite(h1[i].low))
        {
         out.data_fail=true;
         out.reject_reason="FIXP_BOX";
         return(false);
        }
      if(h1[i].high>box_h)
         box_h=h1[i].high;
      if(h1[i].low<box_l)
         box_l=h1[i].low;
     }
   const double sl_dist=(direction>0 ? h1[0].close-box_l : box_h-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0] || box_h<=box_l)
     {
      out.reject_reason="FIXP_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=h1[0].close;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? box_l : box_h);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1OgapSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,36,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<8 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="OGAP_HOUR";
      return(true);
     }

   MqlDateTime sig_ldn;
   SnrGmtToLondon(signal_gmt,sig_ldn);
   const int sig_ymd=sig_ldn.year*10000+sig_ldn.mon*100+sig_ldn.day;
   double prev_close=0.0;
   bool prev_found=false;
   const int n=ArraySize(h1);
   for(int i=1;i<n;i++)
     {
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      const int bar_ymd=bar_ldn.year*10000+bar_ldn.mon*100+bar_ldn.day;
      if(bar_ymd<sig_ymd)
        {
         if(!SnrFinite(h1[i].close))
           {
            out.data_fail=true;
            out.reject_reason="OGAP_PREV";
            return(false);
           }
         prev_close=h1[i].close;
         prev_found=true;
         break;
        }
     }
   if(!prev_found || !SnrFinite(prev_close) || prev_close<=0.0)
     {
      out.reject_reason="OGAP_PREV";
      return(true);
     }

   const double gap=h1[0].open-prev_close;
   if(!SnrFinite(gap) || MathAbs(gap)<0.30*atr[0])
     {
      out.reject_reason="OGAP_SIZE";
      return(true);
     }
   int direction=SNR_DIR_NONE;
   if(gap>0.0 && h1[0].close<h1[0].open)
      direction=SNR_DIR_SHORT;
   else if(gap<0.0 && h1[0].close>h1[0].open)
      direction=SNR_DIR_LONG;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="OGAP_FILL";
      return(true);
     }

   double box_h=h1[0].high;
   double box_l=h1[0].low;
   for(int i=1;i<=2;i++)
     {
      if(!SnrFinite(h1[i].high) || !SnrFinite(h1[i].low))
        {
         out.data_fail=true;
         out.reject_reason="OGAP_BOX";
         return(false);
        }
      if(h1[i].high>box_h)
         box_h=h1[i].high;
      if(h1[i].low<box_l)
         box_l=h1[i].low;
     }
   const double sl_dist=(direction>0 ? h1[0].close-box_l : box_h-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0] || box_h<=box_l)
     {
      out.reject_reason="OGAP_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=prev_close;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? box_l : box_h);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1Nr7xSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,16,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<10 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[1].high) || !SnrFinite(h1[1].low) ||
      h1[1].high<=h1[1].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   const double nr_range=h1[1].high-h1[1].low;
   if(!SnrFinite(nr_range) || nr_range<=0.0)
     {
      out.reject_reason="NR7_RANGE";
      return(true);
     }
   for(int i=2;i<=7;i++)
     {
      if(!SnrFinite(h1[i].high) || !SnrFinite(h1[i].low) || h1[i].high<=h1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="NR7_BAR";
         return(false);
        }
      if((h1[i].high-h1[i].low)<=nr_range)
        {
         out.reject_reason="NR7_NOT";
         return(true);
        }
     }

   int direction=SNR_DIR_NONE;
   if(h1[0].close>h1[1].high)
      direction=SNR_DIR_LONG;
   else if(h1[0].close<h1[1].low)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="NR7_BREAK";
      return(true);
     }
   const bool with_color=(direction>0 ? h1[0].close>h1[0].open
                                      : h1[0].close<h1[0].open);
   if(!with_color)
     {
      out.reject_reason="NR7_COLOR";
      return(true);
     }

   double box_h=h1[0].high;
   double box_l=h1[0].low;
   for(int i=1;i<=7;i++)
     {
      if(h1[i].high>box_h)
         box_h=h1[i].high;
      if(h1[i].low<box_l)
         box_l=h1[i].low;
     }
   const double sl_dist=(direction>0 ? h1[0].close-box_l : box_h-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0] || box_h<=box_l)
     {
      out.reject_reason="NR7_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=h1[1].close;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? box_l : box_h);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1H4crSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates h4[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,6,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_H4,4,h4) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<3 || ArraySize(h4)<2 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h4[0].time<=0 || h4[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[1].close) ||
      !SnrFinite(h4[0].close) || !SnrFinite(h4[0].high) || !SnrFinite(h4[0].low) ||
      h4[0].high<=h4[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   const double h4_range=h4[0].high-h4[0].low;
   if(!SnrFinite(h4_range) || h4_range<0.50*atr[0])
     {
      out.reject_reason="H4CR_RANGE";
      return(true);
     }
   int direction=SNR_DIR_NONE;
   if(h1[0].close>h4[0].close && h1[1].close<=h4[0].close)
      direction=SNR_DIR_LONG;
   else if(h1[0].close<h4[0].close && h1[1].close>=h4[0].close)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="H4CR_RECROSS";
      return(true);
     }
   const bool with_color=(direction>0 ? h1[0].close>h1[0].open
                                      : h1[0].close<h1[0].open);
   if(!with_color)
     {
      out.reject_reason="H4CR_COLOR";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-h4[0].low
                                     : h4[0].high-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="H4CR_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=h4[0].close;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? h4[0].low : h4[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1B3fSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<5 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   double box_h=h1[1].high;
   double box_l=h1[1].low;
   for(int i=2;i<=3;i++)
     {
      if(!SnrFinite(h1[i].high) || !SnrFinite(h1[i].low))
        {
         out.data_fail=true;
         out.reject_reason="B3F_BAR";
         return(false);
        }
      if(h1[i].high>box_h)
         box_h=h1[i].high;
      if(h1[i].low<box_l)
         box_l=h1[i].low;
     }
   if(box_h<=box_l)
     {
      out.reject_reason="B3F_BOX";
      return(true);
     }

   int direction=SNR_DIR_NONE;
   if(h1[0].high>box_h && h1[0].close<box_h && h1[0].close<h1[0].open &&
      (h1[0].high-box_h)>=0.15*atr[0])
      direction=SNR_DIR_SHORT;
   else if(h1[0].low<box_l && h1[0].close>box_l && h1[0].close>h1[0].open &&
           (box_l-h1[0].low)>=0.15*atr[0])
      direction=SNR_DIR_LONG;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="B3F_FAIL";
      return(true);
     }

   double sl_box_h=box_h;
   double sl_box_l=box_l;
   if(h1[0].high>sl_box_h)
      sl_box_h=h1[0].high;
   if(h1[0].low<sl_box_l)
      sl_box_l=h1[0].low;
   const double sl_dist=(direction>0 ? h1[0].close-sl_box_l : sl_box_h-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="B3F_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=box_h;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsEurUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? sl_box_l : sl_box_h);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1LdrvSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<5 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[1].close) || !SnrFinite(h1[1].open) ||
      !SnrFinite(h1[2].close) || !SnrFinite(h1[2].open) ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   const datetime h1_gmt=h1[1].time-(server_now-gmt_now);
   const datetime h2_gmt=h1[2].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   MqlDateTime sig_ldn;
   MqlDateTime h1_ldn;
   MqlDateTime h2_ldn;
   SnrGmtToLondon(signal_gmt,sig_ldn);
   SnrGmtToLondon(h1_gmt,h1_ldn);
   SnrGmtToLondon(h2_gmt,h2_ldn);
   if(sig_ldn.hour!=10 || h1_ldn.hour!=9 || h2_ldn.hour!=8 ||
      sig_ldn.year!=h1_ldn.year || sig_ldn.mon!=h1_ldn.mon ||
      sig_ldn.day!=h1_ldn.day || h1_ldn.year!=h2_ldn.year ||
      h1_ldn.mon!=h2_ldn.mon || h1_ldn.day!=h2_ldn.day)
     {
      out.reject_reason="LDRV_HOUR";
      return(true);
     }

   const bool d8_up=(h1[2].close>h1[2].open);
   const bool d9_up=(h1[1].close>h1[1].open);
   if(d8_up!=d9_up)
     {
      out.reject_reason="LDRV_ALIGN";
      return(true);
     }
   const int direction=(d8_up ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const bool with_color=(direction>0 ? h1[0].close>h1[0].open
                                      : h1[0].close<h1[0].open);
   const bool beyond=(direction>0 ? h1[0].close>h1[1].close
                                  : h1[0].close<h1[1].close);
   if(!with_color || !beyond)
     {
      out.reject_reason="LDRV_CONT";
      return(true);
     }

   const double box_h=(h1[2].high>h1[1].high ? h1[2].high : h1[1].high);
   const double box_l=(h1[2].low<h1[1].low ? h1[2].low : h1[1].low);
   const double sl_dist=(direction>0 ? h1[0].close-box_l : box_h-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0] || box_h<=box_l)
     {
      out.reject_reason="LDRV_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=h1[1].close;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsGbpUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? box_l : box_h);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1M3Signal(const string symbol,const ENUM_TIMEFRAMES tf,
                        const SnrHandles &handles,const SnrClassicCfg &cfg,
                        const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<5 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   const bool c1=(h1[1].close>h1[1].open);
   const bool c2=(h1[2].close>h1[2].open);
   const bool c3=(h1[3].close>h1[3].open);
   if(c1!=c2 || c2!=c3)
     {
      out.reject_reason="M3_STREAK";
      return(true);
     }
   const int direction=(c1 ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const bool with_color=(direction>0 ? h1[0].close>h1[0].open
                                      : h1[0].close<h1[0].open);
   const bool beyond=(direction>0 ? h1[0].close>h1[1].close
                                  : h1[0].close<h1[1].close);
   if(!with_color || !beyond)
     {
      out.reject_reason="M3_CONT";
      return(true);
     }

   double box_h=h1[0].high;
   double box_l=h1[0].low;
   for(int i=1;i<=3;i++)
     {
      if(!SnrFinite(h1[i].high) || !SnrFinite(h1[i].low))
        {
         out.data_fail=true;
         out.reject_reason="M3_BAR";
         return(false);
        }
      if(h1[i].high>box_h)
         box_h=h1[i].high;
      if(h1[i].low<box_l)
         box_l=h1[i].low;
     }
   const double sl_dist=(direction>0 ? h1[0].close-box_l : box_h-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0] || box_h<=box_l)
     {
      out.reject_reason="M3_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=h1[1].close;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdJpyHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? box_l : box_h);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1D1cSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,6,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,4,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<3 || ArraySize(d1)<2 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 || d1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[1].close) ||
      !SnrFinite(d1[0].close) || !SnrFinite(d1[0].high) || !SnrFinite(d1[0].low) ||
      d1[0].high<=d1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   int direction=SNR_DIR_NONE;
   if(h1[0].close>d1[0].close && h1[1].close<=d1[0].close)
      direction=SNR_DIR_LONG;
   else if(h1[0].close<d1[0].close && h1[1].close>=d1[0].close)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="D1C_RECROSS";
      return(true);
     }
   const bool with_color=(direction>0 ? h1[0].close>h1[0].open
                                      : h1[0].close<h1[0].open);
   if(!with_color)
     {
      out.reject_reason="D1C_COLOR";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-d1[0].low
                                     : d1[0].high-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="D1C_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=d1[0].close;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsEurUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? d1[0].low : d1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1VexpSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,26,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,16,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<25 || ArraySize(d1)<14 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   double adr_sum=0.0;
   for(int i=0;i<14;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) || d1[i].high<=d1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="VEXP_ADR";
         return(false);
        }
      adr_sum+=(d1[i].high-d1[i].low);
     }
   const double adr=adr_sum/14.0;
   if(!SnrFinite(adr) || adr<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="VEXP_ADR";
      return(false);
     }

   double coil_h=h1[1].high;
   double coil_l=h1[1].low;
   for(int i=2;i<=24;i++)
     {
      if(!SnrFinite(h1[i].high) || !SnrFinite(h1[i].low))
        {
         out.data_fail=true;
         out.reject_reason="VEXP_BAR";
         return(false);
        }
      if(h1[i].high>coil_h)
         coil_h=h1[i].high;
      if(h1[i].low<coil_l)
         coil_l=h1[i].low;
     }
   const double coil=coil_h-coil_l;
   if(!SnrFinite(coil) || coil<=0.0 || coil>0.70*adr)
     {
      out.reject_reason="VEXP_COIL";
      return(true);
     }
   const double bar_range=h1[0].high-h1[0].low;
   if(!SnrFinite(bar_range) || bar_range<1.20*atr[0])
     {
      out.reject_reason="VEXP_BARR";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="VEXP_COLOR";
      return(true);
     }
   double box_h=coil_h;
   double box_l=coil_l;
   if(h1[0].high>box_h)
      box_h=h1[0].high;
   if(h1[0].low<box_l)
      box_l=h1[0].low;
   const double sl_dist=(direction>0 ? h1[0].close-box_l : box_h-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0] || box_h<=box_l)
     {
      out.reject_reason="VEXP_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=adr;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? box_l : box_h);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1SvwapSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                           const SnrHandles &handles,const SnrClassicCfg &cfg,
                           const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,16,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<8 || h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<cfg.london_start_hour+2)
     {
      out.reject_reason="SVWAP_EARLY";
      return(true);
     }

   MqlDateTime day_ldn;
   SnrGmtToLondon(signal_gmt,day_ldn);
   double pv=0.0;
   double vol=0.0;
   int contrib=0;
   const int n=ArraySize(h1);
   for(int i=0;i<n;i++)
     {
      if(!SnrFinite(h1[i].high) || !SnrFinite(h1[i].low) || !SnrFinite(h1[i].close) ||
         h1[i].high<=h1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="SVWAP_BAR";
         return(false);
        }
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      if(bar_ldn.year!=day_ldn.year || bar_ldn.mon!=day_ldn.mon || bar_ldn.day!=day_ldn.day)
         continue;
      if(bar_ldn.hour<cfg.london_start_hour)
         continue;
      if(bar_ldn.hour>day_ldn.hour)
         continue;
      const double typical=(h1[i].high+h1[i].low+h1[i].close)/3.0;
      const double tv=(double)h1[i].tick_volume;
      if(!SnrFinite(typical) || !SnrFinite(tv) || tv<=0.0)
         continue;
      pv+=typical*tv;
      vol+=tv;
      contrib++;
     }
   if(contrib<3 || !SnrFinite(pv) || !SnrFinite(vol) || vol<=0.0)
     {
      out.reject_reason="SVWAP_WARM";
      return(true);
     }
   const double vwap=pv/vol;
   if(!SnrFinite(vwap) || vwap<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="SVWAP_VWAP";
      return(false);
     }

   const double bar_range=h1[0].high-h1[0].low;
   if(!SnrFinite(bar_range) || bar_range<0.80*atr[0])
     {
      out.reject_reason="SVWAP_BARR";
      return(true);
     }
   const double dist=h1[0].close-vwap;
   int direction=SNR_DIR_NONE;
   if(dist>=1.20*atr[0] && h1[0].close>h1[0].open)
      direction=SNR_DIR_SHORT;
   else if(dist<=-1.20*atr[0] && h1[0].close<h1[0].open)
      direction=SNR_DIR_LONG;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="SVWAP_DIST";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-h1[0].low : h1[0].high-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="SVWAP_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=vwap;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? h1[0].low : h1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1VwpbSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,16,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<8 || h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<cfg.london_start_hour+2)
     {
      out.reject_reason="VWPB_EARLY";
      return(true);
     }

   MqlDateTime day_ldn;
   SnrGmtToLondon(signal_gmt,day_ldn);
   double sess_h[16],sess_l[16],sess_c[16],sess_o[16],sess_v[16];
   int sess_n=0;
   const int n=ArraySize(h1);
   for(int i=n-1;i>=0;i--)
     {
      if(!SnrFinite(h1[i].high) || !SnrFinite(h1[i].low) || !SnrFinite(h1[i].close) ||
         h1[i].high<=h1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="VWPB_BAR";
         return(false);
        }
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      if(bar_ldn.year!=day_ldn.year || bar_ldn.mon!=day_ldn.mon || bar_ldn.day!=day_ldn.day)
         continue;
      if(bar_ldn.hour<cfg.london_start_hour)
         continue;
      if(sess_n>=16)
         break;
      sess_h[sess_n]=h1[i].high;
      sess_l[sess_n]=h1[i].low;
      sess_c[sess_n]=h1[i].close;
      sess_o[sess_n]=h1[i].open;
      sess_v[sess_n]=(double)h1[i].tick_volume;
      sess_n++;
     }
   if(sess_n<4)
     {
      out.reject_reason="VWPB_WARM";
      return(true);
     }

   double pv=0.0;
   double vol=0.0;
   int last_dir=SNR_DIR_NONE;
   int last_si=-1;
   const double stretch=1.20*atr[0];
   for(int k=0;k<sess_n;k++)
     {
      if(!SnrFinite(sess_v[k]) || sess_v[k]<=0.0)
         continue;
      const double typical=(sess_h[k]+sess_l[k]+sess_c[k])/3.0;
      if(!SnrFinite(typical))
        {
         out.data_fail=true;
         out.reject_reason="VWPB_TYP";
         return(false);
        }
      pv+=typical*sess_v[k];
      vol+=sess_v[k];
      if(vol<=0.0)
         continue;
      const double vwap=pv/vol;
      if(k==sess_n-1)
         break;
      if(sess_c[k]-vwap>=stretch)
        {
         last_dir=SNR_DIR_LONG;
         last_si=k;
        }
      else if(vwap-sess_c[k]>=stretch)
        {
         last_dir=SNR_DIR_SHORT;
         last_si=k;
        }
     }
   if(last_dir==SNR_DIR_NONE || last_si<0 || !SnrFinite(pv) || !SnrFinite(vol) || vol<=0.0)
     {
      out.reject_reason="VWPB_STRETCH";
      return(true);
     }
   const double vwap=pv/vol;
   if(!SnrFinite(vwap) || vwap<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="VWPB_VWAP";
      return(false);
     }
   if(MathAbs(sess_c[sess_n-1]-vwap)>0.35*atr[0])
     {
      out.reject_reason="VWPB_DIST";
      return(true);
     }
   const int direction=last_dir;
   const bool color_ok=(direction>0 ? sess_c[sess_n-1]>sess_o[sess_n-1]
                                    : sess_c[sess_n-1]<sess_o[sess_n-1]);
   if(!color_ok)
     {
      out.reject_reason="VWPB_COLOR";
      return(true);
     }
   double box_h=sess_h[last_si];
   double box_l=sess_l[last_si];
   for(int k=last_si+1;k<sess_n;k++)
     {
      if(sess_h[k]>box_h)
         box_h=sess_h[k];
      if(sess_l[k]<box_l)
         box_l=sess_l[k];
     }
   const double sl_dist=(direction>0 ? sess_c[sess_n-1]-box_l : box_h-sess_c[sess_n-1]);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0] || box_h<=box_l)
     {
      out.reject_reason="VWPB_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=vwap;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? box_l : box_h);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1LnbrSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,16,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<8 || h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<cfg.ny_start_hour)
     {
      out.reject_reason="LNBR_EARLY";
      return(true);
     }

   MqlDateTime day_ldn;
   SnrGmtToLondon(signal_gmt,day_ldn);
   double or_high=-1.0e100;
   double or_low=1.0e100;
   int or_n=0;
   bool prior_break=false;
   const int n=ArraySize(h1);
   for(int i=n-1;i>=1;i--)
     {
      if(!SnrFinite(h1[i].high) || !SnrFinite(h1[i].low) || !SnrFinite(h1[i].close) ||
         h1[i].high<=h1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="LNBR_BAR";
         return(false);
        }
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      if(bar_ldn.year!=day_ldn.year || bar_ldn.mon!=day_ldn.mon || bar_ldn.day!=day_ldn.day)
         continue;
      if(bar_ldn.hour>=cfg.london_start_hour && bar_ldn.hour<cfg.ny_start_hour)
        {
         or_n++;
         if(h1[i].high>or_high)
            or_high=h1[i].high;
         if(h1[i].low<or_low)
            or_low=h1[i].low;
        }
      else if(bar_ldn.hour>=cfg.ny_start_hour && or_n>=4)
        {
         if(h1[i].close>or_high || h1[i].close<or_low)
            prior_break=true;
        }
     }
   if(or_n<4 || !SnrFinite(or_high) || !SnrFinite(or_low) || or_high<=or_low)
     {
      out.reject_reason="LNBR_OR";
      return(true);
     }
   if(prior_break)
     {
      out.reject_reason="LNBR_NOT_FIRST";
      return(true);
     }

   int direction=SNR_DIR_NONE;
   if(h1[0].close>or_high && h1[0].close>h1[0].open)
      direction=SNR_DIR_LONG;
   else if(h1[0].close<or_low && h1[0].close<h1[0].open)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="LNBR";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-or_low : or_high-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="LNBR_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=(or_high+or_low)/2.0;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? or_low : or_high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1YtdSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,16,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(d1)<15 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 || d1[0].high<=d1[0].low ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=cfg.london_start_hour)
     {
      out.reject_reason="YTD_HOUR";
      return(true);
     }

   double adr_sum=0.0;
   for(int i=1;i<=14;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) || d1[i].high<=d1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="YTD_ADR";
         return(false);
        }
      adr_sum+=(d1[i].high-d1[i].low);
     }
   const double adr=adr_sum/14.0;
   const double y_range=d1[0].high-d1[0].low;
   if(!SnrFinite(adr) || adr<=0.0 || !SnrFinite(y_range) || y_range<0.80*adr)
     {
      out.reject_reason="YTD_ADR";
      return(true);
     }
   const double q=(d1[0].close-d1[0].low)/y_range;
   int bias=SNR_DIR_NONE;
   if(q>=0.75)
      bias=SNR_DIR_LONG;
   else if(q<=0.25)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="YTD_Q";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="YTD_COLOR";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-d1[0].low : d1[0].high-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="YTD_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=q;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? d1[0].low : d1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1H4tdSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates h4[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_H4,16,h4) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(h4)<15 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h4[0].time<=0 || h4[0].high<=h4[0].low ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(h1[0].time-h4[0].time!=4*3600)
     {
      out.reject_reason="H4TD_FIRST";
      return(true);
     }

   double adr_sum=0.0;
   for(int i=1;i<=14;i++)
     {
      if(!SnrFinite(h4[i].high) || !SnrFinite(h4[i].low) || h4[i].high<=h4[i].low)
        {
         out.data_fail=true;
         out.reject_reason="H4TD_ADR";
         return(false);
        }
      adr_sum+=(h4[i].high-h4[i].low);
     }
   const double adr=adr_sum/14.0;
   const double r=h4[0].high-h4[0].low;
   if(!SnrFinite(adr) || adr<=0.0 || !SnrFinite(r) || r<0.80*adr)
     {
      out.reject_reason="H4TD_ADR";
      return(true);
     }
   const double q=(h4[0].close-h4[0].low)/r;
   int bias=SNR_DIR_NONE;
   if(q>=0.75)
      bias=SNR_DIR_LONG;
   else if(q<=0.25)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="H4TD_Q";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="H4TD_COLOR";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-h4[0].low : h4[0].high-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="H4TD_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=q;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? h4[0].low : h4[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1LnyhSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,16,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<8 || h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=cfg.ny_start_hour-1)
     {
      out.reject_reason="LNYH_HOUR";
      return(true);
     }

   MqlDateTime day_ldn;
   SnrGmtToLondon(signal_gmt,day_ldn);
   double box_h=-1.0e100;
   double box_l=1.0e100;
   int box_n=0;
   const int n=ArraySize(h1);
   for(int i=n-1;i>=0;i--)
     {
      if(!SnrFinite(h1[i].high) || !SnrFinite(h1[i].low) || !SnrFinite(h1[i].close) ||
         h1[i].high<=h1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="LNYH_BAR";
         return(false);
        }
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      if(bar_ldn.year!=day_ldn.year || bar_ldn.mon!=day_ldn.mon || bar_ldn.day!=day_ldn.day)
         continue;
      if(bar_ldn.hour<cfg.london_start_hour || bar_ldn.hour>=cfg.ny_start_hour)
         continue;
      box_n++;
      if(h1[i].high>box_h)
         box_h=h1[i].high;
      if(h1[i].low<box_l)
         box_l=h1[i].low;
     }
   if(box_n<4 || !SnrFinite(box_h) || !SnrFinite(box_l) || box_h<=box_l)
     {
      out.reject_reason="LNYH_BOX";
      return(true);
     }
   const double rng=box_h-box_l;
   const double q=(h1[0].close-box_l)/rng;
   int bias=SNR_DIR_NONE;
   if(q>=0.75)
      bias=SNR_DIR_LONG;
   else if(q<=0.25)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="LNYH_Q";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="LNYH_COLOR";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-box_l : box_h-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="LNYH_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=q;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? box_l : box_h);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1YtdEurSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                            const SnrHandles &handles,const SnrClassicCfg &cfg,
                            const datetime availability_time,SnrSignalDecision &out)
  {
   if(!SnrBuildH1YtdSignal(symbol,tf,handles,cfg,availability_time,out))
      return(false);
   if(!out.fired || out.decision_time<=0)
      return(true);
   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=out.decision_time-(server_now-gmt_now);
   if(SnrNewsCcyHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC,"EUR"))
     {
      out.fired=false;
      out.direction=SNR_DIR_NONE;
      out.reject_reason="NEWS";
     }
   return(true);
  }

