   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1H8hvSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedBuffer(handles.atr,24,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(atr)<21 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="H8HV_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   const double body0=MathAbs(h1[0].close-h1[0].open);
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open ||
      !SnrFinite(body0) || body0<0.50*rng0)
     {
      out.reject_reason="H8HV_RANGE";
      return(true);
     }

   double atr_sum=0.0;
   for(int i=1;i<=20;i++)
     {
      if(!SnrFinite(atr[i]) || atr[i]<=0.0)
        {
         out.data_fail=true;
         out.reject_reason="H8HV_ATR";
         return(false);
        }
      atr_sum+=atr[i];
     }
   const double atr_mean=atr_sum/20.0;
   if(!SnrFinite(atr_mean) || atr_mean<=0.0 || atr[0]<1.20*atr_mean)
     {
      out.reject_reason="H8HV_REGIME";
      return(true);
     }

   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="H8HV_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=body0/rng0;
   out.trend.slope=atr[0]/atr_mean;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildM15NymSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates m15[];
   if(!SnrCopyClosedRates(symbol,tf,12,m15))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(m15)<10 ||
      m15[0].time<=0 || m15[0].time>=availability_time ||
      !SnrFinite(m15[0].close) || !SnrFinite(m15[0].open) ||
      !SnrFinite(m15[0].high) || !SnrFinite(m15[0].low) ||
      m15[0].high<=m15[0].low)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=m15[0].time;
   out.signal_high=m15[0].high;
   out.signal_low=m15[0].low;
   out.signal_close=m15[0].close;

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=m15[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<12 || out.session.london_hour>15)
     {
      out.reject_reason="NYM_HOUR";
      return(true);
     }

   double tr_sum=0.0;
   for(int i=1;i<=8;i++)
     {
      if(!SnrFinite(m15[i].high) || !SnrFinite(m15[i].low) || m15[i].high<=m15[i].low)
        {
         out.data_fail=true;
         out.reject_reason="NYM_PRIOR";
         return(false);
        }
      tr_sum+=(m15[i].high-m15[i].low);
     }
   const double tr_mean=tr_sum/8.0;
   const double rng0=m15[0].high-m15[0].low;
   const double body=MathAbs(m15[0].close-m15[0].open);
   if(!SnrFinite(tr_mean) || tr_mean<=0.0 || !SnrFinite(rng0) || rng0<=0.0 ||
      !SnrFinite(body) || m15[0].close==m15[0].open ||
      body<0.70*rng0 || rng0<0.70*tr_mean)
     {
      out.reject_reason="NYM_BODY";
      return(true);
     }
   out.atr=tr_mean;

   const int direction=(m15[0].close>m15[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const double sl_px=(direction>0 ? m15[0].low : m15[0].high);
   const double sl_dist=(direction>0 ? m15[0].close-sl_px : sl_px-m15[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*tr_mean)
     {
      out.reject_reason="NYM_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=body/rng0;
   out.trend.slope=rng0/tr_mean;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=m15[0].close;
   out.wave.impulse_extreme=(direction>0 ? m15[0].high : m15[0].low);

   SnrPvsraReadClosed(m15,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(m15[0].close,direction,tr_mean,cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1H8atSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,12,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<9 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="H8AT_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="H8AT_RANGE";
      return(true);
     }

   double env_high=h1[1].high;
   double env_low=h1[1].low;
   for(int i=1;i<=8;i++)
     {
      if(h1[i].time<=0 || h1[i].time>=availability_time ||
         !SnrFinite(h1[i].high) || !SnrFinite(h1[i].low) ||
         !SnrFinite(h1[i].open) || !SnrFinite(h1[i].close) ||
         h1[i].high<=h1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="H8AT_PRIOR";
         return(false);
        }
      if(h1[i].high>env_high)
         env_high=h1[i].high;
      if(h1[i].low<env_low)
         env_low=h1[i].low;
     }
   const double env_open=h1[8].open;
   const double env_close=h1[1].close;
   const double env_range=env_high-env_low;
   const double env_body=MathAbs(env_close-env_open);
   if(!SnrFinite(env_range) || env_range<=0.0 || !SnrFinite(env_body) ||
      env_close==env_open || env_body<0.70*env_range ||
      env_body<1.00*atr[0])
     {
      out.reject_reason="H8AT_BODY";
      return(true);
     }
   const int bias=(env_close>env_open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="H8AT_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="H8AT_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=env_body/env_range;
   out.trend.slope=env_body/atr[0];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1Mm50Signal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,10,h1) ||
      !SnrCopyClosedBuffer(handles.atr,10,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<8 || ArraySize(atr)<8 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   const double go_range=h1[0].high-h1[0].low;
   if(!SnrFinite(go_range) || go_range<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="MM50_GO";
      return(true);
     }

   int impulse_i=-1;
   int direction=SNR_DIR_NONE;
   double imp_high=0.0;
   double imp_low=0.0;
   for(int k=2;k<=6;k++)
     {
      if(h1[k].time<=0 || h1[k].time>=availability_time ||
         !SnrFinite(h1[k].high) || !SnrFinite(h1[k].low) ||
         !SnrFinite(h1[k].open) || !SnrFinite(h1[k].close) ||
         h1[k].high<=h1[k].low || !SnrFinite(atr[k]) || atr[k]<=0.0)
        {
         out.data_fail=true;
         out.reject_reason="MM50_PRIOR";
         return(false);
        }
      const double rng=h1[k].high-h1[k].low;
      const double body=MathAbs(h1[k].close-h1[k].open);
      if(h1[k].close==h1[k].open || body<1.00*atr[k] || body<0.50*rng)
         continue;
      const int bias=(h1[k].close>h1[k].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
      bool pulled=false;
      bool structure_ok=true;
      for(int j=1;j<k;j++)
        {
         if(h1[j].time<=0 || h1[j].time>=availability_time ||
            !SnrFinite(h1[j].high) || !SnrFinite(h1[j].low) ||
            !SnrFinite(h1[j].close) || h1[j].high<=h1[j].low)
           {
            out.data_fail=true;
            out.reject_reason="MM50_PB";
            return(false);
           }
         if(bias>0)
           {
            if(h1[j].close<h1[k].low || h1[j].close>h1[k].high)
              {
               structure_ok=false;
               break;
              }
            if(h1[j].low<=h1[k].high-0.35*rng)
               pulled=true;
           }
         else
           {
            if(h1[j].close>h1[k].high || h1[j].close<h1[k].low)
              {
               structure_ok=false;
               break;
              }
            if(h1[j].high>=h1[k].low+0.35*rng)
               pulled=true;
           }
        }
      if(!structure_ok || !pulled)
         continue;
      impulse_i=k;
      direction=bias;
      imp_high=h1[k].high;
      imp_low=h1[k].low;
      break;
     }
   if(impulse_i<2 || direction==SNR_DIR_NONE)
     {
      out.reject_reason="MM50_IMPULSE";
      return(true);
     }

   const int go_dir=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const bool beyond=(direction>0 ? h1[0].close>imp_high : h1[0].close<imp_low);
   if(go_dir!=direction || !beyond)
     {
      out.reject_reason="MM50_GO";
      return(true);
     }

   const double sl_px=(direction>0 ? imp_low : imp_high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="MM50_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=(imp_high>imp_low
                  ? MathAbs((direction>0 ? imp_high-h1[1].low : h1[1].high-imp_low)/(imp_high-imp_low))
                  : 0.0);
   out.trend.slope=MathAbs(h1[impulse_i].close-h1[impulse_i].open)/atr[impulse_i];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? imp_high : imp_low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildM15L30bSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                           const SnrHandles &handles,const SnrClassicCfg &cfg,
                           const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates m15[];
   if(!SnrCopyClosedRates(symbol,tf,48,m15))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(m15)<16 ||
      m15[0].time<=0 || m15[0].time>=availability_time ||
      !SnrFinite(m15[0].close) || !SnrFinite(m15[0].open) ||
      !SnrFinite(m15[0].high) || !SnrFinite(m15[0].low) ||
      m15[0].high<=m15[0].low)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=m15[0].time;
   out.signal_high=m15[0].high;
   out.signal_low=m15[0].low;
   out.signal_close=m15[0].close;

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=m15[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   MqlDateTime london_clock;
   SnrGmtToLondon(signal_gmt,london_clock);
   if(london_clock.hour<8 || london_clock.hour>9)
     {
      out.reject_reason="L30B_HOUR";
      return(true);
     }
   if(london_clock.hour==8 && london_clock.min<30)
     {
      out.reject_reason="OR_WAIT";
      return(true);
     }

   double tr_sum=0.0;
   for(int i=1;i<=8;i++)
     {
      if(!SnrFinite(m15[i].high) || !SnrFinite(m15[i].low) || m15[i].high<=m15[i].low)
        {
         out.data_fail=true;
         out.reject_reason="L30B_PRIOR";
         return(false);
        }
      tr_sum+=(m15[i].high-m15[i].low);
     }
   const double tr_mean=tr_sum/8.0;
   if(!SnrFinite(tr_mean) || tr_mean<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="L30B_TR";
      return(false);
     }
   out.atr=tr_mean;

   int or_count=0;
   double or_high=-1.0e100;
   double or_low=1.0e100;
   const int n=ArraySize(m15);
   for(int i=1;i<n;i++)
     {
      if(m15[i].time<=0 || m15[i].time>=availability_time ||
         !SnrFinite(m15[i].high) || !SnrFinite(m15[i].low) ||
         m15[i].high<=m15[i].low)
         continue;
      MqlDateTime bar_london;
      const datetime bar_gmt=m15[i].time-(server_now-gmt_now);
      SnrGmtToLondon(bar_gmt,bar_london);
      if(bar_london.year!=london_clock.year || bar_london.mon!=london_clock.mon ||
         bar_london.day!=london_clock.day)
         continue;
      if(bar_london.hour!=8 || (bar_london.min!=0 && bar_london.min!=15))
         continue;
      or_count++;
      if(m15[i].high>or_high)
         or_high=m15[i].high;
      if(m15[i].low<or_low)
         or_low=m15[i].low;
     }
   if(or_count<2 || !SnrFinite(or_high) || !SnrFinite(or_low) || or_high<=or_low)
     {
      out.reject_reason="OR_INCOMPLETE";
      return(true);
     }
   const double or_range=or_high-or_low;
   if(!SnrFinite(or_range) || or_range<0.40*tr_mean)
     {
      out.reject_reason="OR_SMALL";
      return(true);
     }

   const bool first_up=(m15[0].close>or_high && m15[1].close<=or_high &&
                        m15[0].close>m15[0].open);
   const bool first_dn=(m15[0].close<or_low && m15[1].close>=or_low &&
                        m15[0].close<m15[0].open);
   if(!first_up && !first_dn)
     {
      out.reject_reason="L30B";
      return(true);
     }
   const int direction=(first_up ? SNR_DIR_LONG : SNR_DIR_SHORT);

   const double sl_px=(direction>0 ? or_low : or_high);
   const double sl_dist=(direction>0 ? m15[0].close-sl_px : sl_px-m15[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*tr_mean)
     {
      out.reject_reason="L30B_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=or_range/tr_mean;
   out.trend.slope=sl_dist/tr_mean;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=m15[0].close;
   out.wave.impulse_extreme=(direction>0 ? m15[0].high : m15[0].low);

   SnrPvsraReadClosed(m15,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(m15[0].close,direction,tr_mean,cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1L8goSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 ||
      handles.h1_trend==INVALID_HANDLE)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates h4[];
   double atr[];
   double h4_trend[];
   if(!SnrCopyClosedRates(symbol,tf,6,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_H4,6,h4) ||
      !SnrCopyClosedBuffer(handles.atr,6,atr) ||
      !SnrCopyClosedBuffer(handles.h1_trend,6,h4_trend))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<3 || ArraySize(h4)<2 || ArraySize(atr)<2 ||
      ArraySize(h4_trend)<2 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h1[1].time<=0 || h1[1].time>=availability_time ||
      h4[0].time<=0 || h4[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h1[1].close) || !SnrFinite(h1[1].high) ||
      !SnrFinite(h1[1].low) || !SnrFinite(h4[0].close) ||
      h1[0].high<=h1[0].low || h1[1].high<=h1[1].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="L8GO_HOUR";
      return(true);
     }

   if(!SnrTrendReadClosed(h4_trend,h4[0].close,cfg.trend_slope_bars,out.trend))
     {
      out.data_fail=true;
      out.reject_reason="TREND_READ";
      return(false);
     }
   const int direction=out.trend.side;
   if(direction==SNR_DIR_NONE || !SnrTrendAligned(out.trend,direction))
     {
      out.reject_reason="TREND";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="L8GO_RANGE";
      return(true);
     }

   const bool go=(direction>0
                  ? (h1[0].close>h1[1].high && h1[0].close>h1[0].open)
                  : (h1[0].close<h1[1].low && h1[0].close<h1[0].open));
   if(!go)
     {
      out.reject_reason="L8GO";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[1].low : h1[1].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="L8GO_SL";
      return(true);
     }
   out.direction=direction;

   if(SnrNewsEurUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[1].close;
   out.wave.impulse_extreme=(direction>0 ? h1[1].high : h1[1].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1H4xbSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates h4[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,4,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_H4,4,h4) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(h4)<1 || ArraySize(atr)<1 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h4[0].time<=0 || h4[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h4[0].close) || !SnrFinite(h4[0].open) ||
      !SnrFinite(h4[0].high) || !SnrFinite(h4[0].low) ||
      h1[0].high<=h1[0].low || h4[0].high<=h4[0].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="H4XB_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="H4XB_RANGE";
      return(true);
     }

   const double h4_range=h4[0].high-h4[0].low;
   if(!SnrFinite(h4_range) || h4_range<0.80*atr[0] || h4[0].close==h4[0].open)
     {
      out.reject_reason="H4XB_BOX";
      return(true);
     }

   const int bias=(h4[0].close>h4[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="H4XB_COLOR";
      return(true);
     }
   const bool beyond=(direction>0 ? h1[0].close>h4[0].high
                                  : h1[0].close<h4[0].low);
   if(!beyond)
     {
      out.reject_reason="H4XB";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="H4XB_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=h4_range/atr[0];
   out.trend.slope=(direction>0 ? h1[0].close-h4[0].high : h4[0].low-h1[0].close)/atr[0];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1L1goSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,6,h1) ||
      !SnrCopyClosedBuffer(handles.atr,6,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<3 || ArraySize(atr)<2 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h1[1].time<=0 || h1[1].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h1[1].close) || !SnrFinite(h1[1].open) ||
      !SnrFinite(h1[1].high) || !SnrFinite(h1[1].low) ||
      h1[0].high<=h1[0].low || h1[1].high<=h1[1].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0 || !SnrFinite(atr[1]) || atr[1]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<8 || out.session.london_hour>16)
     {
      out.reject_reason="L1GO_HOUR";
      return(true);
     }

   const double prior_range=h1[1].high-h1[1].low;
   const double prior_body=MathAbs(h1[1].close-h1[1].open);
   if(!SnrFinite(prior_range) || prior_range<=0.0 ||
      h1[1].close==h1[1].open || prior_body<0.70*prior_range ||
      prior_body<1.00*atr[1])
     {
      out.reject_reason="L1GO_BODY";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="L1GO_RANGE";
      return(true);
     }

   const int bias=(h1[1].close>h1[1].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="L1GO_COLOR";
      return(true);
     }
   const bool go=(direction>0 ? h1[0].close>h1[1].high
                              : h1[0].close<h1[1].low);
   if(!go)
     {
      out.reject_reason="L1GO";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[1].low : h1[1].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="L1GO_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=prior_body/prior_range;
   out.trend.slope=prior_body/atr[1];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[1].close;
   out.wave.impulse_extreme=(direction>0 ? h1[1].high : h1[1].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

