                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1PseSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<3 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h1[1].high) || !SnrFinite(h1[1].low) ||
      h1[0].high<=h1[0].low || h1[1].high<=h1[1].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<cfg.london_start_hour || out.session.london_hour>11)
     {
      out.reject_reason="PSE_HOUR";
      return(true);
     }

   const double pause_rng=h1[1].high-h1[1].low;
   const double exp_rng=h1[0].high-h1[0].low;
   if(!SnrFinite(pause_rng) || pause_rng>=0.40*atr[0])
     {
      out.reject_reason="PSE_PAUSE";
      return(true);
     }
   if(!SnrFinite(exp_rng) || exp_rng<1.0*atr[0])
     {
      out.reject_reason="PSE_EXP";
      return(true);
     }
   const double q=(h1[0].close-h1[0].low)/exp_rng;
   int bias=SNR_DIR_NONE;
   if(q>=0.70)
      bias=SNR_DIR_LONG;
   else if(q<=0.30)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="PSE_Q";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="PSE_COLOR";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-h1[0].low : h1[0].high-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="PSE_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=q;
   out.trend.slope=pause_rng/atr[0];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? h1[0].low : h1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1BboSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,24,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<21 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h1[20].close) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<cfg.london_start_hour || out.session.london_hour>11)
     {
      out.reject_reason="BBO_HOUR";
      return(true);
     }

   double mean0=0.0;
   double mean1=0.0;
   for(int k=0;k<20;k++)
     {
      if(!SnrFinite(h1[k].close) || !SnrFinite(h1[k+1].close))
        {
         out.data_fail=true;
         out.reject_reason="BBO_CLOSE";
         return(false);
        }
      mean0+=h1[k].close;
      mean1+=h1[k+1].close;
     }
   mean0/=20.0;
   mean1/=20.0;
   double sumsq0=0.0;
   double sumsq1=0.0;
   for(int k=0;k<20;k++)
     {
      const double d0=h1[k].close-mean0;
      const double d1=h1[k+1].close-mean1;
      sumsq0+=d0*d0;
      sumsq1+=d1*d1;
     }
   const double sd0=MathSqrt(sumsq0/19.0);
   const double sd1=MathSqrt(sumsq1/19.0);
   if(!SnrFinite(sd0) || !SnrFinite(sd1) || sd0<=0.0 || sd1<=0.0)
     {
      out.reject_reason="BBO_SD";
      return(true);
     }
   const double up0=mean0+2.0*sd0;
   const double lo0=mean0-2.0*sd0;
   const double up1=mean1+2.0*sd1;
   const double lo1=mean1-2.0*sd1;
   const bool inside1=(h1[1].close<=up1 && h1[1].close>=lo1);
   if(!inside1)
     {
      out.reject_reason="BBO_FIRST";
      return(true);
     }

   int bias=SNR_DIR_NONE;
   if(h1[0].close>up0)
      bias=SNR_DIR_LONG;
   else if(h1[0].close<lo0)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="BBO_OUT";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="BBO_COLOR";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-h1[0].low : h1[0].high-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="BBO_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=(h1[0].close-mean0)/sd0;
   out.trend.slope=sd0;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? h1[0].low : h1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1LrsSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,24,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<20 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h1[19].close) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<cfg.london_start_hour || out.session.london_hour>11)
     {
      out.reject_reason="LRS_HOUR";
      return(true);
     }

   double sumx=0.0;
   double sumy=0.0;
   double sumxy=0.0;
   double sumx2=0.0;
   for(int i=0;i<20;i++)
     {
      if(!SnrFinite(h1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="LRS_CLOSE";
         return(false);
        }
      const double x=19.0-(double)i;
      const double y=h1[i].close;
      sumx+=x;
      sumy+=y;
      sumxy+=x*y;
      sumx2+=x*x;
     }
   const double den=20.0*sumx2-sumx*sumx;
   if(!SnrFinite(den) || MathAbs(den)<1.0e-12)
     {
      out.reject_reason="LRS_DEN";
      return(true);
     }
   const double slope=(20.0*sumxy-sumx*sumy)/den;
   if(!SnrFinite(slope))
     {
      out.reject_reason="LRS_SLOPE";
      return(true);
     }

   int bias=SNR_DIR_NONE;
   if(slope>=0.10*atr[0])
      bias=SNR_DIR_LONG;
   else if(slope<=-0.10*atr[0])
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="LRS_THR";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="LRS_COLOR";
      return(true);
     }

   double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   for(int i=1;i<5;i++)
     {
      if(!SnrFinite(h1[i].low) || !SnrFinite(h1[i].high) || h1[i].high<=h1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="LRS_BAR";
         return(false);
        }
      if(direction>0)
         sl_px=MathMin(sl_px,h1[i].low);
      else
         sl_px=MathMax(sl_px,h1[i].high);
     }
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="LRS_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=slope/atr[0];
   out.trend.slope=slope;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1AsfdSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,24,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,16,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<12 || ArraySize(d1)<14 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=cfg.london_start_hour)
     {
      out.reject_reason="ASFD_HOUR";
      return(true);
     }

   MqlDateTime day_ldn;
   SnrGmtToLondon(signal_gmt,day_ldn);
   double asia_high=-1.0e100;
   double asia_low=1.0e100;
   double asia_open=0.0;
   double asia_close=0.0;
   int asia_n=0;
   int asia_first_i=-1;
   const int n=ArraySize(h1);
   for(int i=1;i<n;i++)
     {
      if(!SnrFinite(h1[i].high) || !SnrFinite(h1[i].low) ||
         !SnrFinite(h1[i].open) || !SnrFinite(h1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="ASFD_BAR";
         return(false);
        }
      if(h1[i].high<h1[i].low)
         continue;
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      if(bar_ldn.year!=day_ldn.year || bar_ldn.mon!=day_ldn.mon || bar_ldn.day!=day_ldn.day)
         continue;
      if(bar_ldn.hour>=cfg.london_start_hour)
         continue;
      asia_high=MathMax(asia_high,h1[i].high);
      asia_low=MathMin(asia_low,h1[i].low);
      asia_close=h1[i].close;
      asia_open=h1[i].open;
      asia_first_i=i;
      asia_n++;
     }
   if(asia_n<5 || asia_first_i<0 || !SnrFinite(asia_high) || !SnrFinite(asia_low) ||
      asia_high<=asia_low || !SnrFinite(asia_open) || !SnrFinite(asia_close))
     {
      out.reject_reason="ASFD_ASIA";
      return(true);
     }
   asia_open=h1[asia_first_i].open;
   asia_close=0.0;
   int newest_asia=-1;
   int newest_hour=-1;
   for(int i=1;i<n;i++)
     {
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      if(bar_ldn.year!=day_ldn.year || bar_ldn.mon!=day_ldn.mon || bar_ldn.day!=day_ldn.day)
         continue;
      if(bar_ldn.hour>=cfg.london_start_hour)
         continue;
      if(newest_asia<0 || bar_ldn.hour>newest_hour)
        {
         newest_asia=i;
         newest_hour=bar_ldn.hour;
        }
     }
   if(newest_asia<0)
     {
      out.reject_reason="ASFD_ASIA";
      return(true);
     }
   asia_close=h1[newest_asia].close;

   double adr_sum=0.0;
   for(int i=0;i<14;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) || d1[i].high<=d1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="ASFD_ADR";
         return(false);
        }
      adr_sum+=(d1[i].high-d1[i].low);
     }
   const double adr=adr_sum/14.0;
   const double asia_range=asia_high-asia_low;
   if(!SnrFinite(adr) || adr<=0.0 || asia_range<0.80*adr)
     {
      out.reject_reason="ASFD_BUSY";
      return(true);
     }

   const int asia_dir=(asia_close>asia_open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int bias=(asia_dir>0 ? SNR_DIR_SHORT : SNR_DIR_LONG);
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="ASFD_COLOR";
      return(true);
     }
   const double sl_px=(direction>0 ? asia_low : asia_high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="ASFD_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=asia_range/adr;
   out.trend.slope=(double)asia_dir;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1VdrySignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,24,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<21 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<cfg.london_start_hour || out.session.london_hour>11)
     {
      out.reject_reason="VDRY_HOUR";
      return(true);
     }

   double vols[];
   if(ArrayResize(vols,20)<20)
     {
      out.data_fail=true;
      out.reject_reason="VDRY_ALLOC";
      return(false);
     }
   for(int i=1;i<=20;i++)
     {
      if(h1[i].tick_volume<=0)
        {
         out.reject_reason="VDRY_VOL";
         return(true);
        }
      vols[i-1]=(double)h1[i].tick_volume;
     }
   ArraySort(vols);
   const double median=0.5*(vols[9]+vols[10]);
   if(!SnrFinite(median) || median<=0.0)
     {
      out.reject_reason="VDRY_MED";
      return(true);
     }
   if((double)h1[1].tick_volume>=0.70*median ||
      (double)h1[2].tick_volume>=0.70*median ||
      (double)h1[3].tick_volume>=0.70*median)
     {
      out.reject_reason="VDRY_DRY";
      return(true);
     }
   const double exp_rng=h1[0].high-h1[0].low;
   if((double)h1[0].tick_volume<=1.30*median ||
      !SnrFinite(exp_rng) || exp_rng<1.0*atr[0])
     {
      out.reject_reason="VDRY_SPIKE";
      return(true);
     }
   const double q=(h1[0].close-h1[0].low)/exp_rng;
   int bias=SNR_DIR_NONE;
   if(q>=0.70)
      bias=SNR_DIR_LONG;
   else if(q<=0.30)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="VDRY_Q";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="VDRY_COLOR";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-h1[0].low : h1[0].high-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="VDRY_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=(double)h1[0].tick_volume/median;
   out.trend.slope=q;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? h1[0].low : h1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1HaflSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,40,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   const int n=ArraySize(h1);
   if(n<12 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h1[n-1].open) || !SnrFinite(h1[n-1].close) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<cfg.london_start_hour || out.session.london_hour>11)
     {
      out.reject_reason="HAFL_HOUR";
      return(true);
     }

   double ha_open[];
   double ha_close[];
   if(ArrayResize(ha_open,n)<n || ArrayResize(ha_close,n)<n)
     {
      out.data_fail=true;
      out.reject_reason="HAFL_ALLOC";
      return(false);
     }
   ha_close[n-1]=0.25*(h1[n-1].open+h1[n-1].high+h1[n-1].low+h1[n-1].close);
   ha_open[n-1]=0.5*(h1[n-1].open+h1[n-1].close);
   for(int i=n-2;i>=0;i--)
     {
      if(!SnrFinite(h1[i].open) || !SnrFinite(h1[i].high) ||
         !SnrFinite(h1[i].low) || !SnrFinite(h1[i].close) ||
         h1[i].high<=h1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="HAFL_BAR";
         return(false);
        }
      ha_close[i]=0.25*(h1[i].open+h1[i].high+h1[i].low+h1[i].close);
      ha_open[i]=0.5*(ha_open[i+1]+ha_close[i+1]);
     }
   if(!SnrFinite(ha_open[0]) || !SnrFinite(ha_close[0]) ||
      !SnrFinite(ha_open[1]) || !SnrFinite(ha_close[1]) ||
      !SnrFinite(ha_open[2]) || !SnrFinite(ha_close[2]))
     {
      out.reject_reason="HAFL_NAN";
      return(true);
     }

   const int c0=(ha_close[0]>ha_open[0] ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int c1=(ha_close[1]>ha_open[1] ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int c2=(ha_close[2]>ha_open[2] ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(c1==c2)
     {
      out.reject_reason="HAFL_FLIP";
      return(true);
     }
   if(c0!=c1)
     {
      out.reject_reason="HAFL_CONF";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=c0)
     {
      out.reject_reason="HAFL_COLOR";
      return(true);
     }
   const double sl_px=(direction>0 ? MathMin(h1[0].low,h1[1].low)
                                   : MathMax(h1[0].high,h1[1].high));
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="HAFL_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=ha_close[0];
   out.trend.slope=ha_close[0]-ha_open[0];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1AccSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<4 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h1[1].close) || !SnrFinite(h1[2].close) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<cfg.london_start_hour || out.session.london_hour>11)
     {
      out.reject_reason="ACC_HOUR";
      return(true);
     }

   const double d0=h1[0].close-h1[1].close;
   const double d1=h1[1].close-h1[2].close;
   if(!SnrFinite(d0) || !SnrFinite(d1) || d0==0.0 || d1==0.0)
     {
      out.reject_reason="ACC_MOVE";
      return(true);
     }
   if((d0>0.0 && d1<=0.0) || (d0<0.0 && d1>=0.0) || MathAbs(d0)<=MathAbs(d1) ||
      MathAbs(d0)<0.30*atr[0])
     {
      out.reject_reason="ACC_THR";
      return(true);
     }
   const int bias=(d0>0.0 ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="ACC_COLOR";
      return(true);
     }

   double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   for(int i=1;i<3;i++)
     {
      if(!SnrFinite(h1[i].low) || !SnrFinite(h1[i].high) || h1[i].high<=h1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="ACC_BAR";
         return(false);
        }
      if(direction>0)
         sl_px=MathMin(sl_px,h1[i].low);
      else
         sl_px=MathMax(sl_px,h1[i].high);
     }
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="ACC_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=MathAbs(d0)/atr[0];
   out.trend.slope=d0;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1MfsqSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<3 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h1[1].close) || !SnrFinite(h1[1].open) ||
      !SnrFinite(h1[1].high) || !SnrFinite(h1[1].low) ||
      !SnrFinite(h1[2].high) || !SnrFinite(h1[2].low) ||
      h1[0].high<=h1[0].low || h1[1].high<=h1[1].low ||
      h1[2].high<=h1[2].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<cfg.london_start_hour || out.session.london_hour>11)
     {
      out.reject_reason="MFSQ_HOUR";
      return(true);
     }

   const long v1=h1[1].tick_volume;
   const long v2=h1[2].tick_volume;
   if(v1<=0 || v2<=0)
     {
      out.reject_reason="MFSQ_VOL";
      return(true);
     }
   const double rng1=h1[1].high-h1[1].low;
   const double rng2=h1[2].high-h1[2].low;
   const double mfi1=rng1/(double)v1;
   const double mfi2=rng2/(double)v2;
   if(!SnrFinite(mfi1) || !SnrFinite(mfi2) || mfi1<=0.0 || mfi2<=0.0)
     {
      out.reject_reason="MFSQ_MFI";
      return(true);
     }
   if(v1<=v2 || mfi1>=mfi2)
     {
      out.reject_reason="MFSQ_SQUAT";
      return(true);
     }
   if(h1[1].close==h1[1].open || h1[0].close==h1[0].open)
     {
      out.reject_reason="MFSQ_DOJI";
      return(true);
     }
   const int squat_dir=(h1[1].close>h1[1].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction==squat_dir)
     {
      out.reject_reason="MFSQ_CONFIRM";
      return(true);
     }

   const double sl_px=(direction>0 ? MathMin(h1[0].low,h1[1].low)
                                   : MathMax(h1[0].high,h1[1].high));
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="MFSQ_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=mfi2>0.0 ? mfi1/mfi2 : 0.0;
   out.trend.slope=(double)(v1-v2);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1StarSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<3 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h1[1].close) || !SnrFinite(h1[1].open) ||
      !SnrFinite(h1[1].high) || !SnrFinite(h1[1].low) ||
      !SnrFinite(h1[2].close) || !SnrFinite(h1[2].open) ||
      !SnrFinite(h1[2].high) || !SnrFinite(h1[2].low) ||
      h1[0].high<=h1[0].low || h1[1].high<=h1[1].low ||
      h1[2].high<=h1[2].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<cfg.london_start_hour || out.session.london_hour>11)
     {
      out.reject_reason="STAR_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   const double rng2=h1[2].high-h1[2].low;
   const double body0=MathAbs(h1[0].close-h1[0].open);
   const double body1=MathAbs(h1[1].close-h1[1].open);
   const double body2=MathAbs(h1[2].close-h1[2].open);
   const double mid2=0.5*(h1[2].open+h1[2].close);
   if(!SnrFinite(body0) || !SnrFinite(body1) || !SnrFinite(body2) ||
      !SnrFinite(mid2) || body2<=0.0)
     {
      out.reject_reason="STAR_BODY";
      return(true);
     }
   if(body2<0.50*rng2 || body1>0.30*body2 || body0<0.50*rng0)
     {
      out.reject_reason="STAR_SHAPE";
      return(true);
     }

   int direction=SNR_DIR_NONE;
   const bool bar2_bear=h1[2].close<h1[2].open;
   const bool bar2_bull=h1[2].close>h1[2].open;
   const bool bar0_bear=h1[0].close<h1[0].open;
   const bool bar0_bull=h1[0].close>h1[0].open;
   if(bar2_bear && bar0_bull && h1[0].close>mid2)
      direction=SNR_DIR_LONG;
   else if(bar2_bull && bar0_bear && h1[0].close<mid2)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="STAR_DIR";
      return(true);
     }

   double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   for(int i=1;i<3;i++)
     {
      if(direction>0)
         sl_px=MathMin(sl_px,h1[i].low);
      else
         sl_px=MathMax(sl_px,h1[i].high);
     }
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="STAR_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=body0/rng0;
   out.trend.slope=h1[0].close-mid2;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1VtxSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,20,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<16 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<cfg.london_start_hour || out.session.london_hour>11)
     {
      out.reject_reason="VTX_HOUR";
      return(true);
     }

   double vi_p[2];
   double vi_m[2];
   for(int off=0;off<2;off++)
     {
      double vm_p=0.0;
      double vm_m=0.0;
      double trs=0.0;
      for(int i=0;i<14;i++)
        {
         const int k=i+off;
         if(!SnrFinite(h1[k].high) || !SnrFinite(h1[k].low) ||
            !SnrFinite(h1[k+1].high) || !SnrFinite(h1[k+1].low) ||
            !SnrFinite(h1[k+1].close) || h1[k].high<=h1[k].low)
           {
            out.data_fail=true;
            out.reject_reason="VTX_BAR";
            return(false);
           }
         vm_p+=MathAbs(h1[k].high-h1[k+1].low);
         vm_m+=MathAbs(h1[k].low-h1[k+1].high);
         const double tr1=h1[k].high-h1[k].low;
         const double tr2=MathAbs(h1[k].high-h1[k+1].close);
         const double tr3=MathAbs(h1[k].low-h1[k+1].close);
         double tr=tr1;
         if(tr2>tr)
            tr=tr2;
         if(tr3>tr)
            tr=tr3;
         trs+=tr;
        }
      if(!SnrFinite(vm_p) || !SnrFinite(vm_m) || !SnrFinite(trs) || trs<=0.0)
        {
         out.reject_reason="VTX_TR";
         return(true);
        }
      vi_p[off]=vm_p/trs;
      vi_m[off]=vm_m/trs;
     }
   if(!SnrFinite(vi_p[0]) || !SnrFinite(vi_m[0]) ||
      !SnrFinite(vi_p[1]) || !SnrFinite(vi_m[1]))
     {
      out.reject_reason="VTX_VI";
      return(true);
     }

   int direction=SNR_DIR_NONE;
   if(vi_p[0]>vi_m[0] && vi_p[1]<=vi_m[1])
      direction=SNR_DIR_LONG;
   else if(vi_m[0]>vi_p[0] && vi_m[1]<=vi_p[1])
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="VTX_CROSS";
      return(true);
     }
   const int bar_dir=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(bar_dir!=direction)
     {
      out.reject_reason="VTX_COLOR";
      return(true);
     }

   double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   for(int i=1;i<5;i++)
     {
      if(!SnrFinite(h1[i].low) || !SnrFinite(h1[i].high) || h1[i].high<=h1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="VTX_SLBAR";
         return(false);
        }
      if(direction>0)
         sl_px=MathMin(sl_px,h1[i].low);
      else
         sl_px=MathMax(sl_px,h1[i].high);
     }
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="VTX_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=vi_p[0];
   out.trend.slope=vi_p[0]-vi_m[0];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1FrcSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,20,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<16 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<cfg.london_start_hour || out.session.london_hour>11)
     {
      out.reject_reason="FRC_HOUR";
      return(true);
     }

   double fi[];
   if(ArrayResize(fi,15)<15)
     {
      out.data_fail=true;
      out.reject_reason="FRC_ALLOC";
      return(false);
     }
   for(int i=0;i<15;i++)
     {
      if(h1[i].tick_volume<=0 || !SnrFinite(h1[i].close) ||
         !SnrFinite(h1[i+1].close))
        {
         out.reject_reason="FRC_VOL";
         return(true);
        }
      fi[i]=(double)h1[i].tick_volume*(h1[i].close-h1[i+1].close);
      if(!SnrFinite(fi[i]))
        {
         out.reject_reason="FRC_FI";
         return(true);
        }
     }
   double sma0=0.0;
   double sma1=0.0;
   for(int i=0;i<13;i++)
     {
      sma0+=fi[i];
      sma1+=fi[i+1];
     }
   sma0/=13.0;
   sma1/=13.0;
   if(!SnrFinite(sma0) || !SnrFinite(sma1))
     {
      out.reject_reason="FRC_SMA";
      return(true);
     }

   int direction=SNR_DIR_NONE;
   if(sma0>0.0 && sma1<=0.0)
      direction=SNR_DIR_LONG;
   else if(sma0<0.0 && sma1>=0.0)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="FRC_CROSS";
      return(true);
     }
   const int bar_dir=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(bar_dir!=direction)
     {
      out.reject_reason="FRC_COLOR";
      return(true);
     }

   double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   for(int i=1;i<5;i++)
     {
      if(!SnrFinite(h1[i].low) || !SnrFinite(h1[i].high) || h1[i].high<=h1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="FRC_SLBAR";
         return(false);
        }
      if(direction>0)
         sl_px=MathMin(sl_px,h1[i].low);
      else
         sl_px=MathMax(sl_px,h1[i].high);
     }
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="FRC_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=sma0;
   out.trend.slope=sma0-sma1;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1BeltSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,6,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<cfg.london_start_hour || out.session.london_hour>11)
     {
      out.reject_reason="BELT_HOUR";
      return(true);
     }

   const double rng=h1[0].high-h1[0].low;
   const double body=MathAbs(h1[0].close-h1[0].open);
   if(!SnrFinite(rng) || !SnrFinite(body) || rng<=0.0 || body<0.60*rng)
     {
      out.reject_reason="BELT_BODY";
      return(true);
     }

   int direction=SNR_DIR_NONE;
   if(h1[0].close>h1[0].open && (h1[0].open-h1[0].low)<=0.15*rng)
      direction=SNR_DIR_LONG;
   else if(h1[0].close<h1[0].open && (h1[0].high-h1[0].open)<=0.15*rng)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="BELT_WICK";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="BELT_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=body/rng;
   out.trend.slope=h1[0].close-h1[0].open;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1BpwrSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,40,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<40 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h1[1].high) || !SnrFinite(h1[1].low) ||
      h1[0].high<=h1[0].low || h1[1].high<=h1[1].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<cfg.london_start_hour || out.session.london_hour>11)
     {
      out.reject_reason="BPWR_HOUR";
      return(true);
     }

   double seed=0.0;
   for(int i=27;i<=39;i++)
     {
      if(!SnrFinite(h1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="BPWR_SEED";
         return(false);
        }
      seed+=h1[i].close;
     }
   seed/=13.0;
   double ema=seed;
   double ema1=0.0;
   double ema0=0.0;
   const double k=2.0/14.0;
   const double k1=1.0-k;
   for(int i=26;i>=0;i--)
     {
      if(!SnrFinite(h1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="BPWR_EMA";
         return(false);
        }
      ema=h1[i].close*k+ema*k1;
      if(i==1)
         ema1=ema;
      if(i==0)
         ema0=ema;
     }
   if(!SnrFinite(ema0) || !SnrFinite(ema1))
     {
      out.reject_reason="BPWR_EMA2";
      return(true);
     }

   const double bulls0=h1[0].high-ema0;
   const double bulls1=h1[1].high-ema1;
   const double bears0=h1[0].low-ema0;
   const double bears1=h1[1].low-ema1;
   if(!SnrFinite(bulls0) || !SnrFinite(bulls1) ||
      !SnrFinite(bears0) || !SnrFinite(bears1))
     {
      out.reject_reason="BPWR_PWR";
      return(true);
     }

   int direction=SNR_DIR_NONE;
   const bool long_x=(bulls0>0.0 && bulls1<=0.0);
   const bool short_x=(bears0<0.0 && bears1>=0.0);
   if(long_x && !short_x)
      direction=SNR_DIR_LONG;
   else if(short_x && !long_x)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="BPWR_CROSS";
      return(true);
     }
   const int bar_dir=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(bar_dir!=direction)
     {
      out.reject_reason="BPWR_COLOR";
      return(true);
     }

   double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   for(int i=1;i<5;i++)
     {
      if(!SnrFinite(h1[i].low) || !SnrFinite(h1[i].high) || h1[i].high<=h1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="BPWR_SLBAR";
         return(false);
        }
      if(direction>0)
         sl_px=MathMin(sl_px,h1[i].low);
      else
         sl_px=MathMax(sl_px,h1[i].high);
     }
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="BPWR_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=ema0;
   out.trend.slope=(direction>0 ? bulls0 : bears0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1OdfSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,10,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<4 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<9 || out.session.london_hour>11)
     {
      out.reject_reason="ODF_HOUR";
      return(true);
     }

   MqlDateTime sig_ldn;
   SnrGmtToLondon(signal_gmt,sig_ldn);
   const int sig_ymd=sig_ldn.year*10000+sig_ldn.mon*100+sig_ldn.day;
   int drive_i=-1;
   for(int i=1;i<ArraySize(h1);i++)
     {
      if(!SnrFinite(h1[i].high) || !SnrFinite(h1[i].low) ||
         !SnrFinite(h1[i].open) || !SnrFinite(h1[i].close) ||
         h1[i].high<=h1[i].low || h1[i].time<=0)
         continue;
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      const int bar_ymd=bar_ldn.year*10000+bar_ldn.mon*100+bar_ldn.day;
      if(bar_ymd!=sig_ymd)
         continue;
      if(bar_ldn.hour==cfg.london_start_hour)
        {
         drive_i=i;
         break;
        }
     }
   if(drive_i<0)
     {
      out.reject_reason="ODF_DRIVE";
      return(true);
     }

   const double drng=h1[drive_i].high-h1[drive_i].low;
   const double dbody=MathAbs(h1[drive_i].close-h1[drive_i].open);
   if(!SnrFinite(drng) || !SnrFinite(dbody) || drng<=0.0 ||
      drng<0.80*atr[0] || dbody<0.50*drng ||
      h1[drive_i].close==h1[drive_i].open)
     {
      out.reject_reason="ODF_SHAPE";
      return(true);
     }

   const int drive_dir=(h1[drive_i].close>h1[drive_i].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int bar_dir=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(bar_dir==drive_dir || h1[0].close==h1[0].open)
     {
      out.reject_reason="ODF_COLOR";
      return(true);
     }
   const bool fail_long=(drive_dir>0 && h1[0].close<h1[drive_i].open);
   const bool fail_short=(drive_dir<0 && h1[0].close>h1[drive_i].open);
   if(!fail_long && !fail_short)
     {
      out.reject_reason="ODF_FAIL";
      return(true);
     }
   const int direction=(fail_long ? SNR_DIR_SHORT : SNR_DIR_LONG);
   if(direction!=bar_dir)
     {
      out.reject_reason="ODF_ALIGN";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[drive_i].low : h1[drive_i].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="ODF_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=drng/atr[0];
   out.trend.slope=h1[0].close-h1[drive_i].open;
   out.trend.side=direction;

   if(StringFind(symbol,"EURUSD")==0)
     {
      if(SnrNewsEurUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
        {
         out.reject_reason="NEWS";
         return(true);
        }
     }
   else if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1YvwSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,40,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,4,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<20 || ArraySize(d1)<2 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 || d1[0].high<=d1[0].low ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(d1[0].close) || !SnrFinite(d1[0].open) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=cfg.london_start_hour)
     {
      out.reject_reason="YVW_HOUR";
      return(true);
     }

   const datetime day_open=d1[0].time;
   const datetime day_end=day_open+86400;
   if(h1[0].time<day_end)
     {
      out.reject_reason="YVW_TODAY";
      return(true);
     }

   double pv=0.0;
   double vv=0.0;
   int n=0;
   for(int i=0;i<ArraySize(h1);i++)
     {
      if(h1[i].time<day_open)
         break;
      if(h1[i].time>=day_end)
         continue;
      if(!SnrFinite(h1[i].high) || !SnrFinite(h1[i].low) ||
         !SnrFinite(h1[i].close) || h1[i].high<=h1[i].low ||
         h1[i].tick_volume<=0)
        {
         out.reject_reason="YVW_BAR";
         return(true);
        }
      const double typical=(h1[i].high+h1[i].low+h1[i].close)/3.0;
      pv+=typical*(double)h1[i].tick_volume;
      vv+=(double)h1[i].tick_volume;
      n++;
     }
   if(n<12 || vv<=0.0 || !SnrFinite(pv))
     {
      out.reject_reason="YVW_N";
      return(true);
     }
   const double vwap=pv/vv;
   const double y_range=d1[0].high-d1[0].low;
   const double pad=0.20*y_range;
   if(!SnrFinite(vwap) || !SnrFinite(y_range) || y_range<=0.0 || pad<=0.0)
     {
      out.reject_reason="YVW_VWAP";
      return(true);
     }

   int bias=SNR_DIR_NONE;
   if(d1[0].close>vwap+pad)
      bias=SNR_DIR_LONG;
   else if(d1[0].close<vwap-pad)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="YVW_DISP";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="YVW_COLOR";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-d1[0].low : d1[0].high-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="YVW_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=(d1[0].close-vwap)/y_range;
   out.trend.slope=d1[0].close-vwap;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? d1[0].low : d1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1ClhhSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,10,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<8 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<cfg.london_start_hour || out.session.london_hour>11)
     {
      out.reject_reason="CLHH_HOUR";
      return(true);
     }

   double max_c=h1[1].close;
   double min_c=h1[1].close;
   double max_h=h1[1].high;
   double min_l=h1[1].low;
   double sl_low=h1[0].low;
   double sl_high=h1[0].high;
   for(int i=1;i<8;i++)
     {
      if(!SnrFinite(h1[i].close) || !SnrFinite(h1[i].high) ||
         !SnrFinite(h1[i].low) || h1[i].high<=h1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="CLHH_BAR";
         return(false);
        }
      if(h1[i].close>max_c)
         max_c=h1[i].close;
      if(h1[i].close<min_c)
         min_c=h1[i].close;
      if(h1[i].high>max_h)
         max_h=h1[i].high;
      if(h1[i].low<min_l)
         min_l=h1[i].low;
      if(h1[i].low<sl_low)
         sl_low=h1[i].low;
      if(h1[i].high>sl_high)
         sl_high=h1[i].high;
     }

   int direction=SNR_DIR_NONE;
   if(h1[0].close>max_c && h1[0].high<max_h && h1[0].close>h1[0].open)
      direction=SNR_DIR_LONG;
   else if(h1[0].close<min_c && h1[0].low>min_l && h1[0].close<h1[0].open)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="CLHH_SHAPE";
      return(true);
     }

   const double sl_px=(direction>0 ? sl_low : sl_high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="CLHH_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=(direction>0 ? h1[0].close-max_c : min_c-h1[0].close)/atr[0];
   out.trend.slope=h1[0].close-h1[0].open;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1InsSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,6,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<3 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h1[1].close) || !SnrFinite(h1[1].open) ||
      !SnrFinite(h1[1].high) || !SnrFinite(h1[1].low) ||
      h1[0].high<=h1[0].low || h1[1].high<=h1[1].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<cfg.london_start_hour || out.session.london_hour>11)
     {
      out.reject_reason="INS_HOUR";
      return(true);
     }

   if(h1[0].high>=h1[1].high || h1[0].low<=h1[1].low)
     {
      out.reject_reason="INS_INSIDE";
      return(true);
     }
   const double mother=h1[1].high-h1[1].low;
   if(!SnrFinite(mother) || mother<0.80*atr[0] || h1[1].close==h1[1].open)
     {
      out.reject_reason="INS_MOTHER";
      return(true);
     }
   const int direction=(h1[1].close>h1[1].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int bar_dir=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(h1[0].close==h1[0].open || bar_dir!=direction)
     {
      out.reject_reason="INS_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[1].low : h1[1].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="INS_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=mother/atr[0];
   out.trend.slope=h1[1].close-h1[1].open;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[1].high : h1[1].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1DjgoSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,16,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(d1)<16 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 || d1[0].high<=d1[0].low ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(d1[0].close) || !SnrFinite(d1[0].open) ||
      !SnrFinite(d1[1].close) || !SnrFinite(d1[1].open) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=cfg.london_start_hour)
     {
      out.reject_reason="DJGO_HOUR";
      return(true);
     }

   double adr_sum=0.0;
   for(int i=1;i<=14;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) || d1[i].high<=d1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="DJGO_ADR";
         return(false);
        }
      adr_sum+=(d1[i].high-d1[i].low);
     }
   const double adr=adr_sum/14.0;
   const double y_range=d1[0].high-d1[0].low;
   const double y_body=MathAbs(d1[0].close-d1[0].open);
   if(!SnrFinite(adr) || adr<=0.0 || !SnrFinite(y_range) || y_range<0.50*adr ||
      !SnrFinite(y_body) || y_body>0.25*y_range)
     {
      out.reject_reason="DJGO_DOJI";
      return(true);
     }
   if(d1[1].close==d1[1].open)
     {
      out.reject_reason="DJGO_PRIOR";
      return(true);
     }
   const int bias=(d1[1].close>d1[1].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="DJGO_COLOR";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-d1[0].low : d1[0].high-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="DJGO_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=y_body/y_range;
   out.trend.slope=d1[1].close-d1[1].open;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? d1[0].low : d1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1MidqSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,24,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<21 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<cfg.london_start_hour || out.session.london_hour>11)
     {
      out.reject_reason="MIDQ_HOUR";
      return(true);
     }

   double rngs[];
   if(ArrayResize(rngs,20)<20)
     {
      out.data_fail=true;
      out.reject_reason="MIDQ_ALLOC";
      return(false);
     }
   for(int i=1;i<=20;i++)
     {
      if(!SnrFinite(h1[i].high) || !SnrFinite(h1[i].low) || h1[i].high<=h1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="MIDQ_BAR";
         return(false);
        }
      rngs[i-1]=h1[i].high-h1[i].low;
     }
   ArraySort(rngs);
   const double range0=h1[0].high-h1[0].low;
   if(!SnrFinite(range0) || range0<=0.0 || range0<rngs[7] || range0>rngs[11])
     {
      out.reject_reason="MIDQ_PCT";
      return(true);
     }
   const double q=(h1[0].close-h1[0].low)/range0;
   int direction=SNR_DIR_NONE;
   if(q>=0.75 && h1[0].close>h1[0].open)
      direction=SNR_DIR_LONG;
   else if(q<=0.25 && h1[0].close<h1[0].open)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="MIDQ_Q";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="MIDQ_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=q;
   out.trend.slope=range0;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1AcrSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,24,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<21 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<cfg.london_start_hour || out.session.london_hour>11)
     {
      out.reject_reason="ACR_HOUR";
      return(true);
     }

   double rets[20];
   for(int k=0;k<20;k++)
     {
      if(!SnrFinite(h1[k].close) || !SnrFinite(h1[k+1].close))
        {
         out.data_fail=true;
         out.reject_reason="ACR_RET";
         return(false);
        }
      rets[k]=h1[k].close-h1[k+1].close;
     }

   const int n=19;
   double sx=0.0,sy=0.0;
   for(int p=0;p<n;p++)
     {
      sx+=rets[p];
      sy+=rets[p+1];
     }
   const double mx=sx/(double)n;
   const double my=sy/(double)n;
   double num=0.0,dx2=0.0,dy2=0.0;
   for(int q=0;q<n;q++)
     {
      const double dx=rets[q]-mx;
      const double dy=rets[q+1]-my;
      num+=dx*dy;
      dx2+=dx*dx;
      dy2+=dy*dy;
     }
   if(!SnrFinite(num) || !SnrFinite(dx2) || !SnrFinite(dy2) ||
      dx2<=0.0 || dy2<=0.0)
     {
      out.reject_reason="ACR_DEN";
      return(true);
     }
   const double rho=num/MathSqrt(dx2*dy2);
   if(!SnrFinite(rho) || rho<0.20)
     {
      out.reject_reason="ACR_RHO";
      return(true);
     }

   const int bar_dir=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(h1[0].close==h1[0].open)
     {
      out.reject_reason="ACR_COLOR";
      return(true);
     }
   if((bar_dir>0 && rets[0]<=0.0) || (bar_dir<0 && rets[0]>=0.0))
     {
      out.reject_reason="ACR_ALIGN";
      return(true);
     }
   const int direction=bar_dir;

   double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   for(int s=1;s<=4;s++)
     {
      if(!SnrFinite(h1[s].high) || !SnrFinite(h1[s].low) || h1[s].high<=h1[s].low)
        {
         out.data_fail=true;
         out.reject_reason="ACR_SLBAR";
         return(false);
        }
      if(direction>0)
         sl_px=MathMin(sl_px,h1[s].low);
      else
         sl_px=MathMax(sl_px,h1[s].high);
     }
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="ACR_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=rho;
   out.trend.slope=rets[0];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1MedrSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,12,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<9 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<cfg.london_start_hour || out.session.london_hour>11)
     {
      out.reject_reason="MEDR_HOUR";
      return(true);
     }

   double cs[];
   if(ArrayResize(cs,8)<8)
     {
      out.data_fail=true;
      out.reject_reason="MEDR_ALLOC";
      return(false);
     }
   for(int k=1;k<=8;k++)
     {
      if(!SnrFinite(h1[k].close))
        {
         out.data_fail=true;
         out.reject_reason="MEDR_BAR";
         return(false);
        }
      cs[k-1]=h1[k].close;
     }
   ArraySort(cs);
   const double med=0.5*(cs[3]+cs[4]);
   if(!SnrFinite(med) || !SnrFinite(h1[1].close))
     {
      out.data_fail=true;
      out.reject_reason="MEDR_MED";
      return(false);
     }
   const double stretch=h1[1].close-med;
   if(MathAbs(stretch)<1.0*atr[0])
     {
      out.reject_reason="MEDR_STRETCH";
      return(true);
     }

   int direction=SNR_DIR_NONE;
   if(stretch<0.0 && h1[0].close>med && h1[0].close>h1[0].open)
      direction=SNR_DIR_LONG;
   else if(stretch>0.0 && h1[0].close<med && h1[0].close<h1[0].open)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="MEDR_CROSS";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="MEDR_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=med;
   out.trend.slope=stretch;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1PbcSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
