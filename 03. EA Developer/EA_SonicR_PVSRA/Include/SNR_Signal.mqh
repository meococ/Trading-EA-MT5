bool SnrBuildD1DswSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,16,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(d1)<5 || ArraySize(atr)<1 ||
      d1[0].time<=0 || d1[0].time>=availability_time ||
      !SnrFinite(d1[0].close) || !SnrFinite(d1[0].open) ||
      !SnrFinite(d1[0].high) || !SnrFinite(d1[0].low) ||
      d1[0].high<=d1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=d1[0].time;
   out.signal_high=d1[0].high;
   out.signal_low=d1[0].low;
   out.signal_close=d1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=d1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(out.session.flatten ||
      out.session.london_dow==0 ||
      out.session.london_dow==5 ||
      out.session.london_dow==6)
     {
      out.reject_reason="DSW_DOW";
      return(true);
     }

   const double range=d1[0].high-d1[0].low;
   const double body=MathAbs(d1[0].close-d1[0].open);
   if(!SnrFinite(range) || !SnrFinite(body) ||
      range<=0.0 || body<0.60*range || range<0.80*atr[0])
     {
      out.reject_reason="DSW_BAR";
      return(true);
     }

   const int direction=(d1[0].close>d1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const double sl_px=(direction>0 ? d1[0].low : d1[0].high);
   const double sl_dist=(direction>0 ? d1[0].close-sl_px : sl_px-d1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="DSW_SL";
      return(true);
     }

   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=body/atr[0];
   out.trend.slope=range/atr[0];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+24*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=d1[0].close;
   out.wave.impulse_extreme=(direction>0 ? d1[0].high : d1[0].low);

   SnrPvsraReadClosed(d1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(d1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1EuxySignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<3 || ArraySize(atr)<1 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(out.session.flatten || !out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<8 || out.session.london_hour>16)
     {
      out.reject_reason="EUXY_HOUR";
      return(true);
     }

   MqlRates eur[];
   if(!SnrCopyClosedRates("EURUSD",PERIOD_H1,16,eur) || ArraySize(eur)<15)
     {
      out.reject_reason="EUXY_EUR";
      return(true);
     }
   if(eur[0].time!=h1[0].time || eur[0].time>=availability_time ||
      !SnrFinite(eur[0].close) || !SnrFinite(eur[0].open) ||
      !SnrFinite(eur[0].high) || !SnrFinite(eur[0].low) ||
      eur[0].high<=eur[0].low)
     {
      out.reject_reason="EUXY_EUR";
      return(true);
     }

   double tr_sum=0.0;
   for(int i=0;i<14;i++)
     {
      if(eur[i].time<=0 || !SnrFinite(eur[i].high) || !SnrFinite(eur[i].low) ||
         eur[i].high<=eur[i].low)
        {
         out.reject_reason="EUXY_EUR";
         return(true);
        }
      double tr=eur[i].high-eur[i].low;
      if(i<ArraySize(eur)-1 && SnrFinite(eur[i+1].close))
        {
         const double hc=MathAbs(eur[i].high-eur[i+1].close);
         const double lc=MathAbs(eur[i].low-eur[i+1].close);
         if(hc>tr)
            tr=hc;
         if(lc>tr)
            tr=lc;
        }
      tr_sum+=tr;
     }
   const double eur_atr=tr_sum/14.0;
   const double eur_range=eur[0].high-eur[0].low;
   const double eur_body=MathAbs(eur[0].close-eur[0].open);
   if(!SnrFinite(eur_atr) || eur_atr<=0.0 ||
      eur_body<0.60*eur_range || eur_body<0.80*eur_atr)
     {
      out.reject_reason="EUXY_IMPULSE";
      return(true);
     }

   const int direction=(eur[0].close>eur[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int xau_dir=(h1[0].close>h1[0].open ? SNR_DIR_LONG :
                      (h1[0].close<h1[0].open ? SNR_DIR_SHORT : SNR_DIR_NONE));
   if(direction!=xau_dir)
     {
      out.reject_reason="EUXY_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="EUXY_SL";
      return(true);
     }

   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=eur_body/eur_atr;
   out.trend.slope=eur_range/eur_atr;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1AoacSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,40,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<38 || ArraySize(atr)<1 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(out.session.flatten || !out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<8 || out.session.london_hour>16)
     {
      out.reject_reason="AOAC_HOUR";
      return(true);
     }

   double ao[5];
   for(int k=0;k<5;k++)
     {
      double s5=0.0;
      double s34=0.0;
      for(int j=0;j<34;j++)
        {
         const int idx=k+j;
         if(h1[idx].time<=0 || h1[idx].high<=h1[idx].low ||
            !SnrFinite(h1[idx].high) || !SnrFinite(h1[idx].low))
           {
            out.data_fail=true;
            out.reject_reason="AOAC_BAR";
            return(false);
           }
         const double med=0.5*(h1[idx].high+h1[idx].low);
         if(j<5)
            s5+=med;
         s34+=med;
        }
      ao[k]=s5/5.0-s34/34.0;
      if(!SnrFinite(ao[k]))
        {
         out.data_fail=true;
         out.reject_reason="AOAC_NAN";
         return(false);
        }
     }

   int direction=SNR_DIR_NONE;
   if(ao[1]<=0.0 && ao[0]>0.0)
      direction=SNR_DIR_LONG;
   else if(ao[1]>=0.0 && ao[0]<0.0)
      direction=SNR_DIR_SHORT;
   else
     {
      out.reject_reason="AOAC_CROSS";
      return(true);
     }

   const double ao_sma5=(ao[0]+ao[1]+ao[2]+ao[3]+ao[4])/5.0;
   const double ac0=ao[0]-ao_sma5;
   if(!SnrFinite(ac0) || (direction>0 && ac0<=0.0) || (direction<0 && ac0>=0.0))
     {
      out.reject_reason="AOAC_AC";
      return(true);
     }

   const int bar_dir=(h1[0].close>h1[0].open ? SNR_DIR_LONG :
                      (h1[0].close<h1[0].open ? SNR_DIR_SHORT : SNR_DIR_NONE));
   if(direction!=bar_dir)
     {
      out.reject_reason="AOAC_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="AOAC_SL";
      return(true);
     }

   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=ao[0];
   out.trend.slope=ac0;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1PsarSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<3 || ArraySize(atr)<1 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(out.session.flatten || !out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<8 || out.session.london_hour>16)
     {
      out.reject_reason="PSAR_HOUR";
      return(true);
     }

   if(h1[1].time<=0 || !SnrFinite(h1[1].close) || h1[1].time>=availability_time)
     {
      out.data_fail=true;
      out.reject_reason="PSAR_PRIOR";
      return(false);
     }

   const int sar_h=iSAR(symbol,tf,0.02,0.20);
   if(sar_h==INVALID_HANDLE)
     {
      out.data_fail=true;
      out.reject_reason="PSAR_HANDLE";
      return(false);
     }
   double sar[];
   ArraySetAsSeries(sar,true);
   const int got=CopyBuffer(sar_h,0,1,3,sar);
   IndicatorRelease(sar_h);
   if(got<3 || ArraySize(sar)<2 ||
      !SnrFinite(sar[0]) || !SnrFinite(sar[1]) || sar[0]<=0.0 || sar[1]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="PSAR_COPY";
      return(false);
     }

   int direction=SNR_DIR_NONE;
   if(h1[1].close<=sar[1] && h1[0].close>sar[0])
      direction=SNR_DIR_LONG;
   else if(h1[1].close>=sar[1] && h1[0].close<sar[0])
      direction=SNR_DIR_SHORT;
   else
     {
      out.reject_reason="PSAR_FLIP";
      return(true);
     }

   const int bar_dir=(h1[0].close>h1[0].open ? SNR_DIR_LONG :
                      (h1[0].close<h1[0].open ? SNR_DIR_SHORT : SNR_DIR_NONE));
   if(direction!=bar_dir)
     {
      out.reject_reason="PSAR_COLOR";
      return(true);
     }

   const double sl_px=sar[0];
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="PSAR_SL";
      return(true);
     }

   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=sar[0];
   out.trend.slope=sar[1];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1IkcbSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 ||
      handles.ichi==INVALID_HANDLE)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   double span_a[];
   double span_b[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr) ||
      !SnrCopyClosedBufferIdx(handles.ichi,2,40,span_a) ||
      !SnrCopyClosedBufferIdx(handles.ichi,3,40,span_b))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<3 || ArraySize(atr)<1 ||
      ArraySize(span_a)<28 || ArraySize(span_b)<28 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h1[1].time<=0 || h1[1].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[1].close) ||
      !SnrFinite(h1[0].open) || !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0 ||
      !SnrFinite(span_a[26]) || !SnrFinite(span_b[26]) ||
      !SnrFinite(span_a[27]) || !SnrFinite(span_b[27]))
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(out.session.flatten || !out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<8 || out.session.london_hour>16)
     {
      out.reject_reason="IKCB_HOUR";
      return(true);
     }

   const double cloud_top0=MathMax(span_a[26],span_b[26]);
   const double cloud_bot0=MathMin(span_a[26],span_b[26]);
   const double cloud_top1=MathMax(span_a[27],span_b[27]);
   const double cloud_bot1=MathMin(span_a[27],span_b[27]);
   if(!SnrFinite(cloud_top0) || !SnrFinite(cloud_bot0) ||
      !SnrFinite(cloud_top1) || !SnrFinite(cloud_bot1) ||
      cloud_top0<cloud_bot0 || cloud_top1<cloud_bot1)
     {
      out.data_fail=true;
      out.reject_reason="IKCB_CLOUD";
      return(false);
     }

   int direction=SNR_DIR_NONE;
   if(h1[1].close<=cloud_top1 && h1[0].close>cloud_top0)
      direction=SNR_DIR_LONG;
   else if(h1[1].close>=cloud_bot1 && h1[0].close<cloud_bot0)
      direction=SNR_DIR_SHORT;
   else
     {
      out.reject_reason="IKCB_BREAK";
      return(true);
     }

   const int bar_dir=(h1[0].close>h1[0].open ? SNR_DIR_LONG :
                      (h1[0].close<h1[0].open ? SNR_DIR_SHORT : SNR_DIR_NONE));
   if(direction!=bar_dir)
     {
      out.reject_reason="IKCB_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="IKCB_SL";
      return(true);
     }

   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=cloud_top0;
   out.trend.slope=cloud_bot0;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1KamaSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<3 || ArraySize(atr)<1 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h1[1].time<=0 || h1[1].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[1].close) ||
      !SnrFinite(h1[0].open) || !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(out.session.flatten || !out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<8 || out.session.london_hour>16)
     {
      out.reject_reason="KAMA_HOUR";
      return(true);
     }

   const int ama_h=iAMA(symbol,tf,9,2,30,0,PRICE_CLOSE);
   if(ama_h==INVALID_HANDLE)
     {
      out.data_fail=true;
      out.reject_reason="KAMA_HANDLE";
      return(false);
     }
   double ama[];
   ArraySetAsSeries(ama,true);
   const int got=CopyBuffer(ama_h,0,1,3,ama);
   IndicatorRelease(ama_h);
   if(got<3 || ArraySize(ama)<2 || !SnrFinite(ama[0]) || !SnrFinite(ama[1]))
     {
      out.data_fail=true;
      out.reject_reason="KAMA_COPY";
      return(false);
     }

   int direction=SNR_DIR_NONE;
   if(h1[1].close<=ama[1] && h1[0].close>ama[0])
      direction=SNR_DIR_LONG;
   else if(h1[1].close>=ama[1] && h1[0].close<ama[0])
      direction=SNR_DIR_SHORT;
   else
     {
      out.reject_reason="KAMA_CROSS";
      return(true);
     }

   const int bar_dir=(h1[0].close>h1[0].open ? SNR_DIR_LONG :
                      (h1[0].close<h1[0].open ? SNR_DIR_SHORT : SNR_DIR_NONE));
   if(direction!=bar_dir)
     {
      out.reject_reason="KAMA_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="KAMA_SL";
      return(true);
     }

   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=ama[0];
   out.trend.slope=ama[0]-ama[1];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1RnbrSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 ||
      cfg.round_whole<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<3 || ArraySize(atr)<1 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(out.session.flatten || !out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<8 || out.session.london_hour>16)
     {
      out.reject_reason="RNBR_HOUR";
      return(true);
     }

   const double whole=cfg.round_whole;
   const double open_bin=MathFloor(h1[0].open/whole);
   const double close_bin=MathFloor(h1[0].close/whole);
   int direction=SNR_DIR_NONE;
   if(h1[0].close>h1[0].open && close_bin>open_bin)
      direction=SNR_DIR_LONG;
   else if(h1[0].close<h1[0].open && close_bin<open_bin)
      direction=SNR_DIR_SHORT;
   else
     {
      out.reject_reason="RNBR_CROSS";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="RNBR_SL";
      return(true);
     }

   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=close_bin-open_bin;
   out.trend.slope=MathAbs(h1[0].close-h1[0].open)/atr[0];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildM15LodrSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                           const SnrHandles &handles,const SnrClassicCfg &cfg,
                           const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates m15[];
   double h1_atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,m15) ||
      !SnrCopyClosedBuffer(handles.atr,4,h1_atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(m15)<3 || ArraySize(h1_atr)<1 ||
      m15[0].time<=0 || m15[0].time>=availability_time ||
      !SnrFinite(m15[0].close) || !SnrFinite(m15[0].open) ||
      !SnrFinite(m15[0].high) || !SnrFinite(m15[0].low) ||
      m15[0].high<=m15[0].low || !SnrFinite(h1_atr[0]) || h1_atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=m15[0].time;
   out.signal_high=m15[0].high;
   out.signal_low=m15[0].low;
   out.signal_close=m15[0].close;
   out.atr=h1_atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=m15[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(out.session.flatten)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<8 || out.session.london_hour>9)
     {
      out.reject_reason="LODR_HOUR";
      return(true);
     }

   const double range=m15[0].high-m15[0].low;
   const double body=MathAbs(m15[0].close-m15[0].open);
   if(!SnrFinite(range) || !SnrFinite(body) ||
      range<=0.0 || body<0.70*range || range<0.80*h1_atr[0])
     {
      out.reject_reason="LODR_BAR";
      return(true);
     }

   const int direction=(m15[0].close>m15[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const double sl_px=(direction>0 ? m15[0].low : m15[0].high);
   const double sl_dist=(direction>0 ? m15[0].close-sl_px : sl_px-m15[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*h1_atr[0])
     {
      out.reject_reason="LODR_SL";
      return(true);
     }

   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=body/h1_atr[0];
   out.trend.slope=range/h1_atr[0];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=m15[0].close;
   out.wave.impulse_extreme=(direction>0 ? m15[0].high : m15[0].low);

   SnrPvsraReadClosed(m15,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(m15[0].close,direction,h1_atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1BbwkSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<3 || ArraySize(atr)<1 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h1[1].time<=0 || h1[1].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[1].close) ||
      !SnrFinite(h1[0].open) || !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(out.session.flatten || !out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<8 || out.session.london_hour>16)
     {
      out.reject_reason="BBWK_HOUR";
      return(true);
     }

   const int bb_h=iBands(symbol,tf,20,0,2.0,PRICE_CLOSE);
   if(bb_h==INVALID_HANDLE)
     {
      out.data_fail=true;
      out.reject_reason="BBWK_HANDLE";
      return(false);
     }
   double bb_up[];
   double bb_lo[];
   ArraySetAsSeries(bb_up,true);
   ArraySetAsSeries(bb_lo,true);
   const int got_up=CopyBuffer(bb_h,1,1,3,bb_up);
   const int got_lo=CopyBuffer(bb_h,2,1,3,bb_lo);
   IndicatorRelease(bb_h);
   if(got_up<3 || got_lo<3 || ArraySize(bb_up)<2 || ArraySize(bb_lo)<2 ||
      !SnrFinite(bb_up[0]) || !SnrFinite(bb_up[1]) ||
      !SnrFinite(bb_lo[0]) || !SnrFinite(bb_lo[1]))
     {
      out.data_fail=true;
      out.reject_reason="BBWK_COPY";
      return(false);
     }

   int direction=SNR_DIR_NONE;
   if(h1[1].close>bb_up[1] && h1[0].close>bb_up[0] && h1[0].close>h1[0].open)
      direction=SNR_DIR_LONG;
   else if(h1[1].close<bb_lo[1] && h1[0].close<bb_lo[0] && h1[0].close<h1[0].open)
      direction=SNR_DIR_SHORT;
   else
     {
      out.reject_reason="BBWK_WALK";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="BBWK_SL";
      return(true);
     }

   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=bb_up[0];
   out.trend.slope=bb_lo[0];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1DgbkSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double d_high[],d_mid[],d_low[],atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedBuffer(handles.dragon_high,8,d_high) ||
      !SnrCopyClosedBuffer(handles.dragon_mid,8,d_mid) ||
      !SnrCopyClosedBuffer(handles.dragon_low,8,d_low) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(d_high)<4 || ArraySize(d_mid)<4 ||
      ArraySize(d_low)<4 || ArraySize(atr)<1 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="DGBK_HOUR";
      return(true);
     }

   SnrDragonSnap dragon;
   if(!SnrDragonReadClosed(d_high,d_mid,d_low,atr,cfg.dragon_slope_bars,0.05,dragon) ||
      !dragon.valid)
     {
      out.data_fail=true;
      out.reject_reason="DRAGON_READ";
      return(false);
     }
   if(!dragon.angled || dragon.side==SNR_DIR_NONE)
     {
      out.reject_reason="DGBK_SLOPE";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="DGBK_RANGE";
      return(true);
     }

   int direction=SNR_DIR_NONE;
   if(dragon.side==SNR_DIR_LONG && h1[0].close>d_high[0] && h1[0].close>h1[0].open)
      direction=SNR_DIR_LONG;
   else if(dragon.side==SNR_DIR_SHORT && h1[0].close<d_low[0] && h1[0].close<h1[0].open)
      direction=SNR_DIR_SHORT;
   else
     {
      out.reject_reason="DGBK_BAND";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="DGBK_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=d_mid[0];
   out.trend.slope=dragon.slope_atr;
   out.trend.side=direction;
   out.dragon=dragon;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1PvclSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   const int avg_bars=cfg.vol_avg_bars;
   const int prior_bars=11;
   const int need=prior_bars+avg_bars+1;
   MqlRates h1[];
   double atr[];
   if(avg_bars<5 || !SnrCopyClosedRates(symbol,tf,need,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<need || ArraySize(atr)<1 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="PVCL_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="PVCL_RANGE";
      return(true);
     }

   for(int k=0;k<=prior_bars;k++)
     {
      double sum=0.0;
      double max_sv=0.0;
      for(int i=k+1;i<=k+avg_bars;i++)
        {
         const double vol=(double)h1[i].tick_volume;
         if(!SnrFinite(vol) || vol<0.0 || h1[i].high<h1[i].low)
           {
            out.data_fail=true;
            out.reject_reason="PVCL_VOL";
            return(false);
           }
         sum+=vol;
         const double sv=(h1[i].high-h1[i].low)*vol;
         if(!SnrFinite(sv) || sv<0.0)
           {
            out.data_fail=true;
            out.reject_reason="PVCL_SV";
            return(false);
           }
         if(sv>max_sv)
            max_sv=sv;
        }
      const double average=sum/(double)avg_bars;
      if(!SnrFinite(average) || average<=0.0)
        {
         out.data_fail=true;
         out.reject_reason="PVCL_AVG";
         return(false);
        }
      const int cls=SnrClassifyPvaBar(h1[k],average,cfg.vol_rising_mult,
                                      cfg.vol_climax_mult,max_sv);
      if(cls==SNR_PVSRA_UNKNOWN)
        {
         out.data_fail=true;
         out.reject_reason="PVCL_CLS";
         return(false);
        }
      if(k==0)
        {
         if(cls!=SNR_PVSRA_CLIMAX)
           {
            out.reject_reason="PVCL_NOT_CLIMAX";
            return(true);
           }
        }
      else if(cls==SNR_PVSRA_CLIMAX)
        {
         out.reject_reason="PVCL_PRIOR";
         return(true);
        }
     }

   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="PVCL_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=(double)h1[0].tick_volume;
   out.trend.slope=atr[0];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1DfltSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double d_high[],d_mid[],d_low[],atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedBuffer(handles.dragon_high,8,d_high) ||
      !SnrCopyClosedBuffer(handles.dragon_mid,8,d_mid) ||
      !SnrCopyClosedBuffer(handles.dragon_low,8,d_low) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(d_high)<4 || ArraySize(d_mid)<4 ||
      ArraySize(d_low)<4 || ArraySize(atr)<1 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="DFLT_HOUR";
      return(true);
     }

   SnrDragonSnap dragon;
   if(!SnrDragonReadClosed(d_high,d_mid,d_low,atr,cfg.dragon_slope_bars,0.05,dragon) ||
      !dragon.valid)
     {
      out.data_fail=true;
      out.reject_reason="DRAGON_READ";
      return(false);
     }
   if(dragon.angled)
     {
      out.reject_reason="DFLT_SLOPE";
      return(true);
     }

   const double width=d_high[0]-d_low[0];
   if(!SnrFinite(width) || width<=0.0 || width>1.00*atr[0])
     {
      out.reject_reason="DFLT_WIDTH";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="DFLT_RANGE";
      return(true);
     }

   int direction=SNR_DIR_NONE;
   if(h1[0].close>d_mid[0] && h1[0].close>h1[0].open)
      direction=SNR_DIR_LONG;
   else if(h1[0].close<d_mid[0] && h1[0].close<h1[0].open)
      direction=SNR_DIR_SHORT;
   else
     {
      out.reject_reason="DFLT_MID";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="DFLT_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=width/atr[0];
   out.trend.slope=dragon.slope_atr;
   out.trend.side=direction;
   out.dragon=dragon;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1FvgfSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<4 || ArraySize(atr)<1 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h1[1].time<=0 || h1[2].time<=0 || h1[3].time<=0 ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h1[1].high) || !SnrFinite(h1[1].low) ||
      !SnrFinite(h1[2].close) || !SnrFinite(h1[2].open) ||
      !SnrFinite(h1[3].high) || !SnrFinite(h1[3].low) ||
      h1[0].high<=h1[0].low || h1[1].high<=h1[1].low ||
      h1[2].high<=h1[2].low || h1[3].high<=h1[3].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="FVGF_HOUR";
      return(true);
     }

   const datetime impulse_gmt=h1[2].time-(server_now-gmt_now);
   MqlDateTime impulse_ldn;
   SnrGmtToLondon(impulse_gmt,impulse_ldn);
   if(impulse_ldn.hour>=8 && impulse_ldn.hour<16)
     {
      out.reject_reason="FVGF_LONDON_IMPULSE";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="FVGF_RANGE";
      return(true);
     }

   const double min_gap=0.15*atr[0];
   int direction=SNR_DIR_NONE;
   const double bull_gap=h1[1].low-h1[3].high;
   const double bear_gap=h1[3].low-h1[1].high;
   if(SnrFinite(bull_gap) && bull_gap>=min_gap &&
      h1[2].close>h1[2].open &&
      h1[0].low<=h1[1].low && h1[0].close>h1[1].low &&
      h1[0].close>h1[0].open)
      direction=SNR_DIR_LONG;
   else if(SnrFinite(bear_gap) && bear_gap>=min_gap &&
           h1[2].close<h1[2].open &&
           h1[0].high>=h1[1].high && h1[0].close<h1[1].high &&
           h1[0].close<h1[0].open)
      direction=SNR_DIR_SHORT;
   else
     {
      out.reject_reason="FVGF_FILL";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="FVGF_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=(direction>0 ? bull_gap : bear_gap)/atr[0];
   out.trend.slope=(double)impulse_ldn.hour;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1CadCashSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                             const SnrHandles &handles,const SnrClassicCfg &cfg,
                             const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(atr)<1 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=14)
     {
      out.reject_reason="CASH_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   const double body0=MathAbs(h1[0].close-h1[0].open);
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open ||
      !SnrFinite(body0) || body0<0.50*rng0)
     {
      out.reject_reason="CASH_RANGE";
      return(true);
     }

   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="CASH_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=body0/rng0;
   out.trend.slope=rng0/atr[0];
   out.trend.side=direction;

   if(SnrNewsUsdCadHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1NyqlSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates h4[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_H4,4,h4) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(h4)<2 || ArraySize(atr)<1 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h4[1].time<=0 || h4[1].time>=h1[0].time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h4[1].close) || !SnrFinite(h4[1].open) ||
      !SnrFinite(h4[1].high) || !SnrFinite(h4[1].low) ||
      h1[0].high<=h1[0].low || h4[1].high<=h4[1].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=14)
     {
      out.reject_reason="NYQL_HOUR";
      return(true);
     }

   const int dt_h=(int)((h1[0].time-h4[1].time)/3600);
   if(dt_h<8 || dt_h>12)
     {
      out.reject_reason="NYQL_H4_SLOT";
      return(true);
     }

   const double h4_range=h4[1].high-h4[1].low;
   const double h4_body=MathAbs(h4[1].close-h4[1].open);
   if(SnrFinite(h4_range) && h4_range>0.0 && SnrFinite(h4_body) &&
      h4[1].close!=h4[1].open && h4_body>=0.70*h4_range &&
      h4_body>=1.00*atr[0])
     {
      out.reject_reason="NYQL_LONDON_ALREADY";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   const double body0=MathAbs(h1[0].close-h1[0].open);
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open ||
      !SnrFinite(body0) || body0<0.50*rng0)
     {
      out.reject_reason="NYQL_RANGE";
      return(true);
     }

   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="NYQL_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=body0/rng0;
   out.trend.slope=(double)dt_h;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1Bos1Signal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,16,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<14 || ArraySize(atr)<1 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="BOS1_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="BOS1_RANGE";
      return(true);
     }

   int last_sh=-1;
   int last_sl=-1;
   for(int i=2;i<=12;i++)
     {
      if(!SnrFinite(h1[i].high) || !SnrFinite(h1[i].low) ||
         !SnrFinite(h1[i-1].high) || !SnrFinite(h1[i+1].high) ||
         !SnrFinite(h1[i-1].low) || !SnrFinite(h1[i+1].low) ||
         h1[i].high<=h1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="BOS1_SWING";
         return(false);
        }
      if(last_sh<0 && h1[i].high>h1[i-1].high && h1[i].high>h1[i+1].high)
         last_sh=i;
      if(last_sl<0 && h1[i].low<h1[i-1].low && h1[i].low<h1[i+1].low)
         last_sl=i;
      if(last_sh>=0 && last_sl>=0)
         break;
     }
   if(last_sh<0 || last_sl<0)
     {
      out.reject_reason="BOS1_NOSWING";
      return(true);
     }

   const bool broke_hi=(h1[0].close>h1[last_sh].high);
   const bool broke_lo=(h1[0].close<h1[last_sl].low);
   int direction=SNR_DIR_NONE;
   if(broke_hi && !broke_lo && h1[0].close>h1[0].open)
      direction=SNR_DIR_LONG;
   else if(broke_lo && !broke_hi && h1[0].close<h1[0].open)
      direction=SNR_DIR_SHORT;
   else
     {
      out.reject_reason="BOS1_BREAK";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="BOS1_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=(direction>0 ? h1[last_sh].high : h1[last_sl].low);
   out.trend.slope=(double)(direction>0 ? last_sh : last_sl);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1PnxtSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,4,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(d1)<1 || ArraySize(atr)<1 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 || d1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(d1[0].close) || !SnrFinite(d1[0].open) ||
      h1[0].high<=h1[0].low || d1[0].close==d1[0].open ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="PNXT_HOUR";
      return(true);
     }

   if(!SnrNewsUsdHighImpact(signal_gmt-36*3600,signal_gmt-8*3600))
     {
      out.reject_reason="PNXT_NO_NEWS";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="PNXT_RANGE";
      return(true);
     }

   const int bias=(d1[0].close>d1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="PNXT_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="PNXT_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=d1[0].close;
   out.trend.slope=(d1[0].close-d1[0].open)/atr[0];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1H4nxSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates h4[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_H4,24,h4) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(h4)<8 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h4[0].time<=0 || h4[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h4[0].close) || !SnrFinite(h4[0].open) ||
      !SnrFinite(h4[0].high) || !SnrFinite(h4[0].low) ||
      h1[0].high<=h1[0].low || h4[0].high<=h4[0].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="H4NX_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="H4NX_RANGE";
      return(true);
     }

   const double today_range=h4[0].high-h4[0].low;
   const double today_body=MathAbs(h4[0].close-h4[0].open);
   if(SnrFinite(today_range) && today_range>0.0 && SnrFinite(today_body) &&
      h4[0].close!=h4[0].open && today_body>=0.70*today_range &&
      today_body>=1.00*atr[0])
     {
      out.reject_reason="H4NX_TODAY";
      return(true);
     }

   MqlDateTime slot_dt;
   TimeToStruct(h4[0].time,slot_dt);
   const int slot_hour=slot_dt.hour;
   int origin=-1;
   const int n4=ArraySize(h4);
   for(int i=1;i<n4;i++)
     {
      if(!SnrFinite(h4[i].high) || !SnrFinite(h4[i].low) ||
         !SnrFinite(h4[i].close) || !SnrFinite(h4[i].open) ||
         h4[i].high<=h4[i].low || h4[i].time<=0)
        {
         out.data_fail=true;
         out.reject_reason="H4NX_PRIOR";
         return(false);
        }
      MqlDateTime bar_dt;
      TimeToStruct(h4[i].time,bar_dt);
      if(bar_dt.hour!=slot_hour)
         continue;
      const double o_range=h4[i].high-h4[i].low;
      const double o_body=MathAbs(h4[i].close-h4[i].open);
      if(!SnrFinite(o_range) || o_range<=0.0 || !SnrFinite(o_body) ||
         h4[i].close==h4[i].open || o_body<0.70*o_range ||
         o_body<1.00*atr[0])
         continue;
      origin=i;
      break;
     }
   if(origin<0)
     {
      out.reject_reason="H4NX_ORIGIN";
      return(true);
     }

   const double body_hi=MathMax(h4[origin].close,h4[origin].open);
   const double body_lo=MathMin(h4[origin].close,h4[origin].open);
   if(!SnrFinite(body_hi) || !SnrFinite(body_lo) || body_hi<=body_lo ||
      h1[0].high<body_lo || h1[0].low>body_hi)
     {
      out.reject_reason="H4NX_RETEST";
      return(true);
     }

   const int bias=(h4[origin].close>h4[origin].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="H4NX_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="H4NX_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=MathAbs(h4[origin].close-h4[origin].open)/(h4[origin].high-h4[origin].low);
   out.trend.slope=MathAbs(h4[origin].close-h4[origin].open)/atr[0];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1JtclSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<7 || h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   MqlDateTime tokyo;
   TimeToStruct(signal_gmt+9*3600,tokyo);
   if(tokyo.day_of_week==0 || tokyo.day_of_week==6)
     {
      out.reject_reason="JTCL_WKND";
      return(true);
     }
   if(tokyo.hour!=15)
     {
      out.reject_reason="JTCL_HOUR";
      return(true);
     }

   for(int i=0;i<=6;i++)
     {
      if(!SnrFinite(h1[i].close) || !SnrFinite(h1[i].open) ||
         !SnrFinite(h1[i].high) || !SnrFinite(h1[i].low) ||
         h1[i].high<=h1[i].low || h1[i].time<=0)
        {
         out.data_fail=true;
         out.reject_reason="JTCL_BAR";
         return(false);
        }
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime tk;
      TimeToStruct(bar_gmt+9*3600,tk);
      if(tk.hour!=(15-i))
        {
         out.reject_reason="JTCL_SEQ";
         return(true);
        }
     }

   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }

   const double morning_net=h1[1].close-h1[6].open;
   if(!SnrFinite(morning_net) || MathAbs(morning_net)<0.50*atr[0] ||
      morning_net==0.0)
     {
      out.reject_reason="JTCL_FLAT";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="JTCL_RANGE";
      return(true);
     }

   const int bias=(morning_net>0.0 ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="JTCL_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="JTCL_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=MathAbs(morning_net)/atr[0];
   out.trend.slope=morning_net/atr[0];
   out.trend.side=direction;

   if(SnrNewsUsdJpyHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1TkldSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,16,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<10 || h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="TKLD_HOUR";
      return(true);
     }

   MqlDateTime sig_tk;
   TimeToStruct(signal_gmt+9*3600,sig_tk);
   int i09=-1;
   int i15=-1;
   const int n=ArraySize(h1);
   for(int i=1;i<n;i++)
     {
      if(!SnrFinite(h1[i].close) || !SnrFinite(h1[i].open) ||
         !SnrFinite(h1[i].high) || !SnrFinite(h1[i].low) ||
         h1[i].high<=h1[i].low || h1[i].time<=0)
        {
         out.data_fail=true;
         out.reject_reason="TKLD_BAR";
         return(false);
        }
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime tk;
      TimeToStruct(bar_gmt+9*3600,tk);
      if(tk.year!=sig_tk.year || tk.mon!=sig_tk.mon || tk.day!=sig_tk.day)
         continue;
      if(tk.hour==9)
         i09=i;
      if(tk.hour==15)
         i15=i;
     }
   if(i09<0 || i15<0)
     {
      out.reject_reason="TKLD_TOKYO";
      return(true);
     }

   const double morning_net=h1[i15].close-h1[i09].open;
   if(!SnrFinite(morning_net) || MathAbs(morning_net)<0.50*atr[0] ||
      morning_net==0.0)
     {
      out.reject_reason="TKLD_FLAT";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="TKLD_RANGE";
      return(true);
     }

   const int bias=(morning_net>0.0 ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="TKLD_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="TKLD_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=MathAbs(morning_net)/atr[0];
   out.trend.slope=morning_net/atr[0];
   out.trend.side=direction;

   if(SnrNewsUsdJpyHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildD1DprSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(d1)<3 ||
      d1[0].time<=0 || d1[0].time>=availability_time ||
      !SnrFinite(d1[0].close) || !SnrFinite(d1[0].open) ||
      !SnrFinite(d1[0].high) || !SnrFinite(d1[0].low) ||
      d1[0].high<=d1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=d1[0].time;
   out.signal_high=d1[0].high;
   out.signal_low=d1[0].low;
   out.signal_close=d1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=d1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(out.session.flatten ||
      out.session.london_dow==0 ||
      out.session.london_dow==5 ||
      out.session.london_dow==6)
     {
      out.reject_reason="DPR_DOW";
      return(true);
     }

   const double range=d1[0].high-d1[0].low;
   const double body=MathAbs(d1[0].close-d1[0].open);
   const double upper=d1[0].high-MathMax(d1[0].open,d1[0].close);
   const double lower=MathMin(d1[0].open,d1[0].close)-d1[0].low;
   if(!SnrFinite(range) || !SnrFinite(body) || !SnrFinite(upper) ||
      !SnrFinite(lower) || range<=0.0 || body<=0.0)
     {
      out.reject_reason="DPR_BAR";
      return(true);
     }

   int direction=SNR_DIR_NONE;
   if(lower>=2.0*body && lower>=0.50*range && upper<=body &&
      d1[0].close>=0.50*(d1[0].high+d1[0].low))
      direction=SNR_DIR_LONG;
   else if(upper>=2.0*body && upper>=0.50*range && lower<=body &&
           d1[0].close<=0.50*(d1[0].high+d1[0].low))
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="DPR_PIN";
      return(true);
     }

   const double probe=(direction>0 ? d1[0].low : d1[0].high);
   const double round_px=cfg.round_whole*MathRound(probe/cfg.round_whole);
   if(!SnrFinite(round_px) || cfg.round_whole<=0.0 ||
      d1[0].low>round_px || d1[0].high<round_px)
     {
      out.reject_reason="DPR_ROUND";
      return(true);
     }

   const double sl_px=(direction>0 ? d1[0].low : d1[0].high);
   const double sl_dist=(direction>0 ? d1[0].close-sl_px : sl_px-d1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="DPR_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=(direction>0 ? lower : upper)/range;
   out.trend.slope=body/atr[0];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+24*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=d1[0].close;
   out.wave.impulse_extreme=(direction>0 ? d1[0].high : d1[0].low);

   SnrPvsraReadClosed(d1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(d1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1Ga10Signal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates xh4[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates("XAUUSD",PERIOD_H4,4,xh4) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(xh4)<1 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      xh4[0].time<=0 || xh4[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(xh4[0].close) || !SnrFinite(xh4[0].open) ||
      !SnrFinite(xh4[0].high) || !SnrFinite(xh4[0].low) ||
      h1[0].high<=h1[0].low || xh4[0].high<=xh4[0].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=10)
     {
      out.reject_reason="GA10_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="GA10_RANGE";
      return(true);
     }
   if(xh4[0].close==xh4[0].open)
     {
      out.reject_reason="GA10_GOLD";
      return(true);
     }

   const int bias=(xh4[0].close>xh4[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="GA10_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="GA10_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=MathAbs(xh4[0].close-xh4[0].open);
   out.trend.slope=(xh4[0].close-xh4[0].open)/atr[0];
   out.trend.side=direction;

   if(SnrNewsAudUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

