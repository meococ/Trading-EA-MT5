      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1H4BrkSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                           const SnrHandles &handles,const SnrClassicCfg &cfg,
                           const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 ||
      handles.h1_trend==INVALID_HANDLE || handles.h1_atr==INVALID_HANDLE)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates h4[];
   MqlRates d1[];
   double h1_atr[];
   double d1_trend[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_H4,8,h4) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,16,d1) ||
      !SnrCopyClosedBuffer(handles.atr,8,h1_atr) ||
      !SnrCopyClosedBuffer(handles.h1_trend,16,d1_trend))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<3 || ArraySize(h4)<2 || ArraySize(d1)<4 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h4[0].time<=0 || h4[0].time>=availability_time ||
      d1[0].time<=0 || d1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[1].close) ||
      !SnrFinite(h4[0].high) || !SnrFinite(h4[0].low) ||
      !SnrFinite(h1_atr[0]) || h1_atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=h1_atr[0];

   if(!SnrTrendReadClosed(d1_trend,d1[0].close,cfg.trend_slope_bars,out.trend))
     {
      out.data_fail=true;
      out.reject_reason="TREND_READ";
      return(false);
     }
   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   MqlDateTime london_clock;
   SnrGmtToLondon(signal_gmt,london_clock);
   if((cfg.use_ny_session && london_clock.hour>=cfg.ny_end_hour-1) ||
      (london_clock.day_of_week==5 && london_clock.hour>=cfg.friday_flatten_hour-1))
     {
      out.reject_reason="SESSION_TAIL";
      return(true);
     }

   const int direction=out.trend.side;
   if(direction==SNR_DIR_NONE || !SnrTrendAligned(out.trend,direction))
     {
      out.reject_reason="TREND";
      return(true);
     }
   out.direction=direction;

   const bool first_beyond=(direction>0
                            ? (h1[0].close>h4[0].high && h1[1].close<=h4[0].high)
                            : (h1[0].close<h4[0].low && h1[1].close>=h4[0].low));
   const bool with_trend_color=(direction>0 ? h1[0].close>h1[0].open
                                            : h1[0].close<h1[0].open);
   if(!first_beyond || !with_trend_color)
     {
      out.reject_reason="H4BRK";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? h1[0].low : h1[0].high);
   out.wave.pullback_price=(direction>0 ? h4[0].high : h4[0].low);
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,h1_atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildM5H4PbSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 ||
      handles.h1_trend==INVALID_HANDLE || handles.h1_atr==INVALID_HANDLE)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates m5[];
   MqlRates h4[];
   double m5_atr[];
   double h4_trend[];
   double h4_atr[];
   if(!SnrCopyClosedRates(symbol,tf,50,m5) ||
      !SnrCopyClosedRates(symbol,PERIOD_H4,6,h4) ||
      !SnrCopyClosedBuffer(handles.atr,8,m5_atr) ||
      !SnrCopyClosedBuffer(handles.h1_trend,8,h4_trend) ||
      !SnrCopyClosedBuffer(handles.h1_atr,6,h4_atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(m5)<8 || ArraySize(h4)<2 || m5[0].time<=0 ||
      m5[0].time>=availability_time || h4[0].time<=0 ||
      h4[0].time>=availability_time || !SnrFinite(m5[0].close) ||
      !SnrFinite(m5[1].close) || !SnrFinite(h4[0].open) ||
      !SnrFinite(h4[0].close) || !SnrFinite(m5_atr[0]) || m5_atr[0]<=0.0 ||
      !SnrFinite(h4_atr[0]) || h4_atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=m5[0].time;
   out.signal_high=m5[0].high;
   out.signal_low=m5[0].low;
   out.signal_close=m5[0].close;
   out.atr=m5_atr[0];

   if(!SnrTrendReadClosed(h4_trend,h4[0].close,cfg.trend_slope_bars,out.trend))
     {
      out.data_fail=true;
      out.reject_reason="TREND_READ";
      return(false);
     }
   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=m5[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   MqlDateTime london_clock;
   SnrGmtToLondon(signal_gmt,london_clock);
   if((cfg.use_ny_session && london_clock.hour>=cfg.ny_end_hour-1) ||
      (london_clock.day_of_week==5 && london_clock.hour>=cfg.friday_flatten_hour-1))
     {
      out.reject_reason="SESSION_TAIL";
      return(true);
     }

   const int direction=out.trend.side;
   if(direction==SNR_DIR_NONE || !SnrTrendAligned(out.trend,direction))
     {
      out.reject_reason="TREND";
      return(true);
     }
   out.direction=direction;

   const int h4_sec=PeriodSeconds(PERIOD_H4);
   if(h4_sec<=0)
     {
      out.data_fail=true;
      out.reject_reason="H4_PERIOD";
      return(false);
     }
   const datetime window_start=h4[0].time+(datetime)h4_sec;
   const datetime window_end=h4[0].time+(datetime)(2*h4_sec);
   if(m5[0].time<window_start || m5[0].time>=window_end)
     {
      out.reject_reason="H4PB_WINDOW";
      return(true);
     }

   const double body=MathAbs(h4[0].close-h4[0].open);
   const bool h4_color=(direction>0 ? h4[0].close>h4[0].open
                                    : h4[0].close<h4[0].open);
   if(!h4_color || body<0.50*h4_atr[0])
     {
      out.reject_reason="H4PB_IMPULSE";
      return(true);
     }

   const double body_hi=MathMax(h4[0].open,h4[0].close);
   const double body_lo=MathMin(h4[0].open,h4[0].close);
   const double body_mid=0.5*(h4[0].open+h4[0].close);
   bool tagged=false;
   double pb_ext=(direction>0 ? m5[0].low : m5[0].high);
   const int n=ArraySize(m5);
   for(int i=0; i<n; i++)
     {
      if(m5[i].time<window_start)
         break;
      if(direction>0)
        {
         if(m5[i].close<h4[0].low)
           {
            out.reject_reason="H4PB_BROKEN";
            return(true);
           }
         if(m5[i].low<=body_hi && m5[i].high>=body_lo)
           {
            tagged=true;
            if(m5[i].low<pb_ext)
               pb_ext=m5[i].low;
           }
        }
      else
        {
         if(m5[i].close>h4[0].high)
           {
            out.reject_reason="H4PB_BROKEN";
            return(true);
           }
         if(m5[i].high>=body_lo && m5[i].low<=body_hi)
           {
            tagged=true;
            if(m5[i].high>pb_ext)
               pb_ext=m5[i].high;
           }
        }
     }
   if(!tagged)
     {
      out.reject_reason="H4PB_TAG";
      return(true);
     }

   const bool first_reclaim=(direction>0
                             ? (m5[0].close>body_mid && m5[1].close<=body_mid &&
                                m5[0].close>m5[0].open)
                             : (m5[0].close<body_mid && m5[1].close>=body_mid &&
                                m5[0].close<m5[0].open));
   bool earlier_reclaim=false;
   for(int j=1; j<n-1; j++)
     {
      if(m5[j].time<window_start)
         break;
      if(direction>0)
        {
         if(m5[j].close>body_mid && m5[j+1].close<=body_mid)
            earlier_reclaim=true;
        }
      else if(m5[j].close<body_mid && m5[j+1].close>=body_mid)
         earlier_reclaim=true;
      if(earlier_reclaim)
         break;
     }
   if(!first_reclaim || earlier_reclaim)
     {
      out.reject_reason="H4PB";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=false;
   out.wave.first_break=false;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=pb_ext;
   out.wave.pullback_price=body_mid;
   out.wave.impulse_extreme=(direction>0 ? h4[0].high : h4[0].low);

   SnrPvsraReadClosed(m5,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(m5[0].close,direction,m5_atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildAnyTouchSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                            const SnrHandles &handles,const SnrClassicCfg &cfg,
                            const datetime availability_time,SnrSignalDecision &out)
  {
   if(!SnrBuildPullSignal(symbol,tf,handles,cfg,availability_time,out))
      return(false);
   if(out.fired || out.data_fail)
      return(!out.data_fail);
   if(out.reject_reason!="PULL")
      return(true);

   MqlRates rates[];
   double d_high[],d_mid[],d_low[],atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,rates) ||
      !SnrCopyClosedBuffer(handles.dragon_high,8,d_high) ||
      !SnrCopyClosedBuffer(handles.dragon_mid,8,d_mid) ||
      !SnrCopyClosedBuffer(handles.dragon_low,8,d_low) ||
      !SnrCopyClosedBuffer(handles.atr,8,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   const int direction=out.direction;
   const double touch=MathMax(cfg.dragon_touch_atr,0.05)*atr[0];
   const bool tag_any=(direction>0 ? rates[1].low<=d_mid[0]+touch
                                   : rates[1].high>=d_mid[0]-touch);
   const bool reclaim_now=(direction>0
                           ? (rates[0].close>d_mid[0] && rates[0].close>rates[0].open)
                           : (rates[0].close<d_mid[0] && rates[0].close<rates[0].open));
   const bool not_break=(direction>0 ? rates[0].close<=d_high[0]
                                    : rates[0].close>=d_low[0]);
   if(!tag_any || !reclaim_now || !not_break)
     {
      out.reject_reason="ANYTOUCH";
      return(true);
     }
   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=true;
   out.wave.break_or_reject=true;
   out.wave.first_break=false;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? MathMin(rates[0].low,rates[1].low)
                                        : MathMax(rates[0].high,rates[1].high));
   out.wave.pullback_price=out.wave.structure_swing;
   out.wave.impulse_extreme=(direction>0 ? rates[0].high : rates[0].low);
   SnrPvsraReadClosed(rates,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(rates[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }
   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1WinSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   if(!SnrBuildPullSignal(symbol,tf,handles,cfg,availability_time,out))
      return(false);
   if(out.fired)
      return(true);
   if(out.data_fail || out.reject_reason=="SESSION" || out.reject_reason=="TREND" ||
      out.reject_reason=="DRAGON" || out.reject_reason=="HANDLE_OR_CFG" ||
      out.reject_reason=="COPY_FAIL" || out.reject_reason=="STALE_OR_EMPTY" ||
      out.reject_reason=="DRAGON_READ" || out.reject_reason=="TREND_READ" ||
      out.reject_reason=="SESSION_READ" || out.reject_reason=="SCOUT_FORBIDDEN")
      return(true);

   if(handles.h1_dragon_mid==INVALID_HANDLE || handles.h1_atr==INVALID_HANDLE)
     {
      out.data_fail=true;
      out.reject_reason="H1_HANDLE";
      return(false);
     }

   MqlRates h1[];
   double h1_mid[],h1_atr[];
   if(!SnrCopyClosedRates(symbol,PERIOD_H1,16,h1) ||
      !SnrCopyClosedBuffer(handles.h1_dragon_mid,16,h1_mid) ||
      !SnrCopyClosedBuffer(handles.h1_atr,16,h1_atr))
     {
      out.data_fail=true;
      out.reject_reason="H1_COPY";
      return(false);
     }
   if(ArraySize(h1)<6 || h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1_atr[0]) || h1_atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="H1_STALE";
      return(false);
     }

   const int direction=out.direction;
   const double h1_touch=MathMax(cfg.dragon_touch_atr,0.05)*h1_atr[0];
   const bool h1_slope_ok=((direction>0 && h1_mid[0]>=h1_mid[3]) ||
                           (direction<0 && h1_mid[0]<=h1_mid[3]));
   if(!h1_slope_ok)
     {
      out.reject_reason="H1_DRAGON";
      return(true);
     }

   bool h1_window=false;
   for(int i=0;i<=1;i++)
     {
      const bool tag=(direction>0
                      ? (h1[i].low<=h1_mid[0]+h1_touch && h1[i+1].low>h1_mid[0]+h1_touch)
                      : (h1[i].high>=h1_mid[0]-h1_touch && h1[i+1].high<h1_mid[0]-h1_touch));
      if(tag)
         h1_window=true;
     }
   if(!h1_window)
     {
      out.reject_reason="H1_WINDOW";
      return(true);
     }

   MqlRates rates[];
   double d_high[],d_mid[],d_low[],atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,rates) ||
      !SnrCopyClosedBuffer(handles.dragon_high,8,d_high) ||
      !SnrCopyClosedBuffer(handles.dragon_mid,8,d_mid) ||
      !SnrCopyClosedBuffer(handles.dragon_low,8,d_low) ||
      !SnrCopyClosedBuffer(handles.atr,8,atr))
     {
      out.data_fail=true;
      out.reject_reason="M15_RECOPY";
      return(false);
     }

   const double touch=MathMax(cfg.dragon_touch_atr,0.05)*atr[0];
   const bool tag_any=(direction>0 ? rates[1].low<=d_mid[0]+touch
                                   : rates[1].high>=d_mid[0]-touch);
   const bool reclaim_now=(direction>0
                           ? (rates[0].close>d_mid[0] && rates[0].close>rates[0].open)
                           : (rates[0].close<d_mid[0] && rates[0].close<rates[0].open));
   const bool not_break=(direction>0 ? rates[0].close<=d_high[0]
                                    : rates[0].close>=d_low[0]);
   if(!tag_any || !reclaim_now || !not_break)
     {
      out.reject_reason="H1_M15";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=true;
   out.wave.break_or_reject=true;
   out.wave.first_break=false;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? MathMin(rates[0].low,rates[1].low)
                                        : MathMax(rates[0].high,rates[1].high));
   out.wave.pullback_price=out.wave.structure_swing;
   out.wave.impulse_extreme=(direction>0 ? rates[0].high : rates[0].low);
   SnrPvsraReadClosed(rates,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(rates[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }
   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildNearSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                        const SnrHandles &handles,const SnrClassicCfg &cfg,
                        const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 || cfg.lookback<32)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates rates[];
   double d_high[],d_mid[],d_low[],trend[],atr[];
   if(!SnrCopyClosedRates(symbol,tf,cfg.lookback,rates) ||
      !SnrCopyClosedBuffer(handles.dragon_high,cfg.lookback,d_high) ||
      !SnrCopyClosedBuffer(handles.dragon_mid,cfg.lookback,d_mid) ||
      !SnrCopyClosedBuffer(handles.dragon_low,cfg.lookback,d_low) ||
      !SnrCopyClosedBuffer(handles.trend,cfg.lookback,trend) ||
      !SnrCopyClosedBuffer(handles.atr,cfg.lookback,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(rates)<4 || rates[0].time<=0 || rates[0].time>=availability_time ||
      !SnrFinite(rates[0].close) || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=rates[0].time;
   out.signal_high=rates[0].high;
   out.signal_low=rates[0].low;
   out.signal_close=rates[0].close;
   out.atr=atr[0];

   if(!SnrDragonReadClosed(d_high,d_mid,d_low,atr,cfg.dragon_slope_bars,
                           cfg.dragon_min_slope_atr,out.dragon))
     {
      out.data_fail=true;
      out.reject_reason="DRAGON_READ";
      return(false);
     }
   if(!SnrTrendReadClosed(trend,rates[0].close,cfg.trend_slope_bars,out.trend))
     {
      out.data_fail=true;
      out.reject_reason="TREND_READ";
      return(false);
     }
   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=rates[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   const int direction=out.trend.side;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="TREND";
      return(true);
     }
   const bool dragon_ok=((direction>0 && d_mid[0]>=d_mid[cfg.dragon_slope_bars]) ||
                         (direction<0 && d_mid[0]<=d_mid[cfg.dragon_slope_bars]));
   if(!dragon_ok)
     {
      out.reject_reason="DRAGON";
      return(true);
     }
   out.direction=direction;

   const double touch=MathMax(cfg.dragon_touch_atr,0.05)*atr[0];
   const bool was_run=(direction>0 ? rates[2].close>d_high[0]
                                  : rates[2].close<d_low[0]);
   const bool tag_prior=(direction>0
                         ? (rates[1].low<=d_high[0]+touch && rates[2].low>d_high[0]+touch)
                         : (rates[1].high>=d_low[0]-touch && rates[2].high<d_low[0]-touch));
   const bool resume_now=(direction>0
                          ? (rates[0].close>d_high[0] && rates[0].close>rates[0].open)
                          : (rates[0].close<d_low[0] && rates[0].close<rates[0].open));
   if(!was_run || !tag_prior || !resume_now)
     {
      out.reject_reason="NEAR";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=true;
   out.wave.break_or_reject=true;
   out.wave.first_break=false;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? MathMin(rates[0].low,rates[1].low)
                                        : MathMax(rates[0].high,rates[1].high));
   out.wave.pullback_price=out.wave.structure_swing;
   out.wave.impulse_extreme=(direction>0 ? rates[0].high : rates[0].low);

   SnrPvsraReadClosed(rates,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(rates[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildEnvSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                       const SnrHandles &handles,const SnrClassicCfg &cfg,
                       const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 || cfg.lookback<32)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates rates[];
   double d_high[],d_mid[],d_low[],trend[],atr[];
   if(!SnrCopyClosedRates(symbol,tf,cfg.lookback,rates) ||
      !SnrCopyClosedBuffer(handles.dragon_high,cfg.lookback,d_high) ||
      !SnrCopyClosedBuffer(handles.dragon_mid,cfg.lookback,d_mid) ||
      !SnrCopyClosedBuffer(handles.dragon_low,cfg.lookback,d_low) ||
      !SnrCopyClosedBuffer(handles.trend,cfg.lookback,trend) ||
      !SnrCopyClosedBuffer(handles.atr,cfg.lookback,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(rates)<4 || rates[0].time<=0 || rates[0].time>=availability_time ||
      !SnrFinite(rates[0].close) || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=rates[0].time;
   out.signal_high=rates[0].high;
   out.signal_low=rates[0].low;
   out.signal_close=rates[0].close;
   out.atr=atr[0];

   if(!SnrDragonReadClosed(d_high,d_mid,d_low,atr,cfg.dragon_slope_bars,
                           cfg.dragon_min_slope_atr,out.dragon))
     {
      out.data_fail=true;
      out.reject_reason="DRAGON_READ";
      return(false);
     }
   if(!SnrTrendReadClosed(trend,rates[0].close,cfg.trend_slope_bars,out.trend))
     {
      out.data_fail=true;
      out.reject_reason="TREND_READ";
      return(false);
     }
   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=rates[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   const int direction=out.trend.side;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="TREND";
      return(true);
     }
   const bool dragon_ok=((direction>0 && d_mid[0]>=d_mid[cfg.dragon_slope_bars]) ||
                         (direction<0 && d_mid[0]<=d_mid[cfg.dragon_slope_bars]));
   if(!dragon_ok)
     {
      out.reject_reason="DRAGON";
      return(true);
     }
   out.direction=direction;

   const double touch=MathMax(cfg.dragon_touch_atr,0.05)*atr[0];
   const bool fresh_env=(direction>0
                         ? (rates[0].low<=d_low[0]+touch && rates[1].low>d_low[0]+touch)
                         : (rates[0].high>=d_high[0]-touch && rates[1].high<d_high[0]-touch));
   const bool reclaim=(direction>0
                       ? (rates[0].close>d_mid[0] && rates[0].close>rates[0].open)
                       : (rates[0].close<d_mid[0] && rates[0].close<rates[0].open));
   const bool inside_band=(direction>0 ? rates[0].close<=d_high[0]
                                       : rates[0].close>=d_low[0]);
   if(!fresh_env || !reclaim || !inside_band)
     {
      out.reject_reason="ENV";
      return(true);
     }

   const double structure=(direction>0 ? MathMin(rates[0].low,d_low[0])
                                       : MathMax(rates[0].high,d_high[0]));
   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=true;
   out.wave.break_or_reject=true;
   out.wave.first_break=false;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=structure;
   out.wave.pullback_price=structure;
   out.wave.impulse_extreme=(direction>0 ? rates[0].high : rates[0].low);

   SnrPvsraReadClosed(rates,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(rates[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildM15LnycSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                           const SnrHandles &handles,const SnrClassicCfg &cfg,
                           const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 ||
      handles.h1_trend==INVALID_HANDLE || handles.h1_atr==INVALID_HANDLE)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates m15[];
   MqlRates h1[];
   double m15_atr[];
   double h1_trend[];
   double h1_atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,m15) ||
      !SnrCopyClosedRates(symbol,PERIOD_H1,8,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,m15_atr) ||
      !SnrCopyClosedBuffer(handles.h1_trend,6,h1_trend) ||
      !SnrCopyClosedBuffer(handles.h1_atr,4,h1_atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(m15)<2 || ArraySize(h1)<2 || m15[0].time<=0 ||
      m15[0].time>=availability_time || h1[0].time<=0 ||
      h1[0].time>=availability_time || !SnrFinite(m15[0].close) ||
      !SnrFinite(h1[0].open) || !SnrFinite(h1[0].close) ||
      !SnrFinite(m15_atr[0]) || m15_atr[0]<=0.0 ||
      !SnrFinite(h1_atr[0]) || h1_atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=m15[0].time;
   out.signal_high=m15[0].high;
   out.signal_low=m15[0].low;
   out.signal_close=m15[0].close;
   out.atr=m15_atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=m15[0].time-(server_now-gmt_now);
   const datetime h1_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   MqlDateTime london;
   MqlDateTime h1_london;
   SnrGmtToLondon(signal_gmt,london);
   SnrGmtToLondon(h1_gmt,h1_london);
   const int last_london_hour=cfg.london_end_hour-1;
   if(last_london_hour<0 || london.hour!=last_london_hour || london.min<45 ||
      h1_london.hour!=last_london_hour)
     {
      out.reject_reason="LNYC_WINDOW";
      return(true);
     }

   if(!SnrTrendReadClosed(h1_trend,h1[0].close,cfg.trend_slope_bars,out.trend))
     {
      out.data_fail=true;
      out.reject_reason="TREND_READ";
      return(false);
     }
   const int direction=out.trend.side;
   if(direction==SNR_DIR_NONE || !SnrTrendAligned(out.trend,direction))
     {
      out.reject_reason="TREND";
      return(true);
     }
   out.direction=direction;

   const bool h1_color=(direction>0 ? h1[0].close>h1[0].open
                                    : h1[0].close<h1[0].open);
   const double body=MathAbs(h1[0].close-h1[0].open);
   if(!h1_color || body<0.40*h1_atr[0])
     {
      out.reject_reason="LNYC_H1";
      return(true);
     }
   const bool m15_color=(direction>0 ? m15[0].close>m15[0].open
                                     : m15[0].close<m15[0].open);
   if(!m15_color)
     {
      out.reject_reason="LNYC_M15";
      return(true);
     }

   if(SnrNewsUsdHighImpact(h1_gmt-SNR_NEWS_PAD_SEC,h1_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=false;
   out.wave.first_break=false;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? h1[0].low : h1[0].high);
   out.wave.pullback_price=h1[0].open;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(m15,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(m15[0].close,direction,m15_atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildM15NyodSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                           const SnrHandles &handles,const SnrClassicCfg &cfg,
                           const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates m15[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,m15) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(m15)<3 || m15[0].time<=0 || m15[0].time>=availability_time ||
      m15[1].time<=0 || !SnrFinite(m15[0].close) || !SnrFinite(m15[1].close) ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=m15[0].time;
   out.signal_high=m15[0].high;
   out.signal_low=m15[0].low;
   out.signal_close=m15[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=m15[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   MqlDateTime london;
   SnrGmtToLondon(signal_gmt,london);
   if(london.hour!=14 || london.min<45)
     {
      out.reject_reason="NYOD_WINDOW";
      return(true);
     }
   if((m15[0].time-m15[1].time)!=15*60)
     {
      out.reject_reason="NYOD_GAP";
      return(true);
     }

   const bool long_drive=(m15[0].close>m15[0].open && m15[1].close>m15[1].open);
   const bool short_drive=(m15[0].close<m15[0].open && m15[1].close<m15[1].open);
   if(!long_drive && !short_drive)
     {
      out.reject_reason="NYOD_COLOR";
      return(true);
     }
   const int direction=(long_drive ? SNR_DIR_LONG : SNR_DIR_SHORT);
   out.direction=direction;
   out.trend.valid=true;
   out.trend.side=direction;
   out.trend.ema=0.0;
   out.trend.slope=0.0;

   const double body=MathAbs(m15[0].close-m15[0].open);
   if(body<0.40*atr[0])
     {
      out.reject_reason="NYOD_BODY";
      return(true);
     }

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=false;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? MathMin(m15[0].low,m15[1].low)
                                        : MathMax(m15[0].high,m15[1].high));
   out.wave.pullback_price=m15[1].open;
   out.wave.impulse_extreme=(direction>0 ? MathMax(m15[0].high,m15[1].high)
                                        : MathMin(m15[0].low,m15[1].low));

   SnrPvsraReadClosed(m15,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(m15[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildM15NybrkSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                            const SnrHandles &handles,const SnrClassicCfg &cfg,
                            const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 ||
      handles.h1_trend==INVALID_HANDLE)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates m15[];
   MqlRates h4[];
   double atr[];
   double h4_trend[];
   if(!SnrCopyClosedRates(symbol,tf,48,m15) ||
      !SnrCopyClosedRates(symbol,PERIOD_H4,6,h4) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr) ||
      !SnrCopyClosedBuffer(handles.h1_trend,6,h4_trend))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(m15)<16 || ArraySize(h4)<2 || m15[0].time<=0 ||
      m15[0].time>=availability_time || h4[0].time<=0 ||
      h4[0].time>=availability_time || !SnrFinite(m15[0].close) ||
      !SnrFinite(m15[1].close) || !SnrFinite(h4[0].close) ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=m15[0].time;
   out.signal_high=m15[0].high;
   out.signal_low=m15[0].low;
   out.signal_close=m15[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime offset=server_now-gmt_now;
   const datetime signal_gmt=m15[0].time-offset;
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   MqlDateTime london;
   SnrGmtToLondon(signal_gmt,london);
   const int last_h=cfg.london_end_hour-1;
   if(last_h<cfg.london_start_hour || london.hour!=last_h || london.min>=15)
     {
      out.reject_reason="NYBRK_WINDOW";
      return(true);
     }

   if(!SnrTrendReadClosed(h4_trend,h4[0].close,cfg.trend_slope_bars,out.trend))
     {
      out.data_fail=true;
      out.reject_reason="TREND_READ";
      return(false);
     }
   const int direction=out.trend.side;
   if(direction==SNR_DIR_NONE || !SnrTrendAligned(out.trend,direction))
     {
      out.reject_reason="TREND";
      return(true);
     }
   out.direction=direction;

   const int day=london.year*10000+london.mon*100+london.day;
   double range_hi=0.0;
   double range_lo=0.0;
   int n_range=0;
   const int n=ArraySize(m15);
   for(int i=1;i<n;i++)
     {
      const datetime bar_gmt=m15[i].time-offset;
      MqlDateTime bar_london;
      SnrGmtToLondon(bar_gmt,bar_london);
      const int bar_day=bar_london.year*10000+bar_london.mon*100+bar_london.day;
      if(bar_day!=day)
         break;
      if(bar_london.hour<cfg.london_start_hour || bar_london.hour>=last_h)
         continue;
      if(n_range==0)
        {
         range_hi=m15[i].high;
         range_lo=m15[i].low;
        }
      else
        {
         if(m15[i].high>range_hi)
            range_hi=m15[i].high;
         if(m15[i].low<range_lo)
            range_lo=m15[i].low;
        }
      n_range++;
     }
   if(n_range<8 || !SnrFinite(range_hi) || !SnrFinite(range_lo) || range_hi<=range_lo)
     {
      out.reject_reason="NYBRK_RANGE";
      return(true);
     }

   const bool first_up=(m15[0].close>range_hi && m15[1].close<=range_hi);
   const bool first_dn=(m15[0].close<range_lo && m15[1].close>=range_lo);
   if((direction>0 && !first_up) || (direction<0 && !first_dn))
     {
      out.reject_reason="NYBRK";
      return(true);
     }
   if(MathAbs(m15[0].close-m15[0].open)<0.30*atr[0])
     {
      out.reject_reason="NYBRK_BODY";
      return(true);
     }

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? m15[0].low : m15[0].high);
   out.wave.pullback_price=(direction>0 ? range_hi : range_lo);
   out.wave.impulse_extreme=(direction>0 ? m15[0].high : m15[0].low);

   SnrPvsraReadClosed(m15,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(m15[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1IpgSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 ||
      handles.h1_trend==INVALID_HANDLE)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates h4[];
   double atr[];
   double h4_trend[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_H4,6,h4) ||
      !SnrCopyClosedBuffer(handles.atr,6,atr) ||
      !SnrCopyClosedBuffer(handles.h1_trend,6,h4_trend))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<3 || ArraySize(h4)<2 || ArraySize(atr)<2 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h4[0].time<=0 || h4[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[1].close) ||
      !SnrFinite(h4[0].close) ||
      !SnrFinite(atr[0]) || atr[0]<=0.0 || !SnrFinite(atr[1]) || atr[1]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   if(!SnrTrendReadClosed(h4_trend,h4[0].close,cfg.trend_slope_bars,out.trend))
     {
      out.data_fail=true;
      out.reject_reason="TREND_READ";
      return(false);
     }
   const int direction=out.trend.side;
   if(direction==SNR_DIR_NONE || !SnrTrendAligned(out.trend,direction))
     {
      out.reject_reason="TREND";
      return(true);
     }
   out.direction=direction;

   const bool impulse_color=(direction>0 ? h1[1].close>h1[1].open
                                         : h1[1].close<h1[1].open);
   const double impulse_body=MathAbs(h1[1].close-h1[1].open);
   if(!impulse_color || impulse_body<0.60*atr[1])
     {
      out.reject_reason="IPG_IMPULSE";
      return(true);
     }

   const bool go=(direction>0
                  ? (h1[0].close>h1[1].high && h1[0].close>h1[0].open)
                  : (h1[0].close<h1[1].low && h1[0].close<h1[0].open));
   if(!go)
     {
      out.reject_reason="IPG_GO";
      return(true);
     }

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=false;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? h1[1].low : h1[1].high);
   out.wave.pullback_price=h1[1].close;
   out.wave.impulse_extreme=(direction>0 ? h1[1].high : h1[1].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH4EngSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h4[];
   double trend[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h4) ||
      !SnrCopyClosedBuffer(handles.trend,6,trend) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h4)<3 || h4[0].time<=0 || h4[0].time>=availability_time ||
      !SnrFinite(h4[0].close) || !SnrFinite(h4[1].close) ||
      !SnrFinite(h4[1].open) || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h4[0].time;
   out.signal_high=h4[0].high;
   out.signal_low=h4[0].low;
   out.signal_close=h4[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h4[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   if(!SnrTrendReadClosed(trend,h4[0].close,cfg.trend_slope_bars,out.trend))
     {
      out.data_fail=true;
      out.reject_reason="TREND_READ";
      return(false);
     }
   const int direction=out.trend.side;
   if(direction==SNR_DIR_NONE || !SnrTrendAligned(out.trend,direction))
     {
      out.reject_reason="TREND";
      return(true);
     }
   out.direction=direction;

   const bool prior_opp=(direction>0 ? h4[1].close<h4[1].open
                                     : h4[1].close>h4[1].open);
   const bool now_dir=(direction>0 ? h4[0].close>h4[0].open
                                   : h4[0].close<h4[0].open);
   const bool covers=(direction>0
                      ? (h4[0].open<=h4[1].close && h4[0].close>=h4[1].open)
                      : (h4[0].open>=h4[1].close && h4[0].close<=h4[1].open));
   if(!prior_opp || !now_dir || !covers)
     {
      out.reject_reason="H4ENG";
      return(true);
     }

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+8*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=false;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? h4[0].low : h4[0].high);
   out.wave.pullback_price=h4[1].close;
   out.wave.impulse_extreme=(direction>0 ? h4[0].high : h4[0].low);

   SnrPvsraReadClosed(h4,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h4[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1ImpSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 ||
      handles.h1_trend==INVALID_HANDLE)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates h4[];
   double atr[];
   double h4_trend[];
   if(!SnrCopyClosedRates(symbol,tf,6,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_H4,6,h4) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr) ||
      !SnrCopyClosedBuffer(handles.h1_trend,6,h4_trend))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(h4)<2 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h4[0].time<=0 || h4[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h4[0].close) ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   if(!SnrTrendReadClosed(h4_trend,h4[0].close,cfg.trend_slope_bars,out.trend))
     {
      out.data_fail=true;
      out.reject_reason="TREND_READ";
      return(false);
     }
   const int direction=out.trend.side;
   if(direction==SNR_DIR_NONE || !SnrTrendAligned(out.trend,direction))
     {
      out.reject_reason="TREND";
      return(true);
     }
   out.direction=direction;

   const bool color_ok=(direction>0 ? h1[0].close>h1[0].open
                                    : h1[0].close<h1[0].open);
   const double body=MathAbs(h1[0].close-h1[0].open);
   if(!color_ok || body<0.70*atr[0])
     {
      out.reject_reason="H1IMP";
      return(true);
     }

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=false;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? h1[0].low : h1[0].high);
   out.wave.pullback_price=h1[0].open;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1L10Signal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   if(!SnrBuildH1ImpSignal(symbol,tf,handles,cfg,availability_time,out))
      return(false);
   if(out.data_fail || !out.session.valid)
      return(!out.data_fail);
   if(out.session.london_hour!=10)
     {
      out.fired=false;
      out.reject_reason="L10_WINDOW";
      return(true);
     }
   const datetime signal_gmt=out.decision_time-(TimeCurrent()-TimeGMT());
   if(out.decision_time>0 &&
      (SnrNewsCcyHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC,"EUR") ||
       SnrNewsCcyHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC,"USD")))
     {
      out.fired=false;
      out.reject_reason="NEWS";
      return(true);
     }
   return(true);
  }

bool SnrBuildH1CciSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 ||
      handles.h1_trend==INVALID_HANDLE || handles.cci==INVALID_HANDLE)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates h4[];
   double atr[];
   double h4_trend[];
   double cci[];
   if(!SnrCopyClosedRates(symbol,tf,6,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_H4,6,h4) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr) ||
      !SnrCopyClosedBuffer(handles.h1_trend,6,h4_trend) ||
      !SnrCopyClosedBuffer(handles.cci,6,cci))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<3 || ArraySize(cci)<2 || ArraySize(h4)<2 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(cci[0]) || !SnrFinite(cci[1]) ||
      !SnrFinite(atr[0]) || atr[0]<=0.0 || !SnrFinite(h4[0].close))
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   if(!SnrTrendReadClosed(h4_trend,h4[0].close,cfg.trend_slope_bars,out.trend))
     {
      out.data_fail=true;
      out.reject_reason="TREND_READ";
      return(false);
     }
   const int direction=out.trend.side;
   if(direction==SNR_DIR_NONE || !SnrTrendAligned(out.trend,direction))
     {
      out.reject_reason="TREND";
      return(true);
     }
   out.direction=direction;

   const bool cross_up=(cci[1]<=0.0 && cci[0]>0.0);
   const bool cross_dn=(cci[1]>=0.0 && cci[0]<0.0);
   if((direction>0 && !cross_up) || (direction<0 && !cross_dn))
     {
      out.reject_reason="CCI";
      return(true);
     }

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=false;
   out.wave.first_break=false;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? h1[0].low : h1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrH4SqzOn(const double bb_up,const double bb_lo,const double kc_mid,const double atr)
  {
   if(!SnrFinite(bb_up) || !SnrFinite(bb_lo) || !SnrFinite(kc_mid) ||
      !SnrFinite(atr) || atr<=0.0 || bb_up<=bb_lo)
      return(false);
   const double kc_up=kc_mid+1.5*atr;
   const double kc_lo=kc_mid-1.5*atr;
   return(bb_up<kc_up && bb_lo>kc_lo);
  }

bool SnrBuildH4SqzSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 ||
      handles.h1_trend==INVALID_HANDLE || handles.bands==INVALID_HANDLE ||
      handles.kc_ema==INVALID_HANDLE || handles.sqz_atr==INVALID_HANDLE)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h4[];
   MqlRates d1[];
   double atr[];
   double d1_trend[];
   double bb_mid[];
   double bb_up[];
   double bb_lo[];
   double kc_mid[];
   double sqz_atr[];
   if(!SnrCopyClosedRates(symbol,tf,40,h4) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,8,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr) ||
      !SnrCopyClosedBuffer(handles.h1_trend,8,d1_trend) ||
      !SnrCopyClosedBufferIdx(handles.bands,0,40,bb_mid) ||
      !SnrCopyClosedBufferIdx(handles.bands,1,40,bb_up) ||
      !SnrCopyClosedBufferIdx(handles.bands,2,40,bb_lo) ||
      !SnrCopyClosedBuffer(handles.kc_ema,40,kc_mid) ||
      !SnrCopyClosedBuffer(handles.sqz_atr,40,sqz_atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h4)<12 || ArraySize(d1)<4 || ArraySize(bb_up)<12 ||
      h4[0].time<=0 || h4[0].time>=availability_time ||
      !SnrFinite(h4[0].close) || !SnrFinite(atr[0]) || atr[0]<=0.0 ||
      !SnrFinite(d1[0].close) || !SnrFinite(d1_trend[0]))
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h4[0].time;
   out.signal_high=h4[0].high;
   out.signal_low=h4[0].low;
   out.signal_close=h4[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h4[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   if(!SnrTrendReadClosed(d1_trend,d1[0].close,cfg.trend_slope_bars,out.trend))
     {
      out.data_fail=true;
      out.reject_reason="TREND_READ";
      return(false);
     }
   const int direction=out.trend.side;
   if(direction==SNR_DIR_NONE || !SnrTrendAligned(out.trend,direction))
     {
      out.reject_reason="TREND";
      return(true);
     }
   out.direction=direction;

   if(SnrH4SqzOn(bb_up[0],bb_lo[0],kc_mid[0],sqz_atr[0]))
     {
      out.reject_reason="SQZ_ON";
      return(true);
     }

   int streak=0;
   const int n=ArraySize(h4);
   const int cap=(n<9 ? n-1 : 8);
   for(int i=1;i<=cap;i++)
     {
      if(!SnrH4SqzOn(bb_up[i],bb_lo[i],kc_mid[i],sqz_atr[i]))
         break;
      streak++;
     }
   if(streak<3)
     {
      out.reject_reason="SQZ_LEN";
      return(true);
     }

   double box_h=h4[1].high;
   double box_l=h4[1].low;
   for(int i=2;i<=streak;i++)
     {
      if(h4[i].high>box_h)
         box_h=h4[i].high;
      if(h4[i].low<box_l)
         box_l=h4[i].low;
     }
   if(!SnrFinite(box_h) || !SnrFinite(box_l) || box_h<=box_l)
     {
      out.data_fail=true;
      out.reject_reason="SQZ_BOX";
      return(false);
     }

   const bool brk_up=(h4[0].close>box_h);
   const bool brk_dn=(h4[0].close<box_l);
   if((direction>0 && !brk_up) || (direction<0 && !brk_dn))
     {
      out.reject_reason="SQZ_NOBRK";
      return(true);
     }

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+8*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? box_l : box_h);
   out.wave.pullback_price=h4[0].close;
   out.wave.impulse_extreme=(direction>0 ? h4[0].high : h4[0].low);

   SnrPvsraReadClosed(h4,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h4[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1AdxSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 ||
      handles.h1_trend==INVALID_HANDLE || handles.adx==INVALID_HANDLE)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates h4[];
   double atr[];
   double h4_trend[];
   double adx[];
   double pdi[];
   double mdi[];
   if(!SnrCopyClosedRates(symbol,tf,6,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_H4,6,h4) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr) ||
      !SnrCopyClosedBuffer(handles.h1_trend,6,h4_trend) ||
      !SnrCopyClosedBufferIdx(handles.adx,0,6,adx) ||
      !SnrCopyClosedBufferIdx(handles.adx,1,6,pdi) ||
      !SnrCopyClosedBufferIdx(handles.adx,2,6,mdi))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<3 || ArraySize(adx)<2 || ArraySize(h4)<2 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(adx[0]) || !SnrFinite(adx[1]) ||
      !SnrFinite(pdi[0]) || !SnrFinite(mdi[0]) ||
      !SnrFinite(atr[0]) || atr[0]<=0.0 || !SnrFinite(h4[0].close))
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   if(!SnrTrendReadClosed(h4_trend,h4[0].close,cfg.trend_slope_bars,out.trend))
     {
      out.data_fail=true;
      out.reject_reason="TREND_READ";
      return(false);
     }
   const int direction=out.trend.side;
   if(direction==SNR_DIR_NONE || !SnrTrendAligned(out.trend,direction))
     {
      out.reject_reason="TREND";
      return(true);
     }
   out.direction=direction;

   if(!(adx[1]<25.0 && adx[0]>=25.0))
     {
      out.reject_reason="ADX";
      return(true);
     }
   const bool di_long=(pdi[0]>mdi[0]);
   const bool di_short=(mdi[0]>pdi[0]);
   if((direction>0 && !di_long) || (direction<0 && !di_short))
     {
      out.reject_reason="DI";
      return(true);
     }

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=false;
   out.wave.first_break=false;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? h1[0].low : h1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrSupertrendFlip(const MqlRates &rates[],const double &atr[],
                       const double mult,int &flip_dir,double &st_line)
  {
   flip_dir=SNR_DIR_NONE;
   st_line=0.0;
   const int n=ArraySize(rates);
   if(n<20 || ArraySize(atr)<n || mult<=0.0)
      return(false);
   double fu[];
   double fl[];
   int dir[];
   ArrayResize(fu,n);
   ArrayResize(fl,n);
   ArrayResize(dir,n);
   for(int i=n-1;i>=0;i--)
     {
      if(!SnrFinite(rates[i].high) || !SnrFinite(rates[i].low) ||
         !SnrFinite(rates[i].close) || !SnrFinite(atr[i]) || atr[i]<=0.0)
         return(false);
      const double hl2=0.5*(rates[i].high+rates[i].low);
      const double bu=hl2+mult*atr[i];
      const double bl=hl2-mult*atr[i];
      if(i==n-1)
        {
         fu[i]=bu;
         fl[i]=bl;
         dir[i]=(rates[i].close>=hl2 ? SNR_DIR_LONG : SNR_DIR_SHORT);
         continue;
        }
      if(bu<fu[i+1] || rates[i+1].close>fu[i+1])
         fu[i]=bu;
      else
         fu[i]=fu[i+1];
      if(bl>fl[i+1] || rates[i+1].close<fl[i+1])
         fl[i]=bl;
      else
         fl[i]=fl[i+1];
      if(dir[i+1]==SNR_DIR_LONG)
         dir[i]=(rates[i].close<fl[i] ? SNR_DIR_SHORT : SNR_DIR_LONG);
      else
         dir[i]=(rates[i].close>fu[i] ? SNR_DIR_LONG : SNR_DIR_SHORT);
     }
   if(dir[0]==dir[1] || dir[0]==SNR_DIR_NONE)
      return(true);
   flip_dir=dir[0];
   st_line=(flip_dir>0 ? fl[0] : fu[0]);
   return(SnrFinite(st_line));
  }

bool SnrBuildH1StSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                        const SnrHandles &handles,const SnrClassicCfg &cfg,
                        const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 ||
      handles.h1_trend==INVALID_HANDLE)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates h4[];
   double atr[];
   double h4_trend[];
   if(!SnrCopyClosedRates(symbol,tf,40,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_H4,6,h4) ||
      !SnrCopyClosedBuffer(handles.atr,40,atr) ||
      !SnrCopyClosedBuffer(handles.h1_trend,6,h4_trend))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<20 || ArraySize(atr)<20 || ArraySize(h4)<2 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(atr[0]) || atr[0]<=0.0 ||
      !SnrFinite(h4[0].close))
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   if(!SnrTrendReadClosed(h4_trend,h4[0].close,cfg.trend_slope_bars,out.trend))
     {
      out.data_fail=true;
      out.reject_reason="TREND_READ";
      return(false);
     }
   const int direction=out.trend.side;
   if(direction==SNR_DIR_NONE || !SnrTrendAligned(out.trend,direction))
     {
      out.reject_reason="TREND";
      return(true);
     }

   int flip_dir=SNR_DIR_NONE;
   double st_line=0.0;
   if(!SnrSupertrendFlip(h1,atr,3.0,flip_dir,st_line))
     {
      out.data_fail=true;
      out.reject_reason="ST_CALC";
      return(false);
     }
   if(flip_dir==SNR_DIR_NONE || flip_dir!=direction)
     {
      out.reject_reason="ST_FLIP";
      return(true);
     }
   out.direction=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=st_line;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1IchiSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 ||
      handles.ichi==INVALID_HANDLE)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   double tenkan[];
   double kijun[];
   double span_a[];
   double span_b[];
   if(!SnrCopyClosedRates(symbol,tf,6,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr) ||
      !SnrCopyClosedBufferIdx(handles.ichi,0,4,tenkan) ||
      !SnrCopyClosedBufferIdx(handles.ichi,1,4,kijun) ||
      !SnrCopyClosedBufferIdx(handles.ichi,2,4,span_a) ||
      !SnrCopyClosedBufferIdx(handles.ichi,3,4,span_b))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<3 || ArraySize(tenkan)<2 || ArraySize(kijun)<2 ||
      ArraySize(span_a)<1 || ArraySize(span_b)<1 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(atr[0]) || atr[0]<=0.0 ||
      !SnrFinite(tenkan[0]) || !SnrFinite(tenkan[1]) ||
      !SnrFinite(kijun[0]) || !SnrFinite(kijun[1]) ||
      !SnrFinite(span_a[0]) || !SnrFinite(span_b[0]))
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   const bool cross_up=(tenkan[1]<=kijun[1] && tenkan[0]>kijun[0]);
   const bool cross_dn=(tenkan[1]>=kijun[1] && tenkan[0]<kijun[0]);
   if(!cross_up && !cross_dn)
     {
      out.reject_reason="TK";
      return(true);
     }
   const int direction=(cross_up ? SNR_DIR_LONG : SNR_DIR_SHORT);
   out.direction=direction;

   const double cloud_top=MathMax(span_a[0],span_b[0]);
   const double cloud_bot=MathMin(span_a[0],span_b[0]);
   if(!SnrFinite(cloud_top) || !SnrFinite(cloud_bot) || cloud_top<cloud_bot)
     {
      out.data_fail=true;
      out.reject_reason="KUMO";
      return(false);
     }
   if((direction>0 && h1[0].close<=cloud_top) ||
      (direction<0 && h1[0].close>=cloud_bot))
     {
      out.reject_reason="KUMO";
      return(true);
     }
   if((direction>0 && !(kijun[0]<h1[0].close)) ||
      (direction<0 && !(kijun[0]>h1[0].close)))
     {
      out.reject_reason="KIJUN";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-kijun[0] : kijun[0]-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="ICHI_SL";
      return(true);
     }

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.trend.valid=true;
   out.trend.ema=kijun[0];
   out.trend.slope=tenkan[0]-kijun[0];
   out.trend.side=direction;

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=kijun[0];
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1VolSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 ||
      handles.h1_trend==INVALID_HANDLE)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates h4[];
   double atr[];
   double h4_trend[];
   if(!SnrCopyClosedRates(symbol,tf,12,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_H4,6,h4) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr) ||
      !SnrCopyClosedBuffer(handles.h1_trend,6,h4_trend))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<12 || ArraySize(h4)<2 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(atr[0]) || atr[0]<=0.0 ||
      !SnrFinite(h4[0].close))
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   if(!SnrTrendReadClosed(h4_trend,h4[0].close,cfg.trend_slope_bars,out.trend))
     {
      out.data_fail=true;
      out.reject_reason="TREND_READ";
      return(false);
     }
   const int direction=out.trend.side;
   if(direction==SNR_DIR_NONE || !SnrTrendAligned(out.trend,direction))
     {
      out.reject_reason="TREND";
      return(true);
     }
   out.direction=direction;

   double vol_avg=0.0;
   if(!SnrVolumeAveragePrior(h1,cfg.vol_avg_bars,vol_avg))
     {
      out.data_fail=true;
      out.reject_reason="VOL_AVG";
      return(false);
     }
   const int vol_class=SnrClassifyVolume((double)h1[0].tick_volume,vol_avg,
                                         cfg.vol_rising_mult,cfg.vol_climax_mult);
   const double body=MathAbs(h1[0].close-h1[0].open);
   const bool with_color=(direction>0 ? h1[0].close>h1[0].open
                                      : h1[0].close<h1[0].open);
   const bool effort=(vol_class==SNR_PVSRA_RISING || vol_class==SNR_PVSRA_CLIMAX);
   if(!effort || !with_color || body<0.30*atr[0])
     {
      out.reject_reason="VOL";
      return(true);
     }

   if(SnrNewsEurUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=false;
   out.wave.first_break=false;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? h1[0].low : h1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1D1InSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,8,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<3 || ArraySize(d1)<3 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 || d1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[1].close) ||
      !SnrFinite(d1[0].high) || !SnrFinite(d1[0].low) ||
      !SnrFinite(d1[1].high) || !SnrFinite(d1[1].low) ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   const bool d1_inside=(d1[0].high<d1[1].high && d1[0].low>d1[1].low);
   if(!d1_inside)
     {
      out.reject_reason="D1IN";
      return(true);
     }

   const double mother_h=d1[1].high;
   const double mother_l=d1[1].low;
   const bool brk_up=(h1[0].close>mother_h && h1[1].close<=mother_h);
   const bool brk_dn=(h1[0].close<mother_l && h1[1].close>=mother_l);
   int direction=SNR_DIR_NONE;
   if(brk_up)
      direction=SNR_DIR_LONG;
   else if(brk_dn)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="D1IN_BRK";
      return(true);
     }
   const bool with_color=(direction>0 ? h1[0].close>h1[0].open
                                      : h1[0].close<h1[0].open);
   if(!with_color)
     {
      out.reject_reason="D1IN_COLOR";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=0.5*(mother_h+mother_l);
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsGbpUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? mother_l : mother_h);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1AsiacSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                           const SnrHandles &handles,const SnrClassicCfg &cfg,
                           const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,24,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<10 || h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[1].close) ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   MqlDateTime sig_ldn;
   SnrGmtToLondon(signal_gmt,sig_ldn);
   double asia_h=0.0;
   double asia_l=0.0;
   double asia_c=0.0;
   int asia_n=0;
   int asia_last_hour=-1;
   bool asia_init=false;
   const int n=ArraySize(h1);
   for(int i=0;i<n;i++)
     {
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      if(bar_ldn.year!=sig_ldn.year || bar_ldn.mon!=sig_ldn.mon ||
         bar_ldn.day!=sig_ldn.day)
         continue;
      if(bar_ldn.hour<0 || bar_ldn.hour>=8)
         continue;
      if(!SnrFinite(h1[i].high) || !SnrFinite(h1[i].low) || !SnrFinite(h1[i].close))
         {
          out.data_fail=true;
          out.reject_reason="ASIA_BAR";
          return(false);
         }
      if(!asia_init)
        {
         asia_h=h1[i].high;
         asia_l=h1[i].low;
         asia_init=true;
        }
      else
        {
         if(h1[i].high>asia_h)
            asia_h=h1[i].high;
         if(h1[i].low<asia_l)
            asia_l=h1[i].low;
        }
      if(bar_ldn.hour>=asia_last_hour)
        {
         asia_last_hour=bar_ldn.hour;
         asia_c=h1[i].close;
        }
      asia_n++;
     }
   if(!asia_init || asia_n<4 || asia_last_hour<7 || asia_h<=asia_l ||
      !SnrFinite(asia_c))
     {
      out.reject_reason="ASIA_LEN";
      return(true);
     }

   const double q=(asia_c-asia_l)/(asia_h-asia_l);
   int direction=SNR_DIR_NONE;
   if(q>=0.75)
      direction=SNR_DIR_LONG;
   else if(q<=0.25)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="ASIA_Q";
      return(true);
     }

   const bool first=(direction>0
                     ? (h1[0].close>asia_c && h1[1].close<=asia_c)
                     : (h1[0].close<asia_c && h1[1].close>=asia_c));
   const bool with_color=(direction>0 ? h1[0].close>h1[0].open
                                      : h1[0].close<h1[0].open);
   if(!first || !with_color)
     {
      out.reject_reason="ASIAC";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=asia_c;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsAudUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? asia_l : asia_h);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1AudcSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates nzd[];
   MqlRates aud[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,12,nzd) ||
      !SnrCopyClosedRates("AUDUSD",tf,12,aud) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(nzd)<3 || ArraySize(aud)<12 ||
      nzd[0].time<=0 || nzd[0].time>=availability_time ||
      aud[0].time<=0 || aud[0].time>=availability_time ||
      nzd[0].time!=aud[0].time ||
      !SnrFinite(nzd[0].close) || !SnrFinite(aud[0].close) ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=nzd[0].time;
   out.signal_high=nzd[0].high;
   out.signal_low=nzd[0].low;
   out.signal_close=nzd[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=nzd[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   double aud_rng=0.0;
   int rng_n=0;
   for(int i=1;i<=10;i++)
     {
      const double w=aud[i].high-aud[i].low;
      if(!SnrFinite(w) || w<=0.0)
         continue;
      aud_rng+=w;
      rng_n++;
     }
   if(rng_n<5 || aud_rng<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="AUD_ATR";
      return(false);
     }
   aud_rng/=(double)rng_n;

   const double nzd_body=MathAbs(nzd[0].close-nzd[0].open);
   const double aud_body=MathAbs(aud[0].close-aud[0].open);
   const bool nzd_up=(nzd[0].close>nzd[0].open);
   const bool nzd_dn=(nzd[0].close<nzd[0].open);
   const bool aud_up=(aud[0].close>aud[0].open);
   const bool aud_dn=(aud[0].close<aud[0].open);
   int direction=SNR_DIR_NONE;
   if(nzd_up && aud_up)
      direction=SNR_DIR_LONG;
   else if(nzd_dn && aud_dn)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE || nzd_body<0.30*atr[0] || aud_body<0.30*aud_rng)
     {
      out.reject_reason="AUDC";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=aud[0].close;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsNzdUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=false;
   out.wave.first_break=false;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? nzd[0].low : nzd[0].high);
   out.wave.pullback_price=nzd[0].close;
   out.wave.impulse_extreme=(direction>0 ? nzd[0].high : nzd[0].low);

   SnrPvsraReadClosed(nzd,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(nzd[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1RndSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 || cfg.round_whole<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,6,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<3 || h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   const double step=cfg.round_whole;
   const double support=step*MathCeil((h1[0].low+1.0e-8)/step);
   const double resist=step*MathFloor((h1[0].high-1.0e-8)/step);
   const bool bounce_up=(support>h1[0].low && support<h1[0].close &&
                         h1[0].close>h1[0].open &&
                         (support-h1[0].low)>=0.15*atr[0]);
   const bool bounce_dn=(resist<h1[0].high && resist>h1[0].close &&
                         h1[0].close<h1[0].open &&
                         (h1[0].high-resist)>=0.15*atr[0]);
   int direction=SNR_DIR_NONE;
   if(bounce_up && !bounce_dn)
      direction=SNR_DIR_LONG;
   else if(bounce_dn && !bounce_up)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="RND";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=(direction>0 ? support : resist);
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdChfHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=false;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? h1[0].low : h1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1PdcSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,6,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,4,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<3 || ArraySize(d1)<2 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 || d1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[1].close) ||
      !SnrFinite(d1[0].close) || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   const double pdc=d1[0].close;
   const bool cross_up=(h1[0].close>pdc && h1[1].close<=pdc && h1[0].close>h1[0].open);
   const bool cross_dn=(h1[0].close<pdc && h1[1].close>=pdc && h1[0].close<h1[0].open);
   int direction=SNR_DIR_NONE;
   if(cross_up)
      direction=SNR_DIR_LONG;
   else if(cross_dn)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="PDC";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=pdc;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdCadHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? h1[0].low : h1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

int SnrFractalSwingHigh(const MqlRates &rates[],const int strength)
  {
   const int n=ArraySize(rates);
   if(strength<1 || n<2*strength+1)
      return(-1);
   for(int k=strength;k<=n-1-strength;k++)
     {
      bool ok=true;
      for(int j=1;j<=strength;j++)
        {
         if(!(rates[k].high>rates[k-j].high && rates[k].high>rates[k+j].high))
           {
            ok=false;
            break;
           }
        }
      if(ok)
         return(k);
     }
   return(-1);
  }

int SnrFractalSwingLow(const MqlRates &rates[],const int strength)
  {
   const int n=ArraySize(rates);
   if(strength<1 || n<2*strength+1)
      return(-1);
   for(int k=strength;k<=n-1-strength;k++)
     {
      bool ok=true;
      for(int j=1;j<=strength;j++)
        {
         if(!(rates[k].low<rates[k-j].low && rates[k].low<rates[k+j].low))
           {
            ok=false;
            break;
           }
        }
      if(ok)
         return(k);
     }
   return(-1);
  }

bool SnrBuildH4SwgSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h4[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,40,h4) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h4)<12 || h4[0].time<=0 || h4[0].time>=availability_time ||
      !SnrFinite(h4[0].close) || !SnrFinite(h4[1].close) ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h4[0].time;
   out.signal_high=h4[0].high;
   out.signal_low=h4[0].low;
   out.signal_close=h4[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h4[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   const int strength=(cfg.swing_strength>=2 ? cfg.swing_strength : 2);
   const int sh=SnrFractalSwingHigh(h4,strength);
   const int sl=SnrFractalSwingLow(h4,strength);
   if(sh<strength || sl<strength)
     {
      out.reject_reason="SWG_NONE";
      return(true);
     }
   const bool brk_up=(h4[0].close>h4[sh].high && h4[1].close<=h4[sh].high &&
                      h4[0].close>h4[0].open);
   const bool brk_dn=(h4[0].close<h4[sl].low && h4[1].close>=h4[sl].low &&
                      h4[0].close<h4[0].open);
   int direction=SNR_DIR_NONE;
   double structure=0.0;
   if(brk_up && !brk_dn)
     {
      direction=SNR_DIR_LONG;
      structure=h4[sl].low;
      if(sl<sh)
         structure=h4[sh].low;
     }
   else if(brk_dn && !brk_up)
     {
      direction=SNR_DIR_SHORT;
      structure=h4[sh].high;
      if(sh<sl)
         structure=h4[sl].high;
     }
   if(direction==SNR_DIR_NONE || !SnrFinite(structure))
     {
      out.reject_reason="SWG";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=(direction>0 ? h4[sh].high : h4[sl].low);
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+8*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=structure;
   out.wave.pullback_price=h4[0].close;
   out.wave.impulse_extreme=(direction>0 ? h4[0].high : h4[0].low);

   SnrPvsraReadClosed(h4,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h4[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1D1qSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,6,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,4,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<3 || ArraySize(d1)<2 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 || d1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[1].close) ||
      !SnrFinite(d1[0].close) || !SnrFinite(d1[0].high) || !SnrFinite(d1[0].low) ||
      d1[0].high<=d1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   const double q=(d1[0].close-d1[0].low)/(d1[0].high-d1[0].low);
   int direction=SNR_DIR_NONE;
   if(q>=0.75)
      direction=SNR_DIR_LONG;
   else if(q<=0.25)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="D1Q";
      return(true);
     }
   const bool cont=(direction>0
                    ? (h1[0].close>d1[0].close && h1[1].close<=d1[0].close &&
                       h1[0].close>h1[0].open)
                    : (h1[0].close<d1[0].close && h1[1].close>=d1[0].close &&
                       h1[0].close<h1[0].open));
   if(!cont)
     {
      out.reject_reason="D1Q_CONT";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=d1[0].close;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? d1[0].low : d1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1D1q2Signal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,6,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,4,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<3 || ArraySize(d1)<2 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 || d1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[1].close) ||
      !SnrFinite(d1[0].close) || !SnrFinite(d1[0].high) || !SnrFinite(d1[0].low) ||
      d1[0].high<=d1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   const datetime prev_gmt=h1[1].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   SnrSessionSnap prev_sess;
   if(!SnrSessionRead(prev_gmt,cfg,prev_sess))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   MqlDateTime h0ldn;
   MqlDateTime h1ldn;
   SnrGmtToLondon(signal_gmt,h0ldn);
   SnrGmtToLondon(prev_gmt,h1ldn);
   const bool first_sess=(!prev_sess.entry_allowed ||
                          h0ldn.year!=h1ldn.year ||
                          h0ldn.mon!=h1ldn.mon ||
                          h0ldn.day!=h1ldn.day);
   if(!first_sess)
     {
      out.reject_reason="D1Q_FIRST";
      return(true);
     }

   const double q=(d1[0].close-d1[0].low)/(d1[0].high-d1[0].low);
   int direction=SNR_DIR_NONE;
   if(q>=0.75)
      direction=SNR_DIR_LONG;
   else if(q<=0.25)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="D1Q";
      return(true);
     }
   const bool with_color=(direction>0 ? h1[0].close>h1[0].open
                                      : h1[0].close<h1[0].open);
   if(!with_color)
     {
      out.reject_reason="D1Q_COLOR";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=d1[0].close;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? d1[0].low : d1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1D1q3Signal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   if(!SnrBuildH1D1qSignal(symbol,tf,handles,cfg,availability_time,out))
      return(false);
   if(!out.fired)
      return(true);
   out.wave.structure_swing=(out.direction>0 ? out.signal_low : out.signal_high);
   return(true);
  }

bool SnrBuildH1AdrlSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,36,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,16,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<12 || ArraySize(d1)<14 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 || d1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   MqlDateTime sig_ldn;
   SnrGmtToLondon(signal_gmt,sig_ldn);
   if(sig_ldn.hour<10 || sig_ldn.hour>15)
     {
      out.reject_reason="ADRL_HOUR";
      return(true);
     }

   double adr_sum=0.0;
   int adr_n=0;
   for(int i=0;i<14;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) || d1[i].high<=d1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="ADR_BAR";
         return(false);
        }
      adr_sum+=(d1[i].high-d1[i].low);
      adr_n++;
     }
   const double adr=adr_sum/(double)adr_n;
   if(!SnrFinite(adr) || adr<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="ADR_EMPTY";
      return(false);
     }

   double day_h=0.0;
   double day_l=0.0;
   double day_open=0.0;
   int day_n=0;
   int earliest_hour=99;
   bool day_init=false;
   const int n=ArraySize(h1);
   for(int i=0;i<n;i++)
     {
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      if(bar_ldn.year<sig_ldn.year ||
         (bar_ldn.year==sig_ldn.year && bar_ldn.mon<sig_ldn.mon) ||
         (bar_ldn.year==sig_ldn.year && bar_ldn.mon==sig_ldn.mon &&
          bar_ldn.day<sig_ldn.day))
         break;
      if(bar_ldn.year!=sig_ldn.year || bar_ldn.mon!=sig_ldn.mon ||
         bar_ldn.day!=sig_ldn.day)
         continue;
      if(!SnrFinite(h1[i].high) || !SnrFinite(h1[i].low) || !SnrFinite(h1[i].open))
        {
         out.data_fail=true;
         out.reject_reason="DAY_BAR";
         return(false);
        }
      if(!day_init)
        {
         day_h=h1[i].high;
         day_l=h1[i].low;
         day_init=true;
        }
      else
        {
         if(h1[i].high>day_h)
            day_h=h1[i].high;
         if(h1[i].low<day_l)
            day_l=h1[i].low;
        }
      if(bar_ldn.hour<=earliest_hour)
        {
         earliest_hour=bar_ldn.hour;
         day_open=h1[i].open;
        }
      day_n++;
     }
   if(!day_init || day_n<8 || earliest_hour>1 || day_h<=day_l ||
      !SnrFinite(day_open))
     {
      out.reject_reason="ADRL_LEN";
      return(true);
     }

   const double consumed=day_h-day_l;
   if(!SnrFinite(consumed) || consumed<=0.0 || consumed>0.50*adr)
     {
      out.reject_reason="ADRL_USED";
      return(true);
     }
   const double drift=h1[0].close-day_open;
   if(!SnrFinite(drift) || MathAbs(drift)<0.20*consumed)
     {
      out.reject_reason="ADRL_DRIFT";
      return(true);
     }
   const int direction=(drift>0.0 ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const bool with_color=(direction>0 ? h1[0].close>h1[0].open
                                      : h1[0].close<h1[0].open);
   if(!with_color)
     {
      out.reject_reason="ADRL_COLOR";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=day_open;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? day_l : day_h);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1WosSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,120,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<24 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   MqlDateTime sig_ldn;
   SnrGmtToLondon(signal_gmt,sig_ldn);
   MqlDateTime z=sig_ldn;
   z.hour=0;
   z.min=0;
   z.sec=0;
   const int back=(sig_ldn.day_of_week==0 ? 6 : sig_ldn.day_of_week-1);
   const datetime monday_dt=StructToTime(z)-(datetime)(back*86400);
   MqlDateTime mon;
   TimeToStruct(monday_dt,mon);
   const int monday_ymd=mon.year*10000+mon.mon*100+mon.day;
   const int sig_ymd=sig_ldn.year*10000+sig_ldn.mon*100+sig_ldn.day;
   if(monday_ymd<=0 || sig_ymd<monday_ymd)
     {
      out.data_fail=true;
      out.reject_reason="WEEK_DATE";
      return(false);
     }

   double week_h=0.0;
   double week_l=0.0;
   double week_open=0.0;
   int week_n=0;
   int earliest_ymd=99999999;
   int earliest_hour=99;
   bool week_init=false;
   const int n=ArraySize(h1);
   for(int i=0;i<n;i++)
     {
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      const int bar_ymd=bar_ldn.year*10000+bar_ldn.mon*100+bar_ldn.day;
      if(bar_ymd<monday_ymd)
         break;
      if(bar_ymd>sig_ymd)
         continue;
      if(!SnrFinite(h1[i].high) || !SnrFinite(h1[i].low) || !SnrFinite(h1[i].open))
        {
         out.data_fail=true;
         out.reject_reason="WEEK_BAR";
         return(false);
        }
      if(!week_init)
        {
         week_h=h1[i].high;
         week_l=h1[i].low;
         week_init=true;
        }
      else
        {
         if(h1[i].high>week_h)
            week_h=h1[i].high;
         if(h1[i].low<week_l)
            week_l=h1[i].low;
        }
      if(bar_ymd<earliest_ymd ||
         (bar_ymd==earliest_ymd && bar_ldn.hour<=earliest_hour))
        {
         earliest_ymd=bar_ymd;
         earliest_hour=bar_ldn.hour;
         week_open=h1[i].open;
        }
      week_n++;
     }
   if(!week_init || week_n<12 || earliest_ymd>monday_ymd+1 ||
      week_h<=week_l || !SnrFinite(week_open))
     {
      out.reject_reason="WOS_LEN";
      return(true);
     }

   const double stretch=h1[0].close-week_open;
   if(!SnrFinite(stretch) || MathAbs(stretch)<atr[0])
     {
      out.reject_reason="WOS_STRETCH";
      return(true);
     }
   const int direction=(stretch>0.0 ? SNR_DIR_SHORT : SNR_DIR_LONG);
   const bool with_color=(direction>0 ? h1[0].close>h1[0].open
                                      : h1[0].close<h1[0].open);
   if(!with_color)
     {
      out.reject_reason="WOS_COLOR";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-week_l : week_h-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="WOS_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=week_open;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? week_l : week_h);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1LfailSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                           const SnrHandles &handles,const SnrClassicCfg &cfg,
                           const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<3 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h1[1].time<=0 || h1[1].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[1].close) || !SnrFinite(h1[1].open) ||
      !SnrFinite(h1[1].high) || !SnrFinite(h1[1].low) ||
      h1[1].high<=h1[1].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   const datetime drive_gmt=h1[1].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   MqlDateTime sig_ldn;
   MqlDateTime drv_ldn;
   SnrGmtToLondon(signal_gmt,sig_ldn);
   SnrGmtToLondon(drive_gmt,drv_ldn);
   if(sig_ldn.hour!=9 || drv_ldn.hour!=8 ||
      sig_ldn.year!=drv_ldn.year || sig_ldn.mon!=drv_ldn.mon ||
      sig_ldn.day!=drv_ldn.day)
     {
      out.reject_reason="LFAIL_HOUR";
      return(true);
     }

   const double drive_body=MathAbs(h1[1].close-h1[1].open);
   if(!SnrFinite(drive_body) || drive_body<0.50*atr[0])
     {
      out.reject_reason="LFAIL_DRIVE";
      return(true);
     }
   const int drive_dir=(h1[1].close>h1[1].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(drive_dir==SNR_DIR_NONE)
     {
      out.reject_reason="LFAIL_DRIVE";
      return(true);
     }
   if(h1[0].close>=h1[1].high || h1[0].close<=h1[1].low)
     {
      out.reject_reason="LFAIL_INSIDE";
      return(true);
     }
   const int direction=(drive_dir>0 ? SNR_DIR_SHORT : SNR_DIR_LONG);
   const bool with_color=(direction>0 ? h1[0].close>h1[0].open
                                      : h1[0].close<h1[0].open);
   if(!with_color)
     {
      out.reject_reason="LFAIL_COLOR";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=h1[1].close;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsEurUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? h1[1].low : h1[1].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1UsdxSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }
   if(!SymbolSelect("EURUSD",true))
     {
      out.data_fail=true;
      out.reject_reason="EURUSD_SELECT";
      return(false);
     }

   MqlRates h1[];
   MqlRates eu[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates("EURUSD",tf,8,eu) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<4 || ArraySize(eu)<4 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h1[1].time<=0 || eu[1].time<=0 ||
      eu[1].time!=h1[1].time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(eu[1].close) || !SnrFinite(eu[1].open) ||
      !SnrFinite(eu[1].high) || !SnrFinite(eu[1].low) ||
      eu[1].high<=eu[1].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   const double eu_range=eu[1].high-eu[1].low;
   const double eu_body=MathAbs(eu[1].close-eu[1].open);
   if(!SnrFinite(eu_range) || !SnrFinite(eu_body) ||
      eu_body<0.60*eu_range || eu_body<0.00050)
     {
      out.reject_reason="USDX_IMPULSE";
      return(true);
     }
   const int usd_weak=(eu[1].close>eu[1].open ? 1 : -1);
   const int direction=(usd_weak>0 ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const bool with_color=(direction>0 ? h1[0].close>h1[0].open
                                      : h1[0].close<h1[0].open);
   if(!with_color)
     {
      out.reject_reason="USDX_COLOR";
      return(true);
     }
   double box_h=h1[0].high;
   double box_l=h1[0].low;
   for(int i=1;i<=3;i++)
     {
      if(!SnrFinite(h1[i].high) || !SnrFinite(h1[i].low))
        {
         out.data_fail=true;
         out.reject_reason="USDX_BOX";
         return(false);
        }
      if(h1[i].high>box_h)
         box_h=h1[i].high;
      if(h1[i].low<box_l)
         box_l=h1[i].low;
     }
   const double sl_dist=(direction>0 ? h1[0].close-box_l : box_h-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0] || box_h<=box_l)
     {
      out.reject_reason="USDX_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=eu[1].close;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? box_l : box_h);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1DopSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,36,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<12 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[1].close) || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   MqlDateTime sig_ldn;
   SnrGmtToLondon(signal_gmt,sig_ldn);
   double day_h=0.0;
   double day_l=0.0;
   double day_open=0.0;
   int day_n=0;
   int earliest_hour=99;
   bool day_init=false;
   const int n=ArraySize(h1);
   for(int i=0;i<n;i++)
     {
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      if(bar_ldn.year<sig_ldn.year ||
         (bar_ldn.year==sig_ldn.year && bar_ldn.mon<sig_ldn.mon) ||
         (bar_ldn.year==sig_ldn.year && bar_ldn.mon==sig_ldn.mon &&
          bar_ldn.day<sig_ldn.day))
         break;
      if(bar_ldn.year!=sig_ldn.year || bar_ldn.mon!=sig_ldn.mon ||
         bar_ldn.day!=sig_ldn.day)
         continue;
      if(!SnrFinite(h1[i].high) || !SnrFinite(h1[i].low) || !SnrFinite(h1[i].open))
        {
         out.data_fail=true;
         out.reject_reason="DAY_BAR";
         return(false);
        }
      if(!day_init)
        {
         day_h=h1[i].high;
         day_l=h1[i].low;
         day_init=true;
        }
      else
        {
         if(h1[i].high>day_h)
            day_h=h1[i].high;
         if(h1[i].low<day_l)
            day_l=h1[i].low;
        }
      if(bar_ldn.hour<=earliest_hour)
        {
         earliest_hour=bar_ldn.hour;
         day_open=h1[i].open;
        }
      day_n++;
     }
   if(!day_init || day_n<8 || earliest_hour>1 || day_h<=day_l ||
      !SnrFinite(day_open))
     {
      out.reject_reason="DOP_LEN";
      return(true);
     }

   const datetime prev_gmt=h1[1].time-(server_now-gmt_now);
   MqlDateTime prev_ldn;
   SnrGmtToLondon(prev_gmt,prev_ldn);
   if(prev_ldn.year!=sig_ldn.year || prev_ldn.mon!=sig_ldn.mon ||
      prev_ldn.day!=sig_ldn.day)
     {
      out.reject_reason="DOP_PREV";
      return(true);
     }

   int direction=SNR_DIR_NONE;
   if(h1[0].close>day_open && h1[1].close<=day_open)
      direction=SNR_DIR_LONG;
   else if(h1[0].close<day_open && h1[1].close>=day_open)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="DOP_RECROSS";
      return(true);
     }
   const bool with_color=(direction>0 ? h1[0].close>h1[0].open
                                      : h1[0].close<h1[0].open);
   if(!with_color)
     {
      out.reject_reason="DOP_COLOR";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-day_l : day_h-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="DOP_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=day_open;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? day_l : day_h);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

