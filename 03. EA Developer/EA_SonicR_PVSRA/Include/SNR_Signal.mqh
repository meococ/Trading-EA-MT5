      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="H4BA_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="H4BA_RANGE";
      return(true);
     }

   const double h4_body=MathAbs(h4[0].close-h4[0].open);
   if(!SnrFinite(h4_body) || h4_body<1.00*atr[0] || h4[0].close==h4[0].open)
     {
      out.reject_reason="H4BA_BODY";
      return(true);
     }

   const int bias=(h4[0].close>h4[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
