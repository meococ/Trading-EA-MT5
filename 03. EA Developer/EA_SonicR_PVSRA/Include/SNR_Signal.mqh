                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(m15[0].close,direction,m15_atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildM5H1BrkSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                           const SnrHandles &handles,const SnrClassicCfg &cfg,
                           const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 ||
      handles.h1_trend==INVALID_HANDLE || handles.h1_atr==INVALID_HANDLE)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates m5[];
   MqlRates h1[];
   double m5_atr[];
   double h1_trend[];
   if(!SnrCopyClosedRates(symbol,tf,8,m5) ||
      !SnrCopyClosedRates(symbol,PERIOD_H1,16,h1) ||
      !SnrCopyClosedBuffer(handles.atr,8,m5_atr) ||
      !SnrCopyClosedBuffer(handles.h1_trend,16,h1_trend))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(m5)<3 || ArraySize(h1)<4 || m5[0].time<=0 ||
      m5[0].time>=availability_time || h1[0].time<=0 ||
      h1[0].time>=availability_time || !SnrFinite(m5[0].close) ||
      !SnrFinite(m5[1].close) || !SnrFinite(h1[0].high) ||
      !SnrFinite(m5_atr[0]) || m5_atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=m5[0].time;
   out.signal_high=m5[0].high;
   out.signal_low=m5[0].low;
   out.signal_close=m5[0].close;
   out.atr=m5_atr[0];

   if(!SnrTrendReadClosed(h1_trend,h1[0].close,cfg.trend_slope_bars,out.trend))
     {
      out.data_fail=true;
      out.reject_reason="TREND_READ";
      return(false);
     }
   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=m5[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   MqlDateTime london_clock;
   SnrGmtToLondon(signal_gmt,london_clock);
   if((cfg.use_ny_session && london_clock.hour>=cfg.ny_end_hour-1) ||
      (london_clock.day_of_week==5 && london_clock.hour>=cfg.friday_flatten_hour-1))
     {
      out.reject_reason="SESSION_TAIL";
      return(true);
     }

   const int direction=out.trend.side;
   if(direction==SNR_DIR_NONE || !SnrTrendAligned(out.trend,direction))
     {
      out.reject_reason="TREND";
      return(true);
     }
   out.direction=direction;

   const bool first_beyond=(direction>0
                            ? (m5[0].close>h1[0].high && m5[1].close<=h1[0].high)
                            : (m5[0].close<h1[0].low && m5[1].close>=h1[0].low));
   const bool with_trend_color=(direction>0 ? m5[0].close>m5[0].open
                                            : m5[0].close<m5[0].open);
   if(!first_beyond || !with_trend_color)
     {
      out.reject_reason="H1BRK";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? MathMin(m5[0].low,m5[1].low)
                                         : MathMax(m5[0].high,m5[1].high));
   out.wave.pullback_price=(direction>0 ? h1[0].high : h1[0].low);
   out.wave.impulse_extreme=(direction>0 ? m5[0].high : m5[0].low);

   SnrPvsraReadClosed(m5,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(m5[0].close,direction,m5_atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildM15LorbSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                           const SnrHandles &handles,const SnrClassicCfg &cfg,
                           const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 ||
      handles.h1_trend==INVALID_HANDLE || handles.h1_atr==INVALID_HANDLE)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates m15[];
   MqlRates h1[];
   double m15_atr[];
   double h1_trend[];
   if(!SnrCopyClosedRates(symbol,tf,48,m15) ||
      !SnrCopyClosedRates(symbol,PERIOD_H1,16,h1) ||
      !SnrCopyClosedBuffer(handles.atr,16,m15_atr) ||
      !SnrCopyClosedBuffer(handles.h1_trend,16,h1_trend))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(m15)<8 || ArraySize(h1)<4 || m15[0].time<=0 ||
      m15[0].time>=availability_time || h1[0].time<=0 ||
      h1[0].time>=availability_time || !SnrFinite(m15[0].close) ||
      !SnrFinite(m15[1].close) || !SnrFinite(m15_atr[0]) || m15_atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=m15[0].time;
   out.signal_high=m15[0].high;
   out.signal_low=m15[0].low;
   out.signal_close=m15[0].close;
   out.atr=m15_atr[0];

   if(!SnrTrendReadClosed(h1_trend,h1[0].close,cfg.trend_slope_bars,out.trend))
     {
      out.data_fail=true;
      out.reject_reason="TREND_READ";
      return(false);
     }
   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=m15[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   MqlDateTime london_clock;
   SnrGmtToLondon(signal_gmt,london_clock);
   if((cfg.use_ny_session && london_clock.hour>=cfg.ny_end_hour-1) ||
      (london_clock.day_of_week==5 && london_clock.hour>=cfg.friday_flatten_hour-1))
     {
      out.reject_reason="SESSION_TAIL";
      return(true);
     }
   if(london_clock.hour<cfg.london_start_hour+1)
     {
      out.reject_reason="OR_WAIT";
      return(true);
     }

   const int direction=out.trend.side;
   if(direction==SNR_DIR_NONE || !SnrTrendAligned(out.trend,direction))
     {
      out.reject_reason="TREND";
      return(true);
     }
   out.direction=direction;

   int or_count=0;
   double or_high=-1.0e100;
   double or_low=1.0e100;
   const int n=ArraySize(m15);
   for(int i=1;i<n;i++)
     {
      MqlDateTime bar_london;
      const datetime bar_gmt=m15[i].time-(server_now-gmt_now);
      SnrGmtToLondon(bar_gmt,bar_london);
      if(bar_london.year!=london_clock.year || bar_london.mon!=london_clock.mon ||
         bar_london.day!=london_clock.day || bar_london.hour!=cfg.london_start_hour)
         continue;
      or_count++;
      if(m15[i].high>or_high)
         or_high=m15[i].high;
      if(m15[i].low<or_low)
         or_low=m15[i].low;
     }
   if(or_count<4 || !SnrFinite(or_high) || !SnrFinite(or_low) || or_high<=or_low)
     {
      out.reject_reason="OR_INCOMPLETE";
      return(true);
     }

   const bool first_beyond=(direction>0
                            ? (m15[0].close>or_high && m15[1].close<=or_high)
                            : (m15[0].close<or_low && m15[1].close>=or_low));
   const bool with_trend_color=(direction>0 ? m15[0].close>m15[0].open
                                            : m15[0].close<m15[0].open);
   if(!first_beyond || !with_trend_color)
     {
      out.reject_reason="LORB";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? or_low : or_high);
   out.wave.pullback_price=(direction>0 ? or_high : or_low);
   out.wave.impulse_extreme=(direction>0 ? m15[0].high : m15[0].low);

   SnrPvsraReadClosed(m15,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(m15[0].close,direction,m15_atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildM15OutsideSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                              const SnrHandles &handles,const SnrClassicCfg &cfg,
                              const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 ||
      handles.h1_trend==INVALID_HANDLE || handles.h1_atr==INVALID_HANDLE)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates m15[];
   MqlRates h1[];
   double m15_atr[];
   double h1_trend[];
   if(!SnrCopyClosedRates(symbol,tf,8,m15) ||
      !SnrCopyClosedRates(symbol,PERIOD_H1,16,h1) ||
      !SnrCopyClosedBuffer(handles.atr,8,m15_atr) ||
      !SnrCopyClosedBuffer(handles.h1_trend,16,h1_trend))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(m15)<3 || ArraySize(h1)<4 || m15[0].time<=0 ||
      m15[0].time>=availability_time || h1[0].time<=0 ||
      h1[0].time>=availability_time || !SnrFinite(m15[0].close) ||
      !SnrFinite(m15[1].high) || !SnrFinite(m15[1].low) ||
      !SnrFinite(m15_atr[0]) || m15_atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=m15[0].time;
   out.signal_high=m15[0].high;
   out.signal_low=m15[0].low;
   out.signal_close=m15[0].close;
   out.atr=m15_atr[0];

   if(!SnrTrendReadClosed(h1_trend,h1[0].close,cfg.trend_slope_bars,out.trend))
     {
      out.data_fail=true;
      out.reject_reason="TREND_READ";
      return(false);
     }
   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=m15[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   MqlDateTime london_clock;
   SnrGmtToLondon(signal_gmt,london_clock);
   if((cfg.use_ny_session && london_clock.hour>=cfg.ny_end_hour-1) ||
      (london_clock.day_of_week==5 && london_clock.hour>=cfg.friday_flatten_hour-1))
     {
      out.reject_reason="SESSION_TAIL";
      return(true);
     }

   const int direction=out.trend.side;
   if(direction==SNR_DIR_NONE || !SnrTrendAligned(out.trend,direction))
     {
      out.reject_reason="TREND";
      return(true);
     }
   out.direction=direction;

   const bool outside_bar=(m15[0].high>m15[1].high && m15[0].low<m15[1].low);
   const bool with_trend_color=(direction>0 ? m15[0].close>m15[0].open
                                            : m15[0].close<m15[0].open);
   const bool close_beyond=(direction>0 ? m15[0].close>m15[1].high
                                        : m15[0].close<m15[1].low);
   if(!outside_bar || !with_trend_color || !close_beyond)
     {
      out.reject_reason="OUTSIDE";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? m15[0].low : m15[0].high);
   out.wave.pullback_price=(direction>0 ? m15[1].high : m15[1].low);
   out.wave.impulse_extreme=(direction>0 ? m15[0].high : m15[0].low);

   SnrPvsraReadClosed(m15,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(m15[0].close,direction,m15_atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildM15Nr7Signal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 ||
      handles.h1_trend==INVALID_HANDLE || handles.h1_atr==INVALID_HANDLE)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates m15[];
   MqlRates h1[];
   double m15_atr[];
   double h1_trend[];
   if(!SnrCopyClosedRates(symbol,tf,20,m15) ||
      !SnrCopyClosedRates(symbol,PERIOD_H1,16,h1) ||
      !SnrCopyClosedBuffer(handles.atr,8,m15_atr) ||
      !SnrCopyClosedBuffer(handles.h1_trend,16,h1_trend))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(m15)<15 || ArraySize(h1)<4 || m15[0].time<=0 ||
      m15[0].time>=availability_time || h1[0].time<=0 ||
      h1[0].time>=availability_time || !SnrFinite(m15[0].close) ||
      !SnrFinite(m15[1].high) || !SnrFinite(m15_atr[0]) || m15_atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=m15[0].time;
   out.signal_high=m15[0].high;
   out.signal_low=m15[0].low;
   out.signal_close=m15[0].close;
   out.atr=m15_atr[0];

   if(!SnrTrendReadClosed(h1_trend,h1[0].close,cfg.trend_slope_bars,out.trend))
     {
      out.data_fail=true;
      out.reject_reason="TREND_READ";
      return(false);
     }
   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=m15[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   MqlDateTime london_clock;
   SnrGmtToLondon(signal_gmt,london_clock);
   if((cfg.use_ny_session && london_clock.hour>=cfg.ny_end_hour-1) ||
      (london_clock.day_of_week==5 && london_clock.hour>=cfg.friday_flatten_hour-1))
     {
      out.reject_reason="SESSION_TAIL";
      return(true);
     }

   const int direction=out.trend.side;
   if(direction==SNR_DIR_NONE || !SnrTrendAligned(out.trend,direction))
     {
      out.reject_reason="TREND";
      return(true);
     }
   out.direction=direction;

   int nr7_idx=-1;
   double nr7_high=0.0;
   double nr7_low=0.0;
   const int n=ArraySize(m15);
   for(int k=1;k<=8;k++)
     {
      if(k+6>=n)
         continue;
      const double r=m15[k].high-m15[k].low;
      if(r<=0.0 || !SnrFinite(r))
         continue;
      bool is_nr7=true;
      for(int j=1;j<=6;j++)
        {
         const double other=m15[k+j].high-m15[k+j].low;
         if(!SnrFinite(other) || other<r)
           {
            is_nr7=false;
            break;
           }
        }
      if(!is_nr7)
         continue;
      nr7_idx=k;
      nr7_high=m15[k].high;
      nr7_low=m15[k].low;
      break;
     }
   if(nr7_idx<1 || nr7_high<=nr7_low)
     {
      out.reject_reason="NR7_NONE";
      return(true);
     }

   bool already_beyond=false;
   for(int i=1;i<nr7_idx;i++)
     {
      if(direction>0 && m15[i].close>nr7_high)
         already_beyond=true;
      if(direction<0 && m15[i].close<nr7_low)
         already_beyond=true;
     }
   const bool first_beyond=(direction>0
                            ? (m15[0].close>nr7_high && !already_beyond)
                            : (m15[0].close<nr7_low && !already_beyond));
   const bool with_trend_color=(direction>0 ? m15[0].close>m15[0].open
                                            : m15[0].close<m15[0].open);
   if(!first_beyond || !with_trend_color)
     {
      out.reject_reason="NR7";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? nr7_low : nr7_high);
   out.wave.pullback_price=(direction>0 ? nr7_high : nr7_low);
   out.wave.impulse_extreme=(direction>0 ? m15[0].high : m15[0].low);

   SnrPvsraReadClosed(m15,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(m15[0].close,direction,m15_atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildM15PinSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0 ||
      handles.h1_trend==INVALID_HANDLE || handles.h1_atr==INVALID_HANDLE)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates m15[];
   MqlRates h1[];
   double m15_atr[];
   double h1_trend[];
   if(!SnrCopyClosedRates(symbol,tf,8,m15) ||
      !SnrCopyClosedRates(symbol,PERIOD_H1,16,h1) ||
      !SnrCopyClosedBuffer(handles.atr,8,m15_atr) ||
      !SnrCopyClosedBuffer(handles.h1_trend,16,h1_trend))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(m15)<3 || ArraySize(h1)<4 || m15[0].time<=0 ||
      m15[0].time>=availability_time || h1[0].time<=0 ||
      h1[0].time>=availability_time || !SnrFinite(m15[0].close) ||
      !SnrFinite(m15[1].low) || !SnrFinite(m15_atr[0]) || m15_atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=m15[0].time;
   out.signal_high=m15[0].high;
   out.signal_low=m15[0].low;
   out.signal_close=m15[0].close;
   out.atr=m15_atr[0];

   if(!SnrTrendReadClosed(h1_trend,h1[0].close,cfg.trend_slope_bars,out.trend))
     {
      out.data_fail=true;
      out.reject_reason="TREND_READ";
      return(false);
     }
   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=m15[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   MqlDateTime london_clock;
   SnrGmtToLondon(signal_gmt,london_clock);
   if((cfg.use_ny_session && london_clock.hour>=cfg.ny_end_hour-1) ||
      (london_clock.day_of_week==5 && london_clock.hour>=cfg.friday_flatten_hour-1))
     {
      out.reject_reason="SESSION_TAIL";
      return(true);
     }

   const int direction=out.trend.side;
   if(direction==SNR_DIR_NONE || !SnrTrendAligned(out.trend,direction))
     {
      out.reject_reason="TREND";
      return(true);
     }
   out.direction=direction;

   const double body=MathAbs(m15[0].close-m15[0].open);
   const double upper=m15[0].high-MathMax(m15[0].open,m15[0].close);
   const double lower=MathMin(m15[0].open,m15[0].close)-m15[0].low;
   if(body<=0.0 || !SnrFinite(body) || !SnrFinite(upper) || !SnrFinite(lower))
     {
      out.reject_reason="PIN_BODY";
      return(true);
     }

   const bool pin_ok=(direction>0
                      ? (lower>=2.0*body && lower>upper &&
                         m15[0].low<m15[1].low && m15[0].close>m15[1].low &&
                         m15[0].close>m15[0].open)
                      : (upper>=2.0*body && upper>lower &&
                         m15[0].high>m15[1].high && m15[0].close<m15[1].high &&
                         m15[0].close<m15[0].open));
   if(!pin_ok)
     {
      out.reject_reason="PIN";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=false;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? m15[0].low : m15[0].high);
   out.wave.pullback_price=(direction>0 ? m15[1].low : m15[1].high);
   out.wave.impulse_extreme=(direction>0 ? m15[0].high : m15[0].low);

   SnrPvsraReadClosed(m15,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(m15[0].close,direction,m15_atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildM15D1BrkSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                            const SnrHandles &handles,const SnrClassicCfg &cfg,
                            const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
