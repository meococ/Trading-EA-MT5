bool SnrBuildH1WkbrSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates w1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_W1,3,w1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(w1)<1 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h1[1].time<=0 || h1[1].time>=availability_time ||
      w1[0].time<=0 || w1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h1[1].close) ||
      !SnrFinite(w1[0].high) || !SnrFinite(w1[0].low) ||
      h1[0].high<=h1[0].low || w1[0].high<=w1[0].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="WKBR_RANGE";
      return(true);
     }

   const double wk_high=w1[0].high;
   const double wk_low=w1[0].low;
   const bool first_up=(h1[0].close>wk_high && h1[1].close<=wk_high &&
                        h1[0].close>h1[0].open);
   const bool first_dn=(h1[0].close<wk_low && h1[1].close>=wk_low &&
                        h1[0].close<h1[0].open);
   if(first_up==first_dn)
     {
      out.reject_reason="WKBR_BREAK";
      return(true);
     }
   const int direction=(first_up ? SNR_DIR_LONG : SNR_DIR_SHORT);

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="WKBR_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=wk_high-wk_low;
   out.trend.slope=(direction>0 ? h1[0].close-wk_high : wk_low-h1[0].close);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1WkrtSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates w1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,80,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_W1,3,w1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<8 || ArraySize(w1)<1 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      w1[0].time<=0 || w1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(w1[0].high) || !SnrFinite(w1[0].low) ||
      h1[0].high<=h1[0].low || w1[0].high<=w1[0].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="WKRT_RANGE";
      return(true);
     }

   const double wk_high=w1[0].high;
   const double wk_low=w1[0].low;
   const datetime week_start=w1[0].time+7*86400;
   if(h1[0].time<week_start)
     {
      out.reject_reason="WKRT_WEEK";
      return(true);
     }

   bool broke_up=false;
   bool broke_dn=false;
   const int n=ArraySize(h1);
   for(int i=1;i<n;i++)
     {
      if(h1[i].time<=0 || h1[i].time<week_start || h1[i].time>=h1[0].time)
         continue;
      if(!SnrFinite(h1[i].close))
         continue;
      if(h1[i].close>wk_high)
         broke_up=true;
      if(h1[i].close<wk_low)
         broke_dn=true;
     }

   const bool retest_up=(broke_up && h1[0].low<=wk_high &&
                         h1[0].close>wk_high && h1[0].close>h1[0].open);
   const bool retest_dn=(broke_dn && h1[0].high>=wk_low &&
                         h1[0].close<wk_low && h1[0].close<h1[0].open);
   if(retest_up==retest_dn)
     {
      out.reject_reason="WKRT_RETEST";
      return(true);
     }
   const int direction=(retest_up ? SNR_DIR_LONG : SNR_DIR_SHORT);

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="WKRT_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=wk_high-wk_low;
   out.trend.slope=(direction>0 ? h1[0].close-wk_high : wk_low-h1[0].close);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=false;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildM15LdspSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                           const SnrHandles &handles,const SnrClassicCfg &cfg,
                           const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates m15[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,m15) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(m15)<2 ||
      m15[0].time<=0 || m15[0].time>=availability_time ||
      !SnrFinite(m15[0].close) || !SnrFinite(m15[0].open) ||
      !SnrFinite(m15[0].high) || !SnrFinite(m15[0].low) ||
      m15[0].high<=m15[0].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=m15[0].time;
   out.signal_high=m15[0].high;
   out.signal_low=m15[0].low;
   out.signal_close=m15[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=m15[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<8 || out.session.london_hour>11)
     {
      out.reject_reason="LDSP_HOUR";
      return(true);
     }

   const double rng0=m15[0].high-m15[0].low;
   const double body=MathAbs(m15[0].close-m15[0].open);
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || m15[0].close==m15[0].open ||
      !SnrFinite(body) || body<0.70*rng0 || body<1.00*atr[0])
     {
      out.reject_reason="LDSP_BODY";
      return(true);
     }

   const int direction=(m15[0].close>m15[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const double sl_px=(direction>0 ? m15[0].low : m15[0].high);
   const double sl_dist=(direction>0 ? m15[0].close-sl_px : sl_px-m15[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="LDSP_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=body/rng0;
   out.trend.slope=body/atr[0];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=m15[0].close;
   out.wave.impulse_extreme=(direction>0 ? m15[0].high : m15[0].low);

   SnrPvsraReadClosed(m15,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(m15[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1E8atSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates h4[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_H4,4,h4) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(h4)<1 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h4[0].time<=0 || h4[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h4[0].close) || !SnrFinite(h4[0].open) ||
      !SnrFinite(h4[0].high) || !SnrFinite(h4[0].low) ||
      h1[0].high<=h1[0].low || h4[0].high<=h4[0].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="E8AT_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="E8AT_RANGE";
      return(true);
     }

   const double h4_range=h4[0].high-h4[0].low;
   const double h4_body=MathAbs(h4[0].close-h4[0].open);
   if(!SnrFinite(h4_range) || h4_range<=0.0 || !SnrFinite(h4_body) ||
      h4[0].close==h4[0].open || h4_body<0.70*h4_range ||
      h4_body<1.00*atr[0])
     {
      out.reject_reason="E8AT_BODY";
      return(true);
     }
   const int bias=(h4[0].close>h4[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="E8AT_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="E8AT_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=h4_body/h4_range;
   out.trend.slope=h4_body/atr[0];
   out.trend.side=direction;

   if(SnrNewsEurUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1IbrkSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<3 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h1[1].time<=0 || h1[1].time>=availability_time ||
      h1[2].time<=0 || h1[2].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h1[1].high) || !SnrFinite(h1[1].low) ||
      !SnrFinite(h1[2].high) || !SnrFinite(h1[2].low) ||
      h1[0].high<=h1[0].low || h1[1].high<=h1[1].low ||
      h1[2].high<=h1[2].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   const double mother_rng=h1[2].high-h1[2].low;
   if(!SnrFinite(mother_rng) || mother_rng<0.80*atr[0])
     {
      out.reject_reason="IBRK_MOTHER";
      return(true);
     }
   if(!(h1[1].high<h1[2].high && h1[1].low>h1[2].low))
     {
      out.reject_reason="IBRK_INSIDE";
      return(true);
     }

   const bool brk_up=(h1[0].close>h1[2].high && h1[0].close>h1[0].open);
   const bool brk_dn=(h1[0].close<h1[2].low && h1[0].close<h1[0].open);
   if(brk_up==brk_dn)
     {
      out.reject_reason="IBRK_BREAK";
      return(true);
     }
   const int direction=(brk_up ? SNR_DIR_LONG : SNR_DIR_SHORT);

   const double sl_px=(direction>0 ? h1[2].low : h1[2].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="IBRK_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=mother_rng/atr[0];
   out.trend.slope=sl_dist/atr[0];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildM15I1pbSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                           const SnrHandles &handles,const SnrClassicCfg &cfg,
                           const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates m15[];
   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,m15) ||
      !SnrCopyClosedRates(symbol,PERIOD_H1,16,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(m15)<2 || ArraySize(h1)<15 ||
      m15[0].time<=0 || m15[0].time>=availability_time ||
      !SnrFinite(m15[0].close) || !SnrFinite(m15[0].open) ||
      !SnrFinite(m15[0].high) || !SnrFinite(m15[0].low) ||
      m15[0].high<=m15[0].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=m15[0].time;
   out.signal_high=m15[0].high;
   out.signal_low=m15[0].low;
   out.signal_close=m15[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=m15[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   double h1_atr=0.0;
   double tr_sum=0.0;
   for(int t=0;t<14;t++)
     {
      if(h1[t].time<=0 || h1[t].time>=availability_time ||
         h1[t+1].time<=0 ||
         !SnrFinite(h1[t].high) || !SnrFinite(h1[t].low) ||
         !SnrFinite(h1[t+1].close) || h1[t].high<=h1[t].low)
        {
         out.data_fail=true;
         out.reject_reason="STALE_OR_EMPTY";
         return(false);
        }
      const double tr=MathMax(h1[t].high-h1[t].low,
                       MathMax(MathAbs(h1[t].high-h1[t+1].close),
                               MathAbs(h1[t].low-h1[t+1].close)));
      if(!SnrFinite(tr) || tr<=0.0)
        {
         out.reject_reason="I1PB_H1ATR";
         return(true);
        }
      tr_sum+=tr;
     }
   h1_atr=tr_sum/14.0;
   if(!SnrFinite(h1_atr) || h1_atr<=0.0)
     {
      out.reject_reason="I1PB_H1ATR";
      return(true);
     }

   int impulse_i=-1;
   int direction=SNR_DIR_NONE;
   for(int i=0;i<=3;i++)
     {
      if(h1[i].time<=0 || h1[i].time>=availability_time ||
         !SnrFinite(h1[i].high) || !SnrFinite(h1[i].low) ||
         !SnrFinite(h1[i].open) || !SnrFinite(h1[i].close) ||
         h1[i].high<=h1[i].low)
         continue;
      const double rng=h1[i].high-h1[i].low;
      const double body=MathAbs(h1[i].close-h1[i].open);
      if(!SnrFinite(rng) || !SnrFinite(body) ||
         body<0.60*h1_atr || body<0.50*rng)
         continue;
      impulse_i=i;
      direction=(h1[i].close>h1[i].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
      break;
     }
   if(impulse_i<0 || direction==SNR_DIR_NONE)
     {
      out.reject_reason="I1PB_IMPULSE";
      return(true);
     }
   if(m15[0].time<h1[impulse_i].time+3600 ||
      m15[0].time>h1[impulse_i].time+4*3600)
     {
      out.reject_reason="I1PB_AGE";
      return(true);
     }

   const double mid=0.5*(h1[impulse_i].high+h1[impulse_i].low);
   if(!SnrFinite(mid))
     {
      out.reject_reason="I1PB_MID";
      return(true);
     }
   const bool tag=(direction>0
                   ? (m15[0].low<=mid && m15[0].close>mid && m15[0].close>m15[0].open)
                   : (m15[0].high>=mid && m15[0].close<mid && m15[0].close<m15[0].open));
   if(!tag)
     {
      out.reject_reason="I1PB_TAG";
      return(true);
     }

   const double sl_px=(direction>0 ? m15[0].low : m15[0].high);
   const double sl_dist=(direction>0 ? m15[0].close-sl_px : sl_px-m15[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="I1PB_SL";
      return(true);
     }
   const double imp_rng=h1[impulse_i].high-h1[impulse_i].low;
   const double imp_body=MathAbs(h1[impulse_i].close-h1[impulse_i].open);
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=(imp_rng>0.0 ? imp_body/imp_rng : 0.0);
   out.trend.slope=imp_body/h1_atr;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=m15[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[impulse_i].high : h1[impulse_i].low);

   SnrPvsraReadClosed(m15,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(m15[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

#endif

