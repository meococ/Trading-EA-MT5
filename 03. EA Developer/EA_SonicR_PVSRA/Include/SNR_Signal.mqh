bool SnrBuildH1NrdSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,16,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(d1)<15 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 || d1[0].high<=d1[0].low ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   double adr_sum=0.0;
   for(int i=1;i<=14;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) || d1[i].high<=d1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="NRD_ADR";
         return(false);
        }
      adr_sum+=(d1[i].high-d1[i].low);
     }
   const double adr=adr_sum/14.0;
   const double y_range=d1[0].high-d1[0].low;
   if(!SnrFinite(adr) || adr<=0.0 || !SnrFinite(y_range) || y_range>=0.70*adr)
     {
      out.reject_reason="NRD_WIDE";
      return(true);
     }
   const double bar_range=h1[0].high-h1[0].low;
   if(!SnrFinite(bar_range) || bar_range<1.20*atr[0])
     {
      out.reject_reason="NRD_BARR";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="NRD_COLOR";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-h1[0].low : h1[0].high-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="NRD_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=y_range/adr;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? h1[0].low : h1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1PbrkSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,16,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,8,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<8 || ArraySize(d1)<2 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 || d1[0].high<=d1[0].low ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   const double pdh=d1[0].high;
   const double pdl=d1[0].low;
   int direction=SNR_DIR_NONE;
   if(h1[0].close>pdh && h1[0].close>h1[0].open)
      direction=SNR_DIR_LONG;
   else if(h1[0].close<pdl && h1[0].close<h1[0].open)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="PBRK";
      return(true);
     }

   MqlDateTime day_ldn;
   SnrGmtToLondon(signal_gmt,day_ldn);
   const int n=ArraySize(h1);
   for(int i=1;i<n;i++)
     {
      if(!SnrFinite(h1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="PBRK_BAR";
         return(false);
        }
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      if(bar_ldn.year!=day_ldn.year || bar_ldn.mon!=day_ldn.mon || bar_ldn.day!=day_ldn.day)
         continue;
      if((direction>0 && h1[i].close>pdh) || (direction<0 && h1[i].close<pdl))
        {
         out.reject_reason="PBRK_NOT_FIRST";
         return(true);
        }
     }

   const double sl_dist=(direction>0 ? h1[0].close-pdl : pdh-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="PBRK_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=(pdh+pdl)/2.0;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? pdl : pdh);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1AtlgSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,16,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<8 || h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=cfg.london_start_hour)
     {
      out.reject_reason="ATLG_HOUR";
      return(true);
     }

   MqlDateTime day_ldn;
   SnrGmtToLondon(signal_gmt,day_ldn);
   double box_h=-1.0e100;
   double box_l=1.0e100;
   double asia_close=0.0;
   int asia_hour=-1;
   int asia_n=0;
   const int n=ArraySize(h1);
   for(int i=1;i<n;i++)
     {
      if(!SnrFinite(h1[i].high) || !SnrFinite(h1[i].low) || !SnrFinite(h1[i].close) ||
         h1[i].high<=h1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="ATLG_BAR";
         return(false);
        }
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      if(bar_ldn.year!=day_ldn.year || bar_ldn.mon!=day_ldn.mon || bar_ldn.day!=day_ldn.day)
         continue;
      if(bar_ldn.hour>=cfg.london_start_hour)
         continue;
      asia_n++;
      if(h1[i].high>box_h)
         box_h=h1[i].high;
      if(h1[i].low<box_l)
         box_l=h1[i].low;
      if(bar_ldn.hour>=asia_hour)
        {
         asia_hour=bar_ldn.hour;
         asia_close=h1[i].close;
        }
     }
   if(asia_n<4 || !SnrFinite(box_h) || !SnrFinite(box_l) || box_h<=box_l ||
      !SnrFinite(asia_close) || asia_hour<0)
     {
      out.reject_reason="ATLG_ASIA";
      return(true);
     }
   const double rng=box_h-box_l;
   const double q=(asia_close-box_l)/rng;
   int bias=SNR_DIR_NONE;
   if(q>=0.75)
      bias=SNR_DIR_LONG;
   else if(q<=0.25)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="ATLG_Q";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="ATLG_COLOR";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-box_l : box_h-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="ATLG_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=q;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? box_l : box_h);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1TkyoSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   MqlDateTime tokyo;
   TimeToStruct(signal_gmt+9*3600,tokyo);
   if(tokyo.day_of_week==0 || tokyo.day_of_week==6)
     {
      out.reject_reason="TKYO_WKND";
      return(true);
     }
   if(tokyo.hour!=9)
     {
      out.reject_reason="TKYO_HOUR";
      return(true);
     }

   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }

   const double bar_range=h1[0].high-h1[0].low;
   if(!SnrFinite(bar_range) || bar_range<0.80*atr[0])
     {
      out.reject_reason="TKYO_BARR";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="TKYO_COLOR";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-h1[0].low : h1[0].high-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="TKYO_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=bar_range/atr[0];
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdJpyHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? h1[0].low : h1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1YbrkSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,16,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,16,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<8 || ArraySize(d1)<15 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 || d1[0].high<=d1[0].low ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   double adr_sum=0.0;
   for(int i=1;i<=14;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) || d1[i].high<=d1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="YBRK_ADR";
         return(false);
        }
      adr_sum+=(d1[i].high-d1[i].low);
     }
   const double adr=adr_sum/14.0;
   const double y_range=d1[0].high-d1[0].low;
   if(!SnrFinite(adr) || adr<=0.0 || !SnrFinite(y_range) || y_range<0.80*adr)
     {
      out.reject_reason="YBRK_ADR";
      return(true);
     }
   const double q=(d1[0].close-d1[0].low)/y_range;
   int bias=SNR_DIR_NONE;
   if(q>=0.75)
      bias=SNR_DIR_LONG;
   else if(q<=0.25)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="YBRK_Q";
      return(true);
     }

   const double pdh=d1[0].high;
   const double pdl=d1[0].low;
   int direction=SNR_DIR_NONE;
   if(bias>0 && h1[0].close>pdh && h1[0].close>h1[0].open)
      direction=SNR_DIR_LONG;
   else if(bias<0 && h1[0].close<pdl && h1[0].close<h1[0].open)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="YBRK";
      return(true);
     }

   MqlDateTime day_ldn;
   SnrGmtToLondon(signal_gmt,day_ldn);
   const int n=ArraySize(h1);
   for(int i=1;i<n;i++)
     {
      if(!SnrFinite(h1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="YBRK_BAR";
         return(false);
        }
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      if(bar_ldn.year!=day_ldn.year || bar_ldn.mon!=day_ldn.mon || bar_ldn.day!=day_ldn.day)
         continue;
      if((direction>0 && h1[i].close>pdh) || (direction<0 && h1[i].close<pdl))
        {
         out.reject_reason="YBRK_NOT_FIRST";
         return(true);
        }
     }

   const double sl_dist=(direction>0 ? h1[0].close-pdl : pdh-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="YBRK_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=q;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? pdl : pdh);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1OutbSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<3 || h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h1[1].high) || !SnrFinite(h1[1].low) ||
      h1[0].high<=h1[0].low || h1[1].high<=h1[1].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(h1[0].high<=h1[1].high || h1[0].low>=h1[1].low)
     {
      out.reject_reason="OUTB_WRAP";
      return(true);
     }
   const double bar_range=h1[0].high-h1[0].low;
   if(!SnrFinite(bar_range) || bar_range<1.00*atr[0])
     {
      out.reject_reason="OUTB_BARR";
      return(true);
     }
   const double q=(h1[0].close-h1[0].low)/bar_range;
   int direction=SNR_DIR_NONE;
   if(q>=0.70 && h1[0].close>h1[0].open)
      direction=SNR_DIR_LONG;
   else if(q<=0.30 && h1[0].close<h1[0].open)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="OUTB_Q";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-h1[0].low : h1[0].high-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="OUTB_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=q;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? h1[0].low : h1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1QfdSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,16,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(d1)<15 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 || d1[0].high<=d1[0].low ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   double adr_sum=0.0;
   for(int i=1;i<=14;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) || d1[i].high<=d1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="QFD_ADR";
         return(false);
        }
      adr_sum+=(d1[i].high-d1[i].low);
     }
   const double adr=adr_sum/14.0;
   const double y_range=d1[0].high-d1[0].low;
   if(!SnrFinite(adr) || adr<=0.0 || !SnrFinite(y_range) || y_range>=0.70*adr)
     {
      out.reject_reason="QFD_WIDE";
      return(true);
     }
   const double bar_range=h1[0].high-h1[0].low;
   if(!SnrFinite(bar_range) || bar_range<1.20*atr[0])
     {
      out.reject_reason="QFD_BARR";
      return(true);
     }
   int direction=SNR_DIR_NONE;
   if(h1[0].close>h1[0].open)
      direction=SNR_DIR_SHORT;
   else if(h1[0].close<h1[0].open)
      direction=SNR_DIR_LONG;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="QFD_COLOR";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-h1[0].low : h1[0].high-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="QFD_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=y_range/adr;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? h1[0].low : h1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1PinxSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,16,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<13 || h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   double ext_h=h1[0].high;
   double ext_l=h1[0].low;
   for(int i=1;i<=12;i++)
     {
      if(!SnrFinite(h1[i].high) || !SnrFinite(h1[i].low))
        {
         out.data_fail=true;
         out.reject_reason="PINX_BAR";
         return(false);
        }
      if(h1[i].high>ext_h)
         ext_h=h1[i].high;
      if(h1[i].low<ext_l)
         ext_l=h1[i].low;
     }
   const double body=MathAbs(h1[0].close-h1[0].open);
   const double up_wick=h1[0].high-MathMax(h1[0].open,h1[0].close);
   const double dn_wick=MathMin(h1[0].open,h1[0].close)-h1[0].low;
   int direction=SNR_DIR_NONE;
   if(h1[0].low<=ext_l+1.0e-8 && dn_wick>=0.50*atr[0] && dn_wick>=2.0*MathMax(body,atr[0]*0.05) &&
      h1[0].close>=(h1[0].high+h1[0].low)/2.0)
      direction=SNR_DIR_LONG;
   else if(h1[0].high>=ext_h-1.0e-8 && up_wick>=0.50*atr[0] && up_wick>=2.0*MathMax(body,atr[0]*0.05) &&
           h1[0].close<=(h1[0].high+h1[0].low)/2.0)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="PINX";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-h1[0].low : h1[0].high-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="PINX_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=(direction>0 ? dn_wick/atr[0] : up_wick/atr[0]);
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? h1[0].low : h1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1YpbSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,16,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,16,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<8 || ArraySize(d1)<15 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 || d1[0].high<=d1[0].low ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   double adr_sum=0.0;
   for(int i=1;i<=14;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) || d1[i].high<=d1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="YPB_ADR";
         return(false);
        }
      adr_sum+=(d1[i].high-d1[i].low);
     }
   const double adr=adr_sum/14.0;
   const double y_range=d1[0].high-d1[0].low;
   if(!SnrFinite(adr) || adr<=0.0 || !SnrFinite(y_range) || y_range<0.80*adr)
     {
      out.reject_reason="YPB_ADR";
      return(true);
     }
   const double q=(d1[0].close-d1[0].low)/y_range;
   int bias=SNR_DIR_NONE;
   if(q>=0.75)
      bias=SNR_DIR_LONG;
   else if(q<=0.25)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="YPB_Q";
      return(true);
     }
   const double mid=(d1[0].high+d1[0].low)/2.0;
   int direction=SNR_DIR_NONE;
   if(bias>0 && h1[0].low<=mid && h1[0].close>mid && h1[0].close>h1[0].open)
      direction=SNR_DIR_LONG;
   else if(bias<0 && h1[0].high>=mid && h1[0].close<mid && h1[0].close<h1[0].open)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="YPB";
      return(true);
     }

   MqlDateTime day_ldn;
   SnrGmtToLondon(signal_gmt,day_ldn);
   const int n=ArraySize(h1);
   for(int i=1;i<n;i++)
     {
      if(!SnrFinite(h1[i].close) || !SnrFinite(h1[i].high) || !SnrFinite(h1[i].low))
        {
         out.data_fail=true;
         out.reject_reason="YPB_BAR";
         return(false);
        }
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      if(bar_ldn.year!=day_ldn.year || bar_ldn.mon!=day_ldn.mon || bar_ldn.day!=day_ldn.day)
         continue;
      const bool prior=(direction>0
                        ? (h1[i].low<=mid && h1[i].close>mid && h1[i].close>h1[i].open)
                        : (h1[i].high>=mid && h1[i].close<mid && h1[i].close<h1[i].open));
      if(prior)
        {
         out.reject_reason="YPB_NOT_FIRST";
         return(true);
        }
     }

   const double sl_dist=(direction>0 ? h1[0].close-d1[0].low : d1[0].high-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="YPB_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=q;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? d1[0].low : d1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1PvtSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,24,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,8,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<8 || ArraySize(d1)<2 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 || d1[0].high<=d1[0].low ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(d1[0].high) || !SnrFinite(d1[0].low) ||
      !SnrFinite(d1[0].close) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   const double y_h=d1[0].high;
   const double y_l=d1[0].low;
   const double y_c=d1[0].close;
   const double pvt=(y_h+y_l+y_c)/3.0;
   const double r1=2.0*pvt-y_l;
   const double s1=2.0*pvt-y_h;
   if(!SnrFinite(pvt) || !SnrFinite(r1) || !SnrFinite(s1) || r1<=pvt || pvt<=s1)
     {
      out.reject_reason="PVT_LEVELS";
      return(true);
     }

   int direction=SNR_DIR_NONE;
   if(h1[0].close>r1 && h1[0].close>h1[0].open)
      direction=SNR_DIR_LONG;
   else if(h1[0].close<s1 && h1[0].close<h1[0].open)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="PVT";
      return(true);
     }

   MqlDateTime day_ldn;
   SnrGmtToLondon(signal_gmt,day_ldn);
   const int n=ArraySize(h1);
   for(int i=1;i<n;i++)
     {
      if(!SnrFinite(h1[i].close) || !SnrFinite(h1[i].high) || !SnrFinite(h1[i].low))
        {
         out.data_fail=true;
         out.reject_reason="PVT_BAR";
         return(false);
        }
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      if(bar_ldn.year!=day_ldn.year || bar_ldn.mon!=day_ldn.mon || bar_ldn.day!=day_ldn.day)
         continue;
      const bool prior=(direction>0 ? h1[i].close>r1 : h1[i].close<s1);
      if(prior)
        {
         out.reject_reason="PVT_NOT_FIRST";
         return(true);
        }
     }

   const double sl_dist=(direction>0 ? h1[0].close-pvt : pvt-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="PVT_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=pvt;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=pvt;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1WlbrSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,80,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,16,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<16 || ArraySize(d1)<8 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 || d1[0].high<=d1[0].low ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   datetime monday_cursor=signal_gmt;
   MqlDateTime this_mon;
   SnrGmtToLondon(monday_cursor,this_mon);
   int hops=0;
   while(this_mon.day_of_week!=1 && hops<8)
     {
      monday_cursor-=86400;
      SnrGmtToLondon(monday_cursor,this_mon);
      hops++;
     }
   if(this_mon.day_of_week!=1)
     {
      out.reject_reason="WLBR_MON";
      return(true);
     }
   datetime last_mon_cursor=monday_cursor-7*86400;
   MqlDateTime last_mon;
   SnrGmtToLondon(last_mon_cursor,last_mon);
   const int this_key=this_mon.year*10000+this_mon.mon*100+this_mon.day;
   const int last_key=last_mon.year*10000+last_mon.mon*100+last_mon.day;

   double week_h=-1.0e100;
   double week_l=1.0e100;
   int week_n=0;
   const int dn=ArraySize(d1);
   for(int i=0;i<dn;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) || d1[i].high<=d1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="WLBR_D1";
         return(false);
        }
      const datetime d_gmt=d1[i].time-(server_now-gmt_now);
      MqlDateTime dldn;
      SnrGmtToLondon(d_gmt,dldn);
      const int dkey=dldn.year*10000+dldn.mon*100+dldn.day;
      if(dkey<last_key || dkey>=this_key)
         continue;
      if(dldn.day_of_week<1 || dldn.day_of_week>5)
         continue;
      if(d1[i].high>week_h)
         week_h=d1[i].high;
      if(d1[i].low<week_l)
         week_l=d1[i].low;
      week_n++;
     }
   if(week_n<3 || !SnrFinite(week_h) || !SnrFinite(week_l) || week_h<=week_l)
     {
      out.reject_reason="WLBR_WEEK";
      return(true);
     }

   int direction=SNR_DIR_NONE;
   if(h1[0].close>week_h && h1[0].close>h1[0].open)
      direction=SNR_DIR_LONG;
   else if(h1[0].close<week_l && h1[0].close<h1[0].open)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="WLBR";
      return(true);
     }

   const int hn=ArraySize(h1);
   for(int i=1;i<hn;i++)
     {
      if(!SnrFinite(h1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="WLBR_BAR";
         return(false);
        }
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      const int bkey=bar_ldn.year*10000+bar_ldn.mon*100+bar_ldn.day;
      if(bkey<this_key)
         continue;
      const bool prior=(direction>0 ? h1[i].close>week_h : h1[i].close<week_l);
      if(prior)
        {
         out.reject_reason="WLBR_NOT_FIRST";
         return(true);
        }
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="WLBR_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=week_h-week_l;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1WlbrEurSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                             const SnrHandles &handles,const SnrClassicCfg &cfg,
                             const datetime availability_time,SnrSignalDecision &out)
  {
   if(!SnrBuildH1WlbrSignal(symbol,tf,handles,cfg,availability_time,out))
      return(false);
   if(!out.fired || out.decision_time<=0)
      return(true);
   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=out.decision_time-(server_now-gmt_now);
   if(SnrNewsCcyHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC,"EUR"))
     {
      out.fired=false;
      out.direction=SNR_DIR_NONE;
      out.reject_reason="NEWS";
     }
   return(true);
  }

bool SnrBuildH1Rsi2Signal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,32,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,24,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<8 || ArraySize(d1)<21 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   double sma=0.0;
   for(int i=0;i<20;i++)
     {
      if(!SnrFinite(d1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="RSI2_SMA";
         return(false);
        }
      sma+=d1[i].close;
     }
   sma/=20.0;
   int bias=SNR_DIR_NONE;
   if(d1[0].close>sma)
      bias=SNR_DIR_LONG;
   else if(d1[0].close<sma)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="RSI2_SMA";
      return(true);
     }

   const int hn=ArraySize(h1);
   double ch0=h1[hn-2].close-h1[hn-1].close;
   double ch1=h1[hn-3].close-h1[hn-2].close;
   if(!SnrFinite(ch0) || !SnrFinite(ch1))
     {
      out.data_fail=true;
      out.reject_reason="RSI2_SEED";
      return(false);
     }
   double ag=(MathMax(ch0,0.0)+MathMax(ch1,0.0))/2.0;
   double al=(MathMax(-ch0,0.0)+MathMax(-ch1,0.0))/2.0;
   for(int i=hn-4;i>=0;i--)
     {
      const double ch=h1[i].close-h1[i+1].close;
      if(!SnrFinite(ch))
        {
         out.data_fail=true;
         out.reject_reason="RSI2_CH";
         return(false);
        }
      ag=(ag+MathMax(ch,0.0))/2.0;
      al=(al+MathMax(-ch,0.0))/2.0;
     }
   double rsi=50.0;
   if(al<=0.0 && ag<=0.0)
      rsi=50.0;
   else if(al<=0.0)
      rsi=100.0;
   else
      rsi=100.0-100.0/(1.0+ag/al);
   if(!SnrFinite(rsi))
     {
      out.data_fail=true;
      out.reject_reason="RSI2_VAL";
      return(false);
     }

   int direction=SNR_DIR_NONE;
   if(bias>0 && rsi<10.0)
      direction=SNR_DIR_LONG;
   else if(bias<0 && rsi>90.0)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="RSI2";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="RSI2_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=rsi;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1IbzSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,16,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<12 || h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   int direction=SNR_DIR_NONE;
   double zone_lo=0.0;
   double zone_hi=0.0;
   const int n=ArraySize(h1);
   for(int k=1;k<=8 && (k+2)<n;k++)
     {
      if(!SnrFinite(h1[k].high) || !SnrFinite(h1[k].low) ||
         !SnrFinite(h1[k+2].high) || !SnrFinite(h1[k+2].low) ||
         h1[k].high<=h1[k].low || h1[k+2].high<=h1[k+2].low)
        {
         out.data_fail=true;
         out.reject_reason="IBZ_BAR";
         return(false);
        }
      const bool bull=(h1[k+2].high<h1[k].low);
      const bool bear=(h1[k+2].low>h1[k].high);
      if(!bull && !bear)
         continue;
      const double z_lo=(bull ? h1[k+2].high : h1[k].high);
      const double z_hi=(bull ? h1[k].low : h1[k+2].low);
      if(!SnrFinite(z_lo) || !SnrFinite(z_hi) || z_hi-z_lo<0.15*atr[0])
         continue;
      const int dir=(bull ? SNR_DIR_LONG : SNR_DIR_SHORT);
      bool filled=false;
      bool prior_tap=false;
      for(int j=0;j<k;j++)
        {
         if(!SnrFinite(h1[j].close) || !SnrFinite(h1[j].high) || !SnrFinite(h1[j].low))
           {
            out.data_fail=true;
            out.reject_reason="IBZ_PATH";
            return(false);
           }
         if((dir>0 && h1[j].close<z_lo) || (dir<0 && h1[j].close>z_hi))
            filled=true;
         if(j==0)
            continue;
         const bool tap_j=(dir>0
                           ? (h1[j].low<=z_hi && h1[j].close>z_lo && h1[j].close>h1[j].open)
                           : (h1[j].high>=z_lo && h1[j].close<z_hi && h1[j].close<h1[j].open));
         if(tap_j)
            prior_tap=true;
        }
      if(filled || prior_tap)
         continue;
      const bool tap0=(dir>0
                       ? (h1[0].low<=z_hi && h1[0].close>z_lo && h1[0].close>h1[0].open)
                       : (h1[0].high>=z_lo && h1[0].close<z_hi && h1[0].close<h1[0].open));
      if(!tap0)
         continue;
      direction=dir;
      zone_lo=z_lo;
      zone_hi=z_hi;
      break;
     }
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="IBZ";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="IBZ_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=zone_hi-zone_lo;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1EmxSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
