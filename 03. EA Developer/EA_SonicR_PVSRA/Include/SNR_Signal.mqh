      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<8 || out.session.london_hour>15)
     {
      out.reject_reason="D10B_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="D10B_RANGE";
      return(true);
     }

   double hh=d1[0].high;
   double ll=d1[0].low;
   for(int i=0;i<10;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) ||
         d1[i].time<=0 || d1[i].high<=d1[i].low)
        {
         out.reject_reason="D10B_BAR";
         return(true);
        }
      if(d1[i].high>hh)
         hh=d1[i].high;
      if(d1[i].low<ll)
         ll=d1[i].low;
     }
   if(!SnrFinite(hh) || !SnrFinite(ll) || hh<=ll)
     {
      out.reject_reason="D10B_BOX";
      return(true);
     }

   int direction=SNR_DIR_NONE;
   if(h1[0].close>hh && h1[1].close<=hh && h1[0].close>h1[0].open)
      direction=SNR_DIR_LONG;
   else if(h1[0].close<ll && h1[1].close>=ll && h1[0].close<h1[0].open)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="D10B_CROSS";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="D10B_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=hh;
   out.trend.slope=ll;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildD1Dt10Signal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,16,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(d1)<12 || ArraySize(atr)<1 ||
      d1[0].time<=0 || d1[0].time>=availability_time ||
      d1[1].time<=0 ||
      !SnrFinite(d1[0].close) || !SnrFinite(d1[0].open) ||
      !SnrFinite(d1[0].high) || !SnrFinite(d1[0].low) ||
      !SnrFinite(d1[1].close) ||
      d1[0].high<=d1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=d1[0].time;
   out.signal_high=d1[0].high;
   out.signal_low=d1[0].low;
   out.signal_close=d1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=d1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(out.session.flatten ||
      out.session.london_dow==0 ||
      out.session.london_dow==5 ||
      out.session.london_dow==6)
     {
      out.reject_reason="DT10_DOW";
      return(true);
     }

   double hh=d1[1].high;
   double ll=d1[1].low;
   for(int i=1;i<=10;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) ||
         d1[i].time<=0 || d1[i].high<=d1[i].low)
        {
         out.reject_reason="DT10_BAR";
         return(true);
        }
      if(d1[i].high>hh)
         hh=d1[i].high;
      if(d1[i].low<ll)
         ll=d1[i].low;
     }
   if(!SnrFinite(hh) || !SnrFinite(ll) || hh<=ll)
     {
      out.reject_reason="DT10_BOX";
      return(true);
     }

   int direction=SNR_DIR_NONE;
   if(d1[0].close>hh && d1[1].close<=hh && d1[0].close>d1[0].open)
      direction=SNR_DIR_LONG;
   else if(d1[0].close<ll && d1[1].close>=ll && d1[0].close<d1[0].open)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="DT10_CROSS";
      return(true);
     }

   const double sl_px=(direction>0 ? d1[0].low : d1[0].high);
   const double sl_dist=(direction>0 ? d1[0].close-sl_px : sl_px-d1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="DT10_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=hh;
   out.trend.slope=ll;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+24*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=d1[0].close;
   out.wave.impulse_extreme=(direction>0 ? d1[0].high : d1[0].low);

   SnrPvsraReadClosed(d1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(d1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1H4skSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(atr)<1 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8 && out.session.london_hour!=12)
     {
      out.reject_reason="H4SK_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="H4SK_RANGE";
      return(true);
     }

   const int stoch_h=iStochastic(symbol,PERIOD_H4,5,3,3,MODE_SMA,STO_LOWHIGH);
   if(stoch_h==INVALID_HANDLE)
     {
      out.data_fail=true;
      out.reject_reason="H4SK_HANDLE";
      return(false);
     }
   double k[];
   double d[];
   ArraySetAsSeries(k,true);
   ArraySetAsSeries(d,true);
   const int got_k=CopyBuffer(stoch_h,0,1,3,k);
   const int got_d=CopyBuffer(stoch_h,1,1,3,d);
   IndicatorRelease(stoch_h);
   if(got_k<3 || got_d<3 || ArraySize(k)<2 || ArraySize(d)<2 ||
      !SnrFinite(k[0]) || !SnrFinite(k[1]) ||
      !SnrFinite(d[0]) || !SnrFinite(d[1]))
     {
      out.data_fail=true;
      out.reject_reason="H4SK_COPY";
      return(false);
     }

   int direction=SNR_DIR_NONE;
   if(k[1]<=d[1] && k[0]>d[0])
      direction=SNR_DIR_LONG;
   else if(k[1]>=d[1] && k[0]<d[0])
      direction=SNR_DIR_SHORT;
   else
     {
      out.reject_reason="H4SK_CROSS";
      return(true);
     }

   const int bar_dir=(h1[0].close>h1[0].open ? SNR_DIR_LONG :
                      (h1[0].close<h1[0].open ? SNR_DIR_SHORT : SNR_DIR_NONE));
   if(direction!=bar_dir)
     {
      out.reject_reason="H4SK_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="H4SK_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=k[0];
   out.trend.slope=d[0];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1FrbSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<6 || ArraySize(atr)<1 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<8 || out.session.london_hour>15)
     {
      out.reject_reason="FRB_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="FRB_RANGE";
      return(true);
     }

   for(int i=1;i<=5;i++)
     {
      if(h1[i].time<=0 || h1[i].time>=availability_time ||
         !SnrFinite(h1[i].high) || !SnrFinite(h1[i].low) ||
         !SnrFinite(h1[i].close) || h1[i].high<=h1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="FRB_BAR";
         return(false);
        }
     }

   const bool frac_hi=(h1[3].high>h1[1].high && h1[3].high>h1[2].high &&
                       h1[3].high>h1[4].high && h1[3].high>h1[5].high);
   const bool frac_lo=(h1[3].low<h1[1].low && h1[3].low<h1[2].low &&
                       h1[3].low<h1[4].low && h1[3].low<h1[5].low);

   int direction=SNR_DIR_NONE;
   if(frac_hi && h1[0].close>h1[3].high && h1[1].close<=h1[3].high &&
      h1[0].close>h1[0].open)
      direction=SNR_DIR_LONG;
   else if(frac_lo && h1[0].close<h1[3].low && h1[1].close>=h1[3].low &&
           h1[0].close<h1[0].open)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="FRB_CROSS";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="FRB_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=(direction>0 ? h1[3].high : h1[3].low);
   out.trend.slope=(frac_hi ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsAudUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1H4dlSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates h4[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_H4,4,h4) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(h4)<2 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h4[0].time<=0 || h4[0].time>=availability_time ||
      h4[1].time<=0 || h4[1].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h4[1].close) || !SnrFinite(h4[1].open) ||
      !SnrFinite(h4[1].high) || !SnrFinite(h4[1].low) ||
      h1[0].high<=h1[0].low || h4[1].high<=h4[1].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=12)
     {
      out.reject_reason="H4DL_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="H4DL_RANGE";
      return(true);
     }

   const double h4_range=h4[1].high-h4[1].low;
   const double h4_body=MathAbs(h4[1].close-h4[1].open);
   if(!SnrFinite(h4_range) || h4_range<=0.0 || !SnrFinite(h4_body) ||
      h4[1].close==h4[1].open || h4_body<0.70*h4_range ||
      h4_body<1.00*atr[0])
     {
      out.reject_reason="H4DL_BODY";
      return(true);
     }
   const int bias=(h4[1].close>h4[1].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="H4DL_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="H4DL_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=h4_body/h4_range;
   out.trend.slope=h4_body/atr[0];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1H4rvSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   if(!SnrBuildH1H4atSignal(symbol,tf,handles,cfg,availability_time,out))
      return(false);
   if(out.data_fail || !out.fired || out.decision_time<=0)
      return(true);

   MqlRates h4[];
   if(!SnrCopyClosedRates(symbol,PERIOD_H4,4,h4) || ArraySize(h4)<2 ||
      h4[1].time<=0 || !SnrFinite(h4[1].close) || !SnrFinite(h4[1].open) ||
      h4[1].close==h4[1].open)
     {
      out.fired=false;
      out.reject_reason="H4RV_PRIOR";
      return(true);
     }
   const int prior=(h4[1].close>h4[1].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(prior==out.direction)
     {
      out.fired=false;
      out.reject_reason="H4RV_CONT";
     }
   return(true);
  }

bool SnrBuildH1SwgoSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(atr)<1 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h1[1].time<=0 || h1[1].time>=h1[0].time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h1[1].close) || !SnrFinite(h1[1].open) ||
      !SnrFinite(h1[1].high) || !SnrFinite(h1[1].low) ||
      h1[0].high<=h1[0].low || h1[1].high<=h1[1].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<8 || out.session.london_hour>15)
     {
      out.reject_reason="SWGO_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="SWGO_RANGE";
      return(true);
     }

   const bool sweep_high=(h1[0].high>h1[1].high);
   const bool sweep_low=(h1[0].low<h1[1].low);
   if(sweep_high==sweep_low)
     {
      out.reject_reason="SWGO_OUTB";
      return(true);
     }

   int direction=SNR_DIR_NONE;
   double sl_px=0.0;
   if(sweep_low && h1[0].close>h1[1].close && h1[0].close>h1[0].open)
     {
      direction=SNR_DIR_LONG;
      sl_px=h1[0].low;
     }
   else if(sweep_high && h1[0].close<h1[1].close && h1[0].close<h1[0].open)
     {
      direction=SNR_DIR_SHORT;
      sl_px=h1[0].high;
     }
   else
     {
      out.reject_reason="SWGO_RECLAIM";
      return(true);
     }

   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="SWGO_SL";
      return(true);
     }

   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=rng0/atr[0];
   out.trend.slope=(direction>0 ? (h1[0].close-h1[1].close) : (h1[1].close-h1[0].close))/atr[0];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1ClwvSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   if(!SnrBuildClassicSignal(symbol,tf,handles,cfg,availability_time,out))
      return(false);
   if(out.data_fail || !out.fired || out.decision_time<=0)
      return(true);

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=out.decision_time-(server_now-gmt_now);
   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.fired=false;
      out.reject_reason="NEWS";
      return(true);
     }

   const double sl_px=out.wave.structure_swing;
   const double sl_dist=(out.direction>0 ? out.signal_close-sl_px : sl_px-out.signal_close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*out.atr)
     {
      out.fired=false;
      out.reject_reason="CLWV_SL";
      return(true);
     }
   return(true);
  }

