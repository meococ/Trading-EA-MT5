     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="L8ST_RANGE";
      return(true);
     }

   const double y_lo=d1[0].low+0.25*y_range;
   const double y_hi=d1[0].high-0.25*y_range;
   int direction=SNR_DIR_NONE;
   if(h1[0].open>=y_hi && h1[0].close>=y_hi)
      direction=SNR_DIR_LONG;
   else if(h1[0].open<=y_lo && h1[0].close<=y_lo)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="L8ST_STAY";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="L8ST_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=(direction>0 ? (h1[0].close-y_hi)/y_range
                              : (y_lo-h1[0].close)/y_range);
   out.trend.slope=y_range;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1Gb8Signal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="GB8_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   const double body0=MathAbs(h1[0].close-h1[0].open);
   if(!SnrFinite(rng0) || rng0<0.80*atr[0] || h1[0].close==h1[0].open ||
      !SnrFinite(body0) || body0<0.50*rng0)
     {
      out.reject_reason="GB8_BAR";
      return(true);
     }

   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="GB8_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=body0/rng0;
   out.trend.slope=rng0/atr[0];
   out.trend.side=direction;

   if(SnrNewsGbpUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1TkntSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,16,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<10 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="TKNT_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="TKNT_RANGE";
      return(true);
     }

   MqlDateTime sig_ldn;
   SnrGmtToLondon(signal_gmt,sig_ldn);
   const int day_key=sig_ldn.year*10000+sig_ldn.mon*100+sig_ldn.day;
   int n_tk=0;
   int first_i=-1;
   int last_i=-1;
   int first_h=99;
   int last_h=-1;
   const int n=ArraySize(h1);
   for(int i=1;i<n;i++)
     {
      if(!SnrFinite(h1[i].open) || !SnrFinite(h1[i].close) ||
         h1[i].time<=0)
         continue;
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      const int bar_key=bar_ldn.year*10000+bar_ldn.mon*100+bar_ldn.day;
      if(bar_key!=day_key)
         continue;
      if(bar_ldn.hour<0 || bar_ldn.hour>=8)
         continue;
      n_tk++;
      if(bar_ldn.hour<first_h)
        {
         first_h=bar_ldn.hour;
         first_i=i;
        }
      if(bar_ldn.hour>last_h)
        {
         last_h=bar_ldn.hour;
         last_i=i;
        }
     }
   if(n_tk<6 || first_i<1 || last_i<1)
     {
      out.reject_reason="TKNT_BOX";
      return(true);
     }

   const double net=h1[last_i].close-h1[first_i].open;
   if(!SnrFinite(net) || MathAbs(net)<0.50*atr[0])
     {
      out.reject_reason="TKNT_NET";
      return(true);
     }

   const int bias=(net>0.0 ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="TKNT_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="TKNT_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=net/atr[0];
   out.trend.slope=(double)n_tk;
   out.trend.side=direction;

   if(SnrNewsUsdJpyHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1Xas0Signal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   // Hour-0 is SNR_SESS_NONE so entry_allowed is always false. Honor
   // flatten/weekend only; daily flatten 8 still exits before London.
   if(out.session.flatten)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=0)
     {
      out.reject_reason="XAS0_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   const double body0=MathAbs(h1[0].close-h1[0].open);
   if(!SnrFinite(rng0) || rng0<0.80*atr[0] || h1[0].close==h1[0].open ||
      !SnrFinite(body0) || body0<0.50*rng0)
     {
      out.reject_reason="XAS0_BAR";
      return(true);
     }

   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="XAS0_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=body0/rng0;
   out.trend.slope=rng0/atr[0];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+8*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1D1bmSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,8,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(d1)<7 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 || d1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(d1[0].close) || !SnrFinite(d1[0].open) ||
      !SnrFinite(d1[0].high) || !SnrFinite(d1[0].low) ||
      h1[0].high<=h1[0].low || d1[0].high<=d1[0].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="D1BM_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="D1BM_RANGE";
      return(true);
     }

   const double body0=MathAbs(d1[0].close-d1[0].open);
   if(!SnrFinite(body0) || body0<=0.0 || d1[0].close==d1[0].open)
     {
      out.reject_reason="D1BM_BODY";
      return(true);
     }

   double tr_sum=0.0;
   for(int i=1;i<=6;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) || d1[i].high<=d1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="D1BM_PRIOR";
         return(false);
        }
      tr_sum+=(d1[i].high-d1[i].low);
     }
   const double tr_mean=tr_sum/6.0;
   if(!SnrFinite(tr_mean) || tr_mean<=0.0 || body0<0.70*tr_mean)
     {
      out.reject_reason="D1BM_SIZE";
      return(true);
     }

   const int bias=(d1[0].close>d1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="D1BM_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="D1BM_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=body0/tr_mean;
   out.trend.slope=tr_mean;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1H2mSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates h2[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_H2,8,h2) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(h2)<7 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h2[0].time<=0 || h2[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h2[0].close) || !SnrFinite(h2[0].open) ||
      !SnrFinite(h2[0].high) || !SnrFinite(h2[0].low) ||
      h1[0].high<=h1[0].low || h2[0].high<=h2[0].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="H2M_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="H2M_RANGE";
      return(true);
     }

   const double h2_range=h2[0].high-h2[0].low;
   const double h2_body=MathAbs(h2[0].close-h2[0].open);
   if(!SnrFinite(h2_range) || h2_range<=0.0 ||
      !SnrFinite(h2_body) || h2_body<0.70*h2_range)
     {
      out.reject_reason="H2M_BODY";
      return(true);
     }

   double tr_sum=0.0;
   for(int i=1;i<=6;i++)
     {
      if(!SnrFinite(h2[i].high) || !SnrFinite(h2[i].low) || h2[i].high<=h2[i].low)
        {
         out.data_fail=true;
         out.reject_reason="H2M_PRIOR";
         return(false);
        }
      tr_sum+=(h2[i].high-h2[i].low);
     }
   const double tr_mean=tr_sum/6.0;
   if(!SnrFinite(tr_mean) || tr_mean<=0.0 || h2_range<0.70*tr_mean)
     {
      out.reject_reason="H2M_SIZE";
      return(true);
     }

   const int bias=(h2[0].close>h2[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="H2M_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="H2M_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=h2_body/h2_range;
   out.trend.slope=h2_range/tr_mean;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1H2dpSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates h2[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_H2,8,h2) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(h2)<3 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h2[0].time<=0 || h2[0].time>=availability_time ||
      h2[1].time<=0 || h2[1].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h2[0].close) || !SnrFinite(h2[1].close) ||
      !SnrFinite(h2[1].high) || !SnrFinite(h2[1].low) ||
      h1[0].high<=h1[0].low || h2[1].high<=h2[1].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="H2DP_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="H2DP_RANGE";
      return(true);
     }

   const double prior_rng=h2[1].high-h2[1].low;
   const double h2_cc=h2[0].close-h2[1].close;
   if(!SnrFinite(prior_rng) || prior_rng<=0.0 || !SnrFinite(h2_cc))
     {
      out.reject_reason="H2DP_PRIOR";
      return(true);
     }
   if(MathAbs(h2_cc)<0.80*prior_rng)
     {
      out.reject_reason="H2DP_DISP";
      return(true);
     }

   const int bias=(h2_cc>0.0 ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="H2DP_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="H2DP_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=h2_cc/prior_rng;
   out.trend.slope=h2_cc/atr[0];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1H2vSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates h2[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_H2,12,h2) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(h2)<11 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h2[0].time<=0 || h2[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h2[0].close) || !SnrFinite(h2[0].open) ||
      !SnrFinite(h2[0].high) || !SnrFinite(h2[0].low) ||
      h1[0].high<=h1[0].low || h2[0].high<=h2[0].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="H2V_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="H2V_RANGE";
      return(true);
     }
   if(h2[0].close==h2[0].open)
     {
      out.reject_reason="H2V_H2COLOR";
      return(true);
     }

   const double vol0=(double)h2[0].tick_volume;
   if(!SnrFinite(vol0) || vol0<=0.0)
     {
      out.reject_reason="H2V_VOL";
      return(true);
     }

   double vol_sum=0.0;
   for(int i=1;i<=10;i++)
     {
      const double v=(double)h2[i].tick_volume;
      if(!SnrFinite(v) || v<=0.0)
        {
         out.data_fail=true;
         out.reject_reason="H2V_PRIOR";
         return(false);
        }
      vol_sum+=v;
     }
   const double vol_mean=vol_sum/10.0;
   if(!SnrFinite(vol_mean) || vol_mean<=0.0 || vol0<1.50*vol_mean)
     {
      out.reject_reason="H2V_SIZE";
      return(true);
     }

   const int bias=(h2[0].close>h2[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="H2V_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="H2V_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=vol_mean;
   out.trend.slope=vol0/vol_mean;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1H2gpSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates h2[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_H2,4,h2) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(h2)<2 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h2[0].time<=0 || h2[0].time>=availability_time ||
      h2[1].time<=0 || h2[1].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h2[0].close) || !SnrFinite(h2[0].open) ||
      !SnrFinite(h2[0].high) || !SnrFinite(h2[0].low) ||
      !SnrFinite(h2[1].high) || !SnrFinite(h2[1].low) ||
      h1[0].high<=h1[0].low || h2[0].high<=h2[0].low ||
      h2[1].high<=h2[1].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="H2GP_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="H2GP_RANGE";
      return(true);
     }
   if(h2[0].close==h2[0].open)
     {
      out.reject_reason="H2GP_H2COLOR";
      return(true);
     }

   int bias=SNR_DIR_NONE;
   if(h2[0].low>h2[1].high && h2[0].close>h2[0].open)
      bias=SNR_DIR_LONG;
   else if(h2[0].high<h2[1].low && h2[0].close<h2[0].open)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="H2GP_GAP";
      return(true);
     }

   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="H2GP_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="H2GP_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=(direction>0 ? h2[0].low-h2[1].high : h2[1].low-h2[0].high);
   out.trend.slope=rng0/atr[0];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1D1mqSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,16,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(d1)<15 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 || d1[0].high<=d1[0].low ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(d1[0].close) || !SnrFinite(d1[0].open) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="D1MQ_HOUR";
      return(true);
     }

   double adr_sum=0.0;
   for(int i=1;i<=14;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) || d1[i].high<=d1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="D1MQ_ADR";
         return(false);
        }
      adr_sum+=(d1[i].high-d1[i].low);
     }
   const double adr=adr_sum/14.0;
   const double y_range=d1[0].high-d1[0].low;
   if(!SnrFinite(adr) || adr<=0.0 || !SnrFinite(y_range) ||
      y_range<0.50*adr || y_range>=0.80*adr)
     {
      out.reject_reason="D1MQ_ADR";
      return(true);
     }
   const double q=(d1[0].close-d1[0].low)/y_range;
   int bias=SNR_DIR_NONE;
   if(q>=0.75)
      bias=SNR_DIR_LONG;
   else if(q<=0.25)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="D1MQ_Q";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="D1MQ_COLOR";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-d1[0].low : d1[0].high-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="D1MQ_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=q;
   out.trend.slope=y_range/adr;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? d1[0].low : d1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1H4xvSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates h4[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_H4,4,h4) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,4,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(h4)<1 || ArraySize(d1)<1 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h4[0].time<=0 || h4[0].time>=availability_time ||
      d1[0].time<=0 ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h4[0].close) || !SnrFinite(h4[0].open) ||
      !SnrFinite(h4[0].high) || !SnrFinite(h4[0].low) ||
      !SnrFinite(d1[0].high) || !SnrFinite(d1[0].low) ||
      h1[0].high<=h1[0].low || h4[0].high<=h4[0].low ||
      d1[0].high<=d1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="H4XV_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="H4XV_RANGE";
      return(true);
     }

   const double Y=d1[0].high-d1[0].low;
   if(!SnrFinite(Y) || Y<=0.0)
     {
      out.reject_reason="H4XV_Y";
      return(true);
     }
   const double y_lo=d1[0].low+0.25*Y;
   const double y_hi=d1[0].high-0.25*Y;
   int bias=SNR_DIR_NONE;
   if(h4[0].open<=y_lo && h4[0].close>=y_hi)
      bias=SNR_DIR_LONG;
   else if(h4[0].open>=y_hi && h4[0].close<=y_lo)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="H4XV_TRAV";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="H4XV_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="H4XV_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=Y;
   out.trend.slope=(direction>0 ? h4[0].close-h4[0].open : h4[0].open-h4[0].close);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1LdgoSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,16,d1) ||
      !SnrCopyClosedBuffer(handles.atr,6,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<3 || ArraySize(d1)<15 || ArraySize(atr)<2 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h1[1].time<=0 || h1[1].time>=availability_time ||
      d1[0].time<=0 ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h1[1].close) || !SnrFinite(h1[1].open) ||
      !SnrFinite(h1[1].high) || !SnrFinite(h1[1].low) ||
      !SnrFinite(d1[0].close) || !SnrFinite(d1[0].open) ||
      !SnrFinite(d1[0].high) || !SnrFinite(d1[0].low) ||
      h1[0].high<=h1[0].low || h1[1].high<=h1[1].low ||
      d1[0].high<=d1[0].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0 ||
      !SnrFinite(atr[1]) || atr[1]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   double adr_sum=0.0;
   for(int i=1;i<=14;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) || d1[i].high<=d1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="LDGO_ADR";
         return(false);
        }
      adr_sum+=(d1[i].high-d1[i].low);
     }
   const double adr=adr_sum/14.0;
   const double y_range=d1[0].high-d1[0].low;
   if(!SnrFinite(adr) || adr<=0.0 || !SnrFinite(y_range) || y_range<0.80*adr)
     {
      out.reject_reason="LDGO_ADR";
      return(true);
     }
   if(d1[0].close==d1[0].open)
     {
      out.reject_reason="LDGO_D1";
      return(true);
     }
   const int bias=(d1[0].close>d1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);

   const bool impulse_color=(bias>0 ? h1[1].close>h1[1].open
                                    : h1[1].close<h1[1].open);
   const double impulse_body=MathAbs(h1[1].close-h1[1].open);
   if(!impulse_color || impulse_body<0.60*atr[1])
     {
      out.reject_reason="LDGO_IMPULSE";
      return(true);
     }

   const bool go=(bias>0
                  ? (h1[0].close>h1[1].high && h1[0].close>h1[0].open)
                  : (h1[0].close<h1[1].low && h1[0].close<h1[0].open));
   if(!go)
     {
      out.reject_reason="LDGO_GO";
      return(true);
     }

   const int direction=bias;
   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="LDGO_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=y_range/adr;
   out.trend.slope=impulse_body/atr[1];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=false;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[1].close;
   out.wave.impulse_extreme=(direction>0 ? h1[1].high : h1[1].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1H2lSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates h2[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_H2,8,h2) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(h2)<7 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h2[0].time<=0 || h2[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h2[0].close) || !SnrFinite(h2[0].open) ||
      !SnrFinite(h2[0].high) || !SnrFinite(h2[0].low) ||
      h1[0].high<=h1[0].low || h2[0].high<=h2[0].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=10)
     {
      out.reject_reason="H2L_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="H2L_RANGE";
      return(true);
     }

   const double h2_range=h2[0].high-h2[0].low;
   const double h2_body=MathAbs(h2[0].close-h2[0].open);
   if(!SnrFinite(h2_range) || h2_range<=0.0 ||
      !SnrFinite(h2_body) || h2_body<0.70*h2_range)
     {
      out.reject_reason="H2L_BODY";
      return(true);
     }

   double tr_sum=0.0;
   for(int i=1;i<=6;i++)
     {
      if(!SnrFinite(h2[i].high) || !SnrFinite(h2[i].low) || h2[i].high<=h2[i].low)
        {
         out.data_fail=true;
         out.reject_reason="H2L_PRIOR";
         return(false);
        }
      tr_sum+=(h2[i].high-h2[i].low);
     }
   const double tr_mean=tr_sum/6.0;
   if(!SnrFinite(tr_mean) || tr_mean<=0.0 || h2_range<0.70*tr_mean)
     {
      out.reject_reason="H2L_SIZE";
      return(true);
     }

   const int bias=(h2[0].close>h2[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="H2L_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="H2L_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=h2_body/h2_range;
   out.trend.slope=h2_range/tr_mean;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1H3sSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,24,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<22 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="H3S_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="H3S_RANGE";
      return(true);
     }

   for(int j=1;j<=21;j++)
     {
      if(h1[j].time<=0 || !SnrFinite(h1[j].high) || !SnrFinite(h1[j].low) ||
         !SnrFinite(h1[j].open) || !SnrFinite(h1[j].close) ||
         h1[j].high<=h1[j].low)
        {
         out.data_fail=true;
         out.reject_reason="H3S_PRIOR";
         return(false);
        }
     }

   const double syn_open=h1[3].open;
   const double syn_close=h1[1].close;
   const double syn_high=MathMax(h1[1].high,MathMax(h1[2].high,h1[3].high));
   const double syn_low=MathMin(h1[1].low,MathMin(h1[2].low,h1[3].low));
   const double syn_range=syn_high-syn_low;
   const double syn_body=MathAbs(syn_close-syn_open);
   if(!SnrFinite(syn_range) || syn_range<=0.0 ||
      !SnrFinite(syn_body) || syn_body<0.70*syn_range)
     {
      out.reject_reason="H3S_BODY";
      return(true);
     }

   double tr_sum=0.0;
   for(int k=1;k<=6;k++)
     {
      const int b=1+k*3;
      const double ph=MathMax(h1[b].high,MathMax(h1[b+1].high,h1[b+2].high));
      const double pl=MathMin(h1[b].low,MathMin(h1[b+1].low,h1[b+2].low));
      if(!SnrFinite(ph) || !SnrFinite(pl) || ph<=pl)
        {
         out.data_fail=true;
         out.reject_reason="H3S_PRIOR";
         return(false);
        }
      tr_sum+=(ph-pl);
     }
   const double tr_mean=tr_sum/6.0;
   if(!SnrFinite(tr_mean) || tr_mean<=0.0 || syn_range<0.70*tr_mean)
     {
      out.reject_reason="H3S_SIZE";
      return(true);
     }

   const int bias=(syn_close>syn_open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="H3S_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="H3S_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=syn_body/syn_range;
   out.trend.slope=syn_range/tr_mean;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1R24mSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,24,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,16,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<24 || ArraySize(d1)<15 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h1[23].open) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="R24M_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="R24M_RANGE";
      return(true);
     }

   double rh=h1[0].high;
   double rl=h1[0].low;
   for(int r=1;r<24;r++)
     {
      if(!SnrFinite(h1[r].high) || !SnrFinite(h1[r].low) || h1[r].high<=h1[r].low)
        {
         out.data_fail=true;
         out.reject_reason="R24M_BAR";
         return(false);
        }
      if(h1[r].high>rh)
         rh=h1[r].high;
      if(h1[r].low<rl)
         rl=h1[r].low;
     }
   const double rr=rh-rl;
   if(!SnrFinite(rr) || rr<=0.0)
     {
      out.reject_reason="R24M_RNG";
      return(true);
     }

   double adr_sum=0.0;
   for(int d=1;d<=14;d++)
     {
      if(!SnrFinite(d1[d].high) || !SnrFinite(d1[d].low) || d1[d].high<=d1[d].low)
        {
         out.data_fail=true;
         out.reject_reason="R24M_ADR";
         return(false);
        }
      adr_sum+=(d1[d].high-d1[d].low);
     }
   const double adr=adr_sum/14.0;
   if(!SnrFinite(adr) || adr<=0.0 || rr<0.80*adr)
     {
      out.reject_reason="R24M_ADR";
      return(true);
     }

   const double box_open=h1[23].open;
   const double box_body=MathAbs(h1[0].close-box_open);
   if(!SnrFinite(box_open) || !SnrFinite(box_body) || box_body<0.70*rr)
     {
      out.reject_reason="R24M_BODY";
      return(true);
     }

   const int bias=(h1[0].close>box_open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias || h1[0].close==box_open)
     {
      out.reject_reason="R24M_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="R24M_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=box_body/rr;
   out.trend.slope=rr/adr;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1H4odSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates h4[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_H4,4,h4) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(h4)<2 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h4[0].time<=0 || h4[0].time>=availability_time ||
      h4[1].time<=0 || h4[1].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h4[0].close) || !SnrFinite(h4[0].open) ||
      !SnrFinite(h4[0].high) || !SnrFinite(h4[0].low) ||
      !SnrFinite(h4[1].high) || !SnrFinite(h4[1].low) ||
      h1[0].high<=h1[0].low || h4[0].high<=h4[0].low ||
      h4[1].high<=h4[1].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="H4OD_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="H4OD_RANGE";
      return(true);
     }

   if(!(h4[0].high>h4[1].high && h4[0].low<h4[1].low) ||
      h4[0].close==h4[0].open)
     {
      out.reject_reason="H4OD_OUT";
      return(true);
     }

   const int bias=(h4[0].close>h4[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="H4OD_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="H4OD_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=h4[0].high-h4[1].high;
   out.trend.slope=h4[1].low-h4[0].low;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1H8dpSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates h4[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_H4,8,h4) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(h4)<3 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h4[0].time<=0 || h4[0].time>=availability_time ||
      h4[2].time<=0 || h4[2].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h4[0].close) || !SnrFinite(h4[2].close) ||
      !SnrFinite(h4[2].high) || !SnrFinite(h4[2].low) ||
      h1[0].high<=h1[0].low || h4[2].high<=h4[2].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="H8DP_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="H8DP_RANGE";
      return(true);
     }

   const double prior_rng=h4[2].high-h4[2].low;
   const double h8_cc=h4[0].close-h4[2].close;
   if(!SnrFinite(prior_rng) || prior_rng<=0.0 || !SnrFinite(h8_cc))
     {
      out.reject_reason="H8DP_PRIOR";
      return(true);
     }
   if(MathAbs(h8_cc)<0.80*prior_rng)
     {
      out.reject_reason="H8DP_DISP";
      return(true);
     }

   const int bias=(h8_cc>0.0 ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="H8DP_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="H8DP_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=MathAbs(h8_cc)/prior_rng;
   out.trend.slope=h8_cc;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1H4wkSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates h4[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_H4,4,h4) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(h4)<1 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h4[0].time<=0 || h4[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h4[0].close) || !SnrFinite(h4[0].open) ||
      !SnrFinite(h4[0].high) || !SnrFinite(h4[0].low) ||
      h1[0].high<=h1[0].low || h4[0].high<=h4[0].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=8)
     {
      out.reject_reason="H4WK_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="H4WK_RANGE";
      return(true);
     }

   const double hr=h4[0].high-h4[0].low;
   if(!SnrFinite(hr) || hr<=0.0)
     {
      out.reject_reason="H4WK_H4";
      return(true);
     }
   const double q=(h4[0].close-h4[0].low)/hr;
   const double lo_wick=MathMin(h4[0].open,h4[0].close)-h4[0].low;
   const double hi_wick=h4[0].high-MathMax(h4[0].open,h4[0].close);
   int bias=SNR_DIR_NONE;
   if(lo_wick>=0.40*hr && q>=0.70 && h4[0].close>h4[0].open)
      bias=SNR_DIR_LONG;
   else if(hi_wick>=0.40*hr && q<=0.30 && h4[0].close<h4[0].open)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="H4WK_WICK";
      return(true);
     }

   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="H4WK_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="H4WK_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=q;
   out.trend.slope=(direction>0 ? lo_wick/hr : hi_wick/hr);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

