   const int bias=(h4[0].close>h4[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="H4L2_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h4[0].low : h4[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="H4L2_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=h4_body/h4_range;
   out.trend.slope=h4_body/atr[0];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h4[0].high : h4[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1C10dSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,4,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(d1)<1 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 || d1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(d1[0].close) || !SnrFinite(d1[0].open) ||
      !SnrFinite(d1[0].high) || !SnrFinite(d1[0].low) ||
      h1[0].high<=h1[0].low || d1[0].high<=d1[0].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=10)
     {
      out.reject_reason="C10D_HOUR";
      return(true);
     }

   const double rng0=h1[0].high-h1[0].low;
   if(!SnrFinite(rng0) || rng0<0.50*atr[0] || h1[0].close==h1[0].open)
     {
      out.reject_reason="C10D_RANGE";
      return(true);
     }
   if(d1[0].close==d1[0].open)
     {
      out.reject_reason="C10D_D1";
      return(true);
     }

   const int bias=(d1[0].close>d1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="C10D_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="C10D_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=d1[0].close;
   out.trend.slope=(d1[0].close-d1[0].open)/atr[0];
   out.trend.side=direction;

   if(SnrNewsUsdChfHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildD1AdswSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,16,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(d1)<5 || ArraySize(atr)<1 ||
      d1[0].time<=0 || d1[0].time>=availability_time ||
      !SnrFinite(d1[0].close) || !SnrFinite(d1[0].open) ||
      !SnrFinite(d1[0].high) || !SnrFinite(d1[0].low) ||
      d1[0].high<=d1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=d1[0].time;
   out.signal_high=d1[0].high;
   out.signal_low=d1[0].low;
   out.signal_close=d1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=d1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(out.session.flatten ||
      out.session.london_dow==0 ||
      out.session.london_dow==5 ||
      out.session.london_dow==6)
     {
      out.reject_reason="ADSW_DOW";
      return(true);
     }

   const double range=d1[0].high-d1[0].low;
   const double body=MathAbs(d1[0].close-d1[0].open);
   if(!SnrFinite(range) || !SnrFinite(body) ||
      range<=0.0 || body<0.50*range || range<1.00*atr[0])
     {
      out.reject_reason="ADSW_BAR";
      return(true);
     }

   const int direction=(d1[0].close>d1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const double sl_px=(direction>0 ? d1[0].low : d1[0].high);
   const double sl_dist=(direction>0 ? d1[0].close-sl_px : sl_px-d1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="ADSW_SL";
      return(true);
     }

   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=body/range;
   out.trend.slope=range/atr[0];
   out.trend.side=direction;

   if(SnrNewsAudUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+24*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=d1[0].close;
   out.wave.impulse_extreme=(direction>0 ? d1[0].high : d1[0].low);

   SnrPvsraReadClosed(d1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(d1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1PgoSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<3 || ArraySize(atr)<2 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h1[1].time<=0 ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h1[1].close) || !SnrFinite(h1[1].open) ||
      !SnrFinite(h1[1].high) || !SnrFinite(h1[1].low) ||
      h1[0].high<=h1[0].low || h1[1].high<=h1[1].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0 ||
      !SnrFinite(atr[1]) || atr[1]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   const double pause_rng=h1[1].high-h1[1].low;
   const double go_rng=h1[0].high-h1[0].low;
   const double go_body=MathAbs(h1[0].close-h1[0].open);
   if(!SnrFinite(pause_rng) || !SnrFinite(go_rng) || !SnrFinite(go_body) ||
      pause_rng<=0.0 || go_rng<=0.0 || h1[0].close==h1[0].open)
     {
      out.reject_reason="PGO_BAR";
      return(true);
     }
   if(pause_rng>=0.40*atr[1])
     {
      out.reject_reason="PGO_PAUSE";
      return(true);
     }
   if(go_rng<1.00*atr[0] || go_body<0.60*go_rng)
     {
      out.reject_reason="PGO_GO";
      return(true);
     }

   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const bool broke=(direction>0 ? h1[0].close>h1[1].high
                                 : h1[0].close<h1[1].low);
   if(!broke)
     {
      out.reject_reason="PGO_BREAK";
      return(true);
     }

   const double sl_px=(direction>0 ? MathMin(h1[0].low,h1[1].low)
                                   : MathMax(h1[0].high,h1[1].high));
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="PGO_SL";
      return(true);
     }

   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=pause_rng/atr[1];
   out.trend.slope=go_rng/atr[0];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[1].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1FlgSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,12,h1) ||
      !SnrCopyClosedBuffer(handles.atr,8,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<8 || ArraySize(atr)<1 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   int impulse_k=-1;
   int direction=SNR_DIR_NONE;
   double imp_high=0.0;
   double imp_low=0.0;
   const int n=ArraySize(h1);
   for(int k=3;k<=5 && k<n;k++)
     {
      if(!SnrFinite(h1[k].high) || !SnrFinite(h1[k].low) ||
         !SnrFinite(h1[k].close) || !SnrFinite(h1[k].open) ||
         h1[k].high<=h1[k].low || h1[k].close==h1[k].open)
         continue;
      const double rng=h1[k].high-h1[k].low;
      const double body=MathAbs(h1[k].close-h1[k].open);
      if(!SnrFinite(rng) || !SnrFinite(body) ||
         body<0.70*rng || rng<1.00*atr[0])
         continue;
      impulse_k=k;
      direction=(h1[k].close>h1[k].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
      imp_high=h1[k].high;
      imp_low=h1[k].low;
      break;
     }
   if(impulse_k<3 || direction==SNR_DIR_NONE)
     {
      out.reject_reason="FLG_IMPULSE";
      return(true);
     }

   double flag_lo=h1[1].low;
   double flag_hi=h1[1].high;
   for(int i=1;i<impulse_k;i++)
     {
      if(!SnrFinite(h1[i].high) || !SnrFinite(h1[i].low) ||
         h1[i].high<=h1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="FLG_BAR";
         return(false);
        }
      if(h1[i].high>imp_high || h1[i].low<imp_low)
        {
         out.reject_reason="FLG_BROKEN";
         return(true);
        }
      if(h1[i].low<flag_lo)
         flag_lo=h1[i].low;
      if(h1[i].high>flag_hi)
         flag_hi=h1[i].high;
     }

   const bool broke=(direction>0
                     ? (h1[0].close>imp_high && h1[0].close>h1[0].open)
                     : (h1[0].close<imp_low && h1[0].close<h1[0].open));
   const double go_rng=h1[0].high-h1[0].low;
   if(!broke || !SnrFinite(go_rng) || go_rng<0.50*atr[0])
     {
      out.reject_reason="FLG_GO";
      return(true);
     }

   const double sl_px=(direction>0 ? MathMin(h1[0].low,flag_lo)
                                   : MathMax(h1[0].high,flag_hi));
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="FLG_SL";
      return(true);
     }

   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=(double)impulse_k;
   out.trend.slope=(imp_high-imp_low)/atr[0];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[1].close;
   out.wave.impulse_extreme=(direction>0 ? imp_high : imp_low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1NresSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<3 || ArraySize(atr)<2 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      h1[1].time<=0 ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h1[1].close) || !SnrFinite(h1[1].open) ||
      !SnrFinite(h1[1].high) || !SnrFinite(h1[1].low) ||
      h1[0].high<=h1[0].low || h1[1].high<=h1[1].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   const datetime spike_gmt=h1[1].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   if(!SnrNewsUsdHighImpact(spike_gmt-SNR_NEWS_PAD_SEC,signal_gmt))
     {
      out.reject_reason="NRES_NEWS";
      return(true);
     }

   const double spike_rng=h1[1].high-h1[1].low;
   const double go_rng=h1[0].high-h1[0].low;
   if(!SnrFinite(spike_rng) || !SnrFinite(go_rng) ||
      spike_rng<0.80*atr[0] || go_rng<0.50*atr[0] ||
      h1[1].close==h1[1].open || h1[0].close==h1[0].open)
     {
      out.reject_reason="NRES_BAR";
      return(true);
     }

   const int direction=(h1[1].close>h1[1].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int go_dir=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(go_dir!=direction)
     {
      out.reject_reason="NRES_COLOR";
      return(true);
     }
   const bool broke=(direction>0 ? h1[0].close>h1[1].high
                                 : h1[0].close<h1[1].low);
   if(!broke)
     {
      out.reject_reason="NRES_BREAK";
      return(true);
     }

   const double sl_px=(direction>0 ? MathMin(h1[0].low,h1[1].low)
                                   : MathMax(h1[0].high,h1[1].high));
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="NRES_SL";
      return(true);
     }

   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=spike_rng/atr[0];
   out.trend.slope=go_rng/atr[0];
   out.trend.side=direction;

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[1].close;
   out.wave.impulse_extreme=(direction>0 ? h1[1].high : h1[1].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildD1D2rSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,16,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(d1)<5 || ArraySize(atr)<1 ||
      d1[0].time<=0 || d1[0].time>=availability_time ||
      !SnrFinite(d1[0].close) || !SnrFinite(d1[0].open) ||
      !SnrFinite(d1[0].high) || !SnrFinite(d1[0].low) ||
      d1[0].high<=d1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=d1[0].time;
   out.signal_high=d1[0].high;
   out.signal_low=d1[0].low;
   out.signal_close=d1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=d1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(out.session.flatten ||
      out.session.london_dow==0 ||
      out.session.london_dow==5 ||
      out.session.london_dow==6)
     {
      out.reject_reason="D2R_DOW";
      return(true);
     }

   const double range=d1[0].high-d1[0].low;
   const double body=MathAbs(d1[0].close-d1[0].open);
   if(!SnrFinite(range) || !SnrFinite(body) ||
      range<=0.0 || body<0.70*range || range<1.00*atr[0])
     {
      out.reject_reason="D2R_BAR";
      return(true);
     }

   const int direction=(d1[0].close>d1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const double sl_px=(direction>0 ? d1[0].low : d1[0].high);
   const double sl_dist=(direction>0 ? d1[0].close-sl_px : sl_px-d1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="D2R_SL";
      return(true);
     }

   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=body/range;
   out.trend.slope=range/atr[0];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+24*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=d1[0].close;
   out.wave.impulse_extreme=(direction>0 ? d1[0].high : d1[0].low);

   SnrPvsraReadClosed(d1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(d1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildM15H1goSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                           const SnrHandles &handles,const SnrClassicCfg &cfg,
                           const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates m15[];
   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,m15) ||
      !SnrCopyClosedRates(symbol,PERIOD_H1,4,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(m15)<3 || ArraySize(h1)<1 || ArraySize(atr)<1 ||
      m15[0].time<=0 || m15[0].time>=availability_time ||
      m15[1].time<=0 || h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(m15[0].close) || !SnrFinite(m15[0].open) ||
      !SnrFinite(m15[0].high) || !SnrFinite(m15[0].low) ||
      !SnrFinite(m15[1].close) || !SnrFinite(m15[1].open) ||
      !SnrFinite(m15[1].high) || !SnrFinite(m15[1].low) ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      m15[0].high<=m15[0].low || m15[1].high<=m15[1].low ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=m15[0].time;
   out.signal_high=m15[0].high;
   out.signal_low=m15[0].low;
   out.signal_close=m15[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=m15[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<9 || out.session.london_hour>15)
     {
      out.reject_reason="H1GO_HOUR";
      return(true);
     }

   const double h1_rng=h1[0].high-h1[0].low;
   const double h1_body=MathAbs(h1[0].close-h1[0].open);
   if(!SnrFinite(h1_rng) || !SnrFinite(h1_body) ||
      h1_rng<0.50*atr[0] || h1_body<0.40*h1_rng ||
      h1[0].close==h1[0].open)
     {
      out.reject_reason="H1GO_H1";
      return(true);
     }

   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int m15_dir=(m15[0].close>m15[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int imp_dir=(m15[1].close>m15[1].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(m15_dir!=direction || imp_dir!=direction)
     {
      out.reject_reason="H1GO_COLOR";
      return(true);
     }

   const double m15_imp_body=MathAbs(m15[1].close-m15[1].open);
   if(!SnrFinite(m15_imp_body) || m15_imp_body<0.20*atr[0])
     {
      out.reject_reason="H1GO_IMP";
      return(true);
     }
   const bool broke=(direction>0 ? m15[0].close>m15[1].high
                                 : m15[0].close<m15[1].low);
   if(!broke)
     {
      out.reject_reason="H1GO_BREAK";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? m15[0].close-sl_px : sl_px-m15[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="H1GO_SL";
      return(true);
     }

   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=h1_body/h1_rng;
   out.trend.slope=h1_rng/atr[0];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=m15[1].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(m15,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(m15[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildM15TorbSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                           const SnrHandles &handles,const SnrClassicCfg &cfg,
                           const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates m15[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,m15) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(m15)<5 || ArraySize(atr)<1 ||
      m15[0].time<=0 || m15[0].time>=availability_time ||
      !SnrFinite(m15[0].close) || !SnrFinite(m15[0].open) ||
      !SnrFinite(m15[0].high) || !SnrFinite(m15[0].low) ||
      m15[0].high<=m15[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=m15[0].time;
   out.signal_high=m15[0].high;
   out.signal_low=m15[0].low;
   out.signal_close=m15[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=m15[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(out.session.flatten ||
      out.session.london_dow==0 ||
      out.session.london_dow==6)
     {
      out.reject_reason="TORB_DOW";
      return(true);
     }
   if(out.session.london_hour!=1)
     {
      out.reject_reason="TORB_HOUR";
      return(true);
     }

   double or_hi=0.0;
   double or_lo=0.0;
   for(int i=1;i<=4;i++)
     {
      if(!SnrFinite(m15[i].high) || !SnrFinite(m15[i].low) ||
         m15[i].high<=m15[i].low)
        {
         out.data_fail=true;
         out.reject_reason="TORB_OR";
         return(false);
        }
      if(i==1)
        {
         or_hi=m15[i].high;
         or_lo=m15[i].low;
        }
      else
        {
         if(m15[i].high>or_hi)
            or_hi=m15[i].high;
         if(m15[i].low<or_lo)
            or_lo=m15[i].low;
        }
     }
   const double or_rng=or_hi-or_lo;
   if(!SnrFinite(or_rng) || or_rng<0.15*atr[0])
     {
      out.reject_reason="TORB_SIZE";
      return(true);
     }

   int direction=SNR_DIR_NONE;
   if(m15[0].close>or_hi && m15[0].close>m15[0].open)
      direction=SNR_DIR_LONG;
   else if(m15[0].close<or_lo && m15[0].close<m15[0].open)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="TORB_BREAK";
      return(true);
     }

   const double sl_px=(direction>0 ? or_lo : or_hi);
   const double sl_dist=(direction>0 ? m15[0].close-sl_px : sl_px-m15[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.15*atr[0])
     {
      out.reject_reason="TORB_SL";
      return(true);
     }

   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=or_rng/atr[0];
   out.trend.slope=sl_dist/atr[0];
   out.trend.side=direction;

   if(SnrNewsUsdJpyHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=m15[0].close;
   out.wave.impulse_extreme=(direction>0 ? m15[0].high : m15[0].low);

   SnrPvsraReadClosed(m15,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(m15[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1EipgSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   if(!SnrBuildH1IpgSignal(symbol,tf,handles,cfg,availability_time,out))
      return(false);
   if(out.data_fail || !out.fired || out.decision_time<=0)
      return(true);
   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=out.decision_time-(server_now-gmt_now);
   if(SnrNewsEurUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.fired=false;
      out.reject_reason="NEWS";
     }
   return(true);
  }

bool SnrBuildH1D10bSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
