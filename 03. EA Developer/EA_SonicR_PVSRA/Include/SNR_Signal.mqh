      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   double sma=0.0;
   for(int i=0;i<20;i++)
     {
      if(!SnrFinite(d1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="EMX_SMA";
         return(false);
        }
      sma+=d1[i].close;
     }
   sma/=20.0;
   int bias=SNR_DIR_NONE;
   if(d1[0].close>sma)
      bias=SNR_DIR_LONG;
   else if(d1[0].close<sma)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="EMX_SMA";
      return(true);
     }

   const int n=ArraySize(h1);
   double ema8=0.0;
   double ema21=0.0;
   for(int i=n-8;i<n;i++)
     {
      if(!SnrFinite(h1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="EMX_SEED";
         return(false);
        }
      ema8+=h1[i].close;
     }
   ema8/=8.0;
   for(int i=n-21;i<n;i++)
     {
      if(!SnrFinite(h1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="EMX_SEED";
         return(false);
        }
      ema21+=h1[i].close;
     }
   ema21/=21.0;
   double ema8_prev=ema8;
   double ema21_prev=ema21;
   const double k8=2.0/9.0;
   const double k21=2.0/22.0;
   for(int i=n-22;i>=0;i--)
     {
      if(!SnrFinite(h1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="EMX_EMA";
         return(false);
        }
      ema21_prev=ema21;
      ema21=h1[i].close*k21+ema21*(1.0-k21);
      if(i<=n-9)
        {
         ema8_prev=ema8;
         ema8=h1[i].close*k8+ema8*(1.0-k8);
        }
     }
   if(!SnrFinite(ema8) || !SnrFinite(ema21) ||
      !SnrFinite(ema8_prev) || !SnrFinite(ema21_prev))
     {
      out.data_fail=true;
      out.reject_reason="EMX_EMA";
      return(false);
     }

   int direction=SNR_DIR_NONE;
   const bool bull_x=(ema8>ema21 && ema8_prev<=ema21_prev);
   const bool bear_x=(ema8<ema21 && ema8_prev>=ema21_prev);
   if(bull_x && bias>0)
      direction=SNR_DIR_LONG;
   else if(bear_x && bias<0)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="EMX";
      return(true);
     }

   const double sl_px=(direction>0
                       ? MathMin(h1[0].low,MathMin(h1[1].low,h1[2].low))
                       : MathMax(h1[0].high,MathMax(h1[1].high,h1[2].high)));
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="EMX_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=ema8-ema21;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1D2brSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,24,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,8,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<8 || ArraySize(d1)<3 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 || d1[1].time<=0 ||
      d1[0].high<=d1[0].low || d1[1].high<=d1[1].low ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(d1[0].high) || !SnrFinite(d1[0].low) ||
      !SnrFinite(d1[1].high) || !SnrFinite(d1[1].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   const double d2h=MathMax(d1[0].high,d1[1].high);
   const double d2l=MathMin(d1[0].low,d1[1].low);
   if(!SnrFinite(d2h) || !SnrFinite(d2l) || d2h<=d2l)
     {
      out.reject_reason="D2BR_BOX";
      return(true);
     }

   int direction=SNR_DIR_NONE;
   if(h1[0].close>d2h && h1[0].close>h1[0].open)
      direction=SNR_DIR_LONG;
   else if(h1[0].close<d2l && h1[0].close<h1[0].open)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="D2BR";
      return(true);
     }

   MqlDateTime day_ldn;
   SnrGmtToLondon(signal_gmt,day_ldn);
   const int n=ArraySize(h1);
   for(int i=1;i<n;i++)
     {
      if(!SnrFinite(h1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="D2BR_BAR";
         return(false);
        }
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      if(bar_ldn.year!=day_ldn.year || bar_ldn.mon!=day_ldn.mon || bar_ldn.day!=day_ldn.day)
         continue;
      if((direction>0 && h1[i].close>d2h) || (direction<0 && h1[i].close<d2l))
        {
         out.reject_reason="D2BR_NOT_FIRST";
         return(true);
        }
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="D2BR_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=d2h-d2l;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1YasbSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,24,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,16,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<12 || ArraySize(d1)<15 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 || d1[0].high<=d1[0].low ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   double adr_sum=0.0;
   for(int i=1;i<=14;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) || d1[i].high<=d1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="YASB_ADR";
         return(false);
        }
      adr_sum+=(d1[i].high-d1[i].low);
     }
   const double adr=adr_sum/14.0;
   const double y_range=d1[0].high-d1[0].low;
   if(!SnrFinite(adr) || adr<=0.0 || !SnrFinite(y_range) || y_range<0.80*adr)
     {
      out.reject_reason="YASB_ADR";
      return(true);
     }
   const double q=(d1[0].close-d1[0].low)/y_range;
   int bias=SNR_DIR_NONE;
   if(q>=0.75)
      bias=SNR_DIR_LONG;
   else if(q<=0.25)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="YASB_Q";
      return(true);
     }

   MqlDateTime day_ldn;
   SnrGmtToLondon(signal_gmt,day_ldn);
   double box_h=-1.0e100;
   double box_l=1.0e100;
   int asia_n=0;
   const int n=ArraySize(h1);
   for(int i=1;i<n;i++)
     {
      if(!SnrFinite(h1[i].high) || !SnrFinite(h1[i].low) || h1[i].high<=h1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="YASB_BAR";
         return(false);
        }
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      if(bar_ldn.year!=day_ldn.year || bar_ldn.mon!=day_ldn.mon || bar_ldn.day!=day_ldn.day)
         continue;
      if(bar_ldn.hour>=cfg.london_start_hour)
         continue;
      asia_n++;
      if(h1[i].high>box_h)
         box_h=h1[i].high;
      if(h1[i].low<box_l)
         box_l=h1[i].low;
     }
   if(asia_n<4 || !SnrFinite(box_h) || !SnrFinite(box_l) || box_h<=box_l)
     {
      out.reject_reason="YASB_ASIA";
      return(true);
     }

   int direction=SNR_DIR_NONE;
   if(bias>0 && h1[0].close>box_h && h1[0].close>h1[0].open)
      direction=SNR_DIR_LONG;
   else if(bias<0 && h1[0].close<box_l && h1[0].close<h1[0].open)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="YASB";
      return(true);
     }

   for(int i=1;i<n;i++)
     {
      if(!SnrFinite(h1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="YASB_PATH";
         return(false);
        }
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      if(bar_ldn.year!=day_ldn.year || bar_ldn.mon!=day_ldn.mon || bar_ldn.day!=day_ldn.day)
         continue;
      if(bar_ldn.hour<cfg.london_start_hour)
         continue;
      const bool prior=(direction>0 ? h1[i].close>box_h : h1[i].close<box_l);
      if(prior)
        {
         out.reject_reason="YASB_NOT_FIRST";
         return(true);
        }
     }

   const double sl_dist=(direction>0 ? h1[0].close-d1[0].low : d1[0].high-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="YASB_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=q;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? d1[0].low : d1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1Ds8Signal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,24,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(d1)<21 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=cfg.london_start_hour)
     {
      out.reject_reason="DS8_HOUR";
      return(true);
     }

   double sma=0.0;
   for(int i=0;i<20;i++)
     {
      if(!SnrFinite(d1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="DS8_SMA";
         return(false);
        }
      sma+=d1[i].close;
     }
   sma/=20.0;
   int bias=SNR_DIR_NONE;
   if(d1[0].close>sma)
      bias=SNR_DIR_LONG;
   else if(d1[0].close<sma)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="DS8_SMA";
      return(true);
     }

   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="DS8_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="DS8_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=sma;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1WtdSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,40,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(d1)<25 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_dow!=1 || out.session.london_hour!=cfg.london_start_hour)
     {
      out.reject_reason="WTD_CLOCK";
      return(true);
     }

   datetime monday_cursor=signal_gmt;
   MqlDateTime this_mon;
   SnrGmtToLondon(monday_cursor,this_mon);
   int hops=0;
   while(this_mon.day_of_week!=1 && hops<8)
     {
      monday_cursor-=86400;
      SnrGmtToLondon(monday_cursor,this_mon);
      hops++;
     }
   if(this_mon.day_of_week!=1)
     {
      out.reject_reason="WTD_MON";
      return(true);
     }
   const int this_key=this_mon.year*10000+this_mon.mon*100+this_mon.day;

   int wkey[8];
   double wh[8],wl[8],wc[8];
   int wn=0;
   const int dn=ArraySize(d1);
   for(int i=0;i<dn;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) || !SnrFinite(d1[i].close) ||
         d1[i].high<=d1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="WTD_D1";
         return(false);
        }
      datetime d_gmt=d1[i].time-(server_now-gmt_now);
      MqlDateTime dldn;
      SnrGmtToLondon(d_gmt,dldn);
      datetime d_cursor=d_gmt;
      int dhops=0;
      while(dldn.day_of_week!=1 && dhops<8)
        {
         d_cursor-=86400;
         SnrGmtToLondon(d_cursor,dldn);
         dhops++;
        }
      if(dldn.day_of_week!=1)
         continue;
      const int key=dldn.year*10000+dldn.mon*100+dldn.day;
      if(key>=this_key)
         continue;
      int slot=-1;
      for(int s=0;s<wn;s++)
        {
         if(wkey[s]==key)
           {
            slot=s;
            break;
           }
        }
      if(slot<0)
        {
         if(wn>=8)
            continue;
         slot=wn;
         wkey[slot]=key;
         wh[slot]=d1[i].high;
         wl[slot]=d1[i].low;
         wc[slot]=d1[i].close;
         wn++;
        }
      else
        {
         if(d1[i].high>wh[slot])
            wh[slot]=d1[i].high;
         if(d1[i].low<wl[slot])
            wl[slot]=d1[i].low;
        }
     }
   if(wn<5)
     {
      out.reject_reason="WTD_WEEKS";
      return(true);
     }

   int last_s=0;
   for(int s=1;s<wn;s++)
     {
      if(wkey[s]>wkey[last_s])
         last_s=s;
     }
   const double y_range=wh[last_s]-wl[last_s];
   if(!SnrFinite(y_range) || y_range<=0.0)
     {
      out.reject_reason="WTD_RANGE";
      return(true);
     }
   bool taken[8];
   for(int s=0;s<8;s++)
      taken[s]=(s==last_s);
   double adr_sum=0.0;
   int adr_n=0;
   for(int k=0;k<4;k++)
     {
      int best=-1;
      for(int s=0;s<wn;s++)
        {
         if(taken[s] || wkey[s]>=wkey[last_s])
            continue;
         if(best<0 || wkey[s]>wkey[best])
            best=s;
        }
      if(best<0)
         break;
      const double r=wh[best]-wl[best];
      if(!SnrFinite(r) || r<=0.0)
         break;
      taken[best]=true;
      adr_sum+=r;
      adr_n++;
     }
   if(adr_n<4 || adr_sum<=0.0)
     {
      out.reject_reason="WTD_ADR";
      return(true);
     }
   const double wadr=adr_sum/4.0;
   if(y_range<0.80*wadr)
     {
      out.reject_reason="WTD_ADR";
      return(true);
     }
   const double q=(wc[last_s]-wl[last_s])/y_range;
   int bias=SNR_DIR_NONE;
   if(q>=0.75)
      bias=SNR_DIR_LONG;
   else if(q<=0.25)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="WTD_Q";
      return(true);
     }

   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="WTD_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="WTD_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=q;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1WcrSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,80,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,40,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<16 || ArraySize(d1)<25 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   datetime monday_cursor=signal_gmt;
   MqlDateTime this_mon;
   SnrGmtToLondon(monday_cursor,this_mon);
   int hops=0;
   while(this_mon.day_of_week!=1 && hops<8)
     {
      monday_cursor-=86400;
      SnrGmtToLondon(monday_cursor,this_mon);
      hops++;
     }
   if(this_mon.day_of_week!=1)
     {
      out.reject_reason="WCR_MON";
      return(true);
     }
   const int this_key=this_mon.year*10000+this_mon.mon*100+this_mon.day;

   int wkey[8];
   double wh[8],wl[8],wc[8];
   int wn=0;
   const int dn=ArraySize(d1);
   for(int i=0;i<dn;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) || !SnrFinite(d1[i].close) ||
         d1[i].high<=d1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="WCR_D1";
         return(false);
        }
      datetime d_gmt=d1[i].time-(server_now-gmt_now);
      MqlDateTime dldn;
      SnrGmtToLondon(d_gmt,dldn);
      datetime d_cursor=d_gmt;
      int dhops=0;
      while(dldn.day_of_week!=1 && dhops<8)
        {
         d_cursor-=86400;
         SnrGmtToLondon(d_cursor,dldn);
         dhops++;
        }
      if(dldn.day_of_week!=1)
         continue;
      const int key=dldn.year*10000+dldn.mon*100+dldn.day;
      if(key>=this_key)
         continue;
      int slot=-1;
      for(int s=0;s<wn;s++)
        {
         if(wkey[s]==key)
           {
            slot=s;
            break;
           }
        }
      if(slot<0)
        {
         if(wn>=8)
            continue;
         slot=wn;
         wkey[slot]=key;
         wh[slot]=d1[i].high;
         wl[slot]=d1[i].low;
         wc[slot]=d1[i].close;
         wn++;
        }
      else
        {
         if(d1[i].high>wh[slot])
            wh[slot]=d1[i].high;
         if(d1[i].low<wl[slot])
            wl[slot]=d1[i].low;
        }
     }
   if(wn<5)
     {
      out.reject_reason="WCR_WEEKS";
      return(true);
     }

   int last_s=0;
   for(int s=1;s<wn;s++)
     {
      if(wkey[s]>wkey[last_s])
         last_s=s;
     }
   const double y_range=wh[last_s]-wl[last_s];
   if(!SnrFinite(y_range) || y_range<=0.0 || !SnrFinite(wc[last_s]))
     {
      out.reject_reason="WCR_RANGE";
      return(true);
     }
   bool taken[8];
   for(int s=0;s<8;s++)
      taken[s]=(s==last_s);
   double adr_sum=0.0;
   int adr_n=0;
   for(int k=0;k<4;k++)
     {
      int best=-1;
      for(int s=0;s<wn;s++)
        {
         if(taken[s] || wkey[s]>=wkey[last_s])
            continue;
         if(best<0 || wkey[s]>wkey[best])
            best=s;
        }
      if(best<0)
         break;
      const double r=wh[best]-wl[best];
      if(!SnrFinite(r) || r<=0.0)
         break;
      taken[best]=true;
      adr_sum+=r;
      adr_n++;
     }
   if(adr_n<4 || adr_sum<=0.0)
     {
      out.reject_reason="WCR_ADR";
      return(true);
     }
   const double wadr=adr_sum/4.0;
   if(y_range<0.80*wadr)
     {
      out.reject_reason="WCR_ADR";
      return(true);
     }
   const double q=(wc[last_s]-wl[last_s])/y_range;
   int bias=SNR_DIR_NONE;
   if(q>=0.75)
      bias=SNR_DIR_LONG;
   else if(q<=0.25)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="WCR_Q";
      return(true);
     }

   const double week_c=wc[last_s];
   int direction=SNR_DIR_NONE;
   if(bias>0 && h1[0].close>week_c && h1[0].close>h1[0].open)
      direction=SNR_DIR_LONG;
   else if(bias<0 && h1[0].close<week_c && h1[0].close<h1[0].open)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="WCR";
      return(true);
     }

   const int hn=ArraySize(h1);
   for(int i=1;i<hn;i++)
     {
      if(!SnrFinite(h1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="WCR_BAR";
         return(false);
        }
      datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      datetime b_cursor=bar_gmt;
      int b_hops=0;
      while(bar_ldn.day_of_week!=1 && b_hops<8)
        {
         b_cursor-=86400;
         SnrGmtToLondon(b_cursor,bar_ldn);
         b_hops++;
        }
      if(bar_ldn.day_of_week!=1)
         continue;
      const int bkey=bar_ldn.year*10000+bar_ldn.mon*100+bar_ldn.day;
      if(bkey!=this_key)
         continue;
      const bool prior=(direction>0 ? h1[i].close>week_c : h1[i].close<week_c);
      if(prior)
        {
         out.reject_reason="WCR_NOT_FIRST";
         return(true);
        }
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="WCR_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=q;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1D1vSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,24,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(d1)<21 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=cfg.london_start_hour)
     {
      out.reject_reason="D1V_HOUR";
      return(true);
     }

   double vol_sum=0.0;
   for(int i=1;i<=20;i++)
     {
      if(d1[i].tick_volume<=0)
        {
         out.data_fail=true;
         out.reject_reason="D1V_VOL";
         return(false);
        }
      vol_sum+=(double)d1[i].tick_volume;
     }
   const double vol_avg=vol_sum/20.0;
   if(!SnrFinite(vol_avg) || vol_avg<=0.0 || d1[0].tick_volume<=0 ||
      (double)d1[0].tick_volume<1.50*vol_avg)
     {
      out.reject_reason="D1V_VOL";
      return(true);
     }

   int bias=SNR_DIR_NONE;
   if(d1[0].close>d1[0].open)
      bias=SNR_DIR_LONG;
   else if(d1[0].close<d1[0].open)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="D1V_BIAS";
      return(true);
     }

   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="D1V_COLOR";
      return(true);
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="D1V_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=(double)d1[0].tick_volume/vol_avg;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1MwrbSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,80,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,16,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<16 || ArraySize(d1)<5 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_dow<3 || out.session.london_dow>5)
     {
      out.reject_reason="MWRB_DOW";
      return(true);
     }

   datetime monday_cursor=signal_gmt;
   MqlDateTime this_mon;
   SnrGmtToLondon(monday_cursor,this_mon);
   int hops=0;
   while(this_mon.day_of_week!=1 && hops<8)
     {
      monday_cursor-=86400;
      SnrGmtToLondon(monday_cursor,this_mon);
      hops++;
     }
   if(this_mon.day_of_week!=1)
     {
      out.reject_reason="MWRB_MON";
      return(true);
     }
   const int this_key=this_mon.year*10000+this_mon.mon*100+this_mon.day;

   double box_h=-1.0e100;
   double box_l=1.0e100;
   int box_n=0;
   const int dn=ArraySize(d1);
   for(int i=0;i<dn;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) || d1[i].high<=d1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="MWRB_D1";
         return(false);
        }
      datetime d_gmt=d1[i].time-(server_now-gmt_now);
      MqlDateTime dldn;
      SnrGmtToLondon(d_gmt,dldn);
      datetime d_cursor=d_gmt;
      int dhops=0;
      MqlDateTime dmon=dldn;
      while(dmon.day_of_week!=1 && dhops<8)
        {
         d_cursor-=86400;
         SnrGmtToLondon(d_cursor,dmon);
         dhops++;
        }
      if(dmon.day_of_week!=1)
         continue;
      const int key=dmon.year*10000+dmon.mon*100+dmon.day;
      if(key!=this_key)
         continue;
      if(dldn.day_of_week<1 || dldn.day_of_week>2)
         continue;
      box_n++;
      if(d1[i].high>box_h)
         box_h=d1[i].high;
      if(d1[i].low<box_l)
         box_l=d1[i].low;
     }
   if(box_n<2 || !SnrFinite(box_h) || !SnrFinite(box_l) || box_h<=box_l)
     {
      out.reject_reason="MWRB_BOX";
      return(true);
     }

   int direction=SNR_DIR_NONE;
   if(h1[0].close>box_h && h1[0].close>h1[0].open)
      direction=SNR_DIR_LONG;
   else if(h1[0].close<box_l && h1[0].close<h1[0].open)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="MWRB";
      return(true);
     }

   const int hn=ArraySize(h1);
   for(int i=1;i<hn;i++)
     {
      if(!SnrFinite(h1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="MWRB_BAR";
         return(false);
        }
      datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      datetime b_cursor=bar_gmt;
      int b_hops=0;
      MqlDateTime bmon=bar_ldn;
      while(bmon.day_of_week!=1 && b_hops<8)
        {
         b_cursor-=86400;
         SnrGmtToLondon(b_cursor,bmon);
         b_hops++;
        }
      if(bmon.day_of_week!=1)
         continue;
      const int bkey=bmon.year*10000+bmon.mon*100+bmon.day;
      if(bkey!=this_key)
         continue;
      if(bar_ldn.day_of_week<3)
         continue;
      const bool prior=(direction>0 ? h1[i].close>box_h : h1[i].close<box_l);
      if(prior)
        {
         out.reject_reason="MWRB_NOT_FIRST";
         return(true);
        }
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="MWRB_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=box_h-box_l;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1E21pSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,80,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,60,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<40 || ArraySize(d1)<50 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h1[1].close) || !SnrFinite(h1[1].high) || !SnrFinite(h1[1].low) ||
      h1[0].high<=h1[0].low || h1[1].high<=h1[1].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   double sma_sum=0.0;
   for(int i=0;i<50;i++)
     {
      if(!SnrFinite(d1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="E21P_SMA";
         return(false);
        }
      sma_sum+=d1[i].close;
     }
   const double sma50=sma_sum/50.0;
   if(!SnrFinite(sma50) || sma50<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="E21P_SMA";
      return(false);
     }
   int bias=SNR_DIR_NONE;
   if(d1[0].close>sma50)
      bias=SNR_DIR_LONG;
   else if(d1[0].close<sma50)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="E21P_REGIME";
      return(true);
     }

   const int n=ArraySize(h1);
   double seed=0.0;
   for(int i=n-1;i>=n-21;i--)
     {
      if(!SnrFinite(h1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="E21P_EMA";
         return(false);
        }
      seed+=h1[i].close;
     }
   double ema=seed/21.0;
   const double k=2.0/22.0;
   for(int i=n-22;i>=1;i--)
     {
      if(!SnrFinite(h1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="E21P_EMA";
         return(false);
        }
      ema=k*h1[i].close+(1.0-k)*ema;
     }
   if(!SnrFinite(ema) || ema<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="E21P_EMA";
      return(false);
     }

   const bool prior_tag=(h1[1].low<=ema && h1[1].high>=ema);
   const bool now_tag=(h1[0].low<=ema && h1[0].high>=ema);
   if(prior_tag || !now_tag)
     {
      out.reject_reason="E21P_FRESH";
      return(true);
     }

   int direction=SNR_DIR_NONE;
   if(bias==SNR_DIR_LONG && h1[1].close>ema &&
      h1[0].close>ema && h1[0].close>h1[0].open)
      direction=SNR_DIR_LONG;
   else if(bias==SNR_DIR_SHORT && h1[1].close<ema &&
           h1[0].close<ema && h1[0].close<h1[0].open)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="E21P";
      return(true);
     }

   const double sl_px=(direction>0 ? MathMin(h1[0].low,h1[1].low)
                                   : MathMax(h1[0].high,h1[1].high));
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="E21P_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=ema;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1D2tdSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,18,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(d1)<17 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 || d1[1].time<=0 ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=cfg.london_start_hour)
     {
      out.reject_reason="D2TD_HOUR";
      return(true);
     }

   if(!SnrFinite(d1[0].high) || !SnrFinite(d1[0].low) || d1[0].high<=d1[0].low ||
      !SnrFinite(d1[1].high) || !SnrFinite(d1[1].low) || d1[1].high<=d1[1].low ||
      !SnrFinite(d1[0].close))
     {
      out.data_fail=true;
      out.reject_reason="D2TD_D1";
      return(false);
     }
   const double box_h=MathMax(d1[0].high,d1[1].high);
   const double box_l=MathMin(d1[0].low,d1[1].low);
   const double box_range=box_h-box_l;
   if(!SnrFinite(box_h) || !SnrFinite(box_l) || !SnrFinite(box_range) || box_range<=0.0)
     {
      out.reject_reason="D2TD_BOX";
      return(true);
     }

   double adr_sum=0.0;
   for(int i=2;i<=15;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) || d1[i].high<=d1[i].low ||
         !SnrFinite(d1[i+1].high) || !SnrFinite(d1[i+1].low) || d1[i+1].high<=d1[i+1].low)
        {
         out.data_fail=true;
         out.reject_reason="D2TD_ADR";
         return(false);
        }
      adr_sum+=(MathMax(d1[i].high,d1[i+1].high)-MathMin(d1[i].low,d1[i+1].low));
     }
   const double adr2=adr_sum/14.0;
   if(!SnrFinite(adr2) || adr2<=0.0 || box_range<0.80*adr2)
     {
      out.reject_reason="D2TD_ADR";
      return(true);
     }
   const double q=(d1[0].close-box_l)/box_range;
   int bias=SNR_DIR_NONE;
   if(q>=0.75)
      bias=SNR_DIR_LONG;
   else if(q<=0.25)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="D2TD_Q";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="D2TD_COLOR";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-box_l : box_h-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="D2TD_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=q;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? box_l : box_h);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1D1hhSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,30,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,6,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<8 || ArraySize(d1)<3 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 || d1[1].time<=0 ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   if(!SnrFinite(d1[0].high) || !SnrFinite(d1[0].low) || d1[0].high<=d1[0].low ||
      !SnrFinite(d1[1].high) || !SnrFinite(d1[1].low) || d1[1].high<=d1[1].low)
     {
      out.data_fail=true;
      out.reject_reason="D1HH_D1";
      return(false);
     }

   int bias=SNR_DIR_NONE;
   if(d1[0].high>d1[1].high && d1[0].low>d1[1].low)
      bias=SNR_DIR_LONG;
   else if(d1[0].high<d1[1].high && d1[0].low<d1[1].low)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="D1HH_STRUCT";
      return(true);
     }

   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="D1HH_COLOR";
      return(true);
     }

   MqlDateTime sig_ldn;
   SnrGmtToLondon(signal_gmt,sig_ldn);
   const int day_key=sig_ldn.year*10000+sig_ldn.mon*100+sig_ldn.day;
   const int hn=ArraySize(h1);
   for(int i=1;i<hn;i++)
     {
      if(!SnrFinite(h1[i].close) || !SnrFinite(h1[i].open))
        {
         out.data_fail=true;
         out.reject_reason="D1HH_BAR";
         return(false);
        }
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      const int bkey=bar_ldn.year*10000+bar_ldn.mon*100+bar_ldn.day;
      if(bkey!=day_key)
         continue;
      SnrSessionSnap prior_sess;
      if(!SnrSessionRead(bar_gmt,cfg,prior_sess))
        {
         out.data_fail=true;
         out.reject_reason="D1HH_SESS";
         return(false);
        }
      if(!prior_sess.entry_allowed)
         continue;
      const int prior_dir=(h1[i].close>h1[i].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
      if(prior_dir==direction)
        {
         out.reject_reason="D1HH_NOT_FIRST";
         return(true);
        }
     }

   const double sl_px=(direction>0 ? d1[0].low : d1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="D1HH_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=(double)bias;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1LtdSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,400,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<80 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=cfg.london_start_hour)
     {
      out.reject_reason="LTD_HOUR";
      return(true);
     }

   MqlDateTime today_ldn;
   SnrGmtToLondon(signal_gmt,today_ldn);
   const int today_key=today_ldn.year*10000+today_ldn.mon*100+today_ldn.day;
   datetime y_cursor=signal_gmt-86400;
   int y_key=0;
   int hops=0;
   while(hops<8)
     {
      MqlDateTime yldn;
      SnrGmtToLondon(y_cursor,yldn);
      if(yldn.day_of_week>=1 && yldn.day_of_week<=5)
        {
         const int key=yldn.year*10000+yldn.mon*100+yldn.day;
         if(key!=today_key)
           {
            y_key=key;
            break;
           }
        }
      y_cursor-=86400;
      hops++;
     }
   if(y_key<=0)
     {
      out.reject_reason="LTD_YDAY";
      return(true);
     }

   const int hn=ArraySize(h1);
   double box_h=-1.0e100;
   double box_l=1.0e100;
   double box_c=0.0;
   int box_n=0;
   bool close_set=false;
   for(int i=0;i<hn;i++)
     {
      if(!SnrFinite(h1[i].high) || !SnrFinite(h1[i].low) || h1[i].high<=h1[i].low ||
         !SnrFinite(h1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="LTD_BAR";
         return(false);
        }
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      const int bkey=bar_ldn.year*10000+bar_ldn.mon*100+bar_ldn.day;
      if(bkey!=y_key)
         continue;
      if(SnrHourInRange(bar_ldn.hour,cfg.london_start_hour,cfg.london_end_hour)!=1)
         continue;
      if(!close_set)
        {
         box_c=h1[i].close;
         close_set=true;
        }
      if(h1[i].high>box_h)
         box_h=h1[i].high;
      if(h1[i].low<box_l)
         box_l=h1[i].low;
      box_n++;
     }
   if(box_n<6 || !close_set || !SnrFinite(box_h) || !SnrFinite(box_l) ||
      !SnrFinite(box_c) || box_h<=box_l)
     {
      out.reject_reason="LTD_BOX";
      return(true);
     }
   const double box_range=box_h-box_l;

   double adr_sum=0.0;
   int adr_n=0;
   datetime adr_cursor=y_cursor-86400;
   int adr_hops=0;
   while(adr_n<14 && adr_hops<40)
     {
      MqlDateTime adn;
      SnrGmtToLondon(adr_cursor,adn);
      if(adn.day_of_week>=1 && adn.day_of_week<=5)
        {
         const int akey=adn.year*10000+adn.mon*100+adn.day;
         double ah=-1.0e100;
         double al=1.0e100;
         int an=0;
         for(int i=0;i<hn;i++)
           {
            const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
            MqlDateTime bar_ldn;
            SnrGmtToLondon(bar_gmt,bar_ldn);
            const int bkey=bar_ldn.year*10000+bar_ldn.mon*100+bar_ldn.day;
            if(bkey!=akey)
               continue;
            if(SnrHourInRange(bar_ldn.hour,cfg.london_start_hour,cfg.london_end_hour)!=1)
               continue;
            if(h1[i].high>ah)
               ah=h1[i].high;
            if(h1[i].low<al)
               al=h1[i].low;
            an++;
           }
         if(an>=6 && ah>al)
           {
            adr_sum+=(ah-al);
            adr_n++;
           }
        }
      adr_cursor-=86400;
      adr_hops++;
     }
   if(adr_n<14 || adr_sum<=0.0)
     {
      out.reject_reason="LTD_ADR";
      return(true);
     }
   const double ladr=adr_sum/14.0;
   if(!SnrFinite(ladr) || ladr<=0.0 || box_range<0.80*ladr)
     {
      out.reject_reason="LTD_ADR";
      return(true);
     }
   const double q=(box_c-box_l)/box_range;
   int bias=SNR_DIR_NONE;
   if(q>=0.75)
      bias=SNR_DIR_LONG;
   else if(q<=0.25)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="LTD_Q";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="LTD_COLOR";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-box_l : box_h-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="LTD_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=q;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? box_l : box_h);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH4FvgxSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h4[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h4) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h4)<4 ||
      h4[0].time<=0 || h4[0].time>=availability_time ||
      !SnrFinite(h4[0].close) || !SnrFinite(h4[0].open) ||
      !SnrFinite(h4[0].high) || !SnrFinite(h4[0].low) ||
      !SnrFinite(h4[1].close) || !SnrFinite(h4[1].open) ||
      !SnrFinite(h4[1].high) || !SnrFinite(h4[1].low) ||
      !SnrFinite(h4[2].close) || !SnrFinite(h4[2].high) || !SnrFinite(h4[2].low) ||
      h4[0].high<=h4[0].low || h4[1].high<=h4[1].low || h4[2].high<=h4[2].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h4[0].time;
   out.signal_high=h4[0].high;
   out.signal_low=h4[0].low;
   out.signal_close=h4[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h4[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   const double min_gap=0.15*atr[0];
   int direction=SNR_DIR_NONE;
   if(h4[0].low>h4[2].high && (h4[0].low-h4[2].high)>=min_gap &&
      h4[0].close>h4[0].open && h4[1].close>h4[1].open)
      direction=SNR_DIR_LONG;
   else if(h4[0].high<h4[2].low && (h4[2].low-h4[0].high)>=min_gap &&
           h4[0].close<h4[0].open && h4[1].close<h4[1].open)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="FVGX";
      return(true);
     }

   const double sl_px=(direction>0 ? MathMin(h4[0].low,MathMin(h4[1].low,h4[2].low))
                                   : MathMax(h4[0].high,MathMax(h4[1].high,h4[2].high)));
   const double sl_dist=(direction>0 ? h4[0].close-sl_px : sl_px-h4[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="FVGX_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=(direction>0 ? h4[0].low-h4[2].high : h4[2].low-h4[0].high);
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h4[0].close;
   out.wave.impulse_extreme=(direction>0 ? h4[0].high : h4[0].low);

   SnrPvsraReadClosed(h4,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h4[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1NycqSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=13)
     {
      out.reject_reason="NYCQ_HOUR";
      return(true);
     }

   const double br=h1[0].high-h1[0].low;
   if(!SnrFinite(br) || br<0.80*atr[0])
     {
      out.reject_reason="NYCQ_ATR";
      return(true);
     }
   const double q=(h1[0].close-h1[0].low)/br;
   int bias=SNR_DIR_NONE;
   if(q>=0.75)
      bias=SNR_DIR_LONG;
   else if(q<=0.25)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="NYCQ_Q";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="NYCQ_COLOR";
      return(true);
     }
   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="NYCQ_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=q;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1Dc20Signal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,32,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<24 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   double ch_h=-1.0e100;
   double ch_l=1.0e100;
   for(int i=1;i<=20;i++)
     {
      if(!SnrFinite(h1[i].high) || !SnrFinite(h1[i].low) || h1[i].high<=h1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="DC20_CH";
         return(false);
        }
      if(h1[i].high>ch_h)
         ch_h=h1[i].high;
      if(h1[i].low<ch_l)
         ch_l=h1[i].low;
     }
   if(!SnrFinite(ch_h) || !SnrFinite(ch_l) || ch_h<=ch_l)
     {
      out.data_fail=true;
      out.reject_reason="DC20_CH";
      return(false);
     }

   int direction=SNR_DIR_NONE;
   if(h1[0].close>ch_h && h1[0].close>h1[0].open)
      direction=SNR_DIR_LONG;
   else if(h1[0].close<ch_l && h1[0].close<h1[0].open)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="DC20";
      return(true);
     }

   MqlDateTime sig_ldn;
   SnrGmtToLondon(signal_gmt,sig_ldn);
   const int day_key=sig_ldn.year*10000+sig_ldn.mon*100+sig_ldn.day;
   const int hn=ArraySize(h1);
   for(int i=1;i<hn;i++)
     {
      if(!SnrFinite(h1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="DC20_BAR";
         return(false);
        }
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      const int bkey=bar_ldn.year*10000+bar_ldn.mon*100+bar_ldn.day;
      if(bkey!=day_key)
         continue;
      SnrSessionSnap prior_sess;
      if(!SnrSessionRead(bar_gmt,cfg,prior_sess))
        {
         out.data_fail=true;
         out.reject_reason="DC20_SESS";
         return(false);
        }
      if(!prior_sess.entry_allowed)
         continue;
      const bool prior=(direction>0 ? h1[i].close>ch_h : h1[i].close<ch_l);
      if(prior)
        {
         out.reject_reason="DC20_NOT_FIRST";
         return(true);
        }
     }

   const double sl_px=(direction>0 ? ch_l : ch_h);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="DC20_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=ch_h-ch_l;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1R5brSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,140,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<125 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   double ch_h=-1.0e100;
   double ch_l=1.0e100;
   for(int i=1;i<=120;i++)
     {
      if(!SnrFinite(h1[i].high) || !SnrFinite(h1[i].low) || h1[i].high<=h1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="R5BR_CH";
         return(false);
        }
      if(h1[i].high>ch_h)
         ch_h=h1[i].high;
      if(h1[i].low<ch_l)
         ch_l=h1[i].low;
     }
   if(!SnrFinite(ch_h) || !SnrFinite(ch_l) || ch_h<=ch_l)
     {
      out.data_fail=true;
      out.reject_reason="R5BR_CH";
      return(false);
     }

   int direction=SNR_DIR_NONE;
   if(h1[0].close>ch_h && h1[0].close>h1[0].open)
      direction=SNR_DIR_LONG;
   else if(h1[0].close<ch_l && h1[0].close<h1[0].open)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="R5BR";
      return(true);
     }

   MqlDateTime sig_ldn;
   SnrGmtToLondon(signal_gmt,sig_ldn);
   const int day_key=sig_ldn.year*10000+sig_ldn.mon*100+sig_ldn.day;
   const int hn=ArraySize(h1);
   for(int i=1;i<hn;i++)
     {
      if(!SnrFinite(h1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="R5BR_BAR";
         return(false);
        }
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      const int bkey=bar_ldn.year*10000+bar_ldn.mon*100+bar_ldn.day;
      if(bkey!=day_key)
         continue;
      SnrSessionSnap prior_sess;
      if(!SnrSessionRead(bar_gmt,cfg,prior_sess))
        {
         out.data_fail=true;
         out.reject_reason="R5BR_SESS";
         return(false);
        }
      if(!prior_sess.entry_allowed)
         continue;
      const bool prior=(direction>0 ? h1[i].close>ch_h : h1[i].close<ch_l);
      if(prior)
        {
         out.reject_reason="R5BR_NOT_FIRST";
         return(true);
        }
     }

   const double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="R5BR_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=ch_h-ch_l;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1D1mzSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,16,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(d1)<15 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 || d1[0].high<=d1[0].low ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(d1[0].close) || !SnrFinite(d1[0].open) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=cfg.london_start_hour)
     {
      out.reject_reason="D1MZ_HOUR";
      return(true);
     }

   double adr_sum=0.0;
   for(int i=1;i<=14;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) || d1[i].high<=d1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="D1MZ_ADR";
         return(false);
        }
      adr_sum+=(d1[i].high-d1[i].low);
     }
   const double adr=adr_sum/14.0;
   const double y_range=d1[0].high-d1[0].low;
   if(!SnrFinite(adr) || adr<=0.0 || !SnrFinite(y_range) || y_range<0.80*adr)
     {
      out.reject_reason="D1MZ_ADR";
      return(true);
     }
   const double body=MathAbs(d1[0].close-d1[0].open);
   if(!SnrFinite(body) || body<0.70*y_range)
     {
      out.reject_reason="D1MZ_BODY";
      return(true);
     }
   int bias=SNR_DIR_NONE;
   if(d1[0].close>d1[0].open)
      bias=SNR_DIR_LONG;
   else if(d1[0].close<d1[0].open)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="D1MZ_DIR";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="D1MZ_COLOR";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-d1[0].low : d1[0].high-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="D1MZ_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=body/y_range;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? d1[0].low : d1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1IdbrSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,30,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,6,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<8 || ArraySize(d1)<3 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 || d1[1].time<=0 ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   if(!SnrFinite(d1[0].high) || !SnrFinite(d1[0].low) || d1[0].high<=d1[0].low ||
      !SnrFinite(d1[1].high) || !SnrFinite(d1[1].low) || d1[1].high<=d1[1].low)
     {
      out.data_fail=true;
      out.reject_reason="IDBR_D1";
      return(false);
     }
   if(!(d1[0].high<d1[1].high && d1[0].low>d1[1].low))
     {
      out.reject_reason="IDBR_INSIDE";
      return(true);
     }

   int direction=SNR_DIR_NONE;
   if(h1[0].close>d1[0].high && h1[0].close>h1[0].open)
      direction=SNR_DIR_LONG;
   else if(h1[0].close<d1[0].low && h1[0].close<h1[0].open)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="IDBR";
      return(true);
     }

   MqlDateTime sig_ldn;
   SnrGmtToLondon(signal_gmt,sig_ldn);
   const int day_key=sig_ldn.year*10000+sig_ldn.mon*100+sig_ldn.day;
   const int hn=ArraySize(h1);
   for(int i=1;i<hn;i++)
     {
      if(!SnrFinite(h1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="IDBR_BAR";
         return(false);
        }
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      const int bkey=bar_ldn.year*10000+bar_ldn.mon*100+bar_ldn.day;
      if(bkey!=day_key)
         continue;
      SnrSessionSnap prior_sess;
      if(!SnrSessionRead(bar_gmt,cfg,prior_sess))
        {
         out.data_fail=true;
         out.reject_reason="IDBR_SESS";
         return(false);
        }
      if(!prior_sess.entry_allowed)
         continue;
      const bool prior=(direction>0 ? h1[i].close>d1[0].high : h1[i].close<d1[0].low);
      if(prior)
        {
         out.reject_reason="IDBR_NOT_FIRST";
         return(true);
        }
     }

   const double sl_px=(direction>0 ? d1[0].low : d1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="IDBR_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=d1[0].high-d1[0].low;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1R20qSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,24,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(d1)<20 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=cfg.london_start_hour)
     {
      out.reject_reason="R20Q_HOUR";
      return(true);
     }

   double ch_h=-1.0e100;
   double ch_l=1.0e100;
   for(int i=0;i<20;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) || d1[i].high<=d1[i].low ||
         !SnrFinite(d1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="R20Q_CH";
         return(false);
        }
      if(d1[i].high>ch_h)
         ch_h=d1[i].high;
      if(d1[i].low<ch_l)
         ch_l=d1[i].low;
     }
   const double ch_range=ch_h-ch_l;
   if(!SnrFinite(ch_h) || !SnrFinite(ch_l) || !SnrFinite(ch_range) || ch_range<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="R20Q_CH";
      return(false);
     }
   const double q20=(d1[0].close-ch_l)/ch_range;
   int bias=SNR_DIR_NONE;
   if(q20>=0.80)
      bias=SNR_DIR_LONG;
   else if(q20<=0.20)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="R20Q";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="R20Q_COLOR";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-d1[0].low : d1[0].high-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="R20Q_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=q20;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? d1[0].low : d1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1Dnr7Signal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,30,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,10,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<8 || ArraySize(d1)<7 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   if(!SnrFinite(d1[0].high) || !SnrFinite(d1[0].low) || d1[0].high<=d1[0].low)
     {
      out.data_fail=true;
      out.reject_reason="DNR7_D1";
      return(false);
     }
   const double nr=d1[0].high-d1[0].low;
   for(int i=1;i<=6;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) || d1[i].high<=d1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="DNR7_D1";
         return(false);
        }
      if((d1[i].high-d1[i].low)<=nr)
        {
         out.reject_reason="DNR7_NR";
         return(true);
        }
     }

   int direction=SNR_DIR_NONE;
   if(h1[0].close>d1[0].high && h1[0].close>h1[0].open)
      direction=SNR_DIR_LONG;
   else if(h1[0].close<d1[0].low && h1[0].close<h1[0].open)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="DNR7";
      return(true);
     }

   MqlDateTime sig_ldn;
   SnrGmtToLondon(signal_gmt,sig_ldn);
   const int day_key=sig_ldn.year*10000+sig_ldn.mon*100+sig_ldn.day;
   const int hn=ArraySize(h1);
   for(int i=1;i<hn;i++)
     {
      if(!SnrFinite(h1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="DNR7_BAR";
         return(false);
        }
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      const int bkey=bar_ldn.year*10000+bar_ldn.mon*100+bar_ldn.day;
      if(bkey!=day_key)
         continue;
      SnrSessionSnap prior_sess;
      if(!SnrSessionRead(bar_gmt,cfg,prior_sess))
        {
         out.data_fail=true;
         out.reject_reason="DNR7_SESS";
         return(false);
        }
      if(!prior_sess.entry_allowed)
         continue;
      const bool prior=(direction>0 ? h1[i].close>d1[0].high : h1[i].close<d1[0].low);
      if(prior)
        {
         out.reject_reason="DNR7_NOT_FIRST";
         return(true);
        }
     }

   const double sl_px=(direction>0 ? d1[0].low : d1[0].high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="DNR7_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=nr;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1D1odSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,6,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(d1)<3 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 || d1[1].time<=0 ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(d1[0].close) || !SnrFinite(d1[0].open) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=cfg.london_start_hour)
     {
      out.reject_reason="D1OD_HOUR";
      return(true);
     }

   if(!SnrFinite(d1[0].high) || !SnrFinite(d1[0].low) || d1[0].high<=d1[0].low ||
      !SnrFinite(d1[1].high) || !SnrFinite(d1[1].low) || d1[1].high<=d1[1].low)
     {
      out.data_fail=true;
      out.reject_reason="D1OD_D1";
      return(false);
     }
   if(!(d1[0].high>d1[1].high && d1[0].low<d1[1].low))
     {
      out.reject_reason="D1OD_OUT";
      return(true);
     }
   int bias=SNR_DIR_NONE;
   if(d1[0].close>d1[0].open)
      bias=SNR_DIR_LONG;
   else if(d1[0].close<d1[0].open)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="D1OD_DIR";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="D1OD_COLOR";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-d1[0].low : d1[0].high-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="D1OD_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=d1[0].high-d1[0].low;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? d1[0].low : d1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1D1egSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,6,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(d1)<3 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 || d1[1].time<=0 ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(d1[0].close) || !SnrFinite(d1[0].open) ||
      !SnrFinite(d1[1].close) || !SnrFinite(d1[1].open) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=cfg.london_start_hour)
     {
      out.reject_reason="D1EG_HOUR";
      return(true);
     }

   if(!SnrFinite(d1[0].high) || !SnrFinite(d1[0].low) || d1[0].high<=d1[0].low)
     {
      out.data_fail=true;
      out.reject_reason="D1EG_D1";
      return(false);
     }

   int bias=SNR_DIR_NONE;
   const bool prior_bear=(d1[1].close<d1[1].open);
   const bool prior_bull=(d1[1].close>d1[1].open);
   const bool cur_bull=(d1[0].close>d1[0].open);
   const bool cur_bear=(d1[0].close<d1[0].open);
   if(prior_bear && cur_bull && d1[0].open<=d1[1].close && d1[0].close>=d1[1].open)
      bias=SNR_DIR_LONG;
   else if(prior_bull && cur_bear && d1[0].open>=d1[1].close && d1[0].close<=d1[1].open)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="D1EG";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="D1EG_COLOR";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-d1[0].low : d1[0].high-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="D1EG_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=MathAbs(d1[0].close-d1[0].open);
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? d1[0].low : d1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1ArrtSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,24,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,16,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<12 || ArraySize(d1)<14 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<=cfg.london_start_hour ||
      out.session.london_hour>=cfg.ny_start_hour)
     {
      out.reject_reason="ARRT_HOUR";
      return(true);
     }

   MqlDateTime day_ldn;
   SnrGmtToLondon(signal_gmt,day_ldn);
   double asia_high=-1.0e100;
   double asia_low=1.0e100;
   int asia_n=0;
   const int n=ArraySize(h1);
   for(int i=1;i<n;i++)
     {
      if(!SnrFinite(h1[i].high) || !SnrFinite(h1[i].low) || !SnrFinite(h1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="ARRT_BAR";
         return(false);
        }
      if(h1[i].high<h1[i].low)
         continue;
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      if(bar_ldn.year!=day_ldn.year || bar_ldn.mon!=day_ldn.mon || bar_ldn.day!=day_ldn.day)
         continue;
      if(bar_ldn.hour>=cfg.london_start_hour)
         continue;
      asia_high=MathMax(asia_high,h1[i].high);
      asia_low=MathMin(asia_low,h1[i].low);
      asia_n++;
     }
   if(asia_n<5 || !SnrFinite(asia_high) || !SnrFinite(asia_low) || asia_high<=asia_low)
     {
      out.reject_reason="ARRT_ASIA";
      return(true);
     }

   double adr_sum=0.0;
   for(int i=0;i<14;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) || d1[i].high<=d1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="ARRT_ADR";
         return(false);
        }
      adr_sum+=(d1[i].high-d1[i].low);
     }
   const double adr=adr_sum/14.0;
   const double asia_range=asia_high-asia_low;
   if(!SnrFinite(adr) || adr<=0.0 || asia_range<0.20*adr)
     {
      out.reject_reason="ARRT_ASIA";
      return(true);
     }

   int direction=SNR_DIR_NONE;
   if(h1[0].low<=asia_high && h1[0].close>asia_high && h1[0].close>h1[0].open)
      direction=SNR_DIR_LONG;
   else if(h1[0].high>=asia_low && h1[0].close<asia_low && h1[0].close<h1[0].open)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="ARRT";
      return(true);
     }

   bool prior_break=false;
   for(int i=n-1;i>=1;i--)
     {
      if(!SnrFinite(h1[i].close) || !SnrFinite(h1[i].high) || !SnrFinite(h1[i].low) ||
         !SnrFinite(h1[i].open))
        {
         out.data_fail=true;
         out.reject_reason="ARRT_BAR";
         return(false);
        }
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      if(bar_ldn.year!=day_ldn.year || bar_ldn.mon!=day_ldn.mon || bar_ldn.day!=day_ldn.day)
         continue;
      if(bar_ldn.hour<cfg.london_start_hour || bar_ldn.hour>=out.session.london_hour)
         continue;
      const bool closed_beyond=(direction>0 ? h1[i].close>asia_high : h1[i].close<asia_low);
      const bool retest_shape=(direction>0
                               ? (h1[i].low<=asia_high && h1[i].close>asia_high && h1[i].close>h1[i].open)
                               : (h1[i].high>=asia_low && h1[i].close<asia_low && h1[i].close<h1[i].open));
      if(!prior_break)
        {
         if(closed_beyond)
            prior_break=true;
         continue;
        }
      if(retest_shape)
        {
         out.reject_reason="ARRT_NOT_FIRST";
         return(true);
        }
     }
   if(!prior_break)
     {
      out.reject_reason="ARRT_BREAK";
      return(true);
     }

   const double sl_px=(direction>0 ? asia_low : asia_high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="ARRT_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=asia_range/adr;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1Tsm20Signal(const string symbol,const ENUM_TIMEFRAMES tf,
                           const SnrHandles &handles,const SnrClassicCfg &cfg,
                           const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,22,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(d1)<21 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 || d1[20].time<=0 ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(d1[0].close) || !SnrFinite(d1[0].open) ||
      !SnrFinite(d1[20].close) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=cfg.london_start_hour)
     {
      out.reject_reason="TSM20_HOUR";
      return(true);
     }

   double adr_sum=0.0;
   for(int i=0;i<14;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) || d1[i].high<=d1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="TSM20_ADR";
         return(false);
        }
      adr_sum+=(d1[i].high-d1[i].low);
     }
   const double adr=adr_sum/14.0;
   const double move=d1[0].close-d1[20].close;
   if(!SnrFinite(adr) || adr<=0.0 || !SnrFinite(move) || MathAbs(move)<1.0*adr)
     {
      out.reject_reason="TSM20_MOVE";
      return(true);
     }
   const int bias=(move>0.0 ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int d1_color=(d1[0].close>d1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(d1_color!=bias)
     {
      out.reject_reason="TSM20_D1";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="TSM20_COLOR";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-d1[0].low : d1[0].high-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="TSM20_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=move/adr;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? d1[0].low : d1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1ItdSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,16,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,16,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<10 || ArraySize(d1)<14 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=10)
     {
      out.reject_reason="ITD_HOUR";
      return(true);
     }

   MqlDateTime day_ldn;
   SnrGmtToLondon(signal_gmt,day_ldn);
   double day_high=-1.0e100;
   double day_low=1.0e100;
   int day_n=0;
   const int n=ArraySize(h1);
   for(int i=0;i<n;i++)
     {
      if(!SnrFinite(h1[i].high) || !SnrFinite(h1[i].low) || !SnrFinite(h1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="ITD_BAR";
         return(false);
        }
      if(h1[i].high<h1[i].low)
         continue;
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      if(bar_ldn.year!=day_ldn.year || bar_ldn.mon!=day_ldn.mon || bar_ldn.day!=day_ldn.day)
         continue;
      if(bar_ldn.hour>10)
         continue;
      day_high=MathMax(day_high,h1[i].high);
      day_low=MathMin(day_low,h1[i].low);
      day_n++;
     }
   if(day_n<8 || !SnrFinite(day_high) || !SnrFinite(day_low) || day_high<=day_low)
     {
      out.reject_reason="ITD_DAY";
      return(true);
     }

   double adr_sum=0.0;
   for(int i=0;i<14;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) || d1[i].high<=d1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="ITD_ADR";
         return(false);
        }
      adr_sum+=(d1[i].high-d1[i].low);
     }
   const double adr=adr_sum/14.0;
   const double day_range=day_high-day_low;
   if(!SnrFinite(adr) || adr<=0.0 || day_range<0.80*adr)
     {
      out.reject_reason="ITD_ADR";
      return(true);
     }
   const double q=(h1[0].close-day_low)/day_range;
   int bias=SNR_DIR_NONE;
   if(q>=0.75)
      bias=SNR_DIR_LONG;
   else if(q<=0.25)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="ITD_Q";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="ITD_COLOR";
      return(true);
     }
   const double sl_px=(direction>0 ? day_low : day_high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="ITD_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=q;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1L4cSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,16,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,16,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<8 || ArraySize(d1)<14 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=11)
     {
      out.reject_reason="L4C_HOUR";
      return(true);
     }

   MqlDateTime day_ldn;
   SnrGmtToLondon(signal_gmt,day_ldn);
   double box_high=-1.0e100;
   double box_low=1.0e100;
   int box_n=0;
   const int n=ArraySize(h1);
   for(int i=0;i<n;i++)
     {
      if(!SnrFinite(h1[i].high) || !SnrFinite(h1[i].low) || !SnrFinite(h1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="L4C_BAR";
         return(false);
        }
      if(h1[i].high<h1[i].low)
         continue;
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      if(bar_ldn.year!=day_ldn.year || bar_ldn.mon!=day_ldn.mon || bar_ldn.day!=day_ldn.day)
         continue;
      if(bar_ldn.hour<cfg.london_start_hour || bar_ldn.hour>11)
         continue;
      box_high=MathMax(box_high,h1[i].high);
      box_low=MathMin(box_low,h1[i].low);
      box_n++;
     }
   if(box_n<4 || !SnrFinite(box_high) || !SnrFinite(box_low) || box_high<=box_low)
     {
      out.reject_reason="L4C_BOX";
      return(true);
     }

   double adr_sum=0.0;
   for(int i=0;i<14;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) || d1[i].high<=d1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="L4C_ADR";
         return(false);
        }
      adr_sum+=(d1[i].high-d1[i].low);
     }
   const double adr=adr_sum/14.0;
   const double box_range=box_high-box_low;
   if(!SnrFinite(adr) || adr<=0.0 || box_range<0.50*adr)
     {
      out.reject_reason="L4C_ADR";
      return(true);
     }
   const double q=(h1[0].close-box_low)/box_range;
   int bias=SNR_DIR_NONE;
   if(q>=0.75)
      bias=SNR_DIR_LONG;
   else if(q<=0.25)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="L4C_Q";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="L4C_COLOR";
      return(true);
     }
   const double sl_px=(direction>0 ? box_low : box_high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="L4C_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=q;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH4HcqSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h4[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h4) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h4)<2 ||
      h4[0].time<=0 || h4[0].time>=availability_time ||
      !SnrFinite(h4[0].close) || !SnrFinite(h4[0].open) ||
      !SnrFinite(h4[0].high) || !SnrFinite(h4[0].low) ||
      h4[0].high<=h4[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h4[0].time;
   out.signal_high=h4[0].high;
   out.signal_low=h4[0].low;
   out.signal_close=h4[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h4[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   const double r=h4[0].high-h4[0].low;
   if(!SnrFinite(r) || r<0.80*atr[0])
     {
      out.reject_reason="HCQ_ATR";
      return(true);
     }
   const double q=(h4[0].close-h4[0].low)/r;
   int bias=SNR_DIR_NONE;
   if(q>=0.75)
      bias=SNR_DIR_LONG;
   else if(q<=0.25)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="HCQ_Q";
      return(true);
     }
   const int direction=(h4[0].close>h4[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="HCQ_COLOR";
      return(true);
     }
   const double sl_dist=(direction>0 ? h4[0].close-h4[0].low : h4[0].high-h4[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="HCQ_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=q;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? h4[0].low : h4[0].high);
   out.wave.pullback_price=h4[0].close;
   out.wave.impulse_extreme=(direction>0 ? h4[0].high : h4[0].low);

   SnrPvsraReadClosed(h4,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h4[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1AlbrSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,16,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<10 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<cfg.london_start_hour ||
      out.session.london_hour>=cfg.ny_start_hour)
     {
      out.reject_reason="ALBR_HOUR";
      return(true);
     }

   MqlDateTime day_ldn;
   SnrGmtToLondon(signal_gmt,day_ldn);
   double asia_high=-1.0e100;
   double asia_low=1.0e100;
   int asia_n=0;
   const int n=ArraySize(h1);
   for(int i=1;i<n;i++)
     {
      if(!SnrFinite(h1[i].high) || !SnrFinite(h1[i].low) || !SnrFinite(h1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="ALBR_BAR";
         return(false);
        }
      if(h1[i].high<h1[i].low)
         continue;
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      if(bar_ldn.year!=day_ldn.year || bar_ldn.mon!=day_ldn.mon || bar_ldn.day!=day_ldn.day)
         continue;
      if(bar_ldn.hour>=cfg.london_start_hour)
         continue;
      asia_high=MathMax(asia_high,h1[i].high);
      asia_low=MathMin(asia_low,h1[i].low);
      asia_n++;
     }
   if(asia_n<5 || !SnrFinite(asia_high) || !SnrFinite(asia_low) || asia_high<=asia_low)
     {
      out.reject_reason="ALBR_ASIA";
      return(true);
     }
   const double asia_range=asia_high-asia_low;
   if(asia_range<0.30*atr[0])
     {
      out.reject_reason="ALBR_ASIA";
      return(true);
     }

   int direction=SNR_DIR_NONE;
   if(h1[0].close>asia_high && h1[0].close>h1[0].open)
      direction=SNR_DIR_LONG;
   else if(h1[0].close<asia_low && h1[0].close<h1[0].open)
      direction=SNR_DIR_SHORT;
   if(direction==SNR_DIR_NONE)
     {
      out.reject_reason="ALBR";
      return(true);
     }

   for(int i=1;i<n;i++)
     {
      if(!SnrFinite(h1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="ALBR_BAR";
         return(false);
        }
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      if(bar_ldn.year!=day_ldn.year || bar_ldn.mon!=day_ldn.mon || bar_ldn.day!=day_ldn.day)
         continue;
      if(bar_ldn.hour<cfg.london_start_hour || bar_ldn.hour>=out.session.london_hour)
         continue;
      const bool prior=(direction>0 ? h1[i].close>asia_high : h1[i].close<asia_low);
      if(prior)
        {
         out.reject_reason="ALBR_NOT_FIRST";
         return(true);
        }
     }

   const double sl_px=(direction>0 ? asia_low : asia_high);
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="ALBR_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=asia_range/atr[0];
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdJpyHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1C10rSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,12,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(d1)<10 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(d1[0].close) || !SnrFinite(d1[0].open) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=cfg.london_start_hour)
     {
      out.reject_reason="C10R_HOUR";
      return(true);
     }

   bool is_max=true;
   bool is_min=true;
   for(int i=1;i<10;i++)
     {
      if(!SnrFinite(d1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="C10R_D1";
         return(false);
        }
      if(d1[0].close<d1[i].close)
         is_max=false;
      if(d1[0].close>d1[i].close)
         is_min=false;
     }
   int bias=SNR_DIR_NONE;
   if(is_max && !is_min)
      bias=SNR_DIR_LONG;
   else if(is_min && !is_max)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="C10R_RANK";
      return(true);
     }
   const int d1_color=(d1[0].close>d1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(d1_color!=bias)
     {
      out.reject_reason="C10R_D1";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="C10R_COLOR";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-d1[0].low : d1[0].high-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="C10R_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=d1[0].close;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? d1[0].low : d1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1Er10Signal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,12,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(d1)<10 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(d1[0].close) || !SnrFinite(d1[0].open) ||
      !SnrFinite(d1[9].close) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=cfg.london_start_hour)
     {
      out.reject_reason="ER10_HOUR";
      return(true);
     }

   double path=0.0;
   for(int i=0;i<10;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) || d1[i].high<=d1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="ER10_D1";
         return(false);
        }
      path+=(d1[i].high-d1[i].low);
     }
   const double move=d1[0].close-d1[9].close;
   if(!SnrFinite(path) || path<=0.0 || !SnrFinite(move))
     {
      out.reject_reason="ER10_ER";
      return(true);
     }
   const double er=MathAbs(move)/path;
   if(er<0.50)
     {
      out.reject_reason="ER10_ER";
      return(true);
     }
   const int bias=(move>0.0 ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int d1_color=(d1[0].close>d1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(d1_color!=bias)
     {
      out.reject_reason="ER10_D1";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="ER10_COLOR";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-d1[0].low : d1[0].high-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="ER10_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=er;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? d1[0].low : d1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1D1maSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,6,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<4 || ArraySize(d1)<2 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(d1[0].high) || !SnrFinite(d1[0].low) ||
      d1[0].high<=d1[0].low ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=9)
     {
      out.reject_reason="D1MA_HOUR";
      return(true);
     }

   const double mid=(d1[0].high+d1[0].low)/2.0;
   if(!SnrFinite(mid))
     {
      out.data_fail=true;
      out.reject_reason="D1MA_MID";
      return(false);
     }

   MqlDateTime day_ldn;
   SnrGmtToLondon(signal_gmt,day_ldn);
   bool found_h8=false;
   double h8_close=0.0;
   const int n=ArraySize(h1);
   for(int i=1;i<n;i++)
     {
      if(!SnrFinite(h1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="D1MA_BAR";
         return(false);
        }
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      if(bar_ldn.year!=day_ldn.year || bar_ldn.mon!=day_ldn.mon || bar_ldn.day!=day_ldn.day)
         continue;
      if(bar_ldn.hour!=cfg.london_start_hour)
         continue;
      found_h8=true;
      h8_close=h1[i].close;
      break;
     }
   if(!found_h8)
     {
      out.reject_reason="D1MA_H8";
      return(true);
     }

   int bias=SNR_DIR_NONE;
   if(h8_close>mid && h1[0].close>mid && h1[0].close>h8_close && h1[0].close>h1[0].open)
      bias=SNR_DIR_LONG;
   else if(h8_close<mid && h1[0].close<mid && h1[0].close<h8_close && h1[0].close<h1[0].open)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="D1MA";
      return(true);
     }

   const double sl_px=(bias>0 ? d1[0].low : d1[0].high);
   const double sl_dist=(bias>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="D1MA_SL";
      return(true);
     }
   out.direction=bias;
   out.trend.valid=true;
   out.trend.ema=mid;
   out.trend.slope=(bias>0 ? 1.0 : -1.0);
   out.trend.side=bias;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=bias;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(bias>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,bias,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,bias,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1VrqSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                         const SnrHandles &handles,const SnrClassicCfg &cfg,
                         const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,12,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(d1)<10 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(d1[0].close) || !SnrFinite(d1[0].high) || !SnrFinite(d1[0].low) ||
      d1[0].high<=d1[0].low ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=cfg.london_start_hour)
     {
      out.reject_reason="VRQ_HOUR";
      return(true);
     }

   double recent=0.0;
   double prior=0.0;
   for(int i=0;i<5;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) || d1[i].high<=d1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="VRQ_D1";
         return(false);
        }
      recent+=(d1[i].high-d1[i].low);
     }
   for(int i=5;i<10;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) || d1[i].high<=d1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="VRQ_D1";
         return(false);
        }
      prior+=(d1[i].high-d1[i].low);
     }
   if(!SnrFinite(recent) || !SnrFinite(prior) || prior<=0.0 || recent<1.30*prior)
     {
      out.reject_reason="VRQ_REGIME";
      return(true);
     }

   const double q=(d1[0].close-d1[0].low)/(d1[0].high-d1[0].low);
   int bias=SNR_DIR_NONE;
   if(q>=0.75)
      bias=SNR_DIR_LONG;
   else if(q<=0.25)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="VRQ_Q";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="VRQ_COLOR";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-d1[0].low : d1[0].high-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="VRQ_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=q;
   out.trend.slope=recent/prior;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? d1[0].low : d1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1ZretSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,22,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 || ArraySize(d1)<22 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 || d1[21].time<=0 ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(d1[0].close) || !SnrFinite(d1[0].open) ||
      !SnrFinite(d1[0].high) || !SnrFinite(d1[0].low) ||
      !SnrFinite(d1[1].close) || !SnrFinite(d1[21].close) ||
      d1[0].high<=d1[0].low ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour!=cfg.london_start_hour)
     {
      out.reject_reason="ZRET_HOUR";
      return(true);
     }

   const double y_move=d1[0].close-d1[1].close;
   double mean=0.0;
   for(int i=1;i<=20;i++)
     {
      if(!SnrFinite(d1[i].close) || !SnrFinite(d1[i+1].close))
        {
         out.data_fail=true;
         out.reject_reason="ZRET_PRIOR";
         return(false);
        }
      mean+=(d1[i].close-d1[i+1].close);
     }
   mean/=20.0;
   double sumsq=0.0;
   for(int i=1;i<=20;i++)
     {
      const double prior_move=d1[i].close-d1[i+1].close;
      const double prior_dev=prior_move-mean;
      sumsq+=prior_dev*prior_dev;
     }
   const double sigma=MathSqrt(sumsq/19.0);
   if(!SnrFinite(y_move) || !SnrFinite(sigma) || sigma<=0.0)
     {
      out.reject_reason="ZRET_SIGMA";
      return(true);
     }
   if(MathAbs(y_move)<1.50*sigma)
     {
      out.reject_reason="ZRET_MOVE";
      return(true);
     }
   const int bias=(y_move>0.0 ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int d1_color=(d1[0].close>d1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(d1_color!=bias)
     {
      out.reject_reason="ZRET_D1";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="ZRET_COLOR";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-d1[0].low : d1[0].high-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="ZRET_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=y_move/sigma;
   out.trend.slope=sigma;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? d1[0].low : d1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1Sol3Signal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,4,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<4 || ArraySize(d1)<1 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h1[1].close) || !SnrFinite(h1[1].open) ||
      !SnrFinite(h1[1].high) || !SnrFinite(h1[1].low) ||
      !SnrFinite(h1[2].close) || !SnrFinite(h1[2].open) ||
      !SnrFinite(h1[2].high) || !SnrFinite(h1[2].low) ||
      !SnrFinite(d1[0].close) || !SnrFinite(d1[0].open) ||
      h1[0].high<=h1[0].low || h1[1].high<=h1[1].low || h1[2].high<=h1[2].low ||
      !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<cfg.london_start_hour || out.session.london_hour>11)
     {
      out.reject_reason="SOL3_HOUR";
      return(true);
     }

   MqlDateTime day_ldn;
   SnrGmtToLondon(signal_gmt,day_ldn);
   for(int i=0;i<3;i++)
     {
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      if(bar_ldn.year!=day_ldn.year || bar_ldn.mon!=day_ldn.mon || bar_ldn.day!=day_ldn.day)
        {
         out.reject_reason="SOL3_DATE";
         return(true);
        }
      if(bar_ldn.hour<cfg.london_start_hour || bar_ldn.hour>11)
        {
         out.reject_reason="SOL3_WINDOW";
         return(true);
        }
     }

   const int c0=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int c1=(h1[1].close>h1[1].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   const int c2=(h1[2].close>h1[2].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(c0!=c1 || c1!=c2)
     {
      out.reject_reason="SOL3_COLOR";
      return(true);
     }
   const int direction=c0;
   const int d1_color=(d1[0].close>d1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(d1_color!=direction)
     {
      out.reject_reason="SOL3_D1";
      return(true);
     }
   if(direction>0)
     {
      if(!(h1[0].close>h1[1].close && h1[1].close>h1[2].close))
        {
         out.reject_reason="SOL3_SEQ";
         return(true);
        }
     }
   else
     {
      if(!(h1[0].close<h1[1].close && h1[1].close<h1[2].close))
        {
         out.reject_reason="SOL3_SEQ";
         return(true);
        }
     }
   for(int i=0;i<3;i++)
     {
      const double rng=h1[i].high-h1[i].low;
      const double body=MathAbs(h1[i].close-h1[i].open);
      if(!SnrFinite(rng) || rng<=0.0 || !SnrFinite(body) || body<0.50*rng)
        {
         out.reject_reason="SOL3_BODY";
         return(true);
        }
     }
   if(h1[0].open<h1[1].low || h1[0].open>h1[1].high ||
      h1[1].open<h1[2].low || h1[1].open>h1[2].high)
     {
      out.reject_reason="SOL3_OPEN";
      return(true);
     }

   const double sl_px=(direction>0 ? MathMin(h1[0].low,MathMin(h1[1].low,h1[2].low))
                                   : MathMax(h1[0].high,MathMax(h1[1].high,h1[2].high)));
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="SOL3_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=sl_dist/atr[0];
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1QasxSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   MqlRates d1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,24,h1) ||
      !SnrCopyClosedRates(symbol,PERIOD_D1,16,d1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<12 || ArraySize(d1)<14 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      d1[0].time<=0 ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<cfg.london_start_hour || out.session.london_hour>11)
     {
      out.reject_reason="QASX_HOUR";
      return(true);
     }

   MqlDateTime day_ldn;
   SnrGmtToLondon(signal_gmt,day_ldn);
   double asia_high=-1.0e100;
   double asia_low=1.0e100;
   int asia_n=0;
   const int n=ArraySize(h1);
   for(int i=1;i<n;i++)
     {
      if(!SnrFinite(h1[i].high) || !SnrFinite(h1[i].low))
        {
         out.data_fail=true;
         out.reject_reason="QASX_BAR";
         return(false);
        }
      if(h1[i].high<h1[i].low)
         continue;
      const datetime bar_gmt=h1[i].time-(server_now-gmt_now);
      MqlDateTime bar_ldn;
      SnrGmtToLondon(bar_gmt,bar_ldn);
      if(bar_ldn.year!=day_ldn.year || bar_ldn.mon!=day_ldn.mon || bar_ldn.day!=day_ldn.day)
         continue;
      if(bar_ldn.hour>=cfg.london_start_hour)
         continue;
      asia_high=MathMax(asia_high,h1[i].high);
      asia_low=MathMin(asia_low,h1[i].low);
      asia_n++;
     }
   if(asia_n<5 || !SnrFinite(asia_high) || !SnrFinite(asia_low) || asia_high<=asia_low)
     {
      out.reject_reason="QASX_ASIA";
      return(true);
     }

   double adr_sum=0.0;
   for(int i=0;i<14;i++)
     {
      if(!SnrFinite(d1[i].high) || !SnrFinite(d1[i].low) || d1[i].high<=d1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="QASX_ADR";
         return(false);
        }
      adr_sum+=(d1[i].high-d1[i].low);
     }
   const double adr=adr_sum/14.0;
   const double asia_range=asia_high-asia_low;
   if(!SnrFinite(adr) || adr<=0.0 || asia_range>=0.40*adr)
     {
      out.reject_reason="QASX_COIL";
      return(true);
     }

   const double bar_range=h1[0].high-h1[0].low;
   if(!SnrFinite(bar_range) || bar_range<1.0*atr[0])
     {
      out.reject_reason="QASX_EXP";
      return(true);
     }
   const double q=(h1[0].close-h1[0].low)/bar_range;
   int bias=SNR_DIR_NONE;
   if(q>=0.70)
      bias=SNR_DIR_LONG;
   else if(q<=0.30)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="QASX_Q";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="QASX_COLOR";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-h1[0].low : h1[0].high-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="QASX_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=q;
   out.trend.slope=asia_range/adr;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? h1[0].low : h1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1ObvsSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,12,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<10 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h1[9].close) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<cfg.london_start_hour || out.session.london_hour>11)
     {
      out.reject_reason="OBVS_HOUR";
      return(true);
     }

   double obv=0.0;
   double vol_sum=0.0;
   for(int i=9;i>=1;i--)
     {
      if(!SnrFinite(h1[i].close) || !SnrFinite(h1[i-1].close) ||
         h1[i].tick_volume<0 || h1[i-1].tick_volume<0)
        {
         out.data_fail=true;
         out.reject_reason="OBVS_VOL";
         return(false);
        }
      vol_sum+=(double)h1[i-1].tick_volume;
      if(h1[i-1].close>h1[i].close)
         obv+=(double)h1[i-1].tick_volume;
      else if(h1[i-1].close<h1[i].close)
         obv-=(double)h1[i-1].tick_volume;
     }
   if(!SnrFinite(obv) || vol_sum<=0.0)
     {
      out.reject_reason="OBVS_FLOW";
      return(true);
     }

   int bias=SNR_DIR_NONE;
   if(obv>0.0 && h1[0].close>h1[9].close)
      bias=SNR_DIR_LONG;
   else if(obv<0.0 && h1[0].close<h1[9].close)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="OBVS_ALIGN";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="OBVS_COLOR";
      return(true);
     }

   double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   for(int i=1;i<10;i++)
     {
      if(!SnrFinite(h1[i].low) || !SnrFinite(h1[i].high) || h1[i].high<=h1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="OBVS_BAR";
         return(false);
        }
      if(direction>0)
         sl_px=MathMin(sl_px,h1[i].low);
      else
         sl_px=MathMax(sl_px,h1[i].high);
     }
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="OBVS_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=obv;
   out.trend.slope=(direction>0 ? 1.0 : -1.0);
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1MacdSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,80,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   const int n=ArraySize(h1);
   if(n<50 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h1[n-1].close) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<cfg.london_start_hour || out.session.london_hour>11)
     {
      out.reject_reason="MACD_HOUR";
      return(true);
     }

   const double k12=2.0/13.0;
   const double k26=2.0/27.0;
   const double k9=2.0/10.0;
   double macd[];
   double sig[];
   if(ArrayResize(macd,n)<n || ArrayResize(sig,n)<n)
     {
      out.data_fail=true;
      out.reject_reason="MACD_ALLOC";
      return(false);
     }
   double e12=h1[n-1].close;
   double e26=h1[n-1].close;
   macd[n-1]=0.0;
   for(int i=n-2;i>=0;i--)
     {
      if(!SnrFinite(h1[i].close))
        {
         out.data_fail=true;
         out.reject_reason="MACD_CLOSE";
         return(false);
        }
      e12=h1[i].close*k12+e12*(1.0-k12);
      e26=h1[i].close*k26+e26*(1.0-k26);
      macd[i]=e12-e26;
     }
   sig[n-1]=macd[n-1];
   double s=macd[n-1];
   for(int i=n-2;i>=0;i--)
     {
      s=macd[i]*k9+s*(1.0-k9);
      sig[i]=s;
     }
   if(!SnrFinite(macd[0]) || !SnrFinite(sig[0]) ||
      !SnrFinite(macd[1]) || !SnrFinite(sig[1]))
     {
      out.reject_reason="MACD_NAN";
      return(true);
     }

   int bias=SNR_DIR_NONE;
   if(macd[0]>sig[0] && macd[1]<=sig[1] && macd[0]>0.0)
      bias=SNR_DIR_LONG;
   else if(macd[0]<sig[0] && macd[1]>=sig[1] && macd[0]<0.0)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="MACD_CROSS";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="MACD_COLOR";
      return(true);
     }

   double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   for(int i=1;i<5;i++)
     {
      if(!SnrFinite(h1[i].low) || !SnrFinite(h1[i].high) || h1[i].high<=h1[i].low)
        {
         out.data_fail=true;
         out.reject_reason="MACD_BAR";
         return(false);
        }
      if(direction>0)
         sl_px=MathMin(sl_px,h1[i].low);
      else
         sl_px=MathMax(sl_px,h1[i].high);
     }
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="MACD_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=macd[0];
   out.trend.slope=macd[0]-sig[0];
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1PnwsSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,8,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<2 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }
   if(!SnrNewsUsdHighImpact(signal_gmt-8*3600,signal_gmt-SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="PNWS_NONE";
      return(true);
     }

   const double bar_range=h1[0].high-h1[0].low;
   if(!SnrFinite(bar_range) || bar_range<0.80*atr[0])
     {
      out.reject_reason="PNWS_RNG";
      return(true);
     }
   const double q=(h1[0].close-h1[0].low)/bar_range;
   int bias=SNR_DIR_NONE;
   if(q>=0.70)
      bias=SNR_DIR_LONG;
   else if(q<=0.30)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="PNWS_Q";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="PNWS_COLOR";
      return(true);
     }
   const double sl_dist=(direction>0 ? h1[0].close-h1[0].low : h1[0].high-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="PNWS_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=q;
   out.trend.slope=bar_range/atr[0];
   out.trend.side=direction;

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=(direction>0 ? h1[0].low : h1[0].high);
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

bool SnrBuildH1HhhlSignal(const string symbol,const ENUM_TIMEFRAMES tf,
                          const SnrHandles &handles,const SnrClassicCfg &cfg,
                          const datetime availability_time,SnrSignalDecision &out)
  {
   ZeroMemory(out);
   out.availability_time=availability_time;
   out.reject_reason="NONE";
   if(SNR_SCOUT_ENABLED)
     {
      out.data_fail=true;
      out.reject_reason="SCOUT_FORBIDDEN";
      return(false);
     }
   if(!SnrHandlesReady(handles) || availability_time<=0)
     {
      out.data_fail=true;
      out.reject_reason="HANDLE_OR_CFG";
      return(false);
     }

   MqlRates h1[];
   double atr[];
   if(!SnrCopyClosedRates(symbol,tf,12,h1) ||
      !SnrCopyClosedBuffer(handles.atr,4,atr))
     {
      out.data_fail=true;
      out.reject_reason="COPY_FAIL";
      return(false);
     }
   if(ArraySize(h1)<9 ||
      h1[0].time<=0 || h1[0].time>=availability_time ||
      !SnrFinite(h1[0].close) || !SnrFinite(h1[0].open) ||
      !SnrFinite(h1[0].high) || !SnrFinite(h1[0].low) ||
      !SnrFinite(h1[8].close) ||
      h1[0].high<=h1[0].low || !SnrFinite(atr[0]) || atr[0]<=0.0)
     {
      out.data_fail=true;
      out.reject_reason="STALE_OR_EMPTY";
      return(false);
     }

   out.decision_time=h1[0].time;
   out.signal_high=h1[0].high;
   out.signal_low=h1[0].low;
   out.signal_close=h1[0].close;
   out.atr=atr[0];

   const datetime server_now=TimeCurrent();
   const datetime gmt_now=TimeGMT();
   const datetime signal_gmt=h1[0].time-(server_now-gmt_now);
   if(!SnrSessionRead(signal_gmt,cfg,out.session))
     {
      out.data_fail=true;
      out.reject_reason="SESSION_READ";
      return(false);
     }
   if(!out.session.entry_allowed)
     {
      out.reject_reason="SESSION";
      return(true);
     }
   if(out.session.london_hour<cfg.london_start_hour || out.session.london_hour>11)
     {
      out.reject_reason="HHHL_HOUR";
      return(true);
     }

   int hh=0;
   int ll=0;
   for(int i=0;i<8;i++)
     {
      if(!SnrFinite(h1[i].high) || !SnrFinite(h1[i].low) ||
         !SnrFinite(h1[i+1].high) || !SnrFinite(h1[i+1].low) ||
         h1[i].high<=h1[i].low || h1[i+1].high<=h1[i+1].low)
        {
         out.data_fail=true;
         out.reject_reason="HHHL_BAR";
         return(false);
        }
      if(h1[i].high>h1[i+1].high)
         hh++;
      if(h1[i].low<h1[i+1].low)
         ll++;
     }

   int bias=SNR_DIR_NONE;
   if(hh>=6 && h1[0].close>h1[8].close)
      bias=SNR_DIR_LONG;
   else if(ll>=6 && h1[0].close<h1[8].close)
      bias=SNR_DIR_SHORT;
   if(bias==SNR_DIR_NONE)
     {
      out.reject_reason="HHHL_STR";
      return(true);
     }
   const int direction=(h1[0].close>h1[0].open ? SNR_DIR_LONG : SNR_DIR_SHORT);
   if(direction!=bias)
     {
      out.reject_reason="HHHL_COLOR";
      return(true);
     }

   double sl_px=(direction>0 ? h1[0].low : h1[0].high);
   for(int i=1;i<9;i++)
     {
      if(direction>0)
         sl_px=MathMin(sl_px,h1[i].low);
      else
         sl_px=MathMax(sl_px,h1[i].high);
     }
   const double sl_dist=(direction>0 ? h1[0].close-sl_px : sl_px-h1[0].close);
   if(!SnrFinite(sl_dist) || sl_dist<0.50*atr[0])
     {
      out.reject_reason="HHHL_SL";
      return(true);
     }
   out.direction=direction;
   out.trend.valid=true;
   out.trend.ema=(double)hh;
   out.trend.slope=(double)ll;
   out.trend.side=direction;

   if(SnrNewsUsdHighImpact(signal_gmt-SNR_NEWS_PAD_SEC,signal_gmt+6*3600+SNR_NEWS_PAD_SEC))
     {
      out.reject_reason="NEWS";
      return(true);
     }

   out.wave.valid=true;
   out.wave.direction=direction;
   out.wave.into_dragon=false;
   out.wave.break_or_reject=true;
   out.wave.first_break=true;
   out.wave.quality=SNR_WAVE_CLEAN;
   out.wave.structure_swing=sl_px;
   out.wave.pullback_price=h1[0].close;
   out.wave.impulse_extreme=(direction>0 ? h1[0].high : h1[0].low);

   SnrPvsraReadClosed(h1,direction,cfg.vol_avg_bars,cfg.vol_rising_mult,
                      cfg.vol_climax_mult,out.pvsra);
   if(!SnrSrReadClosed(h1[0].close,direction,atr[0],cfg.round_whole,
                       cfg.sr_runway_atr,out.sr))
     {
      out.data_fail=true;
      out.reject_reason="SR_READ";
      return(false);
     }

   out.fired=true;
   out.reject_reason="PASS";
   return(true);
  }

